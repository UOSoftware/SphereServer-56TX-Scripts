

// speedler silindi
// weightler ayarlandı,
// silah hızları weightler üzerinden hesaplıyor. (old style)

[ITEMDEF 0e85]
DEFNAME=i_pickaxe
TYPE=t_weapon_mace_pick
DAM=1,15
FLIP=1
SKILL=Swordsmanship
// SPEED=44
VALUE=48
WEIGHT=8.7
TWOHANDS=N
RESOURCES=4 i_ingot_iron,1 i_log
SKILLMAKE=Tinkering 42.1,t_tinker_tools
CATEGORY=Weapons
SUBSECTION=Swordsmanship
DESCRIPTION=PickAxe
ReqStr=50
TEVENTS=t_equipitem
DUPELIST=0e86

ON=@Create
HITPOINTS={500 1000}
//UsesMax=50


ON=@TARGON_CHAR
IF (<SRC.TARG.UID> == <SRC>)
    //SRC.ACTARG1 = 32   
    SRC.ACTARG2 = 1      
    SRC.ACTARG3 = 2      

    //SRC.ACT = <REF4>
    SRC.ACTPRV = <UID>
    SRC.ACTP = <eval <SRC.P.X> + 1>,<eval <SRC.P.Y>+ 1>,<SRC.P.Z>,<SRC.P.M>
    SRC.ACTION = 45	
    RETURN 1
ENDIF	


ON=@TARGON_ITEM
IF (<SRC.TARG.UID> == <UID>)

   // SRC.ACTARG1 = 32   
    SRC.ACTARG2 = 1   
    SRC.ACTARG3 = 2    
    SRC.ACT = <REF4>
    //SRC.ACTPRV = <UID>
    SRC.ACTP = <eval <SRC.P.X> + 1>,<eval <SRC.P.Y>+ 1>,<SRC.P.Z>,<SRC.P.M>
    SRC.ACTION = 45	
    RETURN 1
ENDIF


[ITEMDEF 0e86]
//pickaxe
DUPEITEM=0e85




