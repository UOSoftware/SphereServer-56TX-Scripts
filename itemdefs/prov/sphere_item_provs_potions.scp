////////////////////////////////////
// These are custom potions
////////////////////////////////////

[ITEMDEF i_potion_Mana]
ID=i_bottle_white
NAME=mana refresh potion%s
TYPE=t_potion
TDATA1=i_bottle_empty
RESOURCES=3 i_reag_eye_of_newt,1 i_bottle_empty
SKILLMAKE=ALCHEMY 65.1, t_mortar
TEVENTS=ei_potions_mana
WEIGHT=0

ON=@Create
MORE1=s_mana
MORE2=50.0
COLOR=color_gray_lt

[ITEMDEF i_potion_ManaTotal]
ID=i_bottle_white
NAME=total mana refresh potion%s
TYPE=t_potion
TDATA1=i_bottle_empty
RESOURCES=6 i_reag_eye_of_newt,1 i_bottle_empty
SKILLMAKE=ALCHEMY 95.1, t_mortar
TEVENTS=ei_potions_mana
WEIGHT=0

ON=@Create
MORE1=s_mana
MORE2=100.0
COLOR=color_gray_lt

[typedef ei_potions_mana]

on=@DClick
src.sysmessageloc <def.tcolor_red>, <def.empty_cliloc2>, Bu esya kullanilmamaktadir.
RETURN 1


