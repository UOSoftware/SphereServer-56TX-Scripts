[ITEMDEF I_POTION_BLEED]
DEFNAME=I_POTION_BLEED
ID=I_BOTTLE_ORANGE
TYPE=T_POTION
NAME=bleed potion%s
WEIGHT=0
VALUE=350
RESDISPDNHUE=060

ON=@CREATE
COLOR=060
MORE1=S_HEAL
MORE2=35.0

ON=@CLICK
IF (<AMOUNT> = 0)
	REMOVE
	RETURN 1
ENDIF
MESSAGE @0481,,1 <AMOUNT> adet <NAME>
RETURN 1

ON=@DCLICK
IF (<AMOUNT> = 0)
	REMOVE
	RETURN 1
ENDIF
IF !(<SRC.FINDID.i_bonus_bleed_equiped_mem>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Yaranız kanamıyor.
	RETURN 1
ENDIF
MORE1=0
// IF (<SRC.FINDLAYER(layer_flag_potionused)>)
IF (<SRC.FINDID.i_potion_bleed_cooldown>)
	SRC.sysmessageloc <def.tcolor_red>, <def.empty_cliloc2>, You can't drink another potion yet
	RETURN 1
ENDIF

// IF (<SRC.FINDID.i_bonus_bleed_equiped_mem>)
	SRC.FINDID.i_bonus_bleed_equiped_mem.REMOVE
	// LOCAL.YARAVAR=1
// ENDIF
// IF (<LOCAL.YARAVAR>)
	SRC.FUNC_BANDAGE_SUCCESS_MSG yarasını tedavi eder
// ENDIF
SRC.EFFECT 3,0376a,2,10,1
SERV.NEWITEM i_potion_bleed_cooldown,1,<SRC>,1
SRC.ANIM 34
SRC.SOUND {0030 1 0 031 1}
RETURN 1

