[typedef ei_potions_poison]

ON=@DCLICK
IF !(<SRC.ISINPACK <UID>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, <NAME>: <DEF.UNPACKMSG>
	RETURN 1
ELSEIF (<SRC.ACTION> == Poisoning)
	SRC.SYSMESSAGE <DEFMSG.skillwait_3>
	RETURN 1
ELSEIF (<SRC.FLAGS>&STATF_WAR)
	SRC.SYSMESSAGE <DEFMSG.skillwait_2>
	RETURN 1
ENDIF
// TARGET
// SRC.SYSMESSAGE Zehir surmek istediginiz silahi seciniz.
SRC.SYSMESSAGE Zehir surmek icin Poisoning becerisini kullaniniz.
RETURN 1

ON=@TARGON_CHAR
IF (<SRC.TARG.UID> != <SRC>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, <def.msg_invalid_target_tr> Sadece kendinizi seçebilirsiniz.
ELSE
	REF1=<SRC.WEAPON>
	IF (<REF1>)
		SRC.ACT = <UID> // potion
		SRC.ACTP = <SRC.P>
		SRC.ACTPRV = <ref1> // weapon
		SRC.ACTARG1 = 30
		SRC.ACTARG2 = 0
		SRC.ACTARG3 = 0
		SRC.ACTION = 30
		SRC.SYSMESSAGELOC <def.tcolor_blue>,<def.empty_cliloc2>, <REF1.NAME> silahını zehirlemeye başladın!
	ELSE
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Elinizde silah yok.
	ENDIF
ENDIF
RETURN 1

ON=@TARGON_GROUND
SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Hatalı seçim
TARGET
SRC.SYSMESSAGE Zehir surmek istediginiz silahi seciniz.
RETURN 1

ON=@TARGON_ITEM
IF (<SRC.TARG.UID> == <UID>)
	REF1=<SRC.WEAPON>
	IF (<REF1>)
		SRC.ACT = <UID> // potion
		SRC.ACTP = <SRC.P>
		SRC.ACTPRV = <ref1> // weapon
		SRC.ACTARG1 = 30
		SRC.ACTARG2 = 0
		SRC.ACTARG3 = 0
		SRC.ACTION = 30
		SRC.SYSMESSAGELOC <def.tcolor_blue>,<def.empty_cliloc2>, <REF1.NAME> silahını zehirlemeye başladın!
	ELSE
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Elinizde silah yok.
	ENDIF
	
ELSE

	IF !(<SRC.TARG.ISWEAPON>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu bir silah değil.
		RETURN 1
		
	ELSEIF ((<SRC.TARG.BASEID> == I_STAFF_MAGE) || (<SRC.TARG.TYPE> == T_WEAPON_XBOW) || (<SRC.TARG.TYPE> == T_WEAPON_BOW) || (<SRC.TARG.TYPE> == T_WEAPON_AXE) || (<SRC.TARG.TYPE> == T_WEAPON_MACE_SMITH) || (<SRC.TARG.TYPE> == T_WEAPON_MACE_STAFF))
		IF !(<SRC.TARG.BASEID> == I_BOW_ELVEN)
			SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu zehirlenebilir bir silah türü değil.
			RETURN 1
		ENDIF
	ELSEIF (<SRC.TARG.TOPOBJ> != <SRC>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, <SRC.TARG.NAME>: <DEF.UNPACKMSG>
		RETURN 1
	ELSEIF (<SRC.ACTION> == Poisoning)
		SRC.SYSMESSAGE <DEFMSG.skillwait_3>
		RETURN 1
	ENDIF
	SRC.ACT = <UID> // potion
	SRC.ACTP = <SRC.P>
	SRC.ACTPRV = <SRC.TARG.UID> // weapon
	SRC.ACTARG1 = 30
	SRC.ACTARG2 = 0
	SRC.ACTARG3 = 0
	SRC.ACTION = 30
	SRC.SYSMESSAGE @50 <SRC.TARG.NAME>: Zehri surmeye basladin!
ENDIF
RETURN 1




