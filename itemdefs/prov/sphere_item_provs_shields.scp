[typedef ei_faction_shield]

ON=@UNEQUIP
ATTR=ATTR_NEWBIE

ON=@DESTROY
REF1=<LINK>
IF (<REF1.ISVALID>)
	REF1.TAG0.FACTION_SHIELD=
	REF1.TAG0.FACTION_SHIELD.Nereid=
ENDIF

ON=@EQUIP
ATTR=ATTR_NEWBIE

IF !(<SRC.ISGM>) && (<SRC.ISPLAYER>)
	IF (<SRC.GUILD>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Guild üyeleri bu eşyayı kullanamaz.
		fUnequip
		RETURN 1
	ENDIF
	REF1=<SRC.MEMORYFINDTYPE.memory_town.LINK>
	IF !(<REF1>)
		SRC.SOUND=SND_SPELL_LIGHTNING
		SRC.TAG0.FACTION_SHIELD=
		SRC.TAG0.FACTION_SHIELD.Nereid=
		SRC.TAG0.FACTION_SHIELD.Titan=
		SRC.TAG0.FACTION_SHIELD.Olympos=
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Herhangi bir factiona üye olmadığınız için kalkan kullanamazsınız.
		REMOVE
		RETURN 1
	ENDIF
ENDIF



