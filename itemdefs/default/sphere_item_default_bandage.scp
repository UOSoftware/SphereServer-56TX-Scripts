

[TYPEDEF T_BANDAGE]
ON=@DCLICK
IF !(<TOPOBJ.UID> == <SRC.UID>)
	SRC.SYSMESSAGE Bandajlar cantanizda olmali.
	RETURN 1
ELSEIF (<SRC.FLAGS>&STATF_DEAD)
	SRC.SYSMESSAGE Oluyken bandaj kullanamazsiniz.
	RETURN 1
ELSEIF (<SRC.FINDID.I_MEM_HEALING> && <SRC.FINDID.I_MEM_HEALING.TIMER> < 0)
	SRC.FINDID.I_MEM_HEALING.REMOVE
	RETURN 0
ELSEIF (<SRC.FINDID.I_MEM_HEALING>)
	SRC.SYSMESSAGE Bandajlari su an kullanamazsiniz.
	RETURN 1
ELSE
	RETURN 0
ENDIF


ON=@TARGON_CHAR
// IF (<SRC.ACTION> == SKILL_MAGERY) // acaba bu sorguyu yapmak gerekir mi ? 
	SRC.SKILL FAIL
// ENDIF

IF !(<SRC.RESTEST 1 I_BANDAGE>)
	SRC.SYSMESSAGE Bandajiniz yok.
	RETURN 1
	
ELSEIF (<SRC.TARG.DISTANCE> > 3)
	SRC.SYSMESSAGE Hedefe ulasamiyorsunuz.
	RETURN 1	
	
ELSEIF (<SRC.FLAGS>&STATF_DEAD)
	SRC.SYSMESSAGE Oluyken bandaj kullanamazsiniz.
	RETURN 1
	
ELSEIF (<SRC.TARG.IsMonsters>)
	SRC.SYSMESSAGE Bunu iyilestiremezsiniz.
	RETURN 1
	
ELSEIF (<SRC.TARG.NPC> == brain_animal) // Animal Heal

	IF (<SRC.TARG.ID> == C_M_GOLEM_TINKER1) || (<SRC.TARG.ID> == C_M_GOLEM_TINKER2) || (<SRC.TARG.ID> == C_M_GOLEM)
		SRC.SYSMESSAGE Golem'leri bandajla iyilestiremezsiniz.
		RETURN 1
		
	ELSEIF !((<SRC.TARG.HITS> < <SRC.TARG.STR>) || (<SRC.TARG.FINDID.I_RUNE_POISON>))
		SRC.SYSMESSAGE <SRC.TARG.NAME> tedaviye ihtiyac duymuyor.
		RETURN 1
		
	ELSEIF (<SRC.TARG.FINDID.I_RUNE_POISON>)
		IF ((<SRC.VETERINARY> < 60.0) || (<SRC.ANIMALLORE> < 60.0))
			SRC.SYSMESSAGE Hayvan uzerindeki zehiri tedavi edecek kadar yetenekli degilsiniz. (60.0 Veterinary ve Animallore)
			RETURN 1
		ENDIF
	ENDIF
	
	LOCAL.NX1 <EVAL (<SRC.VETERINARY> / <R20,50>) >
	LOCAL.NX2 <EVAL (<SRC.ANIMALLORE> / 50) >
	LOCAL.NX3 <EVAL (<DLOCAL.NX1> + <DLOCAL.NX2> + <R3,10>) >
	
	SRC.SD 1
	SRC.ANIM 17
	SERV.NEWITEM I_MEM_HEALING,1,<SRC>,1
	NEW.MOREY <DLOCAL.NX3>
	NEW.MOREX 3 // Veterinary
	NEW.LINK <SRC.TARG.UID>

	SRC.FACE <SRC.TARG>
	RETURN 1
	
ELSEIF (<SRC.TARG.FLAGS>&STATF_DEAD) // Resurrect

	IF ((<SRC.HEALING> < 80.0) || (<SRC.ANATOMY> < 80.0))
		SRC.SYSMESSAGE Henuz oluleri diriltecek kudrete sahip degilsiniz.
		RETURN 1
	ELSEIF !(<SRC.RESTEST 5 I_BANDAGE>)
		SRC.SYSMESSAGE Diriltme islemi icin 5 bandaja ihtiyaciniz var.
		RETURN 1
	ELSE
	
		IF (<SRC.TARG.KILLS> > <serv.MurderMinCount>)
			SRC.CRIMINAL 1
			SRC.SAYUA 048,0,0,0 * <src.targ.name> isimli katili diriltir *
		
		ELSEIF (<SRC.TARG.FLAGS>&STATF_CRIMINAL)
			SRC.CRIMINAL 1
			SRC.SAYUA 048,0,0,0 * <src.targ.name> isimli suçluyu diriltir *
			
		ELSEIF (<SRC.MEMORYFINDTYPE.MEMORY_TOWN>) && (<SRC.TARG.MEMORYFINDTYPE.MEMORY_TOWN>) && (<SRC.MEMORYFINDTYPE.MEMORY_TOWN.LINK> != <SRC.TARG.MEMORYFINDTYPE.MEMORY_TOWN.LINK>)
			SRC.CRIMINAL 1

		ELSEIF (<SRC.TARG.MEMORYFINDTYPE.MEMORY_GUILD> && <SRC.TARG.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN> > 0)
			// Src guildsiz mi?
			IF !(<SRC.MEMORYFINDTYPE.MEMORY_GUILD>)
				SRC.CRIMINAL 1
			ELSE // Src guildi var, align > 0 ve farklı mı?
				IF (<SRC.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN> > 0 && <SRC.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN> != <SRC.TARG.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN>)
					SRC.CRIMINAL 1
					SRC.SAYUA 048,0,0,0 * <src.targ.name> isimli düşmanı diriltir *
				ENDIF
			ENDIF
		ENDIF
			
		SRC.SD 2
		SRC.FACE
		SRC.ANIM 17

		SRC.CONSUME 5 I_BANDAGE

        // SPELLEFFECT spell_id, strength, source_character_uid, source_item_uid
		SRC.TARG.SPELLEFFECT S_RESURRECTION,1000,<SRC>,<UID>

		// SRC.TARG.RESURRECT 2 // resleyince karakterin cantasini aciyor?

		SRC.TARG.SAYUA 048,0,0,0 * <src.name> sayesinde hayata döner *

		SRC.CHECKHEALING 2
		SRC.CHECKANATOMY 2
		
	ENDIF
	RETURN 1

ELSEIF (<SRC.TARG.MEMORYFINDTYPE.MEMORY_TOWN>) && !(<SRC.MEMORYFINDTYPE.MEMORY_TOWN>)
	SRC.SYSMESSAGE Faction uyelerini iyilestiremezsiniz.
	RETURN 1

ELSEIF (<SRC.TARG.MEMORYFINDTYPE.MEMORY_GUILD> && <SRC.TARG.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN> > 0)
	// Src guildsiz mi?
	IF !(<SRC.MEMORYFINDTYPE.MEMORY_GUILD>)
		SRC.SYSMESSAGE Order/Chaos uyelerini iyilestiremezsiniz.
		RETURN 1
	ELSE // Src guildi var, align > 0 ve farklı mı?
		IF (<SRC.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN> > 0 && <SRC.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN> != <SRC.TARG.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN>)
			SRC.SYSMESSAGE Order/Chaos uyelerini iyilestiremezsiniz.
			RETURN 1
		ENDIF
	ENDIF
	
ELSEIF !((<SRC.TARG.HITS> < <SRC.TARG.STR>) || (<SRC.TARG.FINDID.I_RUNE_POISON>))
	IF !(<SRC.TARG.UID> == <SRC.UID>)
		SRC.SYSMESSAGE <SRC.TARG.NAME> tedaviye ihtiyac duymuyor.
	ELSE
		SRC.SYSMESSAGE Tedaviye gereksiniminiz yok.
	ENDIF
	RETURN 1
	
ELSEIF (<SRC.TARG.FINDID.I_RUNE_POISON>)
	IF ((<SRC.HEALING> < 60.0) || (<SRC.ANATOMY> < 60.0))
		SRC.SYSMESSAGE Zehiri tedavi edecek kadar yetenekli degilsiniz. (60.0 Healing ve Anatomy)
		RETURN 1
	ENDIF
ENDIF

LOCAL.NX1 <eval (<SRC.HEALING> / <r20,50>)>
LOCAL.NX2 <eval (<SRC.ANATOMY> / 50)>
LOCAL.NX3 <EVAL (<DLOCAL.NX1> + <DLOCAL.NX2> + <r3,10>)>
// Normal Heal
//src.sysmessage <DLOCAL.NX3>
SRC.SD 1
SRC.ANIM 17

SERV.NEWITEM I_MEM_HEALING,1,<SRC>,1
NEW.MOREY <DLOCAL.NX3>

IF !(<SRC.TARG.UID> == <SRC.UID>) // HEAL OTHER
	NEW.MOREX 1 // Kendini mi baskasini mi?
	NEW.LINK <SRC.TARG.UID>
	SRC.FACE <SRC.TARG>
ENDIF
RETURN 1



[ITEMDEF I_MEM_HEALING]
DEFNAME=I_MEM_HEALING
ID=I_MEMORY
TYPE=T_EQ_SCRIPT
NAME=Healing Memory

ON=@CREATE
ATTR=ATTR_DECAY|ATTR_NEWBIE
TIMER=3

ON=@EQUIP
SRC.EVENTS +E_HEALING
TIMER=3

ON=@UNEQUIP
SRC.EVENTS -E_HEALING

ON=@TIMER
IF (<MOREY>)

	IF (<CONT.FLAGS>&STATF_DEAD)
		CONT.SYSMESSAGE Oluyken bandaj kullanamazsiniz.
		REMOVE
		RETURN 1
	ENDIF
	
	IF (<MOREX> == 3) // VETERINARY
		IF !(<LINK.HITS> < <LINK.STR>) && !(<LINK.FINDID.I_RUNE_POISON>)
			CONT.SYSMESSAGE <LINK.NAME> tedaviye ihtiyac duymuyor.
			REMOVE
			RETURN 1
			
		ELSEIF (<LINK.FINDID.I_RUNE_POISON>)
			IF (<CONT.VETERINARY> < 60.0) || (<CONT.ANIMALLORE> < 60.0)
				CONT.SYSMESSAGE Zehiri tedavi edecek kadar yetenekli degilsiniz. (60.0 Healing ve Anatomy)
				REMOVE
				RETURN 1
			ENDIF
		ELSEIF !(<CONT.RESTEST 1 I_BANDAGE>)
			CONT.SYSMESSAGE Bandajiniz yok.
			REMOVE
			RETURN 1
		ENDIF
		
		CONT.CONSUME 1 I_BANDAGE
		
		IF (<LINK.FINDID.I_RUNE_POISON>) // CURE ANIMAL
			IF !(RAND(5) == 1)
				LINK.FINDID.I_RUNE_POISON.REMOVE
				LINK.EFFECT 3,0376A,2,10,1
				LINK.SAYU * iyileştirilir *
			ELSE
				CONT.SAYUA 020,0,0,0 * <link.name> üzerindeki zehiri iyileştiremez *
			ENDIF
		ELSE // HEAL ANIMAL
			LINK.HITS <EVAL (<LINK.HITS> + <MOREY>)>
			LINK.EFFECT 3,0376A,2,10,1
			IF (<LINK.HITS> > <LINK.STR>)
				LINK.HITS <LINK.STR>
			ENDIF
			LINK.SAYU * tedavi görür *
			LINK.UPDATE
		ENDIF
		
		CONT.CHECKVETERINARY
		CONT.CHECKANIMALLORE
		
		IF (<CONT.DEX> < 35)
			TIMER 6
		ELSE
			TIMER 4
		ENDIF
		
	ELSEIF (<MOREX>) // OTHERS
	
		IF !(<LINK.HITS> < <LINK.STR>) && !(<LINK.FINDID.I_RUNE_POISON>)
			CONT.SYSMESSAGE <LINK.NAME> tedaviye ihtiyac duymuyor.
			REMOVE
			RETURN 1
			
		ELSEIF (<LINK.HITS> < 1)
			CONT.SYSMESSAGE <LINK.NAME> tedavi esnasinda hayatini kaybetti.
			REMOVE
			RETURN 1
			
		ELSEIF (<LINK.FINDID.I_RUNE_POISON>)
			IF (<CONT.HEALING> < 60.0) || (<CONT.ANATOMY> < 60.0)
				CONT.SYSMESSAGE Zehiri tedavi edecek kadar yetenekli degilsiniz. (60.0 Healing ve Anatomy)
				REMOVE
				RETURN 1
			ENDIF
		ELSEIF !(<CONT.RESTEST 1 I_BANDAGE>)
			CONT.SYSMESSAGE Bandajiniz yok.
			REMOVE
			RETURN 1
		ENDIF
		
		CONT.CONSUME 1 I_BANDAGE
		
		IF (<LINK.FINDID.I_RUNE_POISON>) // CURE OTHER
		
			IF !(RAND(5) == 1)
				LINK.FINDID.I_RUNE_POISON.REMOVE
				LINK.EFFECT 3,0376A,2,10,1
				
				IF (<LINK.KILLS> > <serv.MurderMinCount>)
					CONT.CRIMINAL 1
					CONT.SAYUA 048,0,0,0 * <LINK.NAME> isimli katili iyileştirir *
				ELSEIF (<LINK.FLAGS>&STATF_CRIMINAL)
					CONT.CRIMINAL 1
					CONT.SAYUA 048,0,0,0 * <LINK.NAME> isimli suçluyu iyileştirir *
				ELSE
					LINK.SAYUA 048,0,0,0 * <CONT.NAME> tarafindan iyileştirilir *
					
					// ZATEN TEDAVI EDEMIYOR BU SORGULAR BOSUNA
					IF (<LINK.MEMORYFINDTYPE.MEMORY_TOWN>) && (<CONT.MEMORYFINDTYPE.MEMORY_TOWN>) && (<CONT.MEMORYFINDTYPE.MEMORY_TOWN.LINK> != <LINK.MEMORYFINDTYPE.MEMORY_TOWN.LINK>)
						CONT.CRIMINAL 1

					ELSEIF (<LINK.MEMORYFINDTYPE.MEMORY_GUILD> && <LINK.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN> > 0)
						// Src guildsiz mi?
						IF !(<CONT.MEMORYFINDTYPE.MEMORY_GUILD>)
							CONT.CRIMINAL 1
						ELSE // Src guildi var, align > 0 ve farklı mı?
							IF (<CONT.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN> > 0 && <CONT.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN> != <LINK.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN>)
								CONT.CRIMINAL 1
								CONT.SAYUA 048,0,0,0 * <LINK.name> isimli düşmanı iyileştirir *
							ENDIF
						ENDIF
					ENDIF
					
				ENDIF
				
			ELSE
				CONT.SAYUA 020,0,0,0 * <LINK.NAME> üzerindeki zehiri iyileştiremez *
			ENDIF
			
		ELSE // HEAL OTHER
		
			LINK.HITS +=<MOREY>

			LINK.EFFECT 3,0376A,2,10,1
			IF (<LINK.HITS> > <LINK.STR>)
				LINK.HITS <LINK.STR>
			ENDIF
			IF (<LINK.KILLS> > <SERV.MURDERMINCOUNT>)
				CONT.CRIMINAL 1
				CONT.SAYUA 048,0,0,0 * <LINK.NAME> isimli katili tedavi eder *
			ELSEIF (<LINK.FLAGS>&STATF_CRIMINAL)
				CONT.CRIMINAL 1
				CONT.SAYUA 048,0,0,0 * <LINK.NAME> isimli suçluyu tedavi eder *
			ELSE
				LINK.SAYUA 048,0,0,0 * <CONT.NAME> tarafından tedavi edilir *
				
				// ZATEN TEDAVI EDEMIYOR BU SORGULAR BOSUNA
				IF (<LINK.MEMORYFINDTYPE.MEMORY_TOWN>) && (<CONT.MEMORYFINDTYPE.MEMORY_TOWN>) && (<CONT.MEMORYFINDTYPE.MEMORY_TOWN.LINK> != <LINK.MEMORYFINDTYPE.MEMORY_TOWN.LINK>)
					CONT.CRIMINAL 1
					
				ELSEIF (<LINK.MEMORYFINDTYPE.MEMORY_GUILD> && <LINK.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN> > 0)
					// Src guildsiz mi?
					IF !(<CONT.MEMORYFINDTYPE.MEMORY_GUILD>)
						CONT.CRIMINAL 1
					ELSE // Src guildi var, align > 0 ve farklı mı?
						IF (<CONT.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN> > 0 && <CONT.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN> != <LINK.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN>)
							CONT.CRIMINAL 1
							CONT.SAYUA 048,0,0,0 * <LINK.name> isimli düşmanı iyileştirir *
						ENDIF
					ENDIF
				ENDIF
					
				//ELSEIF (<LINK.MEMORYFINDTYPE.MEMORY_GUILD> && <LINK.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN>) && (<CONT.MEMORYFINDTYPE.MEMORY_GUILD> && <CONT.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN>) && (<CONT.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN> != <LINK.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN>)
					//CONT.CRIMINAL 1
				//ENDIF
				
				
			ENDIF
		ENDIF
		
		CONT.CHECKHEALING 1
		CONT.CHECKANATOMY 1
		
		IF (<CONT.DEX> < 35)
			TIMER 6
		ELSE
			TIMER 4
		ENDIF
		
	ELSE
	
		IF !(<CONT.HITS> < <CONT.STR>) && !(<CONT.FINDID.I_RUNE_POISON>)
			CONT.SYSMESSAGE Tedaviye ihtiyac duymuyorsunuz.
			REMOVE
			RETURN 1
			
		ELSEIF (<CONT.HITS> < 1)
			REMOVE
			RETURN 1
			
		ELSEIF (<CONT.FINDID.I_RUNE_POISON>)
			IF (<CONT.HEALING> < 60.0) || (<CONT.ANATOMY> < 60.0)
				CONT.SYSMESSAGE Zehiri tedavi edecek kadar yetenekli degilsiniz.
				REMOVE
				RETURN 1
			ENDIF
			
   		ELSEIF !(<CONT.RESTEST 1 I_BANDAGE>)
			CONT.SYSMESSAGE Bandajiniz yok.
			REMOVE
			RETURN 1
		ENDIF
		
		CONT.CONSUME 1 I_BANDAGE
		
		IF (<CONT.FINDID.I_RUNE_POISON>) // CURE SELF
			IF !(RAND(5) == 1)
				CONT.FINDID.I_RUNE_POISON.REMOVE
				CONT.EFFECT 3,0376A,2,10,1
				CONT.SAYUA 048,0,0,0 * zehir etkisini iyileştirir *
			ELSE
				CONT.SAYUA 020,0,0,0 * zehiri iyileştiremez *
			ENDIF
			
		ELSE // HEAL SELF
			CONT.HITS +=<MOREY>

			CONT.EFFECT 3,0376A,2,10,1
			CONT.SAYUA 048,0,0,0 * kendini tedavi eder *
			IF (<CONT.HITS> > <CONT.STR>)
				CONT.HITS <CONT.STR>
			ENDIF
		ENDIF
		
		CONT.CHECKHEALING 1
		CONT.CHECKANATOMY 1
		
		IF (<CONT.DEX> < 35)
			TIMER 14
		ELSE
			TIMER 8
		ENDIF
		
	ENDIF
	
	MOREY 0 // MEMORYYI ETKISIZ HALE GETIR
	CONT.EVENTS -E_HEALING // EVENTI KALDIR ARTIK GEREK YOK
	RETURN 1
ENDIF

REMOVE
RETURN 1


	
[events e_healing]
ON=@GETHIT
// IF (RAND(2) == 1)
	SAYUA 020,0,0,0 * bandajları yırtılır *
	IF (<FINDID.I_MEM_HEALING>)
		FINDID.I_MEM_HEALING.REMOVE
	ENDIF
// ENDIF
BARK 3

ON=@DEATH
IF (<FINDID.I_MEM_HEALING>)
	FINDID.I_MEM_HEALING.REMOVE
ENDIF

ON=@LOGOUT
IF (<FINDID.I_MEM_HEALING>)
	FINDID.I_MEM_HEALING.REMOVE
ENDIF



[FUNCTION CHECKHEALING]
IF !(<ISEMPTY <ARGS>>)
	IF (<ARGS> == 1) && (<HEALING> >= 80.0) && (RAND(3) == 1)
		RETURN 0
	ENDIF
ENDIF

IF ((<SKILLLOCK[17]> == 0) && (<SKILLTOTAL> < <SKILLCLASS.SKILLSUM>))
	IF (<HEALING> < 30.0)
		IF (RAND(4) == 1)
			HEALING (<HEALING> + 1)
		ENDIF
	ELSEIF (<HEALING> < 50.0)
		IF (RAND(8) == 1)
			HEALING (<HEALING> + 1)
		ENDIF
	ELSEIF (<HEALING> < 75.0)
		IF (RAND(10) == 1)
			HEALING (<HEALING> + 1)
		ENDIF
	ELSEIF (<HEALING> < 100.0)
		IF (RAND(14) == 1)
			HEALING (<HEALING> + 1)
		ENDIF
	ENDIF
ENDIF


[FUNCTION CHECKVETERINARY]
IF ((<SKILLLOCK[39]> == 0) && (<SKILLTOTAL> < <SKILLCLASS.SKILLSUM>))
	IF (<VETERINARY> < 30.0)
		IF (RAND(3) == 1)
			VETERINARY (<VETERINARY> + 1)
		ENDIF
	ELSEIF (<VETERINARY> < 50.0)
		IF (RAND(7) == 1)
			VETERINARY (<VETERINARY> + 1)
		ENDIF
	ELSEIF (<VETERINARY> < 75.0)
		IF (RAND(9) == 1)
			VETERINARY (<VETERINARY> + 1)
		ENDIF
	ELSEIF (<VETERINARY> < 100.0)
		IF (RAND(13) == 1)
			VETERINARY (<VETERINARY> + 1)
		ENDIF
	ENDIF
ENDIF



[FUNCTION CHECKANATOMY]
IF !(<ISEMPTY <ARGS>>)
	IF (<ARGS> == 1) && (<ANATOMY> >= 80.0) && (RAND(3) == 1)
		RETURN 0
	ENDIF
ENDIF
IF ((<SKILLLOCK[1]> == 0) && (<SKILLTOTAL> < <SKILLCLASS.SKILLSUM>))
	IF (<ANATOMY> < 30.0)
		IF (RAND(2) == 1)
			ANATOMY (<ANATOMY> + 1)
		ENDIF
	ELSEIF (<ANATOMY> < 50.0)
		IF (RAND(6) == 1)
			ANATOMY (<ANATOMY> + 1)
		ENDIF
	ELSEIF (<ANATOMY> < 75.0)
		IF (RAND(8) == 1)
			ANATOMY (<ANATOMY> + 1)
		ENDIF
	ELSEIF (<ANATOMY> < 100.0)
		IF (RAND(12) == 1)
			ANATOMY (<ANATOMY> + 1)
		ENDIF
	ENDIF
ENDIF


[FUNCTION CHECKANIMALLORE]
IF ((<SKILLLOCK[2]> == 0) && (<SKILLTOTAL> < <SKILLCLASS.SKILLSUM>))
	IF (<ANIMALLORE> < 30.0)
		IF (RAND(2) == 1)
			ANIMALLORE (<ANIMALLORE> + 1)
		ENDIF
	ELSEIF (<ANIMALLORE> < 50.0)
		IF (RAND(6) == 1)
			ANIMALLORE (<ANIMALLORE> + 1)
		ENDIF
	ELSEIF (<ANIMALLORE> < 75.0)
		IF (RAND(8) == 1)
			ANIMALLORE (<ANIMALLORE> + 1)
		ENDIF
	ELSEIF (<ANIMALLORE> < 100.0)
		IF (RAND(12) == 1)
			ANIMALLORE (<ANIMALLORE> + 1)
		ENDIF
	ENDIF
ENDIF



[EOF]
