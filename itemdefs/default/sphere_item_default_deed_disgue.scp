[FUNCTION FUNC_KARMA_FAME_LEVELCHECK]
FUNC_FameLevelCheck
FUNC_KarmaLevelCheck

[FUNCTION FUNC_FAMELEVELCHECK]
IF (<FAME> >= 9900)
	TAG.FAME.LEVEL = 4
ELIF (<FAME> >= 5000) && (<FAME> <= 9899)
	TAG.FAME.LEVEL = 3
ELIF (<FAME> >= 1000) && (<FAME> <= 4999)
	TAG.FAME.LEVEL = 2
ELIF (<FAME> >= 499) && (<FAME> <= 999)
	TAG.FAME.LEVEL = 1
ELIF (<FAME> <= 499)
	TAG.FAME.LEVEL = 0
ENDIF




[FUNCTION FUNC_KARMALEVELCHECK]
IF (<KARMA> >= 9900)
	TAG.KARMA.LEVEL = 5
ELIF (<KARMA> >= 5000) && (<KARMA> <= 9899)
	TAG.KARMA.LEVEL = 4
ELIF (<KARMA> >= 1000) && (<KARMA> <= 4999)
	TAG.KARMA.LEVEL = 3
ELIF (<KARMA> >= 500) && (<KARMA> <= 999)
	TAG.KARMA.LEVEL = 2
ELIF (<KARMA> >= 100) && (<KARMA> <= 499)
	TAG.KARMA.LEVEL = 1
ELIF (<KARMA> >= -100) && (<KARMA> <= 99)
	TAG.KARMA.LEVEL = 0
ELIF (<KARMA> <= -500) && (<KARMA> >= -99)
	TAG.KARMA.LEVEL = -1
ELIF (<KARMA> <= -1000) && (<KARMA> >= -499)
	TAG.KARMA.LEVEL = -2
ELIF (<KARMA> <= -5000) && (<KARMA> >= -999)
	TAG.KARMA.LEVEL = -3
ELIF (<KARMA> <= -9899) && (<KARMA> >= -4999)
	TAG.KARMA.LEVEL = -4
ELIF (<KARMA> <= -9900)
	TAG.KARMA.LEVEL = -5
ENDIF




[Function FUNC_ISSHOW_KARMA_FAME_TITLE_CUSTOM]
