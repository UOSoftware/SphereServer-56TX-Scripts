DEFNAME=i_serpents_jawbone
NAME=Serpent's Jawbone
FLIP=1
CATEGORY=Artifacts
SUBSECTION=Enchanted Origin
DESCRIPTION=Serpent's Jawbone
DUPELIST=09f75

ON=@DClick
SDIALOG d_serpents_jawbone
return 1

[ITEMDEF 09f75]
//serpent's jawbone
DUPEITEM=09f74

[DIALOG d_serpents_jawbone]
75,75
resizepic 0 0 9270 400 500
xmfhtmlgumpcolor 130 15 400 16 1156704 0 0 65535	//Select your destination:
FOR 1 17
 xmfhtmlgumpcolor 60 <eval 45+((<LOCAL._FOR>-1)*25)> 250 16 <STRARG <DEF0.SerpentsJawbone.Loc<dLOCAL._FOR>>> 0 0 65535
 button 20 <eval 50+((<LOCAL._FOR>-1)*25)> 2117 2118 1 0 <LOCAL._FOR>
ENDFOR

[DIALOG d_serpents_jawbone BUTTON]
ON=1 17
IF !(<ATTR> & attr_move_never|attr_lockeddown|attr_secure)
SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, This must be locked down or secured in order to use it.
return 1
ELIF (<DISTANCE> > 1)
SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, You are too far away to use the gate.
return 1
ELIF (<SRC.ACTION> != -1)
SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, You are too busy to do that at the moment.
return 1
ENDIF
SRC.GO <STREAT <DEF0.SerpentsJawbone.Loc<ARGN>>>

