[ITEMDEF 09f64]
DEFNAME=i_jack_in_the_box_east
NAME=Jack in the Box
CATEGORY=Artifacts
SUBSECTION=Enchanted Origin
DESCRIPTION=Jack in the Box (east)
DUPELIST=09f65,09f66,09f67,09f68,09f69,09f6a,09f6b

ON=@DClick
IF (<TYPE> != t_anim_active)
TAG.Animate=1
TAG.Attr=<ATTR>
ATTR |= attr_move_never
MORE1=<DISPID>
MORE2=<TYPE>
TYPE=t_anim_active
SOUND 067d
TIMER=13
return 1
ENDIF

ON=@Timer
IF (<TAG0.Animate>)
TAG.Animate=
DISPID=09f65
TIMER=4
UPDATE
return 1
ELIF (<TAG0.Attr>)
ATTR=<TAG.Attr>
TAG.Attr=
ENDIF

