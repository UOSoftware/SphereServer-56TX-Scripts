[ITEMDEF 01bc3]
DEFNAME=i_shield_chaos
TYPE=t_shield
ARMOR=32
VALUE=1
FLIP=1
WEIGHT=1.0
CATEGORY=Provisions - Armor
SUBSECTION=Shields
DESCRIPTION=Chaos Shield
ReqStr=60
TEVENTS=t_equipitem
TAG0.GuildAlign=0

ON=@Create
ATTR=ATTR_MAGIC|ATTR_NEWBIE
HITPOINTS={128 154}

ON=@EQUIP
IF (<SRC.ISPLAYER>)
	IF (<SRC.ISGM>)
		RETURN 0
	ELSEIF !(<SRC.GUILD>)
		fUnequip
		RETURN 1
	ELSEIF !(<SRC.GUILD.ALIGN> == 2)
		fUnequip
		RETURN 1
	ENDIF
ENDIF



