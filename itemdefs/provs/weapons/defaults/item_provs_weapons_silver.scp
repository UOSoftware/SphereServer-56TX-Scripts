


[ITEMDEF I_SILVER_KRYSS]
DEFNAME=I_SILVER_KRYSS
NAME=silver kryss
ID=I_KRYSS
TYPE=t_weapon_fence
DAM=3,28
SKILL=FENCING
REQSTR=10
TWOHANDS=N
WEIGHT=6.0
RESOURCES=8 I_INGOT_SILVER
SKILLMAKE=BLACKSMITHING 80.0
RESDISPDNHUE=color_o_silver
TEVENTS=t_equipitem

ON=@CREATE
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
HITPOINTS {61 110}

ON=@DAMAGE
IF (<SRC.NPC> == BRAIN_UNDEAD)
	SRC.DAMAGE {18 50} 
	SRC.EFFECT 3,I_FX_SPARKLE,6,15,1
	SRC.SPELLEFFECT S_POISON 50.0
ENDIF



