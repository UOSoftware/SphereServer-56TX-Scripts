
[ITEMDEF i_bow_Elven] // elven bow
DEFNAME=i_bow_Elven
NAME=elven bow
ID=i_bow
DAM=15,25
SKILL=Archery
REQSTR=30
TWOHANDS=Y
WEIGHT=5
RESOURCES=20 i_log
SKILLMAKE=99.5 BOWCRAFT, 60.0 MAGERY
CATEGORY=Provisions - Weapons
SUBSECTION=Bows - Exceptional
DESCRIPTION=Elven Bow
RESDISPDNHUE=237
TEVENTS=t_equipitem

ON=@Create
HITPOINTS={100 200}
COLOR=237

ON=@EQUIP
IF (<SRC.ARCHERY> < 90.0)
	SRC.SYSMESSAGELOC 0,3300523
	// fUnequip
	UNEQUIP
	RETURN 1
ENDIF
	
ON=@DCLICK
IF (<SRC.ARCHERY> < 90.0)
	SRC.SYSMESSAGELOC 0,3300523
	// fUnequip
	UNEQUIP
	RETURN 1
ENDIF


