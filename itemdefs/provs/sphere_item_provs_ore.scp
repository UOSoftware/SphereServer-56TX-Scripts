// Ores //
//////////

[ITEMDEF 019b7]
DEFNAME=i_ore_iron
NAME=iron ore%s
TYPE=t_ore
SKILLMAKE=Mining 20.0
TDATA1=i_ingot_iron
WEIGHT=3.0
// VALUE=4 // SPHERE ZATEN KENDI AYARLIYOR
DUPELIST=019b8,019b9,019ba
CATEGORY=Items by Professions
SUBSECTION=Blacksmiths
DESCRIPTION=Ore (Small Pile)
RESDISPDNHUE=0

ON=@Create
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>

