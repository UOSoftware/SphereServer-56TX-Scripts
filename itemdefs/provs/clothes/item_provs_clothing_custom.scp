

[ITEMDEF i_first_player_robe]
DEFNAME=i_first_player_robe
ID=i_robe
RESOURCES=0
WEIGHT=0
TYPE=T_CLOTHING
DYE=0
ARMOR=10
TEVENTS=t_equipitem

ON=@Create
HITPOINTS=65000
ATTR=ATTR_NEWBIE
COLOR=07fff
LINK=<SRC>

on=@click
messageloc 1153,3301114
IF (<CONT>)
	message @1153,,1,1 <TOPOBJ.NAME>
ENDIF
RETURN 1

ON=@DAMAGE
HITPOINTS=65000
RETURN 1


