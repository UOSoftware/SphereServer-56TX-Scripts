




// +3
[ITEMDEF I_ROBE_MAGE_defense]
DEFNAME=I_ROBE_MAGE_defense
DEFNAME2=i_tc_mr3
ID=I_DEATHSHROUD_CRAFT
NAME=Mage Robe of Defense
ARMOR=15
VALUE=0
WEIGHT=5.0
DYE=0
CATEGORY=Provisions - Cloth - Magic
SUBSECTION=Deathshrouds
DESCRIPTION=Mage Robe of Defense
RESDISPDNHUE=color_magic_defense
TEVENTS=t_equipitem
SKILL=EVALUATINGINTEL

ON=@Create
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
ATTR=ATTR_MAGIC
MOREY=morey_magic_armor_defense
HITPOINTS={100 250}

ON=@Equip
IF !(<SRC.ISGM>)	
	IF ((<SRC.MAGERY> < 800) || (<SRC.EVALUATINGINTEL> < 800))
			SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu eşyayı kullanabilecek yeteneğe sahip değilsiniz. (80.0 Magery - Evaluating Int)
			fUnequip
		RETURN 1
	ENDIF
ENDIF


