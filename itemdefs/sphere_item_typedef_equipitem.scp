ENDIF

ON=@UNEQUIP
IF (<SRC.ISEVENT.e_bonus_shoot_stam>)
	SRC.EVENTS -e_bonus_shoot_stam
ENDIF


[TYPEDEF t_weapon_mace_staff]

ON=@EQUIP
IF !((<BASEID> = i_staff_taming || <baseid> == i_staff_gnarled))
	IF !(<SRC.ISEVENT.e_bonus_shoot_stam>)
		SRC.EVENTS +e_bonus_shoot_stam
	ENDIF
ENDIF

ON=@UNEQUIP
IF (<SRC.ISEVENT.e_bonus_shoot_stam>)
	SRC.EVENTS -e_bonus_shoot_stam
ENDIF



