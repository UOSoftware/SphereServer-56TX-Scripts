
[COMMENT]



[TYPEDEF t_equipitem]
ON=@CLICK
IF (<SRC.ISGM>)
	IF (<ISWEAPON>)
		MESSAGE [dam: <DAM> speed: <SPEED>/<eval (2000/<weight>)>, wght: <FVAL <WEIGHT>>]
	ELSEIF (<ISARMOR>)
		MESSAGE [ar: <ar>, real ar: <fRealAr>]
	ENDIF
ENDIF

IF (<ATTR>&ATTR_MAGIC && <MOREY>)
	MESSAGE a magical <SERV.ITEMDEF.<DISPID>.NAME>
	IF (<ATTR>&attr_identified)
		MESSAGE [<ColoredItemTitle>]
	ENDIF
	RETURN 1
ENDIF





[COMMENT TYPEDEF t_fish_pole]
on=@targon_char
if (<src> == <src.targ.uid>)
    // SRC.ACTARG1 = 0    
    SRC.ACTARG2 = 1    
    SRC.ACTARG3 = 2    
    SRC.ACT = 0
	SRC.ACTPRV = <UID>
    SRC.ACTP = <eval <SRC.P.X> + 1>,<eval <SRC.P.Y>+ 1>,<SRC.P.Z>,<SRC.P.M>
    SRC.ACTION = 18	
	RETURN 1
endif


on=@targon_İTEM
if (<uid> == <src.targ.uid>)
    // SRC.ACTARG1 = 0    
    SRC.ACTARG2 = 1    
    SRC.ACTARG3 = 2    
    SRC.ACT = 0
	SRC.ACTPRV = <UID>
    SRC.ACTP = <eval <SRC.P.X> + 1>,<eval <SRC.P.Y>+ 1>,<SRC.P.Z>,<SRC.P.M>
    SRC.ACTION = 18	
	RETURN 1
endif




[TYPEDEF t_shield]
ON=@EQUIPTEST
IF (<SRC.ISPLAYER>)
	IF (<BASEID> == I_SHIELD_ORDER)
		LOCAL.SPELLREMOVE=0
	ELSEIF (<BASEID> == I_SHIELD_CHAOS)
		LOCAL.SPELLREMOVE=0
	ELSE
		LOCAL.SPELLREMOVE=1
	ENDIF
	IF (<LOCAL.SPELLREMOVE>)
		IF (<SRC.FINDID.I_RUNE_PROTECTION>)
			SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Protection etkisi silindi.
			SRC.FINDID.I_RUNE_PROTECTION.REMOVE
		ENDIF
		IF (<SRC.FINDID.I_RUNE_REACTIVE_ARMOR>)
			SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Reactive Armor etkisi silindi.
			SRC.FINDID.I_RUNE_REACTIVE_ARMOR.REMOVE
		ENDIF
	ENDIF
ENDIF



