[TYPEDEF t_armor_leather]



[TYPEDEF t_clothing]











[TYPEDEF t_robe_gm]

ON=@DCLICK
IF (<SRC.ISINVIS>)
	SRC.INVIS=0
ELSE
	SRC.INVIS=1
ENDIF




[TYPEDEF t_spellbook]

ON=@CLICK
IF (<SPELLCOUNT> <= 0)
	MESSAGE a spellbook
ELSE
	MESSAGE a spellbook [<spellcount>]
ENDIF
RETURN 1




[TYPEDEF t_spellbook_necro]

ON=@CLICK
IF (<SPELLCOUNT> <= 0)
	MESSAGE a necromancer book
ELSE
	MESSAGE a necromancer book [<spellcount>]
ENDIF
RETURN 1





[TYPEDEF t_hair]

ON=@TIMER
RETURN 1
	


[TYPEDEF t_beard]

ON=@TIMER
RETURN 1




[TYPEDEF t_weapon_bow]

ON=@CLICK
IF (<TOPOBJ> == <SRC>)
	MESSAGE [Arrows: <EVAL <TOPOBJ.RESCOUNT <TDATA3>>>]
ENDIF



[TYPEDEF t_weapon_xbow]

ON=@CLICK
IF (<TOPOBJ> == <SRC>)
	MESSAGE [Bolts: <EVAL <TOPOBJ.RESCOUNT <TDATA3>>>]
ENDIF



[TYPEDEF t_weapon_mace_crook]

ON=@CLICK
REF1=<TAG0.NPC>
IF (<REF1.isvalid>) && (<REF1.ISCHAR>)
	MESSAGE (<REF1.NAME>)
ENDIF

IF (<TAG0.TARGP>)
MESSAGE (<TAG0.TARGP>)
ENDIF

ON=@TARGON_ITEM
RETURN 1

ON=@TARGON_CHAR
IF !(<SRC.TARG.NPC> == brain_animal)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Sadece hayvanları sürebilirsiniz.
	RETURN 1
ELSEIF (<SRC.ISDISS 5,<SRC.TARG.UID>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600018,<SRC.TARG.NAME>
	RETURN 1
ELSEIF (<SRC.TARG.OWNER>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Sahipli hayvanları süremezsiniz.
	RETURN 1
ENDIF
TAG0.NPC=<SRC.TARG.UID>



[TYPEDEF t_weapon_mace_smith]

ON=@EQUIP
IF !(<SRC.ISEVENT.e_bonus_shoot_stam>)
	SRC.EVENTS +e_bonus_shoot_stam
ENDIF

ON=@UNEQUIP
IF (<SRC.ISEVENT.e_bonus_shoot_stam>)
	SRC.EVENTS -e_bonus_shoot_stam
ENDIF


[TYPEDEF t_weapon_mace_sharp]

ON=@EQUIP
IF !(<SRC.ISEVENT.e_bonus_shoot_stam>)
