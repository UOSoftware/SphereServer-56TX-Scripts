IF (<SRC.MANA> < 40)
	SRC.SOUND=92
	SRC.SYSMESSAGELOC 0,3300440
	RETURN 1
ENDIF
IF !(<SRC.RESTEST 1 i_reag_mandrake_root>) || !(<SRC.RESTEST 1 i_reag_sulfur_ash>) || !(<SRC.RESTEST 1 i_reag_black_pearl>)
	SRC.SYSMESSAGELOC 0,3300441
	SRC.SOUND=92
	RETURN 1
ENDIF


IF (<LDB.CONNECTED>)	
	LDB.Query "SELECT id, rune_uid FROM 'runebooks' WHERE id='<eval <DARGN>-100000>'"
	IF (<LDB.ROW.NUMROWS>)
		REF1=<LDB.ROW.0.rune_uid>
		IF (<TAG0.LINK>)
			EMPTY
			SERV.NEWITEM I_RUNE_MARKER
			NEW.CONT <UID>
			NEW.MOREP <REF1.MOREP>
			NEW.MORE2=1
			REF1=<NEW>
		ENDIF
		IF (<REF1>) && (<REF1.TYPE> == T_RUNE)
			SRC.ACTDIFF=<ddef.SKILL_ACTION_DIFF_NOFAIL>
			SRC.EVENTS +e_runebook_casts
			REF1.MORE1 65000
			SRC.ACTARG1 = 52      
			SRC.ACT = <REF1>
			SRC.ACTPRV = <SRC>
			SRC.ACTP = <REF1.MOREX>,<REF1.MOREY>,<REF1.MOREZ>,<REF1.MOREM>
			SRC.ACTION = 25	
			SRC.ACTDIFF=<ddef.SKILL_ACTION_DIFF_NOFAIL>
			
			SRC.MANA -=40
			SRC.CONSUME 1 i_reag_black_pearl
			SRC.CONSUME 1 i_reag_mandrake_root
			SRC.CONSUME 1 i_reag_sulfur_ash

		ELSE
			SRC.SYSMESSAGELOC <def.tcolor_red>,3300437
		ENDIF
