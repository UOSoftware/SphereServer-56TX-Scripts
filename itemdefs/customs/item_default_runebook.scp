
[ITEMDEF i_runebook_addon_extrapage]
DEFNAME=i_runebook_addon_extrapage
NAME=runebook addon (extra page)
WEIGHT=0.1
ID=i_scroll_blank
TYPE=T_SCRIPT
RESOURCES=16 i_scroll_blank
SKILLMAKE=INSCRIPTION 60.0, MAGERY 60.0
CATEGORY=Custom Items
SUBSECTION=Runebook
DESCRIPTION=Runebook AddOn
RESDISPDNHUE=045e

ON=@Create
COLOR=<serv.itemdef.<baseid>.RESDISPDNHUE>
ATTR=0

ON=@DClick
TARGET 
SRC.SYSMESSAGELOC 0,3300392
RETURN 1

ON=@TARGON_ITEM
IF (<SRC.TARG.BASEID> == i_runebook)
	IF (<SRC.TARG.CONT>) && (<SRC.TARG.TOPOBJ.UID> != <SRC.UID>) && (<SRC.ACCOUNT.PLEVEL> < 6)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300393
		RETURN 1
	ENDIF
	SRC.TARG.TAG0.RUNEBOOK_PAGE +=1
	SRC.SYSMESSAGELOC 0,3300394,<SRC.TARG.dTAG0.RUNEBOOK_PAGE>
	CONSUME 1
	SRC.DCLICK <SRC.TARG.UID>
ELSE
	SRC.SYSMESSAGELOC 0,3300395
ENDIF
RETURN 1

[ITEMDEF i_runebook]
DEFNAME=i_runebook
ID=i_spellbook
TYPE=T_CONTAINER
WEIGHT=0.1
TDATA2=03D
NAME=runebook
RESOURCES=16 i_scroll_blank, 4 i_scroll_recall
SKILLMAKE=INSCRIPTION 70.0, MAGERY 60.0
CATEGORY=Custom Items
SUBSECTION=Runebook
DESCRIPTION=Runebook
RESDISPDNHUE=045e

ON=@Create
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
ATTR=ATTR_NEWBIE|ATTR_MAGIC
TAG0.RUNEBOOK_PAGE=1

ON=@CLICK
ATTR=ATTR_NEWBIE|ATTR_MAGIC
REF99=<TAG0.LINK>
IF (<REF99>) && (<REF99.ISITEM>)
	REF1=<REF99>
ELSE
	REF1=<UID>
ENDIF
MESSAGELOC 1,3301088,<REF1.RESCOUNT>,<REF1.MOREX>
IF !(STRMATCH('0','<REF1.TAG0.NAME>'))
	LOCAL.NAME <REF1.NAME> (<REF1.TAG0.NAME>)
ELSE
	LOCAL.NAME <REF1.NAME>
ENDIF
IF (<TAG0.COPY>)
	LOCAL.NAME .= [Kopya]
ELSEIF (<TAG0.LINK>)
	LOCAL.NAME .= [Link]
ENDIF
MESSAGE @,,1,1 <LOCAL.NAME>
RETURN 1


ON=@DClick
ATTR=ATTR_NEWBIE|ATTR_MAGIC
IF (<CONT>) && (<TOPOBJ.UID> != <SRC.UID>) && (<SRC.ACCOUNT.PLEVEL> < 6)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300393
	RETURN 1
ELSEIF (<SRC.ISUSESKILL Magery>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300396
	RETURN 1
ELSEIF (<SRC.ISUSESKILL Necromancy>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300396
	RETURN 1
ENDIF

IF (<SRC.SetProcessDelay Runebook,<R3,5>>)
    RETURN 1
ENDIF
REF99=<TAG0.LINK>
IF (<REF99.ISVALID>)
	REF1=<REF99>
ELSE
	REF1=<UID>
ENDIF
SRC.CTAG0.RUNEBOOK_LAST=<REF1>
SRC.CTAG0.RUNEBOOK_FROM=<REF1>
SRC.CTAG0.Dialog.Runebook_Where="id"
SRC.CTAG0.Dialog.Runebook_Order="created_at ASC"
SRC.SOUND=85
IF (<LDB.CONNECTED>)
	LDB.EXECUTE CREATE TABLE IF NOT EXISTS 'runebooks' (id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL, runebook_uid TEXT, runebook_duid INT, rune_uid TEXT, rune_duid INT, rune_name TEXT, rune_morep TEXT, rune_morex INT, rune_morey INT, rune_morez INT, rune_morem INT, region_name TEXT, region_text TEXT, page INT, ordering INT , created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP)
ENDIF
DIALOGCLOSE D_RUNEBOOK
DIALOG D_RUNEBOOK
RETURN <QVAL (<SRC.ISGM>)?0:1>

ON=@DROPON_GROUND
IF (<SRC.ISUSESKILL Magery>)
	SRC.SKILL FAIL
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300397
ENDIF

ON=@DESTROY
IF !(<TAG0.LINK>)
	IF (<LDB.CONNECTED>)	
		LDB.EXECUTE "DELETE FROM 'runebooks' WHERE runebook_uid='<UID>'"
	ENDIF
ENDIF

ON=@TARGON_CHAR
SRC.SYSMESSAGELOC 38,600020 //"Hatalı seçim/hedef."
RETURN 1

ON=@DROPON_SELF
IF !(<SRC.ISINPACK <UID>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600036,<NAME>
	RETURN 1
ENDIF
IF ((<ARGO.BASEID> == I_RUNE_MARKER) || (<ARGO.TYPE> == T_RUNE))
	Func_Runebook_Add_Rune <ARGO.UID>
ELSE
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300398
ENDIF
RETURN 1


ON=@TARGON_ITEM
// ADD RUNE
IF (<MORE2> == 1)
	IF !(<SRC.TARG.TYPE> == T_RUNE)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300399
		MORE2=1
		TARGET
		RETURN 1
		
	ELSEIF (<SRC.TARG.MOREX>==0)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300400
		MORE2=1
		TARGET
		RETURN 1
	ENDIF
	
	Func_Runebook_Add_Rune <SRC.TARG.UID>
	
// Cogalt
ELSEIF (<MORE2> == 2)


	IF !(<SRC.TARG.ISRUNEBOOK>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300395
		MORE2=2
		TARGET
		RETURN 1
		
	ELSEIF !(<ISBLANK <TAG0.COPY>>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300401
		MORE2=2
		TARGET
		RETURN 1
		
	ELSEIF !(<ISBLANK <TAG0.LINK>>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300402
		MORE2=2
		TARGET
		RETURN 1
		
	ELSEIF !(<ISBLANK <SRC.TARG.TAG0.COPY>>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300403
		MORE2=2
		TARGET
		RETURN 1
		
	ELSEIF !(<ISBLANK <SRC.TARG.TAG0.LINK>>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300404
		MORE2=2
		TARGET
		RETURN 1
		
	ELSEIF (<SRC.TARG.RESCOUNT>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300405
		MORE2=2
		TARGET
		RETURN 1
	ENDIF
	
	SERV.NEWDUPE <UID>
	NEW.TAG0.COPY=<UID>
	SRC.TARG.REMOVE
	
	MORE2=

// Linkle
ELSEIF (<MORE2> == 3)

	IF !(<SRC.TARG.ISRUNEBOOK>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300395
		MORE2=3
		TARGET
		RETURN 1
		
	ELSEIF !(<ISBLANK <TAG0.COPY>>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300401
		MORE2=3
		TARGET
		RETURN 1
		
	ELSEIF !(<ISBLANK <TAG0.LINK>>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300402
		MORE2=3
		TARGET
		RETURN 1
		
	ELSEIF !(<ISBLANK <SRC.TARG.TAG0.COPY>>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300403
		MORE2=3
		TARGET
		RETURN 1
		
	ELSEIF !(<ISBLANK <SRC.TARG.TAG0.LINK>>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300404
		MORE2=3
		TARGET
		RETURN 1
		
	ELSEIF (<SRC.TARG.RESCOUNT>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300405
		MORE2=3
		TARGET
		RETURN 1
	ENDIF
	
	SRC.TARG.TAG0.LINK=<UID>
	MORE2=
	SRC.SYSMESSAGELOC <def.tcolor_text>,3300406
	
// Disa aktar
ELSEIF (<MORE2> == 4)

	IF !(<SRC.TARG.TYPE> == T_CONTAINER)
		SRC.SYSMESSAGELOC <def.tcolor_text>,3300407
		MORE2=4
		TARGET
		RETURN 1
	ELSEIF (<SRC.TARG.RESCOUNT>)
		SRC.SYSMESSAGELOC <def.tcolor_text>,3300408
		MORE2=4
		TARGET
		RETURN 1
	ENDIF

		
// Ice aktar
ELSEIF (<MORE2> == 5)

	IF !(<SRC.TARG.TYPE> == T_CONTAINER)
		SRC.SYSMESSAGELOC <def.tcolor_text>,3300407
		MORE2=5
		TARGET
		RETURN 1

	ELSEIF !(<SRC.TARG.RESCOUNT>)
		SRC.SYSMESSAGELOC <def.tcolor_text>,3300409
		MORE2=5
		TARGET
		RETURN 1
	ENDIF
	
	SRC.TARG.FUNC_RUNEBOOK_Rune_Import_Bulk <UID>

	

ENDIF
RETURN 1

ON=@TIMER
RETURN 1





[FUNCTION FUNC_RUNEBOOK_Rune_Import_Bulk]
REF1=<ARGS>   // RUNEBOOK
// UID = Container
FORCONTID i_rune_marker
	IF (<MOREX> > 0)
		// serv.b <name>
	ENDIF
ENDFOR




[FUNCTION FUNC_RUNEBOOK_ADD_RUNE]
REF1=<ARGS>   // Rune
// UID = RUNEBOOK

IF !(<REF1>) || !(<UID>)
	SRC.SYSMESSAGELOC 38,600021 //"Bir hata oluştu!"
	RETURN 1
ELSEIF !(<REF1.ISITEM>) || !(<ISITEM>)
	SRC.SYSMESSAGELOC 38,600021 //"Bir hata oluştu!"
	RETURN 1
ELSEIF !(<REF1.TYPE> == T_RUNE)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300399
	RETURN 1
ELSEIF !(<ISRUNEBOOK>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300410
	RETURN 1
ELSEIF (<TAG0.LINK>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300411
	RETURN 1
ELSEIF (<REF1.MOREX> <= 0)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300400
	RETURN 1
ELSEIF !(<SRC.ISINPACK <REF1>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600036,<REF1.NAME>
	RETURN 1
ENDIF
IF !(<TAG0.RUNEBOOK_LASTPAGE>)
	TAG0.RUNEBOOK_LASTPAGE=1
ENDIF


IF (<LDB.CONNECTED>)	
	LDB.Query "SELECT id FROM 'runebooks' WHERE runebook_uid='<UID>'"
	
	local.maxrune = <eval <dTAG0.RUNEBOOK_PAGE> * 16>
	IF (<dlDB.ROW.NUMROWS> >= <dlocal.maxrune>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300412,<dlocal.maxrune>,<dlDB.ROW.NUMROWS>,<dTAG0.RUNEBOOK_PAGE>
		RETURN 1
	ENDIF
	
	LDB.Query "SELECT id FROM 'runebooks' WHERE runebook_uid='<UID>' AND rune_uid='<REF1>'"
	IF (<lDB.ROW.NUMROWS>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300413
		RETURN 1
	ENDIF
	
	// lDB.Query "SELECT id FROM 'runebooks' WHERE runebook_uid='<UID>' AND rune_uid IS NULL"
	// IF (<LDB.ROW.NUMROWS>)
		// LDB.EXECUTE "UPDATE 'runebooks' SET rune_uid="<REF1>", rune_duid='<DREF1>', rune_name="<StrReplaceSql <REF1.NAME>>", rune_morep="<REF1.MOREP>", rune_morex="<REF1.MOREX>", rune_morey="<REF1.MOREY>", rune_morez="<REF1.MOREZ>", rune_morem="<REF1.MOREM>", region_name="<StrReplaceSql <SERV.MAP(<REF1.MOREX>,<REF1.MOREY>,<REF1.MOREZ>,<REF1.MOREM>).REGION.NAME>>", region_text="<StrReplaceSql <SERV.MAP(<REF1.MOREX>,<REF1.MOREY>,<REF1.MOREZ>,<REF1.MOREM>).REGION.NAME>>", page="<dTAG0.RUNEBOOK_LASTPAGE>", ordering="0" WHERE id='<LDB.ROW.0.id>'"
	// ELSE
		// LDB.EXECUTE "INSERT INTO 'runebooks' ('runebook_uid', 'runebook_duid', 'rune_uid', 'rune_duid', 'rune_name', 'rune_morep', 'rune_morex', 'rune_morey', 'rune_morez', 'rune_morem', 'region_name', 'region_text', 'page', 'ordering') VALUES ('<UID>','<DUID>','<REF1>','<DREF1>','<StrReplaceSql <REF1.NAME>>','<REF1.MOREP>','<REF1.MOREX>','<REF1.MOREY>','<REF1.MOREZ>','<REF1.MOREM>','<StrReplaceSql <SERV.MAP(<REF1.MOREX>,<REF1.MOREY>,<REF1.MOREZ>,<REF1.MOREM>).REGION.NAME>>','<StrReplaceSql <SERV.MAP(<REF1.MOREX>,<REF1.MOREY>,<REF1.MOREZ>,<REF1.MOREM>).REGION.NAME>>','<DTAG0.RUNEBOOK_LASTPAGE>','0')"
	// ENDIF

	LDB.Query "SELECT id FROM 'runebooks' WHERE runebook_uid='<UID>' AND rune_uid IS NULL"
    
    IF (<LDB.ROW.NUMROWS>)
        // Mevcut boş slota (NULL rune_uid olan) ekleme yaparken o sayfanın sonuna ordering ver
        LDB.EXECUTE "UPDATE 'runebooks' SET rune_uid='<REF1>', rune_duid='<DREF1>', rune_name='<StrReplaceSql <REF1.NAME>>', rune_morep='<REF1.MOREP>', rune_morex='<REF1.MOREX>', rune_morey='<REF1.MOREY>', rune_morez='<REF1.MOREZ>', rune_morem='<REF1.MOREM>', region_name='<StrReplaceSql <SERV.MAP(<REF1.MOREX>,<REF1.MOREY>,<REF1.MOREZ>,<REF1.MOREM>).REGION.NAME>>', region_text='<StrReplaceSql <SERV.MAP(<REF1.MOREX>,<REF1.MOREY>,<REF1.MOREZ>,<REF1.MOREM>).REGION.NAME>>', page='<dTAG0.RUNEBOOK_LASTPAGE>', ordering=(SELECT IFNULL(MAX(ordering), 0) + 1 FROM 'runebooks' WHERE runebook_uid='<UID>' AND page='<DTAG0.RUNEBOOK_LASTPAGE>') WHERE id='<LDB.ROW.0.id>'"
    ELSE
        // Yeni kayıt oluştururken o sayfanın sonuna ordering ver
        LDB.EXECUTE "INSERT INTO 'runebooks' ('runebook_uid', 'runebook_duid', 'rune_uid', 'rune_duid', 'rune_name', 'rune_morep', 'rune_morex', 'rune_morey', 'rune_morez', 'rune_morem', 'region_name', 'region_text', 'page', 'ordering') VALUES ('<UID>','<DUID>','<REF1>','<DREF1>','<StrReplaceSql <REF1.NAME>>','<REF1.MOREP>','<REF1.MOREX>','<REF1.MOREY>','<REF1.MOREZ>','<REF1.MOREM>','<StrReplaceSql <SERV.MAP(<REF1.MOREX>,<REF1.MOREY>,<REF1.MOREZ>,<REF1.MOREM>).REGION.NAME>>','<StrReplaceSql <SERV.MAP(<REF1.MOREX>,<REF1.MOREY>,<REF1.MOREZ>,<REF1.MOREM>).REGION.NAME>>','<DTAG0.RUNEBOOK_LASTPAGE>', (SELECT IFNULL(MAX(ordering), 0) + 1 FROM 'runebooks' WHERE runebook_uid='<UID>' AND page='<DTAG0.RUNEBOOK_LASTPAGE>'))"
    ENDIF
	
ENDIF

SRC.SYSMESSAGELOC <def.tcolor_text>,3300414
SRC.SOUND=79
IF (<REF1.ISITEM>) && (<REF1.TYPE> == T_RUNE)
	REF1.CONT = <UID>
	REF1.EVENTS +ei_runebook_rune
	REF1.UPDATE
	REF1.UPDATEX
	SRC.DCLICK <UID>
ENDIF
MORE2=

RETURN 0


[TYPEDEF ei_runebook_rune]
ON=@CLICK
MESSAGELOC 0,3301089

ON=@PICKUP_PACK
IF (<CONT> && <CONT.BASEID> == I_RUNEBOOK)
	IF (<LDB.CONNECTED>)	
		LDB.Query "SELECT id FROM 'runebooks' WHERE runebook_uid='<cont>' AND rune_uid='<UID>'"
		IF (<lDB.ROW.NUMROWS>)
			LDB.EXECUTE "DELETE FROM 'runebooks' WHERE runebook_uid='<cont>' AND rune_uid='<UID>'"
		ENDIF
	ENDIF
ENDIF


ON=@DESTROY
IF (<CONT> && <CONT.BASEID> == I_RUNEBOOK)
	IF (<LDB.CONNECTED>)	
		LDB.Query "SELECT id FROM 'runebooks' WHERE runebook_uid='<cont>' AND rune_uid='<UID>'"
		IF (<lDB.ROW.NUMROWS>)
			LDB.EXECUTE "DELETE FROM 'runebooks' WHERE runebook_uid='<cont>' AND rune_uid='<UID>'"
		ENDIF
	ENDIF
ENDIF






[DIALOG D_RUNEBOOK]
0,0
REF99=<SRC.CTAG0.RUNEBOOK_FROM> // FROM RUNEBOOK

LOCAL.MAIN_X <R300,500>
LOCAL.MAIN_Y <R200,300>
SRC.CTAG0.RUNEBOOK_DEFAULT_DIALOG_MAIN_X=<LOCAL.MAIN_X>
SRC.CTAG0.RUNEBOOK_DEFAULT_DIALOG_MAIN_Y=<LOCAL.MAIN_Y>

PAGE 0
DORIGIN <DLOCAL.MAIN_X> <DLOCAL.MAIN_Y>
GUMPPIC +0 +0 02b2f 0


PAGE 1
GUMPPIC +55 +30 57 0
GUMPPICTILED +65 +30 100 15 58
GUMPPIC +160 +30 59 0

GUMPPIC +210 +30 57 0
GUMPPICTILED +235 +30 100 15 58
GUMPPIC +320 +30 59 0

IF (<TAG0.RUNEBOOK_PAGE> >= 1)
	IF (<TAG0.RUNEBOOK_LASTPAGE> != 1)
		BUTTON +70 +175 08B1 08B1 1 0 10
	ENDIF
ELSE
	// GUMPPIC +70 +175 08B1 38
ENDIF

IF (<TAG0.RUNEBOOK_PAGE> >= 2)
	IF (<TAG0.RUNEBOOK_LASTPAGE> != 2)
		BUTTON +100 +175 08B2 08B2 1 0 11
	ENDIF
ELSE
	// GUMPPIC +100 +175 08B2 38
ENDIF

IF (<TAG0.RUNEBOOK_PAGE> >= 3)
	IF (<TAG0.RUNEBOOK_LASTPAGE> != 3)
		BUTTON +135 +175 08B3 08B3 1 0 12
	ENDIF
ELSE
	// GUMPPIC +135 +175 08B3 38
ENDIF

IF (<TAG0.RUNEBOOK_PAGE> >= 4)
	IF (<TAG0.RUNEBOOK_LASTPAGE> != 4)
		BUTTON +165 +175 08B4 08B4 1 0 13
	ENDIF
ELSE
	// GUMPPIC +165 +175 08B4 38
ENDIF
	
	
IF (<TAG0.RUNEBOOK_PAGE> >= 5)
	IF (<TAG0.RUNEBOOK_LASTPAGE> != 5)
		BUTTON +220 +175 08B5 08B5 1 0 14
	ENDIF
ELSE
	// GUMPPIC +220 +175 08B5 38
ENDIF


IF (<TAG0.RUNEBOOK_PAGE> >= 6)
	IF (<TAG0.RUNEBOOK_LASTPAGE> != 6)
		BUTTON +255 +175 08B6 08B6 1 0 15
	ENDIF
ELSE
	// GUMPPIC +255 +175 08B6 38
ENDIF


IF (<TAG0.RUNEBOOK_PAGE> >= 7)
	IF (<TAG0.RUNEBOOK_LASTPAGE> != 7)
		BUTTON +290 +175 08B7 08B7 1 0 16
	ENDIF
ELSE
	// GUMPPIC +290 +175 08B7 38
ENDIF

IF (<TAG0.RUNEBOOK_PAGE> >=8)
	IF (<TAG0.RUNEBOOK_LASTPAGE> != 8)
		BUTTON +320 +175 08B8 08B8 1 0 17
	ENDIF
ELSE
	// GUMPPIC +320 +175 08B8 38
ENDIF

BUTTON +320 +8 089e 089e 1 0 18 // ++ page
BUTTON +50 +8 089d 089d 1 0 19 // -- page

IF !(<ISBLANK <REF99.TAG0.NAME>>)
	DHTMLGUMP +98 +8 80 25 0 0 <REF99.TAG0.NAME>
ELSE
	DHTMLGUMP +98 +8 50 25 0 0 İsimsiz
ENDIF

DHTMLGUMP +85 +20 110 25 0 0 <def.small>Şarj: <morex>
DHTMLGUMP +145 +20 110 25 0 0 <def.small>Mark: <rescount>

IF !(<TAG0.LINK>)
	// Diğer
	BUTTON +210 +18 2103 2104 0 2 2 
	DHTMLGUMP +223 +14 110 25 0 0 İşlemler

	//Runebook İsim değiştir
	BUTTON +85 +11 2103 2104 0 3 3
ENDIF

LOCAL.X = 350
LOCAL.Y = 260

IF (<LDB.CONNECTED>)
	// LDB.Query "SELECT id, region_text FROM 'runebooks' WHERE runebook_uid='<REF99>' AND <SRC.CTAG0.Dialog.Runebook_Where> LIMIT <DTAG0.RUNEBOOK_PAGE_INDEX>,16"
	LDB.Query "SELECT id, region_text, ordering FROM 'runebooks' WHERE runebook_uid='<REF99>' AND <SRC.CTAG0.Dialog.Runebook_Where> ORDER BY ordering ASC LIMIT <DTAG0.RUNEBOOK_PAGE_INDEX>,16"
	
	IF (<lDB.ROW.NUMROWS>)
		FOR 0 <EVAL <lDB.ROW.NUMROWS>-1>
		
			IF !(<TAG0.LINK>)
				// Move Up (Yukarı taşı) - İlk kayıtta (indeks 0) gözükmesin
				IF (<DLOCAL._FOR> > 0)
					BUTTON <EVAL (<DLOCAL.X>+<EVAL <LOCAL.MAIN_X>>)-160> <EVAL (<DLOCAL.Y>+<EVAL <LOCAL.MAIN_Y>>)-215> 2435 2436 1 0 <EVAL <dlDB.ROW.<DLOCAL._FOR>.id>+500000>
					TOOLTIP <def.empty_cliloc2> @Yukari Tasi
				ENDIF

				// Move Down (Aşağı taşı) - Son kayıtta (indeks lDB.ROW.NUMROWS-1) gözükmesin
				IF (<DLOCAL._FOR> < <EVAL <lDB.ROW.NUMROWS>-1>)
					BUTTON <EVAL (<DLOCAL.X>+<EVAL <LOCAL.MAIN_X>>)-150> <EVAL (<DLOCAL.Y>+<EVAL <LOCAL.MAIN_Y>>)-215> 2437 2438 1 0 <EVAL <dlDB.ROW.<DLOCAL._FOR>.id>+400000>
					TOOLTIP <def.empty_cliloc2> @Asagi Tasi
				ENDIF
				
				BUTTON <EVAL (<DLOCAL.X>+<EVAL <LOCAL.MAIN_X>>)-180> <EVAL (<DLOCAL.Y>+<EVAL <LOCAL.MAIN_Y>>)-215> 2103 2104 1 0 <EVAL <dlDB.ROW.<DLOCAL._FOR>.id>+300000> // rename
				TOOLTIP <def.empty_cliloc2> @Isim
				
				BUTTON <EVAL (<DLOCAL.X>+<EVAL <LOCAL.MAIN_X>>)-170> <EVAL (<DLOCAL.Y>+<EVAL <LOCAL.MAIN_Y>>)-215> 2103 2104 1 0 <EVAL <dlDB.ROW.<DLOCAL._FOR>.id>+200000> // cikart
				TOOLTIP <def.empty_cliloc2> @Cikart
			ENDIF
			
			BUTTON <EVAL (<DLOCAL.X>+<EVAL <LOCAL.MAIN_X>>)-290> <EVAL (<DLOCAL.Y>+<EVAL <LOCAL.MAIN_Y>>)-215> 2103 2104 1 0 <EVAL <dlDB.ROW.<DLOCAL._FOR>.id>+100000> // gate
			TOOLTIP <def.empty_cliloc2> @Gate
			
			BUTTON <EVAL (<DLOCAL.X>+<EVAL <LOCAL.MAIN_X>>)-300> <EVAL (<DLOCAL.Y>+<EVAL <LOCAL.MAIN_Y>>)-215> 2103 2104 1 0 <EVAL <dlDB.ROW.<DLOCAL._FOR>.id>+100> // recall
			TOOLTIP <def.empty_cliloc2> @Recall
			
			IF !(STRMATCH('0','<lDB.ROW.<DLOCAL._FOR>.region_text>'))
				DHTMLGUMP <EVAL (<DLOCAL.X>+<EVAL <LOCAL.MAIN_X>>)-280> <EVAL (<DLOCAL.Y>+<EVAL <LOCAL.MAIN_Y>>)-219> 110 17 0 0 <def.L1>basefont color=#202060<def.R1><lDB.ROW.<DLOCAL._FOR>.region_text>
			ENDIF
			
			LOCAL.Y +=15
			
			IF (<LOCAL.Y> > 370)
				LOCAL.X +=160
				LOCAL.Y=260
			ENDIF
			
		ENDFOR
	ENDIF
ENDIF




// İşlemler
PAGE 2
IF (<ISBLANK <TAG0.LINK>>)
	// BUTTON +60 +18 2103 2104 1 0 5
	// DHTMLGUMP +80 +15 110 25 0 0 Çoğalt
		
	BUTTON +70 +20 2103 2104 0 3 3 // Page
	DHTMLGUMP +80 +18 110 25 0 0 Runebook Adı
			
	BUTTON +70 +40 2103 2104 1 0 20 // Button
	DHTMLGUMP +80 +38 110 25 0 0 Rune Ekle
				
	BUTTON +70 +60 2103 2104 1 0 21 // Button
	DHTMLGUMP +80 +58 110 25 0 0 Şarj et (<MOREX>)
	
	BUTTON +70 +80 2103 2104 1 0 22 // Button
	DHTMLGUMP +80 +78 110 25 0 0 Bağla
		
	BUTTON +70 +100 2103 2104 0 4 4  // Page
	DHTMLGUMP +80 +98 110 25 0 0 Bağlı Runebooklar
		
	BUTTON +70 +120 2103 2104 1 0 23 // Button
	DHTMLGUMP +80 +118 110 25 0 0 Çoğalt
	
	BUTTON +70 +140 2103 2104 1 0 24 // Button
	DHTMLGUMP +80 +138 110 25 0 0 Boşalt
	
	BUTTON +70 +160 2103 2104 1 0 25// Button
	DHTMLGUMP +80 +158 150 25 0 0 Dışa aktar
	
	BUTTON +70 +180 2103 2104 1 0 26 // Button
	DHTMLGUMP +80 +178 150 25 0 0 İçe aktar
	
