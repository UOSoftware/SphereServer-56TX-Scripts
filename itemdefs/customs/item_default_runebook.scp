// Rune: Recall
ON=100,99999
MORE2=
IF (<SRC.MAGERY> < 250)
	SRC.SYSMESSAGELOC 0,3300433
	SRC.SOUND=92
	RETURN 1
ENDIF
IF (<SRC.MANA> < 15)
	SRC.SOUND=92
	SRC.SYSMESSAGELOC 0,3300434
	RETURN 1
ENDIF

IF (<LDB.CONNECTED>)	
	LDB.Query "SELECT id, rune_uid, rune_morep FROM 'runebooks' WHERE id='<eval <DARGN>-100>'"
	
	IF (<LDB.ROW.NUMROWS>)

		IF (<MOREX> > 0)
			MOREX -=1
			SRC.MANA -=15

		ELSEIF (<SRC.RESTEST 1 i_reag_black_pearl>) && (<SRC.RESTEST 1 i_reag_mandrake_root>) && (<SRC.RESTEST 1 i_reag_blood_moss>)
			IF (<SRC.MAGERY> < 400)
				SRC.SYSMESSAGELOC 0,3300435
				SRC.SOUND=92
				RETURN 1
			ENDIF
			SRC.MANA -=15
			SRC.CONSUME 1 I_REAG_BLACK_PEARL
			SRC.CONSUME 1 I_REAG_BLOOD_MOSS
			SRC.CONSUME 1 I_REAG_MANDRAKE_ROOT
		ELSE
			SRC.SYSMESSAGELOC 0,3300436
			SRC.SOUND 92
			RETURN 1
		ENDIF

		REF1=<LDB.ROW.0.rune_uid>
				
		IF (<TAG0.LINK>)
			EMPTY
			SERV.NEWITEM I_RUNE_MARKER
			NEW.CONT <UID>
			NEW.MOREP <REF1.MOREP>
			REF1=<NEW>
		ENDIF
		
		IF !(<REF1.TYPE> == T_RUNE)
			DB.EXECUTE "DELETE FROM 'runebooks' WHERE runebook_uid='<UID>' AND id='<eval <DARGN>-100>'"
			
			SERV.NEWITEM I_RUNE_MARKER
			NEW.CONT <UID>
			NEW.MOREP <LDB.ROW.0.rune_morep>
			NEW.MORE2=1
			REF1=<NEW>
			
			LDB.Query "SELECT id FROM 'runebooks' WHERE runebook_uid='<UID>' AND rune_uid='<ref1>'"
			IF (<LDB.ROW.NUMROWS>)
				LDB.EXECUTE "UPDATE 'runebooks' SET rune_uid="<REF1>", rune_duid='<DREF1>', rune_name="<StrReplaceSql <REF1.NAME>>", rune_morep="<REF1.MOREP>", rune_morex="<REF1.MOREX>", rune_morey="<REF1.MOREY>", rune_morez="<REF1.MOREZ>", rune_morem="<REF1.MOREM>", region_name="<StrReplaceSql <SERV.MAP(<REF1.MOREX>,<REF1.MOREY>,<REF1.MOREZ>,<REF1.MOREM>).REGION.NAME>>", region_text="<StrReplaceSql <SERV.MAP(<REF1.MOREX>,<REF1.MOREY>,<REF1.MOREZ>,<REF1.MOREM>).REGION.NAME>>", page="<dTAG0.RUNEBOOK_LASTPAGE>", ordering="0" WHERE id='<LDB.ROW.0.id>'"
			ELSE
				LDB.EXECUTE INSERT INTO 'runebooks' (runebook_uid, runebook_duid, rune_uid, rune_duid, rune_name, rune_morep, rune_morex, rune_morey, rune_morez, rune_morem, region_name, region_text, page, ordering) VALUES ('<UID>','<DUID>','<REF1>','<DREF1>','<StrReplaceSql <REF1.NAME>>','<REF1.MOREP>','<REF1.MOREX>','<REF1.MOREY>','<REF1.MOREZ>','<REF1.MOREM>','<StrReplaceSql <SERV.MAP(<REF1.MOREX>,<REF1.MOREY>,<REF1.MOREZ>,<REF1.MOREM>).REGION.NAME>>','<StrReplaceSql <SERV.MAP(<REF1.MOREX>,<REF1.MOREY>,<REF1.MOREZ>,<REF1.MOREM>).REGION.NAME>>','<DTAG0.RUNEBOOK_LASTPAGE>','0')
			ENDIF
			// SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu slotta geçerli bir rune bulunamadı!
		ENDIF
		IF (<REF1.TYPE> == T_RUNE)
			SRC.ACTDIFF=<ddef.SKILL_ACTION_DIFF_NOFAIL>
			SRC.EVENTS +e_runebook_casts
			REF1.MORE1 65000
			SRC.ACTARG1 = 32      
			SRC.ACT = <REF1>
			SRC.ACTPRV = <SRC>
			SRC.ACTP = <REF1.MOREX>,<REF1.MOREY>,<REF1.MOREZ>,<REF1.MOREM>
			SRC.ACTION = 25	
			SRC.ACTDIFF=<ddef.SKILL_ACTION_DIFF_NOFAIL>
		ELSE
			SRC.SYSMESSAGELOC <def.tcolor_red>,3300437
		ENDIF

	ELSE
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300437
	ENDIF
ENDIF



// Rune: Gate
ON=100000,199999
MORE2=
IF !(<SRC.REGION.FLAGS>&region_flag_house)
	IF (<SRC.REGION.FLAGS>&0e)
		SRC.SYSMESSAGELOC 0,3300438
		RETURN 1
	ENDIF
ENDIF
IF (<SRC.MAGERY> < 750)
	SRC.SYSMESSAGELOC 0,3300439
	SRC.SOUND=92
	RETURN 1
