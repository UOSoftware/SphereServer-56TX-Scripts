// Rune: Cikart
ON=200000 299999
IF (<LDB.CONNECTED>)	
	LDB.Query "SELECT id, rune_uid FROM 'runebooks' WHERE id='<eval <DARGN>-200000>'"
	IF (<LDB.ROW.NUMROWS>)
		REF1=<LDB.ROW.0.rune_uid>
		IF (<REF1>) && (<REF1.TYPE> == T_RUNE)
			// SRC.SYSMESSAGELOC <def.tcolor_green>,<def.empty_cliloc2>, [Runebook] Rune/Slot Çıkart - Slot:<ldb.row.0.id>
			
			LDB.EXECUTE "UPDATE 'runebooks' SET rune_uid=NULL, rune_duid=NULL, rune_name=NULL, rune_morep=NULL, rune_morex=NULL, rune_morey=NULL, rune_morez=NULL, rune_morem=NULL, region_name=NULL, region_text=NULL, page=NULL, ordering=NULL WHERE id='<EVAL <DARGN>-200000>'"
			
			REF1.CONT=<SRC.FINDLAYER.21>
			REF1.EVENTS -ei_runebook_rune
			REF1.UPDATEX
			UPDATEX
			MORE2=
			SRC.DCLICK <UID>
		ELSE
			SRC.SYSMESSAGELOC <def.tcolor_red>,3300437
		ENDIF
	ELSE
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300437
	ENDIF
ENDIF




// Rune: Rename
ON=300000 399999
MORE2=
IF !(<TOPOBJ.UID> == <SRC.UID>)
	SRC.SYSMESSAGELOC 0,3300429
	RETURN 1
ENDIF
IF (<LDB.CONNECTED>)	
	LDB.Query "SELECT id, rune_uid FROM 'runebooks' WHERE id='<eval <DARGN>-300000>'"
	IF (<LDB.ROW.NUMROWS>)
		REF1=<LDB.ROW.0.rune_uid>
		IF (<REF1.ISVALID>) && (<REF1.TYPE> == T_RUNE)
			DIALOGCLOSE D_RUNEBOOK
			DIALOG D_RUNEBOOK
						
			REF1.DIALOGCLOSE D_RUNEBOOK_LOCALNAME
			REF1.DIALOG D_RUNEBOOK_LOCALNAME
		ELSE
			SRC.SYSMESSAGELOC <def.tcolor_red>,3300437
		ENDIF

	ELSE
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300437
	ENDIF
ENDIF

// Rune: Move Down
ON=400000,499999
MORE2=
IF !(<TOPOBJ.UID> == <SRC.UID>)
    SRC.SYSMESSAGELOC 0,3300429
    RETURN 1
ENDIF
LOCAL.RUNE_ID = <EVAL <DARGN>-400000>

IF (<LDB.CONNECTED>)
    // 1. Seçilen Runeyi getir
    LDB.Query "SELECT id, IFNULL(ordering, 0) as ord, page FROM 'runebooks' WHERE runebook_uid='<UID>' AND id='<dLOCAL.RUNE_ID>'"
    IF (<LDB.ROW.NUMROWS>)
        LOCAL.CUR_ORD = <LDB.ROW.0.ord>
        LOCAL.PAGE = <LDB.ROW.0.page>
        
        // 2. Bir sonraki (aşağıdaki) runeyi bul
        LDB.Query "SELECT id, IFNULL(ordering, 0) as ord FROM 'runebooks' WHERE runebook_uid='<UID>' AND page='<dLOCAL.PAGE>' AND IFNULL(ordering, 0) > <dLOCAL.CUR_ORD> ORDER BY ord ASC LIMIT 1"
        IF (<LDB.ROW.NUMROWS>)
            LOCAL.NEXT_ID = <LDB.ROW.0.id>
            LOCAL.NEXT_ORD = <LDB.ROW.0.ord>
        
            // 3. Yer değiştir
            LDB.EXECUTE "UPDATE 'runebooks' SET ordering='<dLOCAL.NEXT_ORD>' WHERE id='<dLOCAL.RUNE_ID>'"
            LDB.EXECUTE "UPDATE 'runebooks' SET ordering='<dLOCAL.CUR_ORD>' WHERE id='<dLOCAL.NEXT_ID>'"
        ENDIF
    ENDIF
ENDIF
DIALOGCLOSE D_RUNEBOOK
DIALOG D_RUNEBOOK
RETURN 1
	
// Rune: Move Up
ON=500000 599999
MORE2=
IF !(<TOPOBJ.UID> == <SRC.UID>)
    SRC.SYSMESSAGELOC 0,3300429
    RETURN 1
ENDIF
LOCAL.RUNE_ID = <EVAL <DARGN>-500000>

IF (<LDB.CONNECTED>)
    LDB.Query "SELECT id, IFNULL(ordering, 0) as ord, page FROM 'runebooks' WHERE runebook_uid='<UID>' AND id='<dLOCAL.RUNE_ID>'"
    IF (<LDB.ROW.NUMROWS>)
        LOCAL.CUR_ORD = <LDB.ROW.0.ord>
        LOCAL.PAGE = <LDB.ROW.0.page>
        
        // DÜZELTME: Bir önceki (yukarıdaki) runeyi bulmak için DESC (büyükten küçüğe) kullanmalıyız
        LDB.Query "SELECT id, IFNULL(ordering, 0) as ord FROM 'runebooks' WHERE runebook_uid='<UID>' AND page='<dLOCAL.PAGE>' AND IFNULL(ordering, 0) < <dLOCAL.CUR_ORD> ORDER BY ord DESC LIMIT 1"
        IF (<LDB.ROW.NUMROWS>)
            LOCAL.PREV_ID = <LDB.ROW.0.id>
            LOCAL.PREV_ORD = <LDB.ROW.0.ord>
            
            // Yer değiştir
            LDB.EXECUTE "UPDATE 'runebooks' SET ordering='<dLOCAL.PREV_ORD>' WHERE id='<dLOCAL.RUNE_ID>'"
            LDB.EXECUTE "UPDATE 'runebooks' SET ordering='<dLOCAL.CUR_ORD>' WHERE id='<dLOCAL.PREV_ID>'"
        ENDIF
    ENDIF
ENDIF
DIALOGCLOSE D_RUNEBOOK
DIALOG D_RUNEBOOK
RETURN 1





[DIALOG d_runebook_localname]       
<DEF.DSP>
DORIGIN 30 30

RESIZEPIC +0 +0 5054 310 120
RESIZEPIC +10 +10 3000 290 100

DTEXT +20 +20 0 Yeni isim ne olsun?  

IF (<LDB.CONNECTED>)	
	LDB.Query "SELECT id, region_text FROM 'runebooks' WHERE rune_uid='<UID>'"
	IF (<lDB.ROW.NUMROWS>)
		RESIZEPIC +20 +40 3000 270 22
		DTEXTENTRYLIMITED +25 +45 253 25 0 0 25 <ldb.row.0.region_text>
		
		BUTTON +20 +80 4005 4007 1 0 1
		DTEXT +50 +80 <def.tcolor_text> Tamam

		BUTTON +120 +80 4005 4007 1 0 2
		DTEXT +150 +80 <def.tcolor_text> Reset

	ENDIF
ENDIF

BUTTON +220 +80 4005 4007 1 0 3
DTEXT +250 +80 <def.tcolor_text> Iptal  

[DIALOG d_runebook_localname BUTTON]
// Apply
ON=1

IF (<ISBADCHAR <ARGTXT[0]>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300442
	RETURN 1
ELSEIF (<ISBLANK <ARGTXT[0]>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300323
	RETURN 1
// ELSEIF !(<ISALPHANUMERIC <ARGTXT[0]>>)
	// SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Sadece rakam ve harf.
	// RETURN 1
ELSEIF (<EVAL STRLEN(<ARGTXT[0]>)> < 3) || (<EVAL STRLEN(<ARGTXT[0]>)> > 25)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300443
	RETURN 1
ENDIF

IF (<LDB.CONNECTED>)	
	LDB.Query "SELECT id, region_text FROM 'runebooks' WHERE rune_uid='<UID>'"
	IF (<LDB.ROW.NUMROWS>)
		LOCAL.CURRENT_NAME = <LDB.ROW.region_text>
        LOCAL.NEW_NAME = <StrReplaceSql <ARGTXT[0]>>

		IF !(STRMATCH('<STRSUB 0 4 <LOCAL.NEW_NAME>>','rn: ')) // ust uste rn: rn: rn: Moonglow fixi
            LOCAL.FINAL_NAME = "rn: <LOCAL.NEW_NAME>"
        ELSE
            LOCAL.FINAL_NAME = <LOCAL.NEW_NAME>
        ENDIF
		
		LDB.EXECUTE "UPDATE 'runebooks' SET region_text='<LOCAL.FINAL_NAME>' WHERE rune_uid='<UID>'"
		SRC.SYSMESSAGELOC <def.tcolor_text>,3300444,<StrReplaceSql <ARGTXT[0]>>
	ENDIF
ENDIF

DIALOGCLOSE D_RUNEBOOK
DIALOG D_RUNEBOOK

// Reset
ON=2
IF (<LDB.CONNECTED>)	
	LDB.Query "SELECT id, region_text FROM 'runebooks' WHERE rune_uid='<UID>'"
	IF (<LDB.ROW.NUMROWS>)
		LDB.EXECUTE "UPDATE 'runebooks' SET region_text='<StrReplaceSql <SERV.MAP(<MOREP>).REGION.NAME>>' WHERE rune_uid='<UID>'"
		SRC.SYSMESSAGELOC <def.tcolor_text>,3300445,<StrReplaceSql <SERV.MAP(<MOREP>).REGION.NAME>>
	ENDIF
ENDIF
DIALOGCLOSE D_RUNEBOOK
DIALOG D_RUNEBOOK

// Cancel
ON=3
SRC.SYSMESSAGELOC <def.tcolor_text>,3300446
DIALOGCLOSE D_RUNEBOOK
DIALOG D_RUNEBOOK




[EVENTS e_runebook_casts]
ON=@SPELLSELECT
IF (<DARGN1> == 32) || (<DARGN1> == 52)
	// LOCAL.Tithing=0
	// LOCAL.TithingUse=0
	// SERV.B Tithing <LOCAL.Tithing>
	// SERV.B TithingUse <LOCAL.TithingUse>
	SRC.EVENTS -e_runebook_casts
	RETURN 6 // Reg ve spellbook gereksinimini kaldırır return = TRIGRET_RET_HALFBAKED
ENDIF

ON=@SPELLFAIL
SRC.EVENTS -e_runebook_casts
SYSMESSAGELOC 0,3300447

ON=@SPELLABORT
SRC.EVENTS -e_runebook_casts
SYSMESSAGELOC 0,3300447








[ITEMDEF I_RUNEBOOK_GATE]
DEFNAME=I_RUNEBOOK_GATE
ID=I_MOONGATE_BLUE
RESOURCES=I_SCROLL_GATE_TRAVEL
// TYPE=T_TELEPAD
TYPE=T_SCRIPT
NAME=Gate
CATEGORY=Provisions - Alchemy & Magic
SUBSECTION=Moongates
DESCRIPTION=RB Gate

ON=@CREATE
COLOR=022
MORE1=5
ATTR=ATTR_MOVE_NEVER

ON=@DCLICK
IF (<DISTANCE> > 3)
	SRC.SYSMESSAGELOC 0,3300336
ELSE
	IF (<SRC.FINDID.I_RB_GATER>)
		SRC.FINDID.I_RB_GATER.REMOVE
	ENDIF
	SERV.NEWITEM I_RB_GATER
	NEW.LINK <UID>
	NEW.MOREP <MOREP>
	SRC.EQUIP <NEW>
ENDIF
RETURN 1

ON=@STEP
IF !((<SRC.FINDID.I_RB_GATER>) || (<SRC.FLAGS>&STATF_STONE))
	SERV.NEWITEM I_RB_GATER
	NEW.LINK <UID>
	NEW.MOREP <MOREP>
	SRC.EQUIP <NEW>
ENDIF


ON=@CLICK
// IF (<SRC.REGION> && <REGION>)
	IF (<SRC.REGION.UID> == <REGION.UID>)
		SAYU
		SAYUA 0905,0,0,0 <LINK.REGION.NAME>
		SAYUA 0900,0,0,0 [<LINK.P>]
	ELSE
		MESSAGE <LINK.REGION.NAME>
		MESSAGE [<LINK.P>]
		MESSAGE
	ENDIF
// ENDIF
RETURN 1

ON=@TIMER
IF (<MORE1>)
	MORE1 -=1
	TIMER 1
ELSE
	SOUND 528
	REMOVE
ENDIF
RETURN 1


[DIALOG D_RUNEBOOK_GATE]
100,100
NOMOVE

RESIZE 0,0,140,120,GATE TRAVEL

DORIGIN 30 50
DHTMLGUMP +35 +0 80 20 0 0 EVET
BUTTON +0 +0 4006 4007 1 0 1

DHTMLGUMP +35 +20 80 20 0 0 HAYIR
BUTTON +0 +20 4018 4019 1 0 0

[DIALOG D_RUNEBOOK_GATE PREBUTTON]
IF (<SRC.FLAGS>&STATF_FREEZE)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300341
	RETURN 1
ELSEIF (<SRC.FLAGS>&STATF_STONE)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300341
	RETURN 1
ENDIF

[DIALOG D_RUNEBOOK_GATE BUTTON]
ON=0
IF (<FINDID.I_RB_GATER>)
	FINDID.I_RB_GATER.REMOVE
ENDIF

ON=1
IF !(<FINDID.I_RB_GATER>)
	SYSMESSAGELOC 0,3300448
	
ELSEIF !(<FINDID.I_RB_GATER.LINK.ISITEM>)
	SYSMESSAGELOC 0,3300448
	FINDID.I_RB_GATER.REMOVE
	
ELSEIF (<FINDID.I_RB_GATER.LINK.DISTANCE> > 3)
	SYSMESSAGELOC 0,3300336
	FINDID.I_RB_GATER.REMOVE
ELSE
	IF (<FINDID.I_RB_GATER>)
		GO <FINDID.I_RB_GATER.MOREP>
		FINDID.I_RB_GATER.TIMER 2
	ELSE
		SYSMESSAGELOC 0,3300354
	ENDIF
ENDIF



[ITEMDEF I_RB_GATER]
DEFNAME=I_RB_GATER
NAME=Runebook Gate Memory
ID=I_HANDR_1
TYPE=T_EQ_SCRIPT
WEIGHT=0
LAYER=LAYER_SPECIAL

ON=@CREATE
ATTR=ATTR_INVIS|ATTR_CAN_DECAY

ON=@EQUIP
TIMER=30
SRC.SDIALOG d_runebook_gate

ON=@TIMER
REMOVE
RETURN 1


[EOF]
