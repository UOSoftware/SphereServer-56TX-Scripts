// ----------------------------
// Black Dye Tub
// ----------------------------

[ITEMDEF I_DYE_TUB_BLACK]
DEFNAME=I_DYE_TUB_BLACK
ID=i_dye_tub
NAME=black dye tub
TYPE=T_DYE_VAT
WEIGHT=10
CATEGORY=
SUBSECTION=
DESCRIPTION=Black Dye
RESOURCES=5 i_log
SKILLMAKE=CARPENTRY 50.0, t_carpentry
TAG0.REWARD=100000
RESDISPDNHUE=01

ON=@CREATE
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>

ON=@DCLICK
IF (<SRC.TAILORING> < 979)
	SRC.SYSMESSAGELOC 0,3300379
	RETURN 1
ELSE
	SRC.SYSMESSAGELOC 0,3300380
	TARGET
	RETURN 1
ENDIF

ON=@TARGON_ITEM
IF <SRC.TARG.TOPOBJ.UID> != <SRC.UID> 
	SRC.SYSMESSAGELOC 0,3300381
	RETURN 1
ENDIF
IF (( <SRC.TARG.DISPID> = I_LEATHER_CAP ) || ( <SRC.TARG.DISPID> = I_LEATHER_GORGET ) || ( <SRC.TARG.DISPID> = I_LEATHER_SLEEVES ) || ( <SRC.TARG.DISPID> = I_LEATHER_LEGGINGS ) || ( <SRC.TARG.DISPID> = I_LEATHER_TUNIC ) || ( <SRC.TARG.DISPID> = I_STUDDED_GORGET ) || ( <SRC.TARG.DISPID> = I_STUDDED_GLOVES ) || ( <SRC.TARG.DISPID> = I_STUDDED_SLEEVES ) || ( <SRC.TARG.DISPID> = I_STUDDED_LEGGINGS ) || ( <SRC.TARG.DISPID> = I_STUDDED_TUNIC ) || ( <SRC.TARG.DISPID> = I_ARMOR_FEMALE_SHORTS ) || ( <SRC.TARG.DISPID> = I_ARMOR_FEMALE_BUSTIER ) || ( <SRC.TARG.DISPID> = I_ARMOR_FEMALE_BUSTIER_STUDDED ) || ( <SRC.TARG.DISPID> = I_ARMOR_FEMALE_STUDDED ) || ( <SRC.TARG.DISPID> = I_ARMOR_FEMALE_SKIRT ) || ( <SRC.TARG.DISPID> = I_ARMOR_FEMALE_LEATHER ))
	SRC.SYSMESSAGELOC 0,3300382
	RETURN 1
ELSEIF (( <SRC.TARG.BASEID> = I_X_RANGER_SLEEVES ) || ( <SRC.TARG.BASEID> = I_X_RANGER_GLOVES ) || ( <SRC.TARG.BASEID> = I_X_RANGER_GORGET ) || ( <SRC.TARG.BASEID> = I_X_RANGER_LEGGINGS ) || ( <SRC.TARG.BASEID> = I_X_RANGER_TUNIC ))
	SRC.SYSMESSAGELOC 0,3300383
	RETURN 1
ELSEIF (( <SRC.TARG.BASEID> = I_X_PHOENIX_LEGGINGS ) || ( <SRC.TARG.BASEID> = I_X_PHOENIX_GLOVES ) || ( <SRC.TARG.BASEID> = I_X_PHOENIX_SLEEVES ) || ( <SRC.TARG.BASEID> = I_X_PHOENIX_TUNIC ) || ( <SRC.TARG.BASEID> = I_X_PHOENIX_GORGET ) || ( <SRC.TARG.BASEID> = I_X_PHOENIX_HELM ))
	SRC.SYSMESSAGELOC 0,3300384
	RETURN 1
ELSEIF (<SRC.TARG.TYPE> = T_DYE_VAT)
	SRC.SYSMESSAGELOC 0,3300385
	RETURN 1
ELSEIF !(<SRC.TARG.IsBoyanabilir>)
	SRC.SYSMESSAGELOC 0,3300386
	RETURN 1
ELSEIF (<SRC.TARG.TYPE> = T_CLOTHING)
	RETURN 0
ELSE
	SRC.SYSMESSAGELOC 0,3300387
	RETURN 1
ENDIF


// ----------------------------
// Rare Dye Tub
// ----------------------------

[ITEMDEF I_DYE_TUB_RARE]
DEFNAME=I_DYE_TUB_RARE
ID=i_dye_tub
NAME=rare dye tub
TYPE=T_DYE_VAT
WEIGHT=10
CATEGORY=
SUBSECTION=
DESCRIPTION=Rare Dye
RESOURCES=5 i_log
SKILLMAKE=CARPENTRY 50.0, t_carpentry
TAG0.REWARD=125000
RESDISPDNHUE=colors_dye_rare

ON=@CREATE
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>

ON=@DCLICK
IF (<SRC.TAILORING> < 979)
	SRC.SYSMESSAGELOC 0,3300379
	RETURN 1
ELSE
	SRC.SYSMESSAGELOC 0,3300380
	TARGET
	RETURN 1
ENDIF

ON=@TARGON_ITEM
IF <SRC.TARG.TOPOBJ.UID> != <SRC.UID> 
	SRC.SYSMESSAGELOC 0,3300381
	RETURN 1
ENDIF
IF ((<SRC.TARG.DISPID> = I_LEATHER_CAP ) || ( <SRC.TARG.DISPID> = I_LEATHER_GORGET ) || ( <SRC.TARG.DISPID> = I_LEATHER_SLEEVES ) || ( <SRC.TARG.DISPID> = I_LEATHER_LEGGINGS ) || ( <SRC.TARG.DISPID> = I_LEATHER_TUNIC ) || ( <SRC.TARG.DISPID> = I_STUDDED_GORGET ) || ( <SRC.TARG.DISPID> = I_STUDDED_GLOVES ) || ( <SRC.TARG.DISPID> = I_STUDDED_SLEEVES ) || ( <SRC.TARG.DISPID> = I_STUDDED_LEGGINGS ) || ( <SRC.TARG.DISPID> = I_STUDDED_TUNIC ) || ( <SRC.TARG.DISPID> = I_ARMOR_FEMALE_SHORTS ) || ( <SRC.TARG.DISPID> = I_ARMOR_FEMALE_BUSTIER ) || ( <SRC.TARG.DISPID> = I_ARMOR_FEMALE_BUSTIER_STUDDED ) || ( <SRC.TARG.DISPID> = I_ARMOR_FEMALE_STUDDED ) || ( <SRC.TARG.DISPID> = I_ARMOR_FEMALE_SKIRT ) || ( <SRC.TARG.DISPID> = I_ARMOR_FEMALE_LEATHER ))
	SRC.SYSMESSAGELOC 0,3300382
	RETURN 1
ELSEIF (( <SRC.TARG.BASEID> = I_X_RANGER_SLEEVES ) || ( <SRC.TARG.BASEID> = I_X_RANGER_GLOVES ) || ( <SRC.TARG.BASEID> = I_X_RANGER_GORGET ) || ( <SRC.TARG.BASEID> = I_X_RANGER_LEGGINGS ) || ( <SRC.TARG.BASEID> = I_X_RANGER_TUNIC ))
	SRC.SYSMESSAGELOC 0,3300383
	RETURN 1
ELSEIF (( <SRC.TARG.BASEID> = I_X_PHOENIX_LEGGINGS ) || ( <SRC.TARG.BASEID> = I_X_PHOENIX_GLOVES ) || ( <SRC.TARG.BASEID> = I_X_PHOENIX_SLEEVES ) || ( <SRC.TARG.BASEID> = I_X_PHOENIX_TUNIC ) || ( <SRC.TARG.BASEID> = I_X_PHOENIX_GORGET ) || ( <SRC.TARG.BASEID> = I_X_PHOENIX_HELM ))
	SRC.SYSMESSAGELOC 0,3300384
	RETURN 1
ELSEIF (<SRC.TARG.TYPE> = T_DYE_VAT)
	SRC.SYSMESSAGELOC 0,3300385
	RETURN 1
ELSEIF !(<SRC.TARG.IsBoyanabilir>)
	SRC.SYSMESSAGELOC 0,3300386
	RETURN 1
ELSEIF (<SRC.TARG.TYPE> = T_CLOTHING)
	RETURN 0
ELSE
	SRC.SYSMESSAGELOC 0,3300387
	RETURN 1
ENDIF


