
[ITEMDEF I_REWARD]
DEFNAME=I_REWARD
DEFNAME2=I_REWARD_BARREL
ID=0e77
TYPE=T_SCRIPT
NAME=hediye stogu
RESDISPDNHUE=0525

ON=@CLICK
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
MESSAGE @,,1,1 <NAME>
RETURN 1

ON=@CREATE
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
ATTR=ATTR_STATIC|ATTR_MOVE_NEVER

ON=@DCLICK
ATTR=ATTR_STATIC|ATTR_MOVE_NEVER
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>

IF (<SRC.TAG0.REWARDCOINS> > 99.999.999)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300361
	SRC.TAG0.REWARDCOINS 99999999 
ENDIF
IF (<SRC.TAG0.REWARDCOINS> <= 0)
	SRC.TAG0.REWARDCOINS 0
ENDIF

SRC.SOUND 555
DIALOGCLOSE D_REWARD
DIALOG D_REWARD
RETURN 1

ON=@TARGON_CHAR
SRC.SYSMESSAGELOC <def.tcolor_red>,3300362
RETURN 1

ON=@TARGON_ITEM
IF (<MORE> == 2)

	IF (<SRC.TARG.TOPOBJ.UID> != <SRC.UID>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300363
		RETURN 1
	ENDIF
	
	IF (<SRC.TARG.BASEID> = i_reward_coin)
		SRC.TAG0.REWARDCOINS +=<SRC.TARG.AMOUNT>
		SRC.TARG.REMOVE
		
		SRC.SAYLOC 0481,3301080,<NumberFormat <SRC.TARG.AMOUNT>>
		
		SRC.SYSMESSAGELOC <def.tcolor_green>,3300364,<NumberFormat <SRC.TARG.AMOUNT>>
		MORE 2
		TARGET
		SRC.SYSMESSAGELOC <def.tcolor_text>,3300365
		RETURN 1
	ELSE
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300366
		RETURN 1
	ENDIF
	
ENDIF

IF (<MORE> == 1)

	IF (<SRC.TARG.TOPOBJ.UID> != <SRC.UID>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,600036,<SRC.TARG.NAME>
		RETURN 1
	ENDIF
	IF (<SRC.TARG.DISPID> == i_backpack)
		SRC.SYSMESSAGELOC 0,3300367,<SRC.TARG.NAME>
		RETURN 1
	ENDIF
	IF (<SRC.TARG.TYPE> == t_food)
		SRC.SYSMESSAGELOC 0,3300367,<SRC.TARG.NAME>
		RETURN 1
	ENDIF
	IF (<SRC.TARG.TYPE> == t_gold)
		SRC.SYSMESSAGELOC 0,3300367,<SRC.TARG.NAME>
		RETURN 1
	ENDIF
	IF (<SRC.TARG.TYPE> == t_container)
		SRC.SYSMESSAGELOC 0,3300367,<SRC.TARG.NAME>
		RETURN 1
	ENDIF
	IF (<SRC.TARG.TYPE> == t_sign_gump)
		SRC.SYSMESSAGELOC 0,3300367,<SRC.TARG.NAME>
		RETURN 1
	ENDIF
	IF (<SRC.TARG.TYPE> == t_shield)
		SRC.SYSMESSAGELOC 0,3300367,<SRC.TARG.NAME>
		RETURN 1
	ENDIF
	IF (<SRC.TARG.BASEID> == i_reward_coin)
		SRC.SYSMESSAGELOC 0,3300367,<SRC.TARG.NAME>
		RETURN 1
	ENDIF
	IF (<SRC.TARG.DISPID> == i_shield_order)
		SRC.SYSMESSAGELOC 0,3300367,<SRC.TARG.NAME>
		RETURN 1
	ENDIF
	IF (<SRC.TARG.DISPID> == i_shield_chaos)
		SRC.SYSMESSAGELOC 0,3300367,<SRC.TARG.NAME>
		RETURN 1
	ENDIF
	IF (<SRC.TARG.DISPID> == i_cloth)
		SRC.SYSMESSAGELOC 0,3300367,<SRC.TARG.NAME>
		RETURN 1
	ENDIF
	IF (<SRC.TARG.DISPID> == i_cloth_bolt)
		SRC.SYSMESSAGELOC 0,3300367,<SRC.TARG.NAME>
		RETURN 1
	ENDIF
	IF (<SRC.TARG.ID> == i_bandage)
		SRC.SYSMESSAGELOC 0,3300367,<SRC.TARG.NAME>
		RETURN 1
	ENDIF
	IF (<SRC.TARG.ID> == i_kindling)
		SRC.SYSMESSAGELOC 0,3300367,<SRC.TARG.NAME>
		RETURN 1
	ENDIF
	IF (<SRC.TARG.BASEID> == i_robe)
		SRC.SYSMESSAGELOC 0,3300367,<SRC.TARG.NAME>
		RETURN 1
	ENDIF
	IF (<SRC.TARG.DISPID> == i_deed)
		SRC.SYSMESSAGELOC 0,3300367,<SRC.TARG.NAME>
		RETURN 1
	ENDIF
	IF (<SRC.TARG.TYPE> == T_WEAPON_ARROW)
		SRC.SYSMESSAGELOC 0,3300367,<SRC.TARG.NAME>
		RETURN 1
	ENDIF
	IF (<SRC.TARG.TYPE> == T_BANDAGE)
		SRC.SYSMESSAGELOC 0,3300367,<SRC.TARG.NAME>
		RETURN 1
	ENDIF
	IF (<SRC.TARG.ATTR>&ATTR_NEWBIE)
		SRC.SYSMESSAGELOC 0,3300367,<SRC.TARG.NAME>
		RETURN 1
	ENDIF
	LOCAL.REWARDGAIN = <EVAL (<SRC.TARG.VALUE> * <SRC.TARG.AMOUNT> ) / 4>
	IF (<DLOCAL.REWARDGAIN> < 1)
		SRC.SAYLOC 025,3301081
		SRC.TARG.REMOVE
		IF (<DISTANCE> < 4)
			MORE 1
			TARGET
			SRC.SYSMESSAGELOC 0,3300368
		ELSE
			SRC.MESSAGELOC 0,3301082
		ENDIF
		RETURN 1
	ELSE
		SRC.TAG.REWARDCOINS +=<DLOCAL.REWARDGAIN>
		SRC.SAYLOC 0520,3301083,<SRC.TARG.NAME>,<NumberFormat <DLOCAL.REWARDGAIN>>
		SRC.LOGGER <src.targ.amount> <SRC.TARG.NAME> [<src.targ.uid>] isimli esya <NumberFormat <DLOCAL.REWARD>> reward coin kazandirdi.
		SRC.TARG.REMOVE
		
		IF (<DISTANCE> < 4)
			MORE 1
			TARGET 
			SRC.SYSMESSAGELOC 0,3300368
		ELSE
			SRC.MESSAGELOC 0,3301082
		ENDIF
		RETURN 1
	ENDIF
	
ENDIF


[ITEMDEF I_REWARD_COIN]
DEFNAME=I_REWARD_COIN
ID=I_GEM_RUBY
TYPE=0
NAME=hediye bileti
WEIGHT=0.0
VALUE=0
RESDISPDNHUE=055

ON=@CREATE
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
ATTR=ATTR_NEWBIE

ON=@CLICK
ATTR |= ATTR_NEWBIE
MESSAGELOC 0,3301084,<BolukAyir <AMOUNT>>
RETURN 1

ON=@DCLICK
ATTR |= ATTR_NEWBIE
MESSAGELOC 0,3301085,<SERV.NAME>
MESSAGELOC 0,3301086,<SERV.NAME>
RETURN 1


[DIALOG D_REWARD]
<DEF.DSP>
RESIZE 0,0,310,600,Hediye stoğu

PAGE 0
DORIGIN 30 520

BUTTON +0 +5 2103 2104 1 0 999
DTEXT +15 +0 1345 Stokları bilete çevir

BUTTON +0 +25 2103 2104 1 0 998
DTEXT +15 +20 1345 Biletleri stokla

BUTTON +160 +20 2103 2104 1 0 997
DTEXT +175 +15 1345 Çöpe at

// BUTTON +160 +40 2103 2104 1 0 996
// DTEXT +175 +35 1345 Toplu Çöpe at

DTEXT +0 +40 1153 Stok: <BolukAyir <dSRC.TAG0.REWARDCOINS>>

PAGE 1
LOCAL.AUMENTAR=0
LOCAL.PAGE=1

DORIGIN 20 50
BUTTONTILEART +0 +0 151 151 0 100 100 <SERV.ITEMDEF.I_STUDDED_TUNIC_RANGER.ID> <DSERV.ITEMDEF.I_STUDDED_TUNIC_RANGER.RESDISPDNHUE> 0 0
DTEXT +70 +0 990 Ranger Armor
DTEXT 210 +0 1350 200.000

BUTTONTILEART +0 +50 151 151 0 101 101 <SERV.ITEMDEF.I_PHOENIX_TUNIC_REWARD.ID> <DSERV.ITEMDEF.I_PHOENIX_TUNIC_REWARD.RESDISPDNHUE> 0 0
DTEXT +70 +50 990 Phoenix Armor
DTEXT 210 +50 1350 300.000

FOR 1 <ARRAYCOUNT <DEF.REWARD_BARREL_ITEMS>>
	LOCAL.ITEMDEF = <STREAT <ARRAY <DEF.REWARD_BARREL_ITEMS>,<DLOCAL._FOR>>>
	LOCAL.AMOUNT = <STRARG <ARRAY <DEF.REWARD_BARREL_ITEMS>,<DLOCAL._FOR>>>
	
	IF (<DLOCAL.AUMENTAR> >= 7)
		LOCAL.AUMENTAR=0
		BUTTON 260 500 015A4 015A6 0 <EVAL <LOCAL.PAGE>+1> 0
		LOCAL.PAGE += 1
		PAGE <EVAL <LOCAL.PAGE>>
		BUTTON 230 500 015A1 015A3 0 <EVAL <LOCAL.PAGE>-1> 0
	ENDIF
	
	IF (<RESOURCETYPE <LOCAL.ITEMDEF>> == RES_ITEMDEF)
	
		IF (<dSERV.ITEMDEF.<LOCAL.ITEMDEF>.TAG0.REWARD>)
			BUTTONTILEART 20 <EVAL (<LOCAL.AUMENTAR>*50)+150> 151 151 1 0 <EVAL <DLOCAL._FOR>> <SERV.ITEMDEF.<LOCAL.ITEMDEF>.ID> <DSERV.ITEMDEF.<LOCAL.ITEMDEF>.RESDISPDNHUE> 0 0
			DCROPPEDTEXT 85 <EVAL (<LOCAL.AUMENTAR>*50)+150> 110 25 990 <qval (<dLOCAL.AMOUNT> > 1)?<dLOCAL.AMOUNT>:> <SERV.ITEMDEF.<LOCAL.ITEMDEF>.NAME>
			DTEXT 100 <EVAL (<LOCAL.AUMENTAR>*50)+170> 0455 <SERV.ITEMDEF.<LOCAL.ITEMDEF>.description>
			DTEXT 210 <EVAL (<LOCAL.AUMENTAR>*50)+150> 1350 <BolukAyir <dSERV.ITEMDEF.<LOCAL.ITEMDEF>.TAG0.REWARD>>
			LOCAL.AUMENTAR += 1
		ENDIF
		
	ELSEIF (<RESOURCETYPE <LOCAL.ITEMDEF>> == RES_TEMPLATE)
		BUTTONTILEART 20 <EVAL (<LOCAL.AUMENTAR>*50)+150> 151 151 1 0 <EVAL <DLOCAL._FOR>> 0e76 0 0 0
		DCROPPEDTEXT 85 <EVAL (<LOCAL.AUMENTAR>*50)+150> 110 25 990 <qval (<dLOCAL.AMOUNT> > 1)?<dLOCAL.AMOUNT>:> <SERV.TEMPLATE.<LOCAL.ITEMDEF>.SUBSECTION>
		// DTEXT 100 <EVAL (<LOCAL.AUMENTAR>*50)+170> 0455 <SERV.TEMPLATE.<LOCAL.ITEMDEF>.description>
		DTEXT 210 <EVAL (<LOCAL.AUMENTAR>*50)+150> 1350 <BolukAyir <SERV.TEMPLATE.<LOCAL.ITEMDEF>.DESCRIPTION>>
		LOCAL.AUMENTAR += 1
	ENDIF
	
	
ENDFOR

// Ranger armor
PAGE 100
ARGS=I_Deed_Armor_Studded_Ranger_Reward,I_STUDDED_SLEEVES_RANGER_REWARD,I_STUDDED_GORGET_RANGER_REWARD,I_STUDDED_LEGGINGS_RANGER_REWARD,I_STUDDED_TUNIC_RANGER_REWARD,I_STUDDED_GLOVES_RANGER_REWARD
FOR 0 <EVAL <ARGV>-1>
	LOCAL.ITEM = <ARGV<DLOCAL._FOR>>
	IF (<SERV.ITEMDEF.<LOCAL.ITEM>.TAG0.REWARD>)
		BUTTONTILEART 20 <EVAL (<LOCAL._FOR>*45)+50> 151 151 1 0 <EVAL <DLOCAL._FOR>+100> <SERV.ITEMDEF.<LOCAL.ITEM>.ID> <dSERV.ITEMDEF.<LOCAL.ITEM>.RESDISPDNHUE> 5 5
		DCROPPEDTEXT 85 <EVAL (<LOCAL._FOR>*45)+50> 110 25 990 <SERV.ITEMDEF.<LOCAL.ITEM>.NAME>
		DTEXT 210 <EVAL (<LOCAL._FOR>*45)+50> 1350 <BolukAyir <dSERV.ITEMDEF.<LOCAL.ITEM>.TAG0.REWARD>>
	ENDIF
ENDFOR

BUTTON +10 +380 9909 9911 0 1 1
DTEXT +35 +380 0 Anasayfaya dön

// Phoenix armor
PAGE 101
ARGS=I_Deed_Armor_Phoenix_Reward,I_PHOENIX_LEGGINGS_REWARD,I_PHOENIX_GLOVES_REWARD,I_PHOENIX_SLEEVES_REWARD,I_PHOENIX_TUNIC_REWARD,I_PHOENIX_GORGET_REWARD,I_PHOENIX_HELM_REWARD
FOR 0 <EVAL <ARGV>-1>
	LOCAL.ITEM = <ARGV<DLOCAL._FOR>>
	IF (<SERV.ITEMDEF.<LOCAL.ITEM>.TAG0.REWARD>)
		BUTTONTILEART 20 <EVAL (<LOCAL._FOR>*45)+50> 151 151 1 0 <EVAL <DLOCAL._FOR>+200> <SERV.ITEMDEF.<LOCAL.ITEM>.ID> <dSERV.ITEMDEF.<LOCAL.ITEM>.RESDISPDNHUE> 5 5
		DCROPPEDTEXT 85 <EVAL (<LOCAL._FOR>*45)+50> 110 25 990 <SERV.ITEMDEF.<LOCAL.ITEM>.NAME>
		DTEXT 210 <EVAL (<LOCAL._FOR>*45)+50> 1350 <BolukAyir <dSERV.ITEMDEF.<LOCAL.ITEM>.TAG0.REWARD>>
	ENDIF
ENDFOR
BUTTON +10 +380 9909 9911 0 1 1
DTEXT +35 +380 0 Anasayfaya dön


[DIALOG D_REWARD PREBUTTON]

	
[DIALOG D_REWARD BUTTON]
ON=1 99
LOCAL.ITEMDEF = <STREAT <ARRAY <DEF.REWARD_BARREL_ITEMS>,<ARGN>>>
LOCAL.ITEMAMOUNT = <STRARG <ARRAY <DEF.REWARD_BARREL_ITEMS>,<ARGN>>>

IF (<RESOURCETYPE <LOCAL.ITEMDEF>> == RES_ITEMDEF)
	LOCAL.ITEMREWARD = <SERV.ITEMDEF.<LOCAL.ITEMDEF>.TAG0.REWARD>
	
ELSEIF (<RESOURCETYPE <LOCAL.ITEMDEF>> == RES_TEMPLATE)
	LOCAL.ITEMREWARD = <SERV.TEMPLATE.<LOCAL.ITEMDEF>.DESCRIPTION>
ELSE
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300354
	RETURN 1
ENDIF

IF (<DLOCAL.ITEMREWARD> > 0)
	IF (<SRC.TAG0.REWARDCOINS> < <DLOCAL.ITEMREWARD>)
		IF (<RESOURCETYPE <LOCAL.ITEMDEF>> == RES_ITEMDEF)
			SRC.SYSMESSAGELOC <def.tcolor_red>,3300369,<serv.ITEMDEF.<LOCAL.ITEMDEF>.name>,<BolukAyir <DLOCAL.ITEMREWARD>>
		ELSEIF (<RESOURCETYPE <LOCAL.ITEMDEF>> == RES_TEMPLATE)
			SRC.SYSMESSAGELOC <def.tcolor_red>,3300369,<SERV.TEMPLATE.<LOCAL.ITEMDEF>.SUBSECTION>,<BolukAyir <DLOCAL.ITEMREWARD>>
		ELSE
			SRC.SYSMESSAGELOC <def.tcolor_red>,3300354
			RETURN 1
		ENDIF
		DIALOGCLOSE D_REWARD
		DIALOG D_REWARD
		RETURN 1
	ENDIF
ENDIF

SERV.NEWITEM <LOCAL.ITEMDEF>
IF (<RESOURCETYPE <LOCAL.ITEMDEF>> == RES_ITEMDEF)
	IF (<SERV.ITEMDEF.<NEW.BASEID>.CAN>&CAN_I_PILE)
		NEW.AMOUNT=<LOCAL.ITEMAMOUNT>
	ELSE
		IF (<LOCAL.ITEMAMOUNT> > 1)
			NEW.DUPE <EVAL <LOCAL.ITEMAMOUNT>-1>
		ENDIF
	ENDIF
ENDIF

NEW.BOUNCE
NEW.TAG0.Reward_Item=1
SRC.TAG0.REWARDCOINS -=<DLOCAL.ITEMREWARD>
SRC.SOUND 0F7
SRC.LOGGER Hediye stogundan <DLOCAL.ITEMREWARD> bilet karsiliginda <NEW.NAME> isimli esyayi aldi.
SRC.DIALOGCLOSEALL



// Ranger Armor
ON=100 199
LOCAL.BtnID = <EVAL <DARGN>-100>
ARGS=I_Deed_Armor_Studded_Ranger_Reward,I_STUDDED_SLEEVES_RANGER_REWARD,I_STUDDED_GORGET_RANGER_REWARD,I_STUDDED_LEGGINGS_RANGER_REWARD,I_STUDDED_TUNIC_RANGER_REWARD,I_STUDDED_GLOVES_RANGER_REWARD
LOCAL.ITEMDEF=<ARGV<dLOCAL.BtnID>>
LOCAL.ITEMREWARD=<SERV.ITEMDEF.<LOCAL.ITEMDEF>.TAG0.REWARD>

IF (<SRC.dTAG0.REWARDCOINS> < <DLOCAL.ITEMREWARD>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300369,<serv.itemdef.<LOCAL.ITEMDEF>.name>,<BolukAyir <DLOCAL.ITEMREWARD>>
	DIALOGCLOSE D_REWARD
	DIALOG D_REWARD,100
	RETURN 1
ENDIF
SRC.TAG0.REWARDCOINS -=<DLOCAL.ITEMREWARD>

SERV.NEWITEM I_BAG
NEW.BOUNCE
REF1=<NEW.UID>

SERV.NEWITEM <LOCAL.ITEMDEF>,1,<REF1>,1
NEW.TAG0.Reward_Item=1

SRC.SOUND 0F7
SRC.LOGGER Hediye stogundan <DLOCAL.REWARD> bilet karsiliginda <NEW.NAME> isimli esyayi aldi.
SRC.DIALOGCLOSEALL



// Phoenix Armor
ON=200 299
LOCAL.BtnID = <EVAL <DARGN>-200>
ARGS=I_Deed_Armor_Phoenix_Reward,I_PHOENIX_LEGGINGS_REWARD,I_PHOENIX_GLOVES_REWARD,I_PHOENIX_SLEEVES_REWARD,I_PHOENIX_TUNIC_REWARD,I_PHOENIX_GORGET_REWARD,I_PHOENIX_HELM_REWARD
LOCAL.ITEMDEF=<ARGV<dLOCAL.BtnID>>
LOCAL.ITEMREWARD=<SERV.ITEMDEF.<LOCAL.ITEMDEF>.TAG0.REWARD>

IF (<SRC.dTAG0.REWARDCOINS> < <DLOCAL.ITEMREWARD>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300369,<serv.itemdef.<LOCAL.ITEMDEF>.name>,<BolukAyir <DLOCAL.ITEMREWARD>>
	DIALOGCLOSE D_REWARD
	DIALOG D_REWARD,101
	RETURN 1
ENDIF

SRC.TAG0.REWARDCOINS -=<DLOCAL.ITEMREWARD>

SERV.NEWITEM I_BAG
NEW.BOUNCE
REF1=<NEW.UID>

SERV.NEWITEM <LOCAL.ITEMDEF>,1,<REF1>,1
NEW.TAG0.Reward_Item=1

SRC.SOUND 0F7
SRC.LOGGER Hediye stogundan <DLOCAL.REWARD> bilet karsiliginda <NEW.NAME> isimli esyayi aldi.
SRC.DIALOGCLOSEALL





// Stoklari bilete cevir
ON=999
IF (<SRC.TAG0.REWARDCOINS> >= 65000)
	SERV.NEWITEM I_REWARD_COIN,65000,<SRC>,1
	SRC.TAG0.REWARDCOINS -=65000
	SDIALOG d_REWARD
ELSE
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300370
ENDIF
RETURN 1



// Bileti stoga cevir
ON=998
MORE 2
TARGET
SRC.SYSMESSAGELOC <def.tcolor_text>,3300365
RETURN 1


// Cope At
ON=997
MORE 1
TARGET
SRC.SYSMESSAGELOC <def.tcolor_text>,3300371
RETURN 1


// Toplu Cope At
ON=996
RETURN 1
REF1=<SRC.FINDLAYER.21>
FORCONT <REF1> 0 

	IF (<TAG0.ShopItem>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300372,<NAME>
		CONTINUE
	ENDIF
	IF (<ISWEAPON>)	
		IF !(<ATTR>&ATTR_MAGIC)
			SRC.SYSMESSAGELOC <def.tcolor_red>,3300373,<NAME>
			CONTINUE
		ENDIF	
	ELSEIF (<ISARMOR>)	
		IF !(<ATTR>&ATTR_MAGIC || <SERV.ITEMDEF.<BASEID>.Tag0.ColoredArmorPart>)
			SRC.SYSMESSAGELOC <def.tcolor_red>,3300374,<NAME>
			CONTINUE
		ENDIF	
	ELSE
		IF (<IsRewardAllowItem> == 0)
			SRC.SYSMESSAGELOC <def.tcolor_red>,3300375,<NAME>
			CONTINUE
		ENDIF
	ENDIF
	
	LOCAL.VALUE <EVAL (<VALUE>*<AMOUNT>)>
	LOCAL.REWARD = <EVAL <DLOCAL.VALUE>/4>
	IF !(<LOCAL.VALUE>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300376,<NAME>
		CONTINUE
	ELSEIF !(<DLOCAL.REWARD>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300377,<NAME>
		CONTINUE
	ELSE
		SRC.TAG0.REWARDCOINS +=<DLOCAL.REWARD> // value değerinin yarısı kadar reward coin ver.
		SRC.SYSMESSAGELOC <def.tcolor_green>,3300378,<AMOUNT>,<NAME>,<BolukAyir <DLOCAL.REWARD>>
		SRC.LOGGER <amount> <NAME> [<uid>] isimli esya <BolukAyir <DLOCAL.REWARD>> reward coin kazandirdi.
		UPDATE
		REMOVE
	ENDIF	
ENDFOR




