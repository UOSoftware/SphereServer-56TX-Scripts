
[DEFNAME DEF_MOONGATES]

MOONGATE_MOONGATES A_MOONGLOW_MOONGATE_1,A_BRITAIN_MOONGATE_1,A_JHELOM_MOONGATE_1,A_YEW_MOONGATE_1,A_MINOC_VESPER_MOONGATE_1,A_TRINSIC_MOONGATE_1,A_SKARA_BRAE_MOONGATE_1,A_MAGINCIA_MOONGATE_1


MOONGATE_CITYS A_TOWNBRITAIN,A_TOWNMINOC,A_TOWNVESPER,A_TOWNMOONGLOW,A_TOWNYEW,A_TOWNMAGINCIA,A_TOWNSKARABRAE,A_TOWNJHELOM,A_TOWNTRINSIC,A_TOWNNUJELM,A_TOWNBUCSDEN,A_TOWNWIND,A_TOWNOCCLO,A_TOWNCOVE
MOONGATE_DUNGEONS A_DECEIT_LEVEL_1,A_DECEIT_LEVEL_2,A_DECEIT_LEVEL_3,A_DECEIT_LEVEL_4,A_FIRE_DUNGEON_LEVEL_1,A_FIRE_DUNGEON_LEVEL_2,A_ICE_DUNGEON_LEVEL_1,A_ICE_DUNGEON_LEVEL_2,A_ICE_DUNGEON_LEVEL_3,A_DESTARD_LEVEL_1,A_DESTARD_LEVEL_2,A_DESTARD_LEVEL_3,A_DESPISE_LEVEL_1,A_DESPISE_LEVEL_2,A_DESPISE_LEVEL_3,A_DESPISE_LEVEL_4,A_WRONG_LEVEL_1,A_WRONG_LEVEL_2,A_WRONG_LEVEL_3,A_SHAME_LEVEL_1,A_SHAME_LEVEL_2,A_SHAME_LEVEL_3,A_SHAME_LEVEL_4,A_SHAME_LEVEL_5,A_COVETOUS_LEVEL_1,A_COVETOUS_LEVEL_2,A_COVETOUS_LEVEL_3,A_COVETOUS_LEVEL_4,A_COVETOUS_LEVEL_5,A_HYTHLOTH_LEVEL_1,A_HYTHLOTH_LEVEL_2,A_HYTHLOTH_LEVEL_3,A_HYTHLOTH_LEVEL_4,A_TERATHAN_KEEP,A_ICE_ISLE
MOONGATE_GRAVEYARDS A_BRITAIN_GRAVEYARD,A_VESPER_GRAVEYARD,A_MOONGLOW_GRAVEYARD,A_YEW_GRAVEYARD,A_JHELOM_GRAVEYARD,A_NUJELM_GRAVEYARD,A_COVE_GRAVEYARD
MOONGATE_CAVES A_MT_KENDALL,A_MINOC_CAVE1,A_MINOC_CAVE2,A_MINOC_CAVE3,A_CAVE1,A_CAVE2,A_CAVE3
 
[ITEMDEF I_MEM_MOONGATER]
DEFNAME=I_MEM_MOONGATER
NAME=Moongater Memory
ID=I_HANDR_1
TYPE=T_EQ_SCRIPT
WEIGHT=0
LAYER=LAYER_SPECIAL

ON=@CREATE
ATTR=ATTR_INVIS|ATTR_CAN_DECAY

On=@Equip
timer 30
src.dialog d_facet_moongate
	
On=@Timer
remove
return 1

[TYPEDEF t_facet_moongate]
On=@Step
IF !((<SRC.FINDID.I_MEM_MOONGATER>) || (<SRC.FLAGS>&STATF_STONE))
	SRC.NEWITEM I_MEM_MOONGATER
	NEW.LINK <UID>
	SRC.EQUIP <NEW>
ENDIF
RETURN 0

ON=@DCLICK
IF !(<SRC.FLAGS>&STATF_STONE)
	IF (<DISTANCE> > 3)
		SRC.SYSMESSAGE Gate'e ulasamiyorsunuz.
	ELSE
		IF (<SRC.FINDID.I_MOONGATER>)
			SRC.FINDID.I_MOONGATER.REMOVE
		ENDIF
		SERV.NEWITEM I_MOONGATER
		NEW.LINK <UID>
		SRC.EQUIP <NEW>
	ENDIF
ENDIF
RETURN 1


// ON=@DCLICK
// DISPID=<SERV.ITEMDEF.<BASEID>.ID>
// ATTR=ATTR_STATIC|ATTR_MOVE_NEVER
// IF (<SRC.ISPOISONED>)
	// SRC.SYSMESSAGELOC <def.tcolor_red>,600031 // Zehirli durumdayken bu işlemi yapamazsınız.
	// RETURN 1
// ELSEIF (<SRC.IsNoFullHp>)
	// SRC.SYSMESSAGELOC <def.tcolor_red>,600075 // "Yaralı durumdayken bu işlemi yapamazsınız."
	// RETURN 1
// ELSEIF (<SRC.IsInHouse>)
	// SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ev içindeyken kullanamazsınız.
	// RETURN 1
// ENDIF
// SRC.CTAG0.MOONGATE=<UID>
// DIALOGCLOSE d_facet_moongate
// DIALOG d_facet_moongate
// RETURN 1

ON=@CLICK
ATTR=ATTR_STATIC|ATTR_MOVE_NEVER
MESSAGE a Moongate
IF !(<REGION.SAFE>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Geçişlerin etrafını herhangi bir şekilde kapatmak ihlal ve sabote etmek Alan İhlali suçudur.
ENDIF
RETURN 1


[ITEMDEF I_MOONGATE_FACET]
DEFNAME=I_MOONGATE_FACET
DEFNAME2=I_MOONGATE
ID=I_MOONGATE_BLUE
TYPE=t_facet_moongate
NAME=Moongate

ON=@CREATE
ATTR=ATTR_STATIC|ATTR_MOVE_NEVER
TYPE=t_facet_moongate
COLOR=0


[DIALOG d_facet_moongate]
<DEF.DSP>
NOMOVE
SRC.DIALOGCLOSEALL
RESIZE 0,0,180,250,<STRTOUPPER <SERV.NAME>> MOONGATE
 
DORIGIN 20 20
FOR 1 <ARRAYCOUNT <DEF.MOONGATE_MOONGATES>>
	LOCAL.MOONGATE <SERV.AREA.<ARRAY <DEF.MOONGATE_MOONGATES>,<DLOCAL._FOR>>.NAME>
	BUTTON +10 <eval (<dLOCAL._FOR>*21)+30> 2714 2715 1 0 <DLOCAL._FOR>
	DHTMLGUMP +30 <eval (<dLOCAL._FOR>*21)+30> 150 25 0 0 <StrArg <LOCAL.MOONGATE>>
ENDFOR


[DIALOG d_facet_moongate BUTTON]
ON 1 99
REF1=<SRC.CTAG0.MOONGATE> // Moongate
IF !(<REF1.ISVALIDE>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Moongate bulunamadı!
	RETURN 1
ELSEIF (<SRC.ISOUTOFREACH 3,<REF1>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600018,<REF1>
	RETURN 1
ELSEIF (<SRC.ISPOISONED>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600031 // Zehirli durumdayken bu işlemi yapamazsınız.
	RETURN 1
ELSEIF (<SRC.IsNoFullHp>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600075 // "Yaralı durumdayken bu işlemi yapamazsınız."
	RETURN 1
ELSEIF (<SRC.IsInHouse>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ev içindeyken kullanamazsınız.
	RETURN 1
ELSEIF !(<SRC.ISNEARTYPE T_MOONGATE_CUSTOM 4>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Yakınlarınızda Moongate bulunmuyor.
	RETURN 1
ENDIF
LOCAL.P <SERV.AREA.<ARRAY <DEF.MOONGATE_MOONGATES>,<DARGN>>.P>
IF (<SRC.ACTION> != -1)
	SRC.SKILL FAIL
ENDIF
SRC.TARGETCLOSE
SRC.GO <LOCAL.P>
SRC.DIALOGCLOSEALL
SRC.MOVENAR <REF1> <R1,3>



[TYPEDEF T_MOONGATE]
ON=@STEP
SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, <name> Bu eşya kullanılmamaktadır.
RETURN 1

ON=@DCLICK
SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, <name> Bu eşya kullanılmamaktadır.
RETURN 1



[EOF]
