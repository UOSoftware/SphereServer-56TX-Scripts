[TYPEDEF T_REAGENT_CRYSTAL]

ON=@Click
ATTR=ATTR_NEWBIE
LOCAL.AMOUNT = <DTAG0.REAGENT_AMOUNT>

IF (<LOCAL.AMOUNT> == 30)
	MESSAGELOC 0,3301073,<DLOCAL.AMOUNT>

ELSEIF (<LOCAL.AMOUNT> == 60)
	MESSAGELOC 0,3301074,<DLOCAL.AMOUNT>

ELSEIF (<LOCAL.AMOUNT> == 90)
	MESSAGELOC 0,3301075,<DLOCAL.AMOUNT>
ENDIF
RETURN 1

ON=@DClick
ATTR=ATTR_NEWBIE
LOCAL.AMOUNT = <DTAG0.REAGENT_AMOUNT>
LOCAL.REAGENTS <DEF.RESOURCE_<TAG0.REAGENT_TYPE>_REAGENTS>

// IF !(<SRC.ISINPACK <UID>>)
IF !(1 == 1)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600036,<NAME>	// Bunu (~1_val~) kullanabilmek için çantanızda veya üzerinizde olmalıdır.
	RETURN 1

ELSEIF (<DLOCAL.AMOUNT> <= 0)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300359
	RETURN 1

ELSEIF !(<EVAL STRLEN(<LOCAL.REAGENTS>)>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300360
	RETURN 1
ENDIF

// FOR 1 <ARRAYCOUNT <LOCAL.REAGENTS>>
	// LOCAL.REAGENT <ARRAY <LOCAL.REAGENTS>,<DLOCAL._FOR>>
	// SERV.B <LOCAL.REAGENT> = <SERV.ITEMDEF.<LOCAL.REAGENT>.WEIGHT>
	// LOCAL.ReglerinToplamAgirligi +=<SERV.ITEMDEF.<LOCAL.REAGENT>.WEIGHT>
// ENDFOR

// SERV.B <LOCAL.ReglerinToplamAgirligi>
// IF (<SRC.WEIGHT> >= <SRC.MAXWEIGHT>)
	// SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ağırlığınız maksimum seviyeye ulaştığı için bunu kullanamazsınız.
	// RETURN 1
// ENDIF

FOR 1 <ARRAYCOUNT <LOCAL.REAGENTS>>
	LOCAL.REAGENT <ARRAY <LOCAL.REAGENTS>,<DLOCAL._FOR>>
	SERV.NEWITEM <LOCAL.REAGENT>,<DLOCAL.AMOUNT>,<SRC>
	NEW.AMOUNT <DLOCAL.AMOUNT>
	NEW.CONT = <SRC.FINDLAYER.21>
	NEW.BOUNCE
	NEW.CONTP <CONTP> // Bad CONTP usage (item is not in a container) hatasi veriyor.
ENDFOR

IF (<SRC.ACTION> != Magery)
	IF (<DLOCAL.AMOUNT> == 30)
		SRC.EMOTELOC 0,3301076
	ELSEIF (<DLOCAL.AMOUNT> == 60)
		src.EMOTELOC 0,3301077
	ELSEIF (<DLOCAL.AMOUNT> == 90)
		SRC.EMOTELOC 0,3301078
	ELSEIF (<DLOCAL.AMOUNT> == 120)
		SRC.EMOTELOC 0,3301078
	ELSE
		SRC.EMOTELOC 0,3301079
	ENDIF
ENDIF

REMOVE
RETURN 1


[eof]
