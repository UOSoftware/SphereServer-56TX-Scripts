

[ITEMDEF I_FISHING_NET_GREEN]
DEFNAME=I_FISHING_NET_GREEN
ID=I_FISHING_NET_3
VALUE=500
WEIGHT=2
NAME=special fishing net
RESOURCES=10 I_ROPE, 10 I_THREAD, 4 I_SHELL
CATEGORY=Items by Professions
SUBSECTION=Fisherman
DESCRIPTION=Fishing Net

ON=@CREATE
ATTR=ATTR_DECAY
COLOR=color_o_verite
MORE1=1000

on=@DClick
IF !(<MORE1> == 1000)
	MESSAGELOC 0,3301065
	RETURN 1

ELSEIF (<SRC.FISHING> < 90.0)
	SRC.SYSMESSAGELOC 0,3300333
	RETURN 1
	
ELSEIF !(<SRC.REGION.FLAGS>&region_flag_ship)
	SRC.SYSMESSAGELOC 0,3300334
	RETURN 1
	
ELSEIF !(<REGION.FLAGS>&region_flag_ship)
	SRC.SYSMESSAGELOC 0,3300334
	RETURN 1
	
ELSEIF (<src.uid> == <cont.cont.uid>) 
	DROP
	
	SRC.SAYLOC 0,3301066
	MORE1=100
	
	SERV.NEWITEM i_fishnet_spawner
	NEW.MORE1={6 8}
	NEW.TIMER={3 5}
	NEW.MOREP=<SRC.P>
	SRC.EQUIP <NEW>
	
	ATTR=ATTR_MOVE_NEVER|ATTR_DECAY
	TIMER = <EVAL (<SRC.FINDID.I_FISHNET_SPAWNER.MORE1> * <SRC.FINDID.I_FISHNET_SPAWNER.TIMER>)>
	RETURN 1
ENDIF

RETURN 1

ON=@TIMER
ATTR ATTR_DECAY
REMOVE
RETURN 1

[ITEMDEF I_FISHNET_SPAWNER]
DEFNAME=I_FISHNET_SPAWNER
NAME=Fishnet Spawner Memory
ID=I_GOLD
TYPE=T_EQ_SCRIPT
WEIGHT=0
LAYER=LAYER_SPECIAL

ON=@CREATE
ATTR=ATTR_INVIS|ATTR_DECAY

ON=@EQUIP
TIMER={3 5}

ON=@TIMER
IF (<CONT>)

	IF !(<MORE1> = 0)
		MORE1 -=1
		SERV.NEWITEM { I_FISH_BIG_1 1 I_FISH_BIG_2 1 I_FISH_BIG_3 1 I_FISH_BIG_4 1 }
		NEW.P = <MOREP>
		NEW.AMOUNT = {10 12}
		NEW.UPDATE
		TIMER = 1
		RETURN 1
		
	ELSEIF (<MORE1> = 0)
		IF (RAND(10) == 1)
		
			IF (RAND(5) == 1)
				SERV.NEWNPC C_DOLPHIN
			ELSE
				SERV.NEWNPC C_SEA_SERPENT
			ENDIF
			NEW.P <MOREP>
			NEW.MOVE 12
			REF1=<NEW.UID>
			
			SERV.NEWITEM I_SEDO_REMOVE
			NEW.CONT <REF1>
			NEW.TIMER 300
			
			CONT.sysmessageloc 0,3300335
		ENDIF
		REMOVE
		RETURN 1
	ENDIF
	
ENDIF
REMOVE
RETURN 1


[ITEMDEF I_SEDO_REMOVE]
DEFNAME=I_SEDO_REMOVE
ID=I_MEMORY
TYPE=T_EQ_SCRIPT
Name=Serpent & Dolphin Remove Memory

ON=@CREATE
ATTR=ATTR_DECAY
TIMER=300

ON=@EQUIP
TIMER=300

ON=@TIMER
IF !(<MORE2>)
	CONT.FLAGS <CONT.FLAGS>|04
	CONT.ANIM 4
	CONT.SAYLOC 0,3301067
	MORE2 1
	TIMER 4
ELSE
	CONT.REMOVE
ENDIF
RETURN 1
	
[EOF]
