[ITEMDEF i_map_local]
ID=014eb
NAME=local map
TYPE=t_map
VALUE=3
RESOURCES=1 i_map_blank
SKILLMAKE=Cartography 0.0
CATEGORY=Maps
SUBSECTION=
DESCRIPTION=

ON=@Create
IF (<SRC>)
 LOCAL.Radius=<eval 64+((<SRC.CARTOGRAPHY>*2)/10)>
 MORE1=<eval ((<SRC.P.X>-<LOCAL.Radius>)*010000)+(<SRC.P.Y>-<LOCAL.Radius>)>
 MORE2=<eval ((<SRC.P.X>+<LOCAL.Radius>)*010000)+(<SRC.P.Y>+<LOCAL.Radius>)>
ENDIF


[ITEMDEF i_map_city]
ID=014eb
NAME=city map
TYPE=t_map
VALUE=3
RESOURCES=1 i_map_blank
SKILLMAKE=Cartography 25.0
CATEGORY=Maps
SUBSECTION=
DESCRIPTION=

ON=@Create
IF (<SRC>)
LOCAL.Radius=<eval 64+((<SRC.CARTOGRAPHY>*4)/10)>
IF (<LOCAL.Radius> < 200)
LOCAL.Radius=200
ENDIF
MORE1=<eval ((<SRC.P.X>-<LOCAL.Radius>)*010000)+(<SRC.P.Y>-<LOCAL.Radius>)>
MORE2=<eval ((<SRC.P.X>+<LOCAL.Radius>)*010000)+(<SRC.P.Y>+<LOCAL.Radius>)>
ENDIF


[ITEMDEF i_map_sea_chart]
ID=014eb
NAME=sea chart map
TYPE=t_map
VALUE=3
RESOURCES=1 i_map_blank
SKILLMAKE=Cartography 35.0
CATEGORY=Maps
SUBSECTION=
DESCRIPTION=

ON=@Create
IF (<SRC>)
LOCAL.Radius=<eval 64+<SRC.CARTOGRAPHY>>
IF (<LOCAL.Radius> < 200)
LOCAL.Radius=200
ENDIF
MORE1=<eval ((<SRC.P.X>-<LOCAL.Radius>)*010000)+(<SRC.P.Y>-<LOCAL.Radius>)>
MORE2=<eval ((<SRC.P.X>+<LOCAL.Radius>)*010000)+(<SRC.P.Y>+<LOCAL.Radius>)>
ENDIF


[ITEMDEF i_map_world]
