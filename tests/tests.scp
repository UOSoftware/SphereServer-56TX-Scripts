[function WorldSearchChar]
// args = <qval <isnum <args>> ? <args> : <resourceindex <args>>>
// IF !(<RESOURCETYPE <ARGS>> == RES_CHARDEF)
	// SYSMESSAGE Bulunamadi.
	// RETURN 1
// ENDIF
FOR 0 <EVAL <SERV.DEFLIST.CHARDEF.COUNT>-1>
	LOCAL.ITEM=<SERV.DEFLIST.CHARDEF.<DLOCAL._FOR>>
	IF (<LOCAL.ITEM>)	
		FORINSTANCES <LOCAL.ITEM>
			IF (<TAG0.testchar>)
				SERV.log Buldu: <UID>
			ENDIF
		ENDFOR
	ENDIF
ENDFOR


[FUNCTION WorldSearchItem]
// args = <qval <isnum <args>> ? <args> : <resourceindex <args>>>
// IF !(<RESOURCETYPE <ARGS>> == RES_ITEMDEF)
	// SYSMESSAGE Bulunamadi.
	// RETURN 1
// ENDIF
FOR 0 <EVAL <SERV.DEFLIST.ITEMDEF.COUNT>-1>
	LOCAL.ITEM=<SERV.DEFLIST.ITEMDEF.<DLOCAL._FOR>>
	IF (<LOCAL.ITEM>)	
		FORINSTANCES <LOCAL.ITEM>
			IF (<TAG0.testitem>)
				SERV.log Found: <UID>
				break
			ENDIF
		ENDFOR
	ENDIF
ENDFOR




[FUNCTION Fight_GetWeaponSkillID]
REF1=<WEAPON>
IF !(<REF1.ISVALID>)
	RETURN 43
ENDIF
RETURN <REF1.Weapon_GetSkillID>

[FUNCTION Weapon_GetSkillID]
LOCAL.iSkillOverride = <TAG0.OVERRIDE_SKILL>
if (<LOCAL.iSkillOverride> == -1)
	LOCAL.iSkillOverride = <TAG0.OVERRIDE.SKILL>
endif
if ( (<LOCAL.iSkillOverride> > -1) && (<LOCAL.iSkillOverride> < 64) )
	local.skill <LOCAL.iSkillOverride>
endif
if ( (<Skill> > -1) && (<Skill> < 64) )
	local.skill <skill>
endif
if (<type> == T_WEAPON_MACE_CROOK)
	local.skill 41
elseif (<type> == T_WEAPON_MACE_PICK) 
	local.skill 41
elseif (<type> == T_WEAPON_MACE_SMITH) 
	local.skill 41
elseif (<type> == T_WEAPON_MACE_STAFF) 
	local.skill 41
elseif (<type> == T_WEAPON_MACE_SHARP) 
	local.skill 41
elseif (<type> == T_WEAPON_WHIP) 
	local.skill 41
	
elseif (<type> == T_WEAPON_SWORD) 
	local.skill 40
	
elseif (<type> == T_WEAPON_AXE) 
	local.skill 40
	
elseif (<type> == T_WEAPON_FENCE) 
	local.skill 42
	
elseif (<type> == T_WEAPON_BOW) 
	local.skill 31
	
elseif (<type> == T_WEAPON_XBOW) 
	local.skill 31
	
elseif (<type> == T_WEAPON_THROWING) 
	local.skill 57
else
	local.skill 43
endif

return <dlocal.skill>






[FUNCTION Fight_GetWeaponSkill]
REF1=<WEAPON>
IF !(<REF1.ISVALID>)
	RETURN SKILL_WRESTLING
ENDIF
RETURN <REF1.Weapon_GetSkill>




[FUNCTION Weapon_GetSkill]
LOCAL.iSkillOverride = <TAG0.OVERRIDE_SKILL>

if (<LOCAL.iSkillOverride> == -1)
	LOCAL.iSkillOverride = <TAG0.OVERRIDE.SKILL>
endif

if ( (<LOCAL.iSkillOverride> > -1) && (<LOCAL.iSkillOverride> < 64) )
	local.skill <LOCAL.iSkillOverride>
endif

if ( (<Skill> > -1) && (<Skill> < 64) )
	local.skill <skill>
endif

if (<type> == T_WEAPON_MACE_CROOK)
	local.skill SKILL_MACEFIGHTING
elseif (<type> == T_WEAPON_MACE_PICK) 
	local.skill SKILL_MACEFIGHTING
elseif (<type> == T_WEAPON_MACE_SMITH) 
	local.skill SKILL_MACEFIGHTING
elseif (<type> == T_WEAPON_MACE_STAFF) 
	local.skill SKILL_MACEFIGHTING
elseif (<type> == T_WEAPON_MACE_SHARP) 
	local.skill SKILL_MACEFIGHTING
elseif (<type> == T_WEAPON_WHIP) 
	local.skill SKILL_MACEFIGHTING
	
elseif (<type> == T_WEAPON_SWORD) 
	local.skill SKILL_SWORDSMANSHIP
	
elseif (<type> == T_WEAPON_AXE) 
	local.skill SKILL_SWORDSMANSHIP
	
elseif (<type> == T_WEAPON_FENCE) 
	local.skill SKILL_FENCING
	
elseif (<type> == T_WEAPON_BOW) 
	local.skill SKILL_ARCHERY
	
elseif (<type> == T_WEAPON_XBOW) 
	local.skill SKILL_ARCHERY
	
elseif (<type> == T_WEAPON_THROWING) 
	local.skill SKILL_THROWING
else
	local.skill SKILL_WRESTLING
endif

return <local.skill>


