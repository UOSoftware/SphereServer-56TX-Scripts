[SKILL 35]
DEFNAME=Skill_Taming
KEY=Taming
TITLE=Animal Tamer
PROMPT_MSG=Tame which animal?
DELAY=2.0
STAT_STR=30
STAT_DEX=60
STAT_INT=40
BONUS_STR=30
BONUS_DEX=10
BONUS_INT=60
BONUS_STATS=20
ADV_RATE=10.0,200.0,800.0
RANGE=3

ON=@Fail
SRC.SYSMESSAGELOC <def.tcolor_red>,3300060

ON=@Abort
SRC.SYSMESSAGELOC <def.tcolor_red>,3300061

ON=@Select
IF !(<SRC.FINDID.I_STAFF_TAMING>)
SRC.SYSMESSAGELOC <def.tcolor_red>,3300062
RETURN 1
ENDIF
REF1=<SRC.FINDID.I_STAFF_TAMING>
IF (<SRC.ACTION> == SKILL_TAMING)
SRC.SYSMESSAGELOC <def.tcolor_red>,3300063
RETURN 1
ENDIF

// OVERRIDE.STROKECOUNT
ON=@Start
IF !(<SRC.FINDID.I_STAFF_TAMING>)
SRC.SYSMESSAGELOC <def.tcolor_red>,3300062
RETURN 1
ENDIF
REF1=<SRC.FINDID.I_STAFF_TAMING>

IF !(<ACT.NPC> == BRAIN_ANIMAL)
SRC.SYSMESSAGELOC <def.tcolor_red>,3300064
RETURN 1

ELSEIF (<ACT.TAG0.TAMER> == <SRC>) 
SRC.SYSMESSAGELOC <def.tcolor_red>,3300065
RETURN 1

ELSEIF (<ACT.MEMORYFINDTYPE.MEMORY_FIGHT>)
IF (<ACT.MEMORYFINDTYPE.MEMORY_FIGHT.LINK> == <SRC>)
SRC.SYSMESSAGELOC <def.tcolor_red>,3300066
RETURN 1
ENDIF
ENDIF
IF (<REF1>) && (<REF1.TOPOBJ> != <SRC>)
SRC.EQUIP <REF1>
ENDIF

ON=@Stroke
serv.b tame stroke


ON=@Success
IF !(<SRC.FINDID.I_STAFF_TAMING>)
SRC.SYSMESSAGELOC <def.tcolor_red>,3300062
RETURN 1
ENDIF
IF !(<ACT.TAG0.TAMER>)
ACT.TAG0.TAMER=<SRC>
ENDIF

