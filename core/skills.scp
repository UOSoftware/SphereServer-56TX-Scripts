VERSION=0.56T

[ADVANCE]
// Generic advance rates for stats
STR=10000,4000,600
INT=10000,4000,600
DEX=10000,4000,600

[COMMENT]
// old ph system
// 10.0 successes at 0% to gain .1,
// 800.0 successes at 100% to gain .1,
// 200.0 successes at 50% to gain .1
ADV_RATE=2.5,50.0,200.0
// new ph system
// SKILL_GAIN_RANGE=0.0,10.0,80.0
// SKILL_GAIN_RANGE=10.0,30.0,50.0
// SKILL_GAIN_RANGE=30.0,100.0,5.0
GAINRADIUS=100.0
// Skillgain will only be calculated if the current skill is less than the
// actual difficulty + GAINRADIUS.  Used to prohibit skillgain by
// performing way too easy tasks.  Set to 100.0 for original behaviour.
VALUES=0,100
// The amount of value an item created with the skill gets at skill levels.
EFFECT=0,100
// Healing: Effect of bandages
// 56TX: BandageMode=0'da (gömülü bandaj) bandajın canı EFFECT'ten değil emulatörün hesabından (@Start'ta LOCAL.Effect).
// Crafting Skills: Percentage of resources lost on failure.
FREEZE_TIME=0
// 56TX: skill başlayınca karakterin kıpırdayamadığı süre (saniye; büyünün FREEZE_TIME'ı gibi, skill'e göre
//  değer verilebilir). Skill bitince ya da kesilince donma da biter. @Start'ta LOCAL.FreezeTime.
COOLDOWN=8.0
COOLDOWN_OTHER=4.0
// 56TX: BandageMode=0'da Healing ve Veterinary'de bandaj bittikten sonra yenisine kadar bekleme (saniye): COOLDOWN
//  kendine, COOLDOWN_OTHER başkasına ve hayvana (yoksa COOLDOWN). Yazılmazsa emulatörün değeri: 8 ve 4 saniye.
//  @Start'ta LOCAL.Cooldown; DEX LOCAL.LowDex'in (35) altındaysa LOCAL.LowDexPercent kadar (kendine 175, başkasına
//  150: 8 -> 14, 4 -> 6 saniye) uzar.
STAT_STR=80
// You will tend toward these stat vals if you use this skill a lot.
BONUS_STATS=10
// What percent of the skill success is based on stat levels. = 10%.
BONUS_STR=80
// % of each stat toward success at skill.

