[FUNCTION f_axis_preload]
// This function is called every time someone connects from Axis to retrieve information.
// Variables:
//	LOCAL.Account --> Account name connecting
//	LOCAL.IP      --> IP address connecting
// Return:
//	0 --> Deny access without send deny message
//	1 --> Deny access and send deny message
//	2 --> Allow access (default action)
SERV.LOGGER f_axis_preload: Giris reddedildi. Account=<LOCAL.Account>, IP=<LOCAL.IP>
RETURN 1



[FUNCTION f_onclient_exceed_network_quota]
// This function is called after a client exceeded its in/out network traffic quota.
// Variables:
//	LOCAL.Account --> Account name connecting ("NA" if no account attached)
//	LOCAL.IP      --> IP address connecting
//      SRC --> Client Object
//      ARGN1 --> (1: output quota; 2: input quota)
//      ARGN2 --> bytes sent/received
//      ARGN3 --> maximum bytes allowed to be sent/received (quota)
// Return:
//    0 --> Ignore this, stop hardcoded behavior but generate a log message
//    1 --> Ignore this, stop hardcoded behavior and do not generate a log message
//    2 --> Disconnect client and generate log message (default behavior)
SERV.LOGGER Exceed Network Quota : Char:<SRC.NAME>[<SRC>] Account:<local.account> IP:<local.ip> Info: (<ARGN1>)<ARGN2> [<ARGN3>]
// RETURN 2





[FUNCTION f_onaccount_connect]
// This function is called when an client connect on server, before password checks.
// Variables:
//	LOCAL.Account  --> Account name given
//	LOCAL.Password --> Password given
// Return:
//	0 --> Use internal password checks (default action)
//	1 --> Disconnect client assuming the given password is wrong
//	6 --> Skip internal password checks (password checks must be done manually on scripts)
// SERV.LOG f_onaccount_connect: <LOCAL.ACCOUNT>


[FUNCTION f_onaccount_login]
// This function is called after client entered correct password.
// Variables:
//	ARGS  --> Account name connecting
//	ARGO  --> Client connecting
//  ARGN1 --> Login type (3: UO client connected to login server, 4: client connected to game server,
//				5: HTTP, 6: telnet, 7: UOG, 8: Axis)
// ARGN2 = denied packet number
// Return:
//	0 --> Allow connection (default action)
//	1 --> Deny connection
// LOCAL.ACCOUNT=<ARGS>
// SERV.LOG f_onaccount_login: <LOCAL.ACCOUNT> (<ARGN1>)

// Hesaptaki karakterlerin paperdoll bilgilerini cliente gonderir. (Deneysel)
IF (<dARGN1> == 3)
	FOR c 0 <eval <serv.account.<args>.chars>-1>
		ref99=<serv.account.<args>.char.<dlocal.c>>
		IF (<ref99>)
			LOCAL.ITEMDATA =
			LOCAL.LAYERS = 0
			FOR l 0 24
				REF1=<ref99.FINDLAYER.<DLOCAL.l>>
				IF (<REF1.ISVALID>)
					LOCAL.ITEMDATA .= " W<REF1.ID>"
					LOCAL.ITEMDATA .= " W<REF1.COLOR>"
					LOCAL.ITEMDATA .= " B<DLOCAL.l>"
					LOCAL.LAYERS += 1
				ENDIF
			ENDFOR
			// chra bilgilerini hazırla
			LOCAL.BODYHUE = <REF99.COLOR>
			LOCAL.ISFEMALE = <QVAL (<REF99.ID> == C_MAN)?0:1>
			LOCAL.BODYGRAPHIC = <REF99.BODY>
			LOCAL.NAMECOLOR = 044
			// Paket uzunluğu:
			// 1 (layers) + 2 (body graphic) + 2 (body hue) + 1 (isfemale) + 30 (name) + (5 * N items)
			LOCAL.LEN = 13 + 30 + (<dLOCAL.LAYERS> * 5)
			LOCAL.PACKET = 0BF
			LOCAL.PACKET .= " W<dLOCAL.LEN>"
			LOCAL.PACKET .= " W02725"
			// Header BODYPACKET
			LOCAL.PACKET .= " B<dLOCAL.LAYERS>"           // byte: kaç item
			LOCAL.PACKET .= " W<dLOCAL.BODYGRAPHIC>"      // ushort: body graphic (0x0190 = male)
			LOCAL.PACKET .= " W<dLOCAL.BODYHUE>"          // ushort: hue
			LOCAL.PACKET .= " B<dLOCAL.ISFEMALE>"         // byte: 0 = male, 1 = female
			LOCAL.PACKET .= " W<dLOCAL.NAMECOLOR>"          // ushort: NAMECOLOR
			LOCAL.PACKET .= " <ASCPAD 30,<REF99.NAME>>"   // 30 byte: name padded
			LOCAL.PACKET .= <LOCAL.ITEMDATA>
			ARGO.SENDPACKET <LOCAL.PACKET>
		ENDIF
	ENDFOR
ENDIF


IF (<dARGN1> == 4)
    LOCAL.TIME = <SERV.TIME>
    LOCAL.HASH = "<VAR0.uosoft_client.security_verifykey1_onaccount_login_prefix><STRTOUPPER <MD5HASH <DLOCAL.TIME>>>"
    LOCAL.HASH = Z<STRTOUPPER <MD5HASH <LOCAL.HASH>>>
    SERV.ACCOUNT.<ARGS>.TAG0.UOSOFT_CLIENT_VERIFY_0x12.Hash <LOCAL.HASH>
    SERV.ACCOUNT.<ARGS>.TAG0.UOSOFT_CLIENT_VERIFY_0x12.Time <LOCAL.TIME>
    ARGO.SENDPACKET 012 000 00D 0FF 000 000 000 007 D<LOCAL.TIME> 000
ENDIF



// 1. Dogrulama
// 0xA4 paketinden gelen dogrulama
IF (<SERV.ACCOUNT.<args>>)
	LOCAL.MsgDetail (0xA4) [Account=<ARGS>]
	
	IF !(<SERV.ACCOUNT.<ARGS>.dTAG0.UOSOFT_CLIENT_VERIFY_MUAF>)
	
		IF (<ARGN1> == 3)
			SERV.ACCOUNT <ARGS> TAG0.UOSOFT_CLIENT_VERIFY_0xA4.Hash=
		ENDIF
		
		IF (<ARGN1> == 4)
			LOCAL.Plain = MD5_<STRTOUPPER <ARGS>>_<STRTOUPPER <SERV.NAME>>
			Local.GirisKodu = <STRTOUPPER <SERV.ACCOUNT.<ARGS>.TAG0.UOSOFT_CLIENT_VERIFY_0xA4.Hash>>
			IF (<ISBLANK <LOCAL.GirisKodu>>)
				LOCAL.MsgContent (Client Onay) Tanimsiz istemci ile giris denemesi. Kod yok.
				FUNC_UOSOFT_LOGGER <LOCAL.MsgContent> <LOCAL.MsgDetail>
				FUNC_UOSOFT_STAFF_CHAT <LOCAL.MsgContent> <LOCAL.MsgDetail>
				//RETURN 1 // Girise izin verme
				RETURN 0 // Girise izin ver
			ELSEIF !(STRMATCH('HASH_<STRTOUPPER <MD5HASH <Local.Plain>>>','<Local.GirisKodu>'))
				LOCAL.MsgContent (Client Onay) Tanimsiz istemci ile giris denemesi. Kod uyusmuyor.
				FUNC_UOSOFT_LOGGER <LOCAL.MsgContent> <LOCAL.MsgDetail>
				FUNC_UOSOFT_STAFF_CHAT <LOCAL.MsgContent> <LOCAL.MsgDetail>
				//RETURN 1 // Girise izin verme
				RETURN 0 // Girise izin ver
			ENDIF
			//LOCAL.MsgContent (Client Onay) Giris onaylandi. (Giris Kodu=<Local.GirisKodu>)
			//FUNC_UOSOFT_LOGGER <LOCAL.MsgContent> <LOCAL.MsgDetail>
		ENDIF
	ELSE
		LOCAL.MsgContent (Client Onay) Giris onaylandi. (Muaf)
		FUNC_UOSOFT_LOGGER <LOCAL.MsgContent> <LOCAL.MsgDetail>
    ENDIF
	
ENDIF





[FUNCTION f_onaccount_create]
// This function is called before an account get created.
// Variables:
//	ARGS --> Account name being created
// Return:
//	0 --> Allow account creation (default action)
//	1 --> Deny account creation




[FUNCTION f_onaccount_delete]
// This function is called before an account get deleted.
// Variables:
//	ARGS --> Account name being deleted
// RETURN
//	0 --> Allow account deletion (default action)
//	1 --> Deny account deletion
IF ((<SERV.MYSQL>) && (<DB.CONNECTED>))
	LOCAL.SQLTIMEFORMAT = <SERV.RTIME.FORMAT %Y-%m-%d> <SERV.RTIME.FORMAT %H:%M:%S>
	 DB.EXECUTE UPDATE sphere_accounts SET deleted_at='<LOCAL.SQLTIMEFORMAT>' WHERE username='<ARGS>'
ENDIF



[FUNCTION f_onaccount_block]
// Variables:
// ARGS = Account name.
// Spheredeki bloklanan hesabi siteden de blokla
IF ((<SERV.MYSQL>) && (<DB.CONNECTED>))
  LOCAL.SQLTIMEFORMAT = <SERV.RTIME.FORMAT %Y-%m-%d> <SERV.RTIME.FORMAT %H:%M:%S>
	 DB.EXECUTE UPDATE sphere_accounts SET blocked_at='<LOCAL.SQLTIMEFORMAT>' WHERE username='<ARGS>'
ENDIF


[FUNCTION f_onaccount_unblock]
// Variables:
// ARGS = Account name.

IF ((<SERV.MYSQL>) && (<DB.CONNECTED>))
	 DB.EXECUTE UPDATE sphere_accounts SET blocked_at=NULL WHERE username='<ARGS>'
ENDIF



