// Return:
//	0 --> Allow password change (default action)
//	1 --> Deny password change
// SERV.LOG <args> isimli hesabin sifresi degisti. (Eski=<local.oldpassword>, Yeni=<LOCAL.PASSWORD>)



// Karakter olusturulurken once burasi cagrilir.
[FUNCTION f_onchar_create_init]
// This function is called before an account character is created.
// Variables:
//  Read-Write:
//	 ARGN1 --> Feature flags sent by client
//	 ARGN2 --> Character profession (0=Advanced, 1=Warrior, 2=Mage, 3=Blacksmith, 4=Necromancer, 5=Paladin, 6=Samurai, 7=Ninja)
//	 ARGN3 --> Character race (1=Human, 2=Elf, 3=Gargoyle)
//  Read-Only:
//	 ARGS  --> Account name
//	 ARGO  --> Client creating the character
// Return:
//	0 --> Allow character creation (default action)
//	1 --> Deny character creation
// serv.log f_onchar_create_init

ARGO.TAG0.CharCreateInitRace=<dargn1>
ARGO.TAG0.CharCreateInitProf=<dargn2>
ARGN3=1 // her zaman human



// Karakter olusturulurken sonra burasi cagrilir.

[FUNCTION f_onchar_create]
// This function is called after an account character got created.
// Variables (Read-Only):
//	SRC   --> Character being created
//	ARGN1 --> Feature flags sent by client
//	ARGN2 --> Character profession (0=Advanced, 1=Warrior, 2=Mage, 3=Blacksmith, 4=Necromancer, 5=Paladin, 6=Samurai, 7=Ninja)
//	ARGN3 --> Character race (1=Human, 2=Elf, 3=Gargoyle)
//	ARGS  --> Account name
//	ARGO  --> Client creating the character
// Return:
//	0 --> Allow character creation (default action)
//	1 --> Deny character creation
// serv.log f_onchar_create
ARGN3=1  // her zamam human

SRC.TAG0.CharCreateFeature=<ARGN1>
SRC.TAG0.CharCreateProf=<DARGN2>
SRC.TAG0.CharCreateRace=<DARGN3>

SRC.TAG.BODY_DEFAULT_COLOR=<SRC.COLOR>
SRC.TAG.BODY_DEFAULT_OSKIN=<SRC.OSKIN>

IF (<SRC.FINDLAYER(LAYER_HAIR)>)
	SRC.TAG.HAIR_DEFAULT_COLOR=<SRC.FINDLAYER(LAYER_HAIR).COLOR>
	SRC.TAG.HAIR_DEFAULT_BASEID=<SRC.FINDLAYER(LAYER_HAIR).BASEID>
ENDIF
IF (<SRC.FINDLAYER(LAYER_BEARD)>)
	SRC.TAG.BEARD_DEFAULT_COLOR=<SRC.FINDLAYER(LAYER_BEARD).COLOR>
	SRC.TAG.BEARD_DEFAULT_BASEID=<SRC.FINDLAYER(LAYER_BEARD).BASEID>
ENDIF

IF (<SRC.ACCOUNT.PLEVEL> > 1)
	SRC.Func_Char_Start_Staff
ELSEIF (<SRC.ACCOUNT.PLEVEL> <= 1)
	SRC.Func_Char_Start_Player
ENDIF



