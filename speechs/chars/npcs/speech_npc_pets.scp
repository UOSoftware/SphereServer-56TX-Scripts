
[SPEECH spk_generic_npc_pets]
ON=STOCK
SRC.SYSMESSAGELOC <def.tcolor_red>,600095 // "Bu komut kapalı/kaldırılmıştır."
RETURN 1

ON=SAMPLES
SRC.SYSMESSAGELOC <def.tcolor_red>,600095 // "Bu komut kapalı/kaldırılmıştır."
RETURN 1

ON=PRICE
SRC.SYSMESSAGELOC <def.tcolor_red>,600095 // "Bu komut kapalı/kaldırılmıştır."
RETURN 1

