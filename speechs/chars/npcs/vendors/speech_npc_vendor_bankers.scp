
// sphere.ini SpeechNpcBanker: sadece brain_banker NPC'lere verilir.
[SPEECH spk_generic_npc_bankers]
ON=*bank*
// Motorun BANK'i: ölü, donmuş ve taş olan açamaz (sphere.ini BankOpenCheck), ağırlık ve eşya bilgisi BankOpenInfo.
SRC.BANK

ON=*balance*
IF (<SERV.FeatureTOL>&02)
	SAYLOC 0,3301119,<NumberFormat <SRC.VIRTUALGOLD>>
ELSE
	SAYLOC 0,3301120,<NumberFormat <SRC.BANKBALANCE>>
ENDIF


ON=*check*
DIALOGCLOSE D_BANKER_CHECK
DIALOG D_BANKER_CHECK

// Hesap deposu (emulatörün STOREOPEN'ı, STORE'un aynısı; paketin [FUNCTION STORE]'u onu ezemez: d_store, erişim kuralları sphere.ini'de Store*).
ON=*depo*
SRC.STOREOPEN

ON=*store*
SRC.STOREOPEN



[EOF]
