
// sphere.ini SpeechNpcBanker: sadece brain_banker NPC'lere verilir.
[SPEECH spk_generic_npc_bankers]
ON=*bank*
SRC.OPENBANK

ON=*balance*
IF (<SERV.FeatureTOL>&02)
	SAY Thy current bank balance is <NumberFormat <SRC.VIRTUALGOLD>> virtual gold.
ELSE
	SAY Thy current bank balance is <NumberFormat <SRC.BANKBALANCE>> gold pieces.
ENDIF


ON=*check*
DIALOGCLOSE D_BANKER_CHECK
DIALOG D_BANKER_CHECK



[EOF]
