
// sphere.ini SpeechNpcBanker: sadece brain_banker NPC'lere verilir.
[SPEECH spk_generic_npc_bankers]
ON=*bank*
SRC.OPENBANK

ON=*balance*
IF (<SERV.FeatureTOL>&02)
	SAYLOC 0,3301119,<NumberFormat <SRC.VIRTUALGOLD>>
ELSE
	SAYLOC 0,3301120,<NumberFormat <SRC.BANKBALANCE>>
ENDIF


ON=*check*
DIALOGCLOSE D_BANKER_CHECK
DIALOG D_BANKER_CHECK



[EOF]
