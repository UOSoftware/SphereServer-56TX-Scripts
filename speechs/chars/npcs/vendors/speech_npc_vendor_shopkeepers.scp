
[SPEECH spk_generic_npc_vendor_shopkeepers]
ON=*sell*
IF (<SRC.FLAGS>&STATF_DEAD) 
	SRC.SYSMESSAGELOC <def.tcolor_red>,600027 // "Ölü durumdayken bu islemi yapamazsiniz."
	RETURN 1
ELSEIF (<SRC.ISOUTOFREACH 2,<UID>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600018,<JOB> <NAME>
	RETURN 1
ELSEIF (<SRC.ACTION> != -1 && <SERV.SKILL.<SRC.ACTION>.FLAGS>&SKF_CRAFT)
	SRC.SYSMESSAGELOC <def.tcolor_grey>,3300535
	RETURN 1
ENDIF
// SELL
FACE <SRC>
SRC.TARGETF Func_Generic_Npc_Vendor_Shopkeeper_Sell <UID>
SRC.SYSMESSAGELOC 0,3300536
RETURN 1



ON=*buy*
IF (<SRC.FLAGS>&STATF_DEAD) 
	SRC.SYSMESSAGELOC <def.tcolor_red>,600027 // "Ölü durumdayken bu islemi yapamazsiniz."
	RETURN 1
ELSEIF (<SRC.ISOUTOFREACH 2,<UID>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600018,<JOB> <NAME>
	RETURN 1
ENDIF
BUY



// targetli satış
[FUNCTION Func_Generic_Npc_Vendor_Shopkeeper_Sell]
REF1=<ARGS> // VENDOR

IF !(<REF1.ISVALIDE>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600072 // Varlık bulunamadı.
	RETURN 1
ELSEIF !(<ARGO>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600022 // Bir hata oluştu!
	RETURN 1
ELSEIF !(<ARGO.ISITEM>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300537
	RETURN 1
ELSEIF !(<SRC.ISINPACK <ARGO>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600036,<ARGO.NAME>	// Bunu (~1_val~) kullanabilmek için çantanızda veya üzerinizde olmalıdır.
	RETURN 1
ELSEIF (<EVAL <ARGO.VALUE>*<ARGO.AMOUNT>> > 2000000)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300538
	RETURN 1
ELSEIF (<SRC.ISOUTOFREACH 2,<ref1>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600018,<ref1.JOB> <ref1.NAME>
	RETURN 1
ELSEIF !(<ARGO.IsSalableItem>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300539
	RETURN 1
ELSEIF (<SRC.FLAGS>&STATF_DEAD) 
	SRC.SYSMESSAGELOC <def.tcolor_red>,600027 // "Ölü durumdayken bu işlemi yapamazsınız."
	RETURN 1
ENDIF
LOCAL.ESYADEGER <EVAL <ARGO.VALUE>*<ARGO.AMOUNT>>
IF (<DLOCAL.ESYADEGER> <= 0)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300540
	RETURN 1
ENDIF

// Esyayi buylistte ara
IF (<LDB.CONNECTED>)
	LDB.QUERY "SELECT id FROM 'buylist' WHERE defname='<STRTOUPPER <ARGO.BASEID>>' AND job='<STRTOUPPER <REF1.JOBKEY>>'";
	IF !(<LDB.ROW.NUMROWS>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300541
		REF1.SAYLOC 0,3301122
		SRC.CTAG0.Dialog.Generic_Npc_Vendor_Shopkeepers_Buylist.Index 0
		SRC.CTAG0.Dialog.Generic_Npc_Vendor_Shopkeepers_Buylist.ItemId <ARGO.BASEID>
		
		DIALOGCLOSE d_generic_npc_vendor_shopkeepers_buylist
		REF1.DIALOG d_generic_npc_vendor_shopkeepers_buylist 
		RETURN 1
	ENDIF
ENDIF
// Usage: NEWGOLD amount, pile(1: the new gold is stacked on the existing pile in the pack; 0: stacked in a new pile)

SRC.NEWGOLD <DLOCAL.ESYADEGER>,1
SRC.SYSMESSAGELOC <def.tcolor_green>,3300542,<NumberFormat <DLOCAL.ESYADEGER>>
SRC.Logger <ARGO.NAME> isimli esyayi <NumberFormat <DLOCAL.ESYADEGER>> gpe satti. 
TARGETF Func_Generic_Npc_Vendor_Shopkeeper_Sell <REF1>
SOUND 032
ARGO.REMOVE
RETURN 1


[FUNCTION IsSalableItem]
IF (<TYPE> == T_GOLD) || (<BASEID> == I_BACKPACK) || (<TYPE> == T_FIGURINE) || (<TYPE> == T_CONTAINER)
	RETURN 0
ELSEIF (<ATTR>&ATTR_NEWBIE)
	RETURN 0
ELSEIF (<ATTR>&ATTR_MOVE_NEVER)
	RETURN 0
ELSEIF !(<VALUE>)
	RETURN 0
ELSEIF (<AMOUNT> <= 0)
	RETURN 0
ENDIF
RETURN 1



[DIALOG d_generic_npc_vendor_shopkeepers_buylist]
<DEF.DSP>

RESIZE 0,0,320,540,<job> Alabileceği Eşya Listesi

DTEXT 20 45 <def.tcolor_red> Bu eşya satın alma listesinde yok.

LOCAL.Y=70
IF (<LDB.CONNECTED>)


	LDB.Query "SELECT COUNT(*) as total FROM 'buylist' WHERE job='<STRTOUPPER <JOBKEY>>'"
	LOCAL.TotalRows = <LDB.ROW.0.total>
	
	lDB.Query "SELECT * FROM 'buylist' WHERE job='<STRTOUPPER <JOBKEY>>' ORDER BY name ASC LIMIT <SRC.DCTAG0.Dialog.Generic_Npc_Vendor_Shopkeepers_Buylist.Index>,17"
	IF (<lDB.ROW.NUMROWS>)
		FOR 0 <EVAL <lDB.ROW.NUMROWS>-1>	
			LOCAL.Item = <LDB.ROW.<dlocal._for>.defname>
		
			TILEPICHUE +30 <EVAL (<DLOCAL.Y>)> <SERV.ITEMDEF.<LOCAL.Item>.ID> <SERV.ITEMDEF.<LOCAL.Item>.RESDISPDNHUE>
			DCROPPEDTEXT +70 <EVAL (<DLOCAL.Y>)> 80 25 <def.tcolor_grey> <SERV.ITEMDEF.<LOCAL.Item>.NAME>
			DCROPPEDTEXT +200 <EVAL (<DLOCAL.Y>)> 150 25 <def.tcolor_grey> <NumberFormat <SERV.ITEMDEF.<LOCAL.Item>.VALUE>> gp
			LOCAL.Y += 25
		ENDFOR
	ENDIF
	
	DORIGIN 20 500
	IF (<SRC.DCTAG0.Dialog.Generic_Npc_Vendor_Shopkeepers_Buylist.Index>)
		BUTTON +5 +0 015a1 015a3 1 0 1 // Page -
	ENDIF
	IF (<EVAL <SRC.dCTAG0.Dialog.Generic_Npc_Vendor_Shopkeepers_Buylist.Index> + 17> < <DLOCAL.TotalRows>)
		BUTTON +255 +0 015a4 015a6 1 0 2  // Page +
	ENDIF
	// IF (<SRC.DCTAG0.Dialog.Generic_Npc_Vendor_Shopkeepers_Buylist.Page>)
		DHTMLGUMP +30 +0 220 25 0 0 <DEF.CENTER><def.bfont_black><eval (<SRC.dCTAG0.Dialog.Generic_Npc_Vendor_Shopkeepers_Buylist.Index>/17)+1> / <eval (<DLOCAL.TotalRows>/17)+1><DEF.CENTERE><DEF.BFONTE>
	// ENDIF
	
	
	// Esyayi buylistte ara
	
	
	LDB.QUERY "SELECT * FROM 'buylist' WHERE defname='<STRTOUPPER <SRC.CTAG0.Dialog.Generic_Npc_Vendor_Shopkeepers_Buylist.ItemId>>' LIMIT 0,7"
	IF (<LDB.ROW.NUMROWS>)
		RESIZE 0,540,320,200,Eşyayı alabilen vendorlar
		DORIGIN 20 570
		FOR 0 <EVAL <LDB.ROW.NUMROWS> - 1>
			Local.J = <StrReplace 95, 020 , <LDB.ROW.<DLOCAL._FOR>.JOB>>
			DTEXT +20 *20 <def.tcolor_text> <LOCAL.J>
		ENDFOR
	ELSE
		RESIZE 0,540,320,120,Eşyayı alabilen vendorlar
		DORIGIN 20 570
		DTEXT +20 +30 <def.tcolor_red> Bu eşyayı satın alan vendor yok.
	ENDIF

ENDIF

[DIALOG d_generic_npc_vendor_shopkeepers_buylist button]
// --
ON=1 
IF (<SRC.dCTAG0.Dialog.Generic_Npc_Vendor_Shopkeepers_Buylist.Index> > 0)
	SRC.CTAG0.Dialog.Generic_Npc_Vendor_Shopkeepers_Buylist.Index -=17
ENDIF
DIALOG d_generic_npc_vendor_shopkeepers_buylist

// ++
ON=2
SRC.CTAG0.Dialog.Generic_Npc_Vendor_Shopkeepers_Buylist.Index +=17

DIALOG d_generic_npc_vendor_shopkeepers_buylist





[EOF]
