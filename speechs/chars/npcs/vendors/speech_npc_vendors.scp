
// sphere.ini SpeechNpcVendor: sadece satış yapan NPC'lere (brain_vendor, brain_stable, brain_healer) verilir.
// *buy* ve *sell* bütün satıcılarda (önceden sadece TSPEECH'inde spk_generic_npc_vendor_shopkeepers olan c_mage_high'ta).
//  Çift tık (sphere.ini VendorDClickBuy) ve context menünün Buy'ı da *buy*'ı çalıştırır. Satışın fonksiyonu ve dialog'u
//  speech_npc_vendor_shopkeepers.scp'de.
[SPEECH spk_generic_npc_vendors]
ON=*sell*
IF (<SRC.FLAGS>&STATF_DEAD)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600027 // "Ölü durumdayken bu islemi yapamazsiniz."
	RETURN 1
ELSEIF (<SRC.ISOUTOFREACH 2,<UID>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600018,<JOB> <NAME>
	RETURN 1
ELSEIF (<SRC.ACTION> != -1 && <SERV.SKILL.<SRC.ACTION>.FLAGS>&SKF_CRAFT)
	SRC.SYSMESSAGELOC <def.tcolor_grey>,3300535
	RETURN 1
ENDIF
// SELL
FACE <SRC>
SRC.TARGETF Func_Generic_Npc_Vendor_Shopkeeper_Sell <UID>
SRC.SYSMESSAGELOC 0,3300536
RETURN 1



ON=*buy*
IF (<SRC.FLAGS>&STATF_DEAD)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600027 // "Ölü durumdayken bu islemi yapamazsiniz."
	RETURN 1
ELSEIF (<SRC.ISOUTOFREACH 2,<UID>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600018,<JOB> <NAME>
	RETURN 1
ENDIF
BUY
RETURN 1




[EOF]
