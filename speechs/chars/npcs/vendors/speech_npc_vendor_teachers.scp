
// sphere.ini SpeechNpcTeacher: sadece brain_teacher NPC'lere verilir.
// "teach" ya da "train": öğretebildiği skill'leri söyler; "teach <skill>" (ya da "train <skill>"): o skill'in fiyatını
//  söyler, altın verilince öğretir. Motorun TRAIN'i skill'in adını metnin içinde arar. Çift tık da "teach" duyurur
//  (sphere.ini TeacherDClickTeach).
[SPEECH spk_generic_npc_teachers]
ON=*train*
ON=*teach*
IF (<SRC.ISOUTOFREACH 2,<UID>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600018,<JOB> <NAME>
	RETURN 1
ENDIF
FACE <SRC>
TRAIN <ARGS>
RETURN 1


[EOF]
