    ENDIF
    // Dosyayı aç ve yaz
    FILE.MODE.SETDEFAULT
    FILE.MODE.CREATE=1
    FILE.MODE.APPEND=1
    FILE.MODE.WRITEFLAG=1
    IF (<FILE.OPEN <LOCAL.FileName>>)
        IF (<LOCAL.NeedClean>)
            FILE.WRITELINE <SERV.RTIME>: Kayit temizlendi
        ENDIF
        FILE.WRITELINE <SERV.RTIME>: <ARGS>
        FILE.CLOSE
