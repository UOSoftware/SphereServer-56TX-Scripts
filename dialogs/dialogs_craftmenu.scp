// Not: boş olabilecek bir değer LOCAL'e kopyalanmaz (boş metin LOCAL'de 0 olur, ISEMPTY yanlış döner): ISEMPTY
//  değerin kaynağına bakar, ara değerler CTAG'de.

// @SkillMenu (e_generic_chars): ARGV0 skill, ARGV1 menüyü açan eşyanın UID'i. 1: d_craft açıldı, motorun menüsü
//  açılmaz. Skill'in eşyası yoksa 0: motorun menüsü (SKILLMENU). Veritabanı açılamıyorsa dialog nedenini gösterir.
[FUNCTION f_craft_skillmenu]
IF !(<f_defs_connect>)
	f_craft_open <ARGV[0]>,<ARGV[1]>
	RETURN 1
ENDIF
LDB.defs.QUERY "SELECT COUNT(*) AS n FROM crafts WHERE skill = <eval <ARGV[0]>>"
IF (<dLDB.defs.ROW.NUMROWS> == 0)
	RETURN 0
ENDIF
IF (<dLDB.defs.ROW.0.n> == 0)
	RETURN 0
ENDIF
f_craft_open <ARGV[0]>,<ARGV[1]>
RETURN 1

// d_craft'ı açar. ARGV0 skill, ARGV1 (isteğe bağlı) menüyü açan eşyanın UID'i: malzemesi skill'in listesindeyse o
//  malzeme seçilir. Aynı skill yeniden açılınca kategori ve sayfa korunur.
[FUNCTION f_craft_open]
LOCAL.Skill=<eval <ARGV[0]>>
IF (<f_defs_connect>)
	LDB.defs.QUERY "SELECT COUNT(*) AS n FROM crafts WHERE skill = <dLOCAL.Skill>"
	IF (<dLDB.defs.ROW.0.n> == 0)
		SYSMESSAGELOC 0,3300104
		RETURN 0
	ENDIF
ENDIF
LOCAL.Key=<SERV.SKILL.<dLOCAL.Skill>.KEY>
IF !(STRMATCH(<LOCAL.Key>,<CTAG.Craft.Key>))
	CLEARCTAGS Craft
	CTAG.Craft.Skill=<dLOCAL.Skill>
ENDIF
CTAG.Craft.Notice=
CTAG.Craft.Sel=
IF !(<ISEMPTY <DEF.craft_<LOCAL.Key>_materials>>) && (<eval 0<ARGV[1]>>)
	LOCAL.Base=<STRTOLOWER <UID.<ARGV[1]>.BASEID>>
	IF (<ARRAYINDEXOF <LOCAL.Base>,<DEF.craft_<LOCAL.Key>_materials>> != -1)
		TAG.Craft.Mat.<LOCAL.Key>=<LOCAL.Base>
		CTAG.Craft.Page=0
	ENDIF
ENDIF
f_craft_reopen
RETURN 1

// Eski ad (56TX paketinin ilk craft menüsü): ARGV0 skill.
[FUNCTION F_Craftmenu]
f_craft_open <ARGV[0]>,0

[FUNCTION f_craft_reopen]
DIALOGCLOSE d_craft
DIALOG d_craft

// Durumu düzeltir: skill'in KEY'i, malzemeli mi (HasMats), seçili malzeme (yoksa ya da listede değilse listenin
//  ilki), kategori sayısı ve seçili kategori (1..sayı+1; sayı+1 Diğer).
[FUNCTION f_craft_state]
CTAG.Craft.Key=<SERV.SKILL.<dCTAG0.Craft.Skill>.KEY>
CTAG.Craft.HasMats=0
CTAG.Craft.Mat=
IF !(<ISEMPTY <DEF.craft_<CTAG.Craft.Key>_materials>>)
	CTAG.Craft.HasMats=1
	CTAG.Craft.Mat=<TAG.Craft.Mat.<CTAG.Craft.Key>>
	IF (<ISEMPTY <CTAG.Craft.Mat>>)
		CTAG.Craft.Mat=<ARRAY <DEF.craft_<CTAG.Craft.Key>_materials>,1>
	ELIF (<ARRAYINDEXOF <CTAG.Craft.Mat>,<DEF.craft_<CTAG.Craft.Key>_materials>> == -1)
		CTAG.Craft.Mat=<ARRAY <DEF.craft_<CTAG.Craft.Key>_materials>,1>
	ENDIF
ENDIF
CTAG.Craft.CatCount=0
IF !(<ISEMPTY <DEF.craft_<CTAG.Craft.Key>_cats>>)
	CTAG.Craft.CatCount=<ARRAYCOUNT <DEF.craft_<CTAG.Craft.Key>_cats>>
ENDIF
IF (<dCTAG0.Craft.Cat> < 1) || (<dCTAG0.Craft.Cat> > <eval <dCTAG0.Craft.CatCount>+1>)
	CTAG.Craft.Cat=1
ENDIF

// Seçili kategorinin (ya da Diğer'in) sayfası: LDB.defs'te def, disp; en çok 13 satır (13. satır sonraki sayfa var).
//  Liste SQL'e virgüllü metin olarak gider, json_each satırlara böler (sırası pos). crafts'ın sütunları solda: NOCASE.
[FUNCTION f_craft_query]
LOCAL.Key=<CTAG.Craft.Key>
LOCAL.Skill=<dCTAG0.Craft.Skill>
LOCAL.Offset=<eval <dCTAG0.Craft.Page>*12>
IF (<dCTAG0.Craft.Cat> <= <dCTAG0.Craft.CatCount>)
	LOCAL.List=<STRSQLSAFE <DEF.craft_<LOCAL.Key>_cat_<dCTAG0.Craft.Cat>>>
	IF !(<dCTAG0.Craft.HasMats>)
		LDB.defs.QUERY "WITH e AS (SELECT key AS pos, trim(value) AS name FROM json_each('[' || char(34) || replace('<LOCAL.List>', ',', char(34) || ',' || char(34)) || char(34) || ']')) SELECT c.defname AS def, COALESCE(c.dispid, 0) AS disp, MIN(e.pos) AS p, c.skill_min AS sm FROM e JOIN crafts c ON c.defname = e.name WHERE c.skill = <dLOCAL.Skill> GROUP BY c.defname ORDER BY p, sm, def LIMIT 13 OFFSET <dLOCAL.Offset>"
	ELSE
		LDB.defs.QUERY "WITH e AS (SELECT key AS pos, trim(value) AS name FROM json_each('[' || char(34) || replace('<LOCAL.List>', ',', char(34) || ',' || char(34)) || char(34) || ']')) SELECT c.defname AS def, COALESCE(c.dispid, 0) AS disp, MIN(e.pos) AS p, c.skill_min AS sm FROM e JOIN crafts c ON (c.defname = e.name OR c.shape = e.name) WHERE c.skill = <dLOCAL.Skill> AND c.material = '<STRSQLSAFE <CTAG.Craft.Mat>>' GROUP BY c.defname ORDER BY p, sm, def LIMIT 13 OFFSET <dLOCAL.Offset>"
	ENDIF
	RETURN 1
ENDIF
// Diğer: hiçbir kategoride olmayanlar. Liste 0 ile başlar (eşya adı değil, bir şeyle eşleşmez).
LOCAL.All=0
IF (<dCTAG0.Craft.CatCount> > 0)
	FOR c 1 <dCTAG0.Craft.CatCount>
		LOCAL.All=<LOCAL.All>,<DEF.craft_<LOCAL.Key>_cat_<dLOCAL.c>>
	ENDFOR
ENDIF
LOCAL.All=<STRSQLSAFE <LOCAL.All>>
IF !(<dCTAG0.Craft.HasMats>)
	LDB.defs.QUERY "WITH e AS (SELECT trim(value) AS name FROM json_each('[' || char(34) || replace('<LOCAL.All>', ',', char(34) || ',' || char(34)) || char(34) || ']')) SELECT c.defname AS def, COALESCE(c.dispid, 0) AS disp FROM crafts c WHERE c.skill = <dLOCAL.Skill> AND NOT EXISTS (SELECT 1 FROM e WHERE c.defname = e.name) ORDER BY c.skill_min, c.defname LIMIT 13 OFFSET <dLOCAL.Offset>"
ELSE
	LDB.defs.QUERY "WITH e AS (SELECT trim(value) AS name FROM json_each('[' || char(34) || replace('<LOCAL.All>', ',', char(34) || ',' || char(34)) || char(34) || ']')), m AS (SELECT trim(value) AS name FROM json_each('[' || char(34) || replace('<STRSQLSAFE <DEF.craft_<LOCAL.Key>_materials>>', ',', char(34) || ',' || char(34)) || char(34) || ']')) SELECT c.defname AS def, COALESCE(c.dispid, 0) AS disp FROM crafts c WHERE c.skill = <dLOCAL.Skill> AND (c.material = '<STRSQLSAFE <CTAG.Craft.Mat>>' OR c.material IS NULL OR c.material NOT IN (SELECT name FROM m)) AND NOT EXISTS (SELECT 1 FROM e WHERE c.defname = e.name OR c.shape = e.name) ORDER BY c.skill_min, c.defname LIMIT 13 OFFSET <dLOCAL.Offset>"
ENDIF
RETURN 1


[DIALOG d_craft]
<DEF.DlgStartPos>
f_craft_draw

[FUNCTION f_craft_draw]
f_craft_state
LOCAL.Key=<CTAG.Craft.Key>
LOCAL.Skill=<dCTAG0.Craft.Skill>
RESIZE 0,0,700,530,<SERV.SKILL.<dLOCAL.Skill>.NAME>
IF !(<f_defs_connect>)
	DTEXT 30 60 <DEF.tcolor_red> DefsDatabase kapalı ya da veritabanı açılamadı.
	RETURN 0
ENDIF
DTEXT 540 22 0481 Beceri: <FVAL <<LOCAL.Key>>>

// Malzeme şeridi: yedişerli satırlar; çantadaki miktar, olmayan gri, seçili yeşil.
LOCAL.Top=55
IF (<dCTAG0.Craft.HasMats>)
	LOCAL.Mats=<DEF.craft_<LOCAL.Key>_materials>
	LOCAL.MatCount=<ARRAYCOUNT <LOCAL.Mats>>
	FOR i 1 <dLOCAL.MatCount>
		LOCAL.M=<ARRAY <LOCAL.Mats>,<dLOCAL.i>>
		LOCAL.X=<eval 20+(((<dLOCAL.i>-1)%7)*95)>
		LOCAL.Y=<eval 55+(((<dLOCAL.i>-1)/7)*25)>
		LOCAL.N=<PACKCOUNT <LOCAL.M>>
		LOCAL.Hue=0481
		IF (<dLOCAL.N> == 0)
			LOCAL.Hue=<DEF.tcolor_grey>
		ENDIF
		IF (STRMATCH(<LOCAL.M>,<CTAG.Craft.Mat>))
			LOCAL.Hue=<DEF.tcolor_green>
		ENDIF
		BUTTON <dLOCAL.X> <dLOCAL.Y> 4005 4007 1 0 <eval 100+<dLOCAL.i>>
		DCROPPEDTEXT <eval <dLOCAL.X>+32> <eval <dLOCAL.Y>+2> 62 20 <LOCAL.Hue> <STRTITLE <STRBEFORE " ingot",<SERV.ITEMDEF.<LOCAL.M>.NAME>>> <dLOCAL.N>
	ENDFOR
	LOCAL.Top=<eval 60+(((<dLOCAL.MatCount>+6)/7)*25)>
ENDIF

// Sol sütun: kategoriler ve Diğer.
FOR c 1 <eval <dCTAG0.Craft.CatCount>+1>
	IF (<dLOCAL.c> > <dCTAG0.Craft.CatCount>)
		LOCAL.Name=Diğer
		IF (<dCTAG0.Craft.CatCount> == 0)
			LOCAL.Name=Hepsi
		ENDIF
	ELSE
		LOCAL.Name=<ARRAY <DEF.craft_<LOCAL.Key>_cats>,<dLOCAL.c>>
	ENDIF
	LOCAL.Hue=0481
	IF (<dLOCAL.c> == <dCTAG0.Craft.Cat>)
		LOCAL.Hue=<DEF.tcolor_green>
	ENDIF
	LOCAL.Y=<eval <dLOCAL.Top>+((<dLOCAL.c>-1)*22)>
	BUTTON 20 <dLOCAL.Y> 4005 4007 1 0 <dLOCAL.c>
	DCROPPEDTEXT 52 <eval <dLOCAL.Y>+2> 130 20 <LOCAL.Hue> <LOCAL.Name>
ENDFOR

// Eşyalar: 4 sütun, 3 satır. Yap (ok), seç (büyüteç). Ad: yapılabilir açık, beceri yetmiyor kırmızı, malzeme yok gri.
f_craft_query
LOCAL.Rows=<dLDB.defs.ROW.NUMROWS>
CLEARCTAGS Craft.Row
IF (<dLOCAL.Rows> == 0)
	DTEXT 200 <eval <dLOCAL.Top>+5> <DEF.tcolor_grey> Bu kategoride eşya yok.
ENDIF
FOR 0 11
	IF (<dLOCAL._FOR> >= <dLOCAL.Rows>)
		BREAK
	ENDIF
	LOCAL.Def=<LDB.defs.ROW.<dLOCAL._FOR>.def>
	LOCAL.Disp=<dLDB.defs.ROW.<dLOCAL._FOR>.disp>
	CTAG.Craft.Row<dLOCAL._FOR>=<LOCAL.Def>
	LOCAL.X=<eval 190+((<dLOCAL._FOR>%4)*125)>
	LOCAL.Y=<eval <dLOCAL.Top>+((<dLOCAL._FOR>/4)*80)>
	LOCAL.Hue=0481
	IF !(<CANMAKESKILL <LOCAL.Def>>)
		LOCAL.Hue=<DEF.tcolor_red>
	ELIF !(<CANMAKE <LOCAL.Def>>)
		LOCAL.Hue=<DEF.tcolor_grey>
	ENDIF
	BUTTON <dLOCAL.X> <eval <dLOCAL.Y>+8> 4005 4007 1 0 <eval 200+<dLOCAL._FOR>>
	BUTTON <dLOCAL.X> <eval <dLOCAL.Y>+32> 4011 4012 1 0 <eval 300+<dLOCAL._FOR>>
	TILEPICHUE <eval <dLOCAL.X>+40> <dLOCAL.Y> <dLOCAL.Disp> <dSERV.ITEMDEF.<LOCAL.Def>.RESDISPDNHUE>
	DCROPPEDTEXT <dLOCAL.X> <eval <dLOCAL.Y>+56> 120 20 <LOCAL.Hue> <SERV.ITEMDEF.<LOCAL.Def>.NAME>
ENDFOR
LOCAL.Nav=<eval <dLOCAL.Top>+242>
IF (<dCTAG0.Craft.Page> > 0)
	BUTTON 190 <dLOCAL.Nav> 4014 4016 1 0 51
ENDIF
DTEXT 400 <eval <dLOCAL.Nav>+2> 0481 Sayfa <eval <dCTAG0.Craft.Page>+1>
CTAG.Craft.HasNext=0
IF (<dLOCAL.Rows> > 12)
	CTAG.Craft.HasNext=1
	BUTTON 655 <dLOCAL.Nav> 4005 4007 1 0 52
ENDIF

// Alt bölüm: bildirim, seçili (yoksa son yapılan) eşya, Yap, Tekrar yap, Tamir.
LOCAL.Bottom=<eval <dLOCAL.Nav>+30>
IF !(<ISEMPTY <CTAG.Craft.Notice>>)
	DCROPPEDTEXT 30 <dLOCAL.Bottom> 640 20 <dCTAG0.Craft.NoticeHue> <CTAG.Craft.Notice>
ENDIF
f_craft_shown
IF !(<ISEMPTY <CTAG.Craft.Show>>)
	LOCAL.Y=<eval <dLOCAL.Bottom>+25>
	TILEPICHUE 30 <dLOCAL.Y> <dSERV.ITEMDEF.<CTAG.Craft.Show>.DISPID> <dSERV.ITEMDEF.<CTAG.Craft.Show>.RESDISPDNHUE>
	DTEXT 110 <dLOCAL.Y> <DEF.tcolor_green> <SERV.ITEMDEF.<CTAG.Craft.Show>.NAME>
	DCROPPEDTEXT 110 <eval <dLOCAL.Y>+20> 330 20 0481 Malzeme: <SERV.ITEMDEF.<CTAG.Craft.Show>.RESMAKE>
	DCROPPEDTEXT 110 <eval <dLOCAL.Y>+40> 330 20 0481 Beceri: <SERV.ITEMDEF.<CTAG.Craft.Show>.SKILLMAKE>
	BUTTON 110 <eval <dLOCAL.Y>+62> 4005 4007 1 0 53
	DTEXT 142 <eval <dLOCAL.Y>+64> 0481 Yap
ENDIF
LOCAL.Y=<eval <dLOCAL.Bottom>+45>
IF !(<ISEMPTY <TAG.Craft.Last.<LOCAL.Key>>>)
	BUTTON 460 <dLOCAL.Y> 4005 4007 1 0 54
	DCROPPEDTEXT 492 <eval <dLOCAL.Y>+2> 190 20 0481 Tekrar yap: <SERV.ITEMDEF.<TAG.Craft.Last.<LOCAL.Key>>.NAME>
ENDIF
IF (<DEF0.craft_<LOCAL.Key>_repair>)
	BUTTON 460 <eval <dLOCAL.Y>+25> 4005 4007 1 0 55
	DTEXT 492 <eval <dLOCAL.Y>+27> 0481 Tamir
ENDIF

// Alt bölümde gösterilen eşya (CTAG.Craft.Show): seçili, yoksa bu skill'de son yapılmak istenen.
[FUNCTION f_craft_shown]
CTAG.Craft.Show=<CTAG.Craft.Sel>
IF (<ISEMPTY <CTAG.Craft.Show>>)
	CTAG.Craft.Show=<TAG.Craft.Last.<CTAG.Craft.Key>>
ENDIF

[DIALOG d_craft BUTTON]
ON=0
CTAG.Craft.Notice=
RETURN 1

// 1-50 kategori (sayı+1 Diğer), 51-52 sayfa, 53 alttaki eşyayı yap, 54 tekrar yap, 55 tamir, 101-150 malzeme,
//  200-211 satırı yap, 300-311 satırı seç.
ON=1 999
f_craft_state
LOCAL.Key=<CTAG.Craft.Key>
LOCAL.Btn=<eval <ARGN>>
IF (<dLOCAL.Btn> <= 50)
	IF (<dLOCAL.Btn> <= <eval <dCTAG0.Craft.CatCount>+1>)
		CTAG.Craft.Cat=<dLOCAL.Btn>
		CTAG.Craft.Page=0
	ENDIF
ELIF (<dLOCAL.Btn> > 100) && (<dLOCAL.Btn> <= 150)
	IF (<dCTAG0.Craft.HasMats>)
		IF (<eval <dLOCAL.Btn>-100> <= <ARRAYCOUNT <DEF.craft_<LOCAL.Key>_materials>>)
			TAG.Craft.Mat.<LOCAL.Key>=<ARRAY <DEF.craft_<LOCAL.Key>_materials>,<eval <dLOCAL.Btn>-100>>
			CTAG.Craft.Page=0
		ENDIF
	ENDIF
ELIF (<dLOCAL.Btn> >= 200) && (<dLOCAL.Btn> < 212)
	f_craft_make <CTAG.Craft.Row<eval <dLOCAL.Btn>-200>>
ELIF (<dLOCAL.Btn> >= 300) && (<dLOCAL.Btn> < 312)
	CTAG.Craft.Sel=<CTAG.Craft.Row<eval <dLOCAL.Btn>-300>>
ELIF (<dLOCAL.Btn> == 51)
	IF (<dCTAG0.Craft.Page> > 0)
		CTAG.Craft.Page=<eval <dCTAG0.Craft.Page>-1>
	ENDIF
ELIF (<dLOCAL.Btn> == 52)
	IF (<dCTAG0.Craft.HasNext>)
		CTAG.Craft.Page=<eval <dCTAG0.Craft.Page>+1>
	ENDIF
ELIF (<dLOCAL.Btn> == 53)
	f_craft_shown
	f_craft_make <CTAG.Craft.Show>
ELIF (<dLOCAL.Btn> == 54)
	f_craft_make <TAG.Craft.Last.<LOCAL.Key>>
ELIF (<dLOCAL.Btn> == 55)
	IF (<DEF0.craft_<LOCAL.Key>_repair>)
		REPAIR
	ENDIF
ENDIF
f_craft_reopen

// Eşyayı yapar ya da neden yapılamadığını bildirime yazar. ARGS tanımın adı. Yapılmak istenen eşya "Tekrar yap"ta.
[FUNCTION f_craft_make]
IF (<ISEMPTY <ARGS>>)
	RETURN 0
ENDIF
LOCAL.Item=<ARGS>
CTAG.Craft.Sel=<LOCAL.Item>
TAG.Craft.Last.<CTAG.Craft.Key>=<LOCAL.Item>
IF !(<CANMAKESKILL <LOCAL.Item>>)
	CTAG.Craft.NoticeHue=<DEF.tcolor_red>
	CTAG.Craft.Notice=<SERV.ITEMDEF.<LOCAL.Item>.NAME>: beceri yetmiyor (<SERV.ITEMDEF.<LOCAL.Item>.SKILLMAKE>).
	RETURN 0
ENDIF
IF !(<CANMAKE <LOCAL.Item>>)
	CTAG.Craft.NoticeHue=<DEF.tcolor_red>
	CTAG.Craft.Notice=<SERV.ITEMDEF.<LOCAL.Item>.NAME>: malzeme yetmiyor (<SERV.ITEMDEF.<LOCAL.Item>.RESMAKE>).
	RETURN 0
ENDIF
CTAG.Craft.NoticeHue=<DEF.tcolor_green>
CTAG.Craft.Notice=<SERV.ITEMDEF.<LOCAL.Item>.NAME> yapılıyor.
MAKEITEM <LOCAL.Item>
RETURN 1

[EOF]
