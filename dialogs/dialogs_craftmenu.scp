[FUNCTION F_Craftmenu_Blacksmithing]
SRC.ctag0.dialog.craftmenu.skillid=7
SRC.ctag0.dialog.craftmenu.skillkey=<serv.skill.<SRC.dctag0.dialog.craftmenu.skillid>.key>

DIALOGCLOSE d_craftmenu_Blacksmithing
DIALOG d_craftmenu_Blacksmithing , <ARGV1>

[DIALOG d_craftmenu_Blacksmithing]                            
<def.dsp>
LOCAL.CategoryCount = <ARRAYCOUNT <DEF.CRAFTMENU_BLACKSMITHING_CATEGORY_<BASEID>_CATEGORIES>>

Local.MaxWidth = <EVAL (<DLOCAL.CategoryCount>*25)+150>
// MAIN BORDERS
RESIZEPIC 0 0 5054 515 <dLocal.MaxWidth>
DHTMLGUMP 0 3 515 25 0 0 <def.center><serv.name> Blacksmithing (<strtitle <serv.itemdef.<baseid>.name>>) Menu

// Alt
DORIGIN 155 <eval <dLocal.MaxWidth>-30>
BUTTON +0 +0 4006 4007 1 0 9999
LOCAL.LastMakeItem.Skill <SRC.TAG0.CRAFT_LASTMAKE.<SRC.CTAG0.DIALOG.CRAFTMENU.SKILLKEY>>
IF (<LOCAL.LastMakeItem.Skill>)
	TILEPICHUE +20 +0 <SERV.ITEMDEF.<LOCAL.LastMakeItem.Skill>.ID> <dSERV.ITEMDEF.<LOCAL.LastMakeItem.Skill>.RESDISPDNHUE>
	dcroppedtext +60 +0 120 25 0 Tekrar yap (<SERV.ITEMDEF.<LOCAL.LastMakeItem.Skill>.NAME>)
ELSE
	LOCAL.LastMakeItem <SRC.TAG0.CRAFT_LASTMAKE>
	IF (<LOCAL.LastMakeItem>)
		TILEPICHUE +20 +0 <SERV.ITEMDEF.<LOCAL.LastMakeItem.Skill>.ID> <dSERV.ITEMDEF.<LOCAL.LastMakeItem>.RESDISPDNHUE>
		dcroppedtext +60 +0 120 25 0 Tekrar yap (<SERV.ITEMDEF.<LOCAL.LastMakeItem>.NAME>)
	ELSE
		DCROPPEDTEXT +30 +0 200 25 0 Tekrar yap
	ENDIF
ENDIF


DCROPPEDTEXT +190 +0 200 25 <def.tcolor_text> Blacksmithing: <src.Blacksmithing>


// Sol Taraf
DORIGIN 10 5
FOR c 1 <dLOCAL.CategoryCount>
	LOCAL.Category = <ARRAY <DEF.CRAFTMENU_BLACKSMITHING_CATEGORY_<BASEID>_CATEGORIES>,<DLOCAL.C>>
	RESIZEPIC +0 *25 3000 110 24
	DCROPPEDTEXT +5 +3 200 25 <def.tcolor_text> <LOCAL.Category>
	BUTTON +110 +0 4006 4007 0 <DLOCAL.C> <DLOCAL.C>
ENDFOR

RESIZEPIC +0 +80 3000 110 24
DCROPPEDTEXT +5 +83 200 25 <def.tcolor_text> Repair
BUTTON +110 +80 4006 4007 1 0 9998

FOR p 1 <dLOCAL.CategoryCount>
	PAGE <DLOCAL.P>
	DORIGIN 10 <eval <dLocal.MaxWidth>-30>
	DCROPPEDTEXT +0 +0 200 25 <def.tcolor_text> <ARRAY <DEF.CRAFTMENU_BLACKSMITHING_CATEGORY_<BASEID>_CATEGORIES>,<DLOCAL.P>>
	DORIGIN 155 30
	RESIZEPIC +0 +0	3000 350 <eval <Local.MaxWidth>-75>
	FOR i 1 <ARRAYCOUNT <DEF.CRAFTMENU_BLACKSMITHING_CATEGORY_<BASEID>_<DLOCAL.P>>>
		LOCAL.Item = <ARRAY <DEF.CRAFTMENU_BLACKSMITHING_CATEGORY_<BASEID>_<DLOCAL.P>>,<DLOCAL.i>>
		LOCAL.iX=<EVAL ((<LOCAL.i>-1)%4)*83>
		LOCAL.iY=<EVAL ((<LOCAL.i>-1)/4)*65>
		
		IF (<LOCAL.ITEM> == <SRC.TAG0.CRAFT_LASTMAKE>)
			LOCAL.ItemLabelHue = <def.tcolor_blue>
		ELSEIF !(<SRC.CANMAKESKILL <LOCAL.ITEM>> || <SRC.CANMAKE <LOCAL.ITEM>>)
			LOCAL.ItemLabelHue = <def.tcolor_red>
		ELSE
			LOCAL.ItemLabelHue = 0
		ENDIF

		DCROPPEDTEXT <EVAL <LOCAL.iX>+170> <EVAL <LOCAL.iY>+35> 80 25 <LOCAL.ItemLabelHue> <SERV.ITEMDEF.<LOCAL.Item>.NAME>
		BUTTON <EVAL <LOCAL.iX>+170> <EVAL <LOCAL.iY>+55> 210 211 1 0 <EVAL (<DLOCAL.P> * 10) + <DLOCAL.i>>
		TILEPICHUE <EVAL <LOCAL.iX>+185> <EVAL <LOCAL.iY>+55> <SERV.ITEMDEF.<LOCAL.Item>.ID> <dSERV.ITEMDEF.<LOCAL.Item>.RESDISPDNHUE>
	ENDFOR
ENDFOR

[DIALOG d_craftmenu_Blacksmithing button]
ON=1,999
LOCAL.Button = <ARGN1>
LOCAL.Page = <EVAL <LOCAL.Button> / 10>
LOCAL.Id   = <EVAL <LOCAL.Button> % 10>
LOCAL.Item = <ARRAY <DEF.CRAFTMENU_BLACKSMITHING_CATEGORY_<BASEID>_<DLOCAL.Page>>,<DLOCAL.Id>>

IF !(<SRC.CANMAKESKILL <LOCAL.ITEM>>)
	SRC.SYSMESSAGE Gerekli beceri : <SERV.ITEMDEF.<LOCAL.ITEM>.SKILLMAKE>
ELSEIF !(<SRC.CANMAKE <LOCAL.ITEM>>)
	SRC.SYSMESSAGE Gerekli malzeme : <SERV.ITEMDEF.<LOCAL.ITEM>.RESMAKE>
ELSE
	SRC.MAKEITEM <LOCAL.ITEM>
ENDIF
F_Craftmenu_Blacksmithing <BASEID>, <DLOCAL.Page>


// MAKELAST
on=9999
LOCAL.LastMakeItem <SRC.TAG0.CRAFT_LASTMAKE.<SRC.CTAG0.DIALOG.CRAFTMENU.SKILLKEY>>

IF (<ISBLANK <LOCAL.LastMakeItem>>)
LOCAL.LastMakeItem=<SRC.TAG0.CRAFT_LASTMAKE>
ENDIF

IF (<ISBLANK <SRC.TAG0.CRAFT_LASTMAKE>>)
	SRC.SYSMESSAGE En son yaptiginiz esyayi hatirlamiyorsunuz.
ELSE
	LOCAL.ITEM <SRC.TAG0.CRAFT_LASTMAKE>
	IF !(<SRC.CANMAKESKILL <LOCAL.ITEM>>)
		SRC.SYSMESSAGE Gerekli beceri : <SERV.ITEMDEF.<LOCAL.ITEM>.SKILLMAKE>
	ELSEIF !(<SRC.CANMAKE <LOCAL.ITEM>>)
		SRC.SYSMESSAGE Gerekli malzeme : <SERV.ITEMDEF.<LOCAL.ITEM>.RESMAKE>
	ELSE
		SRC.MAKEITEM <LOCAL.ITEM>
	ENDIF
ENDIF
F_Craftmenu_Blacksmithing <BASEID>, 0



// Repair
on=9998
src.repair








[FUNCTION F_Craftmenu_Alchemy]
DIALOGCLOSE d_craftmenu_alchemy
DIALOG d_craftmenu_alchemy

[DIALOG d_craftmenu_alchemy]                            
<def.dsp>

RESIZEPIC 150 0 5054  360 95
RESIZEPIC 155 30 3000 350 60
RESIZEPIC 155 5 3000 140 24

DCROPPEDTEXT 160 7 200 25 <def.tcolor_text> <name>
TILEPIC 245 10 <id>

FOR i 1 <ARRAYCOUNT <DEF.CRAFTMENU_ALCHEMY_CATEGORY_<BASEID>>>
	LOCAL.Item = <ARRAY  <DEF.CRAFTMENU_ALCHEMY_CATEGORY_<BASEID>>,<DLOCAL.i>>
	LOCAL.iX=<EVAL ((<LOCAL.i>-1)%4)*113>
	LOCAL.iY=<EVAL ((<LOCAL.i>-1)/4)*65>
	
	BUTTON <EVAL <LOCAL.iX>+175> <EVAL <LOCAL.iY>+55> 210 211 1 0 <DLOCAL.i>
	// BUTTON <EVAL <LOCAL.iX>+178> <EVAL <LOCAL.iY>+75> 2103 2104 1 0 <EVAL <DLOCAL.i> + 1000> // yapim asamasinda
	
	DCROPPEDTEXT <EVAL <LOCAL.iX>+175> <EVAL <LOCAL.iY>+35> 90 25 0 <SERV.ITEMDEF.<LOCAL.Item>.DESCRIPTION> 
	TILEPICHUE <EVAL <LOCAL.iX>+195> <EVAL <LOCAL.iY>+55> <SERV.ITEMDEF.<LOCAL.Item>.ID> <dSERV.ITEMDEF.<LOCAL.Item>.RESDISPDNHUE>
ENDFOR

[DIALOG d_craftmenu_alchemy button]
ON=1,10
LOCAL.Item = <ARRAY  <DEF.CRAFTMENU_ALCHEMY_CATEGORY_<BASEID>>,<DARGN>>
SRC.MAKEITEM=<LOCAL.Item>
F_Craftmenu_Alchemy <baseid>


ON=1000,1999
LOCAL.Item = <ARRAY  <DEF.CRAFTMENU_ALCHEMY_CATEGORY_<BASEID>>,<eval <DARGN>-1000>>
src.ctag0.dialog.craftmenu.skillid=0
src.ctag0.dialog.craftmenu.skillkey=<serv.skill.<src.dctag0.dialog.craftmenu.skillid>.key>
Src.Ctag0.Dialog.Craftmenu.ItemInfo=<LOCAL.Item>
dialogclose d_craftmenu
dialog d_craftmenu , 999








[FUNCTION F_Craftmenu]
if !(<isblank <argv0>>)
	ctag0.dialog.craftmenu.skillid=<argv0>
ELSE
	ctag0.dialog.craftmenu.skillid=0
endif
ctag0.dialog.craftmenu.skillkey=<serv.skill.<dctag0.dialog.craftmenu.skillid>.key>

// SERV.B Skillid <ARGV0> 
// SERV.B Page <ARGV1> 

DIALOGCLOSE d_craftmenu
DIALOG d_craftmenu , <argv1>



[DIALOG d_craftmenu]                            
<DEF.DSP>
PAGE 0
LOCAL.CategoryCount = <ARRAYCOUNT <DEF.CRAFTMENU_<SRC.CTAG0.DIALOG.CRAFTMENU.SKILLKEY>_CATEGORIES>>

Local.MaxWidth = <EVAL (<DLOCAL.CategoryCount>*25)+110>

// MAIN BORDERS
RESIZEPIC 0 0 5054 515 <eval <dLocal.MaxWidth>+10>
DHTMLGUMP 0 3 515 25 0 0 <def.center><serv.name> <SRC.CTAG0.DIALOG.CRAFTMENU.SKILLKEY> Menu

// Alt
DORIGIN 155 <eval <dLocal.MaxWidth>-30>
BUTTON +0 +0 4006 4007 1 0 10002

LOCAL.LastMakeItem.Skill <SRC.TAG0.CRAFT_LASTMAKE.<SRC.CTAG0.DIALOG.CRAFTMENU.SKILLKEY>>
IF (<LOCAL.LastMakeItem.Skill>)
	TILEPICHUE +20 +0 <SERV.ITEMDEF.<LOCAL.LastMakeItem.Skill>.ID> <dSERV.ITEMDEF.<LOCAL.LastMakeItem.Skill>.RESDISPDNHUE>
	dcroppedtext +60 +0 220 25 0 Tekrar yap (<SERV.ITEMDEF.<LOCAL.LastMakeItem.Skill>.NAME>)
ELSE
	DCROPPEDTEXT +30 +0 200 25 0 Tekrar yap
ENDIF
DCROPPEDTEXT 10 -20 200 25 0 <SRC.CTAG0.DIALOG.CRAFTMENU.SKILLKEY>: <src.<SRC.CTAG0.DIALOG.CRAFTMENU.SKILLKEY>>


// Sol Taraf
DORIGIN 10 5
FOR c 1 <dLOCAL.CategoryCount>
	LOCAL.Category = <ARRAY <DEF.CRAFTMENU_<SRC.CTAG0.DIALOG.CRAFTMENU.SKILLKEY>_CATEGORIES>,<DLOCAL.C>>
	RESIZEPIC +0 *25 3000 110 24
	DCROPPEDTEXT +5 +3 200 25 0 <LOCAL.Category>
	BUTTON +110 +0 4006 4007 0 <DLOCAL.C> <DLOCAL.C>
ENDFOR

FOR p 1 <dLOCAL.CategoryCount>
	PAGE <DLOCAL.P>
	DORIGIN 10 <eval <dLocal.MaxWidth>-30>
	
	DCROPPEDTEXT +0 +0 200 25 0 <ARRAY <DEF.CRAFTMENU_<SRC.CTAG0.DIALOG.CRAFTMENU.SKILLKEY>_CATEGORIES>,<DLOCAL.P>>
	
	DORIGIN 155 30
	RESIZEPIC +0 +0	3000 350 <eval <Local.MaxWidth>-65>
	
	FOR i 1 <ARRAYCOUNT <DEF.CRAFTMENU_<SRC.CTAG0.DIALOG.CRAFTMENU.SKILLKEY>_CATEGORY_<DLOCAL.P>>>
		LOCAL.Item = <ARRAY <DEF.CRAFTMENU_<SRC.CTAG0.DIALOG.CRAFTMENU.SKILLKEY>_CATEGORY_<DLOCAL.P>>,<DLOCAL.i>>
		
		IF (<SERV.ITEMDEF.<LOCAL.Item>.TYPE> == T_SCROLL)
			LOCAL.iX=<EVAL ((<LOCAL.i>-1)%3)*113>
			LOCAL.iY=<EVAL ((<LOCAL.i>-1)/3)*65>
		ELSEIF (<SERV.ITEMDEF.<LOCAL.Item>.TYPE> == T_POTION)
			LOCAL.iX=<EVAL ((<LOCAL.i>-1)%4)*83>
			LOCAL.iY=<EVAL ((<LOCAL.i>-1)/4)*65>
		ELSE
			LOCAL.iX=<EVAL ((<LOCAL.i>-1)%4)*83>
			LOCAL.iY=<EVAL ((<LOCAL.i>-1)/4)*65>
		ENDIF
		
		IF (<LOCAL.ITEM> == <SRC.TAG0.CRAFT_LASTMAKE>)
			LOCAL.ItemLabelHue = <def.tcolor_blue>
		ELSEIF !(<SRC.CANMAKESKILL <LOCAL.ITEM>> || <SRC.CANMAKE <LOCAL.ITEM>>)
			LOCAL.ItemLabelHue = <def.tcolor_red>
		ELSEIF (STRMATCH(*T_SCROLL*,<SERV.ITEMDEF.<LOCAL.ITEM>.TYPE>)) && !(<SRC.ISCANCAST <LOCAL.ITEM>>)
			LOCAL.ItemLabelHue = <def.tcolor_red>
		ELSE
			LOCAL.ItemLabelHue = 0
		ENDIF

		IF ((<SRC.account.priv>&<def.priv_gm>) && (<SRC.account.priv>&<DEF.priv_detail>))
		    LOCAL.ItemName = <LOCAL.Item>
            Local.Detail = 1

		ELSEIF (<SERV.ITEMDEF.<LOCAL.Item>.TYPE> == T_POTION)
		    LOCAL.ItemName = <SERV.ITEMDEF.<LOCAL.Item>.CATEGORY>

		ELSEIF (<SERV.ITEMDEF.<LOCAL.Item>.TYPE> == T_SCROLL)
		    LOCAL.ItemName = <SERV.ITEMDEF.<LOCAL.Item>.NAME>

		ELSE
            LOCAL.ItemName = <SERV.ITEMDEF.<LOCAL.Item>.NAME>
		ENDIF

        IF !(<DLocal.Detail>)
	        dcroppedtext <EVAL <LOCAL.iX>+170> <EVAL <LOCAL.iY>+35> 80 25 <LOCAL.ItemLabelHue> <local.ItemName>
        ELSE
            dtextentrylimited <EVAL <LOCAL.iX>+170> <EVAL <LOCAL.iY>+35> 80 60 <LOCAL.ItemLabelHue> 0 100 <local.ItemName>
        ENDIF


		BUTTON <EVAL <LOCAL.iX>+170> <EVAL <LOCAL.iY>+55> 210 211 1 0 <EVAL (<DLOCAL.P> * 100) + <DLOCAL.i>>
		BUTTON <EVAL <LOCAL.iX>+173> <EVAL <LOCAL.iY>+75> 2103 2104 1 0 <EVAL (<DLOCAL.P> * 100) + <DLOCAL.i> + 2000>

		
		IF (<SERV.ITEMDEF.<LOCAL.Item>.TYPE> == T_SCROLL)
			LOCAL.ScrollRune = i_rune_<strsub 9 99 <LOCAL.Item>>
			TILEPICHUE <EVAL <LOCAL.iX>+195> <EVAL <LOCAL.iY>+55> <serv.itemdef.<LOCAL.ScrollRune>.id> <SERV.ITEMDEF.<LOCAL.Item>.RESDISPDNHUE>
		
		ELSEIF (<serv.itemdef.<LOCAL.Item>.baseid> == i_runebook)
			GUMPPIC <EVAL <LOCAL.iX>+195> <EVAL <LOCAL.iY>+55> 2234 <EVAL 045e>
		
		ELSEIF (<serv.itemdef.<LOCAL.Item>.baseid> == i_pouch_Trapped)
			TILEPIC <EVAL <LOCAL.iX>+185> <EVAL <LOCAL.iY>+55> 14030 0
			
		ELSEIF (<serv.itemdef.<LOCAL.Item>.baseid> == I_DEED_FORGE)
			TILEPIC <EVAL <LOCAL.iX>+185> <EVAL <LOCAL.iY>+55> <serv.itemdef.i_forge.id> 0
		
		ELSEIF (<serv.itemdef.<LOCAL.Item>.baseid> == I_DEED_ANVIL)
			TILEPIC <EVAL <LOCAL.iX>+185> <EVAL <LOCAL.iY>+55> <serv.itemdef.i_anvil.id> 0
					
		ELSEIF (<serv.itemdef.<LOCAL.Item>.baseid> == I_DEED_DUMMYW)
			TILEPIC <EVAL <LOCAL.iX>+185> <EVAL <LOCAL.iY>+55> 4208 0	
			
		ELSEIF (<serv.itemdef.<LOCAL.Item>.baseid> == I_DEED_PICKPOCK)
			TILEPIC <EVAL <LOCAL.iX>+185> <EVAL <LOCAL.iY>+55> 7872 0
						
		ELSEIF (<serv.itemdef.<LOCAL.Item>.baseid> == I_DEED_SPINWHEEL)
			TILEPIC <EVAL <LOCAL.iX>+185> <EVAL <LOCAL.iY>+55> 4117 	
			
		ELSEIF (<serv.itemdef.<LOCAL.Item>.baseid> == I_DEED_BBOARD)
			TILEPIC <EVAL <LOCAL.iX>+185> <EVAL <LOCAL.iY>+55> 7775 0	
			
		ELSEIF (<serv.itemdef.<LOCAL.Item>.baseid> == I_DEED_BBOARDN)
			TILEPIC <EVAL <LOCAL.iX>+185> <EVAL <LOCAL.iY>+55> 7774 0
			
		ELSE
			TILEPICHUE <EVAL <LOCAL.iX>+185> <EVAL <LOCAL.iY>+55> <SERV.ITEMDEF.<LOCAL.Item>.ID> <dSERV.ITEMDEF.<LOCAL.Item>.RESDISPDNHUE>
		ENDIF
		
	ENDFOR
ENDFOR

PAGE 999
Local.ItemInfo = <Src.Ctag0.Dialog.Craftmenu.ItemInfo>

IF (<RESOURCETYPE <LOCAL.ItemInfo>> == RES_ITEMDEF)

	RESIZEPIC +0 +0	3000 350 <eval <Local.MaxWidth>-75>

	// Item Picture
	DORIGIN 170 50
	RESIZEPIC +0 +0 2620 100 80
	TILEPICHUE +25 +25 <SERV.ITEMDEF.<LOCAL.ItemInfo>.ID> <DSERV.ITEMDEF.<LOCAL.ItemInfo>.RESDISPDNHUE>

	// Item Detay
	DORIGIN 280 50
	RESIZEPIC +0 +0 2620 210 80
	DCROPPEDTEXT +10 +10 200 25 <def.tcolor_white> Eşya : <SERV.ITEMDEF.<LOCAL.ItemInfo>.NAME>
	DCROPPEDTEXT +10 +30 200 25 <def.tcolor_white> Fiyatı : <SERV.ITEMDEF.<LOCAL.ItemInfo>.VALUE> gp
	DCROPPEDTEXT +10 +50 200 25 <def.tcolor_white> Ağırlık : <SERV.ITEMDEF.<LOCAL.ItemInfo>.WEIGHT> kg


	// Resources
	DORIGIN 160 140
	// RESIZEPIC +0 +0 2620 170 160
	LOCAL.RESOURCES <SERV.ITEMDEF.<LOCAL.ItemInfo>.RESOURCES.0.KEY>
	IF (<ARRAYCOUNT <LOCAL.RESOURCES>>)
		DCROPPEDTEXT +10 +10 200 25 1000 Malzemeler (<ARRAYCOUNT <LOCAL.RESOURCES>>)
		FOR r 1 <ARRAYCOUNT <LOCAL.RESOURCES>>
			LOCAL.RESITEM <SERV.ITEMDEF.<LOCAL.ItemInfo>.RESOURCES.<DLOCAL.r>.KEY>
			LOCAL.RESAMOUNT <SERV.ITEMDEF.<LOCAL.ItemInfo>.RESOURCES.<DLOCAL.r>.VAL>
			IF (<SRC.RESTEST <DLOCAL.RESAMOUNT> <LOCAL.RESITEM>>)
				DCROPPEDTEXT +40 <EVAL (<LOCAL.r>*25)+150> 115 25 <def.tcolor_green> <SRC.Pack_Counter <LOCAL.RESITEM>>/<DLOCAL.RESAMOUNT> <SERV.ITEMDEF.<LOCAL.RESITEM>.NAME>
			ELSE
				DCROPPEDTEXT +40 <EVAL (<LOCAL.r>*25)+150> 115 25 <def.tcolor_red> <SRC.Pack_Counter <LOCAL.RESITEM>>/<DLOCAL.RESAMOUNT> <SERV.ITEMDEF.<LOCAL.RESITEM>.NAME>
			ENDIF
			TILEPICHUE +5 <EVAL (<LOCAL.r>*25)+150> <SERV.ITEMDEF.<LOCAL.RESITEM>.ID> <dSERV.ITEMDEF.<LOCAL.RESITEM>.RESDISPDNHUE>
		ENDFOR
	ENDIF

	// Skillmake
	DORIGIN 320 140
	// RESIZEPIC +0 +0 2620 140 160
	LOCAL.SKILLMAKE=<SERV.ITEMDEF.<LOCAL.ItemInfo>.SKILLMAKE> // sapıtık çalışıyor
	IF (<ARRAYCOUNT <LOCAL.SKILLMAKE>>)
		// sadece becerileri göstermesi lazım beceriden sonra t_carpentry vs varsa göstermesin.
		DCROPPEDTEXT +10 +10 200 25 1000 Beceriler (<ARRAYCOUNT <LOCAL.SKILLMAKE>>)
		FOR s 1 <ARRAYCOUNT <SERV.ITEMDEF.<LOCAL.ItemInfo>.SKILLMAKE.0.KEY>>
			LOCAL.SKILL_ID <SERV.ITEMDEF.<LOCAL.ItemInfo>.SKILLMAKE.<DLOCAL.s>.KEY>
			LOCAL.SKILL_VAL <SERV.ITEMDEF.<LOCAL.ItemInfo>.SKILLMAKE.<DLOCAL.s>.VAL>	
			
			IF (STRMATCH('Skill_','<STRSUB 0 6 <LOCAL.SKILL_ID>>'))
				IF (<SRC.<SERV.SKILL.<LOCAL.SKILL_ID>.NAME>> >= <DLOCAL.SKILL_VAL>)
					DCROPPEDTEXT +10 <EVAL (<LOCAL.s>*25)+150> 135 25 <def.tcolor_green> <SRC.<SERV.SKILL.<LOCAL.SKILL_ID>.NAME>>/<FVAL <DLOCAL.SKILL_VAL>> <SERV.SKILL.<LOCAL.SKILL_ID>.NAME>
				ELSE
					DCROPPEDTEXT +10 <EVAL (<LOCAL.s>*25)+150> 135 25 0 <SRC.<SERV.SKILL.<LOCAL.SKILL_ID>.NAME>>/<FVAL <DLOCAL.SKILL_VAL>> <SERV.SKILL.<LOCAL.SKILL_ID>.NAME>
				ENDIF
			ELSEIF (STRMATCH('i_','<STRSUB 0 2 <LOCAL.SKILL_ID>>'))
				IF (<SRC.RESTEST 1 <LOCAL.SKILL_ID>>)
					DCROPPEDTEXT +10 <EVAL (<LOCAL.s>*25)+150> 135 25 <def.tcolor_green> <SERV.ITEMDEF.<LOCAL.SKILL_ID>.NAME>
				ELSE
					DCROPPEDTEXT +10 <EVAL (<LOCAL.s>*25)+150> 135 25 0 <SERV.ITEMDEF.<LOCAL.SKILL_ID>.NAME>
				ENDIF
				TILEPICHUE +0 <EVAL (<LOCAL.s>*25)+150> <SERV.ITEMDEF.<LOCAL.SKILL_ID>.ID> 0
			ELSEIF (STRMATCH('t_','<STRSUB 0 2 <LOCAL.SKILL_ID>>'))
			
			ENDIF
			
		ENDFOR
	ENDIF


ENDIF


[DIALOG d_craftmenu button]
ON=1,1999
LOCAL.Button = <ARGN1>
LOCAL.Page = <EVAL <dLOCAL.Button> / 100>
LOCAL.Id   = <EVAL <dLOCAL.Button> % 100>
LOCAL.Item = <ARRAY <DEF.CRAFTMENU_<SRC.CTAG0.DIALOG.CRAFTMENU.SKILLKEY>_CATEGORY_<dLOCAL.Page>>,<dLOCAL.Id>>

IF !(<SRC.CANMAKESKILL <LOCAL.ITEM>>)
	SRC.SYSMESSAGE <SERV.ITEMDEF.<LOCAL.ITEM>.NAME> uretmek icin gerekli beceri: <SERV.ITEMDEF.<LOCAL.ITEM>.SKILLMAKE>

ELSEIF !(<SRC.CANMAKE <LOCAL.ITEM>>)
	SRC.SYSMESSAGE <SERV.ITEMDEF.<LOCAL.ITEM>.NAME> uretmek icin gerekli malzeme : <SERV.ITEMDEF.<LOCAL.ITEM>.RESMAKE>
	
ELSEIF (STRMATCH(*T_SCROLL*,<SERV.ITEMDEF.<LOCAL.ITEM>.TYPE>)) && !(<SRC.ISCANCAST <LOCAL.ITEM>>)
	SRC.SYSMESSAGE Bu buyu spellbook'unuzda yer almiyor veya buyuyu uygulayacak nitelige sahip degilsin. Buyuyu uygulayabiliyor olmalisiniz.
ELSE

	IF (<LOCAL.ITEM> == i_pouch_trapped)
		IF (<TINKERING> < 850)
			LOCAL.Rand 4
		ELSEIF (<TINKERING> < 1000)
			LOCAL.Rand 3
		ELSEIF (<TINKERING> >= 1000)
			LOCAL.Rand 2
		ELSE 
			LOCAL.RAND 4
		ENDIF
		IF (RAND(<DLOCAL.RAND>)==1)
			SRC.MAKEITEM i_pouch_trapped
		ELSE
			SRC.CONSUME 2 i_log
			SRC.CONSUME 1 i_ingot_iron
			SRC.EFFECT 3,i_fx_explode,3,25,1
			SRC.SOUND snd_SPELL_EXPLOSION
			SRC.DAMAGE 5
			SRC.SYSMESSAGE Trapped pouch elinde patladi!
		ENDIF
	ELSE
		SRC.MAKEITEM <LOCAL.ITEM>
	ENDIF
ENDIF
Src.Ctag0.Dialog.Craftmenu.Lastpage=<Dlocal.Page>
SRC.F_CRAFTMENU <SRC.DCTAG0.DIALOG.CRAFTMENU.SKILLID>, <DLOCAL.PAGE>


ON=2000,9999
LOCAL.Button = <ARGN1>
LOCAL.RealButton = <EVAL <dLOCAL.Button> - 2000>
LOCAL.Page = <EVAL <dLOCAL.RealButton> / 100>
LOCAL.Id   = <EVAL <dLOCAL.RealButton> % 100>
LOCAL.Item = <ARRAY <DEF.CRAFTMENU_<SRC.CTAG0.DIALOG.CRAFTMENU.SKILLKEY>_CATEGORY_<dLOCAL.Page>>,<dLOCAL.Id>>

Src.Ctag0.Dialog.Craftmenu.Lastpage=<Dlocal.Page>
Src.Ctag0.Dialog.Craftmenu.ItemInfo=<LOCAL.Item>
dialogclose d_craftmenu
dialog d_craftmenu , 999



// PAGE ++
ON=10000

// PAGE --
ON=10001




// Makelast
ON=10002
LOCAL.LastMakeItem <SRC.TAG0.CRAFT_LASTMAKE.<SRC.CTAG0.DIALOG.CRAFTMENU.SKILLKEY>>

IF (<ISBLANK <LOCAL.LastMakeItem>>)
LOCAL.LastMakeItem=<SRC.TAG0.CRAFT_LASTMAKE>
ENDIF

IF (<ISBLANK <LOCAL.LastMakeItem>>)
	SRC.SYSMESSAGE En son yaptiginiz esyayi hatirlamiyorsunuz.
ELSE
	LOCAL.ITEM <LOCAL.LastMakeItem>
	IF !(<SRC.CANMAKESKILL <LOCAL.ITEM>>)
		SRC.SYSMESSAGE Gerekli beceri : <SERV.ITEMDEF.<LOCAL.ITEM>.SKILLMAKE>
	ELSEIF !(<SRC.CANMAKE <LOCAL.ITEM>>)
		SRC.SYSMESSAGE Gerekli malzeme : <SERV.ITEMDEF.<LOCAL.ITEM>.RESMAKE>
	ELSEIF (STRMATCH(*T_SCROLL*,<SERV.ITEMDEF.<LOCAL.ITEM>.TYPE>)) && !(<SRC.ISCANCAST <LOCAL.ITEM>>)
		SRC.SYSMESSAGE Bu buyu spellbook'unuzda yer almiyor veya buyuyu uygulayacak nitelige sahip degilsin. Buyuyu uygulayabiliyor olmalisiniz.
	ELSE
		SRC.MAKEITEM <LOCAL.ITEM>
	ENDIF
ENDIF
SRC.F_CRAFTMENU <SRC.DCTAG0.DIALOG.CRAFTMENU.SKILLID>, 0





// SCROLL YAZMA GEREKSINIM KONTROLU
[FUNCTION ISCANCAST]
IF !(<ISEMPTY <ARGS>>)
	IF (STRMATCH('I_SCROLL_PARALYZE_FIELD','<ARGS>'))
		LOCAL.SPELL=S_PARALYZATION_FIELD
	ELSE
		LOCAL.SPELL=S_<STRSUB 9 99 <ARGS>>
	ENDIF
	IF (<CANCAST <LOCAL.SPELL>>)	
		RETURN 1
	ENDIF
	RETURN 0
ENDIF




