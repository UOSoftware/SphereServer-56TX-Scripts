VERSION=0.56T

[DIALOG d_where]
30,30

RESIZEPIC 0 0 9200 420 110
RESIZEPIC 10 10 3000 400 90

IF (<REGION>)
	DORIGIN 20 20
	RESIZEPIC +0 +0 3000 380 70
	DTEXT +10 +10 0 KARAKTER
	DHTMLGUMP +10 +30 30 25 1 0 P: 
	RESIZEPIC +45 +30 3000 110 25
	DTEXTENTRYLIMITED +50 +33 150 25 0 0 20 <P.X>,<P.Y>,<P.Z>,<P.M>
	DHTMLGUMP +160 +30 75 25 1 0 SEXTANT: 
	RESIZEPIC +240 +30 3000 130 25
	DTEXTENTRYLIMITED +245 +33 150 25 0 0 20 <SEXTANTP>
ENDIF




[DIALOG d_where_staff]
30,140

RESIZEPIC 0 0 9200 420 <QVAL (<ROOM>)?430:230>
RESIZEPIC 10 10 3000 400 <QVAL (<ROOM>)?410:210>

// AREADEF
DORIGIN 20 20
RESIZEPIC +0 +0 3000 380 190

DTEXT +10 +10 0 AREADEF

DHTMLGUMP +10 +30 80 25 1 0 DEFNAME:
RESIZEPIC +95 +30 3000 275 25
DTEXTENTRYLIMITED +100 +33 250 25 0 0 50 <SERV.AREA(<REGION.DEFNAME>).DEFNAME>

DHTMLGUMP +10 +60 80 25 1 0 NAME: 
RESIZEPIC +95 +60 3000 275 25
DTEXTENTRYLIMITED +100 +63 250 25 0 0 50 <SERV.AREA(<REGION.DEFNAME>).NAME>

DHTMLGUMP +10 +90 80 25 1 0 GROUP: 
RESIZEPIC +95 +90 3000 275 25
DTEXTENTRYLIMITED +100 +93 250 25 0 0 50 <SERV.AREA(<REGION.DEFNAME>).GROUP>

DHTMLGUMP +10 +120 80 25 1 0 P: 
RESIZEPIC +95 +120 3000 275 25
DTEXTENTRYLIMITED +100 +123 150 25 0 0 20 <SERV.AREA(<REGION.DEFNAME>).P>

DHTMLGUMP +10 +150 120 25 1 0 SAFE: <QVAL (<SERV.AREA(<REGION.DEFNAME>).FLAGS>&REGION_FLAG_SAFE)?<DEF.BFONT_GREEN>Evet<DEF.BFONTE>:<DEF.BFONT_RED>Hayır<DEF.BFONTE>>
DHTMLGUMP +130 +150 120 25 1 0 GUARD: <QVAL (<SERV.AREA(<REGION.DEFNAME>).FLAGS>&REGION_FLAG_GUARDED)?<DEF.BFONT_BLUE>Evet<DEF.BFONTE>:<DEF.BFONT_RED>Hayır<DEF.BFONTE>>
DHTMLGUMP +250 +150 120 25 1 0 DUNGEON: <QVAL (<SERV.AREA(<REGION.DEFNAME>).FLAGS>&REGION_FLAG_UNDERGROUND)?<DEF.BFONT_BLUE>Evet<DEF.BFONTE>:<DEF.BFONT_RED>Hayır<DEF.BFONTE>>

