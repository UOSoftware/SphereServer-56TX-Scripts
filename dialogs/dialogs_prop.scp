			DCROPPEDTEXT +0 <EVAL (<DLOCAL.A>*20)+200> 140 25 <DEF.NOTO.<REF99.NOTOGETFLAG <UID>>> <REF99.NAME>
			DCROPPEDTEXT +150 <EVAL (<DLOCAL.A>*20)+200> 90 25 0 <ATTACKER.<dLOCAL.a>.DAM>
			DCROPPEDTEXT +250 <EVAL (<DLOCAL.A>*20)+200> 90 25 0 <kalansure <ATTACKER.<dLOCAL.a>.ELAPSED>> sn.
		ENDIF
	ENDFOR
	
ELSE
