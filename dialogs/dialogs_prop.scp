	// BUTTON +0 +240 4006 4007 1 0 1012	
	DTEXT +30 +240 0 Charter
	IF (<ISEMPTY <CHARTER0>>)
		LOCAL.NOEMPTY=0
		LOCAL.CHARTERTEXT=<DEF0.BR>
	ELSE
		LOCAL.NOEMPTY=1
		LOCAL.CHARTERTEXT=<CHARTER0><DEF0.BR>
	ENDIF
	FOR _cLINE 1 5
	  IF (<ISEMPTY <CHARTER<DLOCAL._cLINE>>>)
			LOCAL.CHARTERTEXT .= <DEF0.BR>
	  ELSE
			LOCAL.CHARTERTEXT .= <CHARTER<DLOCAL._cLINE>><DEF0.BR>
			LOCAL.NOEMPTY += 1
		ENDIF
	ENDFOR
	IF (!<LOCAL.NOEMPTY>)
		DCROPPEDTEXT +200 +240 250 20 38 Empty charter
	ELSE
		DHTMLGUMP +200 +240 210 150 1 1 <local.chartertext>
	ENDIF
ENDIF





