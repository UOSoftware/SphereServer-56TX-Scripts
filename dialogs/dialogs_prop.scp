[FUNCTION _MemoryList]
REF1=<UID>
IF (<REF1.ISVALIDE>)
	REF1._GETMEMORYLIST
ENDIF

[FUNCTION _GetMemoryList]
REF1=<UID>
IF (<REF1.ISVALIDE>)
	REF1.CLEARTAGS MemoryList
	// FORCHARLAYER 30
		// REF1.TAG0.MemoryList.Count ++
		// REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count> <UID>
	// ENDFOR
	FORCHARMEMORYTYPE memory_sawcrime
		REF1.TAG0.MemoryList.Count ++
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_UID <UID>
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_TYPE Sawcrime
	ENDFOR	
	FORCHARMEMORYTYPE memory_ipet
		REF1.TAG0.MemoryList.Count ++
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_UID <UID>
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_TYPE Pet
	ENDFOR		
	FORCHARMEMORYTYPE memory_fight
		REF1.TAG0.MemoryList.Count ++
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_UID <UID>
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_TYPE Fight
	ENDFOR
	FORCHARMEMORYTYPE memory_iaggressor
		REF1.TAG0.MemoryList.Count ++
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_UID <UID>
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_TYPE Aggressor
	ENDFOR
	FORCHARMEMORYTYPE memory_harmedby
		REF1.TAG0.MemoryList.Count ++
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_UID <UID>
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_TYPE HarmedBy
	ENDFOR	
	FORCHARMEMORYTYPE memory_irritatedby
		REF1.TAG0.MemoryList.Count ++
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_UID <UID>
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_TYPE Irritatedby
	ENDFOR	
	FORCHARMEMORYTYPE memory_speak
		REF1.TAG0.MemoryList.Count ++
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_UID <UID>
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_TYPE Speak
	ENDFOR		
	FORCHARMEMORYTYPE memory_aggreived
		REF1.TAG0.MemoryList.Count ++
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_UID <UID>
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_TYPE Aggreived
	ENDFOR		
	FORCHARMEMORYTYPE memory_guard
		REF1.TAG0.MemoryList.Count ++
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_UID <UID>
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_TYPE Guard
	ENDFOR	
	FORCHARMEMORYTYPE memory_ispawned
		REF1.TAG0.MemoryList.Count ++
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_UID <UID>
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_TYPE Spawned
	ENDFOR	
	FORCHARMEMORYTYPE memory_guild
		REF1.TAG0.MemoryList.Count ++
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_UID <UID>
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_TYPE Guild
	ENDFOR	
	FORCHARMEMORYTYPE memory_town
		REF1.TAG0.MemoryList.Count ++
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_UID <UID>
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_TYPE Town
	ENDFOR	
	FORCHARMEMORYTYPE memory_friend
		REF1.TAG0.MemoryList.Count ++
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_UID <UID>
		REF1.TAG0.MemoryList.<REF1.dTAG0.MemoryList.Count>_TYPE Friend
	ENDFOR	
ENDIF











