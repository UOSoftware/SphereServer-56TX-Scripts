// EVENTLIST
PAGE 5
DORIGIN 20 50
IF (<ARRAYCOUNT <EVENTS>> > 0)
	BUTTON +0 +0 4006 4007 1 0 599
	DTEXT +30 +0 38 Event Temizle (<ARRAYCOUNT <EVENTS>>)
	FOR e 0 <eval <ARRAYCOUNT <EVENTS>>-1>
		ARGS=<EVENTS>
		DTEXT +30 <EVAL (<DLOCAL.E>*20)+80> 0 <ARGV[<DLOCAL.E>]>   
		IF (<SRC.ACCOUNT.PLEVEL> > 4)
			IF (<ISEVENT.<ARGV[<DLOCAL.X>]>>)
				BUTTON +0 <EVAL (<DLOCAL.e>*20)+80> 4017 4018 1 0 <EVAL <LOCAL.e>+500>
			ENDIF
		ENDIF
	ENDFOR
ELSE
	DTEXT +0 +0 38 Event yok
ENDIF






// TAGLIST
PAGE 6
DORIGIN 20 50
IF (<TAGCOUNT> > 0) && (<TAGCOUNT> < 250)
	BUTTON +0 +0 4006 4007 1 0 699
	DTEXT +30 +0 38 Tag Temizle (<tagcount>)
	
	FOR 0 <EVAL <TAGCOUNT>-1>
		IF (<DLOCAL._FOR> <= 50)
			IF (STRMATCH('0','<LOCAL.TAG>'))
				LOCAL.TAG = TAG.<TAGAT.<DLOCAL._FOR>.KEY>: <TAGAT.<DLOCAL._FOR>.value>
			ELSE
				LOCAL.TAG .=<DEF.BR>TAG.<TAGAT.<DLOCAL._FOR>.KEY>: <TAGAT.<DLOCAL._FOR>.value>
			ENDIF
		ENDIF
	ENDFOR
	DHTMLGUMP +0 +20 420 480 1 1 <LOCAL.TAG>
ELSE
	DTEXT +0 +0 38 Tag yok
ENDIF





