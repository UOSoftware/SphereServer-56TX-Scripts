	IF (<FLAGS>&Statf_<LOCAL.Flag>)
		CHECKBOX <eval 20+((<LOCAL._FOR>/20)*200)> <eval 50+((<LOCAL._FOR>%20)*20)> 210 211 1 <eval 400+<LOCAL._FOR>>
	ELSE
		CHECKBOX <eval 20+((<LOCAL._FOR>/20)*200)> <eval 50+((<LOCAL._FOR>%20)*20)> 210 211 0 <eval 400+<LOCAL._FOR>>
	ENDIF
