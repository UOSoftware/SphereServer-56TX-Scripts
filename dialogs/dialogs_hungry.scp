VERSION=0.56T

[COMMENT]


[DIALOG D_HUNGRY]
<DEF.dlgstartpos>
RESIZE 0,0,240,140,Hungry
LOCAL.FOOD=<FOOD>
LOCAL.MAXFOOD=<QVAL (<MAXFOOD>)?<MAXFOOD>:<SERV.CHARDEF.<ID>.MAXFOOD>>
DORIGIN 20 50

IF (<DLOCAL.MAXFOOD>)
	RESIZEPIC +0 +0 2620 200 35
	LOCAL.MAXWIDTH=193
	LOCAL.PERCENT=<MULDIV <DLOCAL.FOOD>,10	0,<DlOCAL.MAXFOOD>>
	LOCAL.WIDTH=<MULDIV <DLOCAL.FOOD>,200,<DLOCAL.MAXFOOD>>

	IF (<DLOCAL.WIDTH> >= <DLOCAL.MAXWIDTH>)
		LOCAL.WIDTH=<DLOCAL.MAXWIDTH>
	ENDIF
	IF (<DLOCAL.PERCENT> >= 100)
		LOCAL.PERCENT=100
	ENDIF

	RESIZEPIC +6 +6 3000 <EVAL <DLOCAL.WIDTH>-3> 23
	DTEXT +85 +9 1000 %<DLOCAL.PERCENT>
	DTEXT +0 +35 0 Food/MaxFood: <DLOCAL.FOOD>/<DLOCAL.MAXFOOD>
	DTEXT +0 +55 0 <ARGS>
ELSE
	DTEXT +0 +0 0 <ARGS>
ENDIF




[EOF]
