VERSION=TX

// Hesap pin'i. Pin hesabın PIN'idir (ACCOUNT.PIN; Md5Pins=1'de MD5 özeti). Emulatör sorar (0.56TX):
// - .pin (oyuncu komutu, argümansız): bu bağlantıda pin girilmemişse d_pin_login'i, girilmişse d_pin_main'i açar.
// - PINVERIFY <pin>: pin'i karşılaştırır; yanlış pin'leri hesapta sayar, PinMaxTries'ta bağlantıyı keser. Mesajları
//   emulatör yazar ([DEFMESSAGE] pin_*).
// - <ISPINVERIFIED>: hesabın pin'i yoksa ya da bu bağlantıda doğru girildiyse 1. Bağlantı bitince silinir, save'e girmez.
// Script'ler dialog'u f_pin_login ile açar, PIN ile değil: argümansız PIN, pakette d_pin_login yoksa pin'i siler (0.56T).
// Pin girilmeden nelerin yapılamayacağı e_pin'de ve f_oncommand'da.


// Pin girişi dialog'u, açıksa yeniden.
[FUNCTION f_pin_login]
DIALOGCLOSE d_pin_login
DIALOG d_pin_login


[DIALOG d_pin_login]
0,0

IF (<SRC.dTAG0.SCREENSIZE.W> <= 0)
	LOCAL.MAINX = 100
	LOCAL.MAINW = 2000
	LOCAL.MAINH = 2000
ELSE
	LOCAL.MAINX = <EVAL (<SRC.dTAG0.SCREENSIZE.W>-360)/2>
	LOCAL.MAINW = <EVAL <SRC.dTAG0.SCREENSIZE.W>+500>
	LOCAL.MAINH = <EVAL <SRC.dTAG0.SCREENSIZE.H>+500>
ENDIF

IF (<SRC.dTAG0.SCREENSIZE.H> <= 0)
	LOCAL.MAINY = 100
ELSE
	LOCAL.MAINY = <EVAL (<SRC.dTAG0.SCREENSIZE.H>-560)/2>
ENDIF

DORIGIN <LOCAL.MAINX> <LOCAL.MAINY>

RESIZE <LOCAL.MAINX>,<LOCAL.MAINY>,200,150,Pin Giriş

BUTTON +60 +83 072 073 1 0 1

RESIZEPIC +60 +45 11625 85 35
IF (<SRC.TAG0.TogglePinVisible>)
	DTEXTENTRYLIMITED +90 +55 60 30 1000 1 4
	BUTTON +155 +12 13070 13071 1 1 2
ELSE
	DTEXTENTRYLIMITED +90 +55 60 30 0 1 4
	BUTTON +155 +12 13071 13070 1 0 2
ENDIF

LOCAL.HTTPS https:/
DHTMLGUMP +20 +115 190 25 0 0 <def.bfont_black><DEF.L1>a href="<LOCAL.HTTPS>/<SERV.URL>/login?username=<ACCOUNT>&pwd=<STRSUB 5 99 <ACCOUNT.TAG0.PWD>>"<DEF.R1>Pinimi unuttum!<DEF.L1>/a<DEF.R1>


[DIALOG d_pin_login BUTTON]
ON=2
IF (<SRC.TAG0.TogglePinVisible>)
	SRC.TAG0.TogglePinVisible=
ELSE
	SRC.TAG0.TogglePinVisible=1
ENDIF
f_pin_login

ON=1
// Boş pin, yanlış pin ve sınır emulatörün; doğruysa ISPINVERIFIED 1 olur.
PINVERIFY <ARGTXT[1]>
IF (<ISPINVERIFIED>)
	EVENTS -E_PIN
ELSE
	f_pin_login
ENDIF



[DIALOG d_pin_main]
<DEF.DSP>

RESIZE 0,0,290,270,Pin
DORIGIN 20 50
DHTMLGUMP +0 +0 250 60 1 1 Pin kodu değişiklikleri internet sitesi üzerinden yapılmaktadır. Hesabınıza giriş yaptıktan sonra Pin bölümünden değişiklik yapabilirsiniz.
BUTTON +0 +70 4006 4007 1 0 3
DTEXT +30 +70 0455 Hesabıma git
DHTMLGUMP +0 +100 250 100 1 1 <def.bfont_red>Pinkodu sorulan yerler;<def.bfont_black><def.br>* Help menü<def.br>* Eşya kullanımı<def.br>* Komut kullanımı

[DIALOG d_pin_main BUTTON]
ON=1
SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Pin kodu ayarlarınız kaydedildi.
ACCOUNT.TAG.PIN_SPEECH=<ARGCHK[1]>
ACCOUNT.TAG.PIN_HELP=<ARGCHK[2]>
ACCOUNT.TAG.PIN_ITEMUSE=<ARGCHK[3]>
ACCOUNT.TAG.PIN_COMMAND=<ARGCHK[4]>

ON=2
DIALOGCLOSEALL d_staff_panel,d_pin_login
SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Pin sisteminden faylanmıyorsunuz. Karakteriniz ile ilgili herhangi bir güvenlik ihlalinden, kayıp vs. gibi şeylerden <serv.name> sunucusu sorumlu değildir.
EVENTS -E_PIN

ON=3
SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Pin değişimleri Hesabım > Pin bölümünden yapılmaktadır. Yönlendiriliyorsunuz...
OpenWebUrl <SERV.URL>/home
DIALOG d_pin_main

ON=4
SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Pin kodu ayarlarınız sıfırlandı.
ACCOUNT.TAG.PIN_SPEECH=
ACCOUNT.TAG.PIN_HELP=
ACCOUNT.TAG.PIN_ITEMUSE=
ACCOUNT.TAG.PIN_COMMAND=



// Pin girilmeden yapılamayanlar. Oyuncuya girişte verilir, pin girilince kalkar (e_generic_chars, d_pin_login).
[EVENTS e_pin]
ON=@ItemPickUp_Pack
IF (<SRC.REGION.SAFE>)
	IF !(<SRC.ISPINVERIFIED>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Pin girişi yapmadan bunu yapamazsınız.
		SRC.f_pin_login
		RETURN 1
	ENDIF
ENDIF

ON=@ITEMPICKUP_SELF
IF !(<SRC.REGION.SAFE>)
	IF !(<SRC.ISPINVERIFIED>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Pin girişi yapmadan bunu yapamazsınız.
		SRC.f_pin_login
		RETURN 1
	ENDIF
ENDIF

On=@ItemDClick
IF !(<SRC.ISPINVERIFIED>)

	IF ( (<ACT.BASEID> == I_BACKPACK) )
		LOCAL.PINSOR=0

	ELSEIF ((<ACT.TYPE> == T_POTION) || (<ACT.TYPE> == T_BANDAGE)  || (<ACT.TYPE> == T_DOOR) || (<ACT.TYPE> == T_DOOR_OPEN) || (<ACT.TYPE> == t_shield) )
		LOCAL.PINSOR=0

	ELSEIF ( (<ACT.ISWEAPON> == 1) || (<ACT.fIsArmor> == 1) )
		LOCAL.PINSOR=0

	ELSE
		LOCAL.PINSOR=1
	ENDIF

	IF (<DLOCAL.PINSOR> == 1)
		SRC.f_pin_login
		RETURN 1
	ENDIF

ENDIF

On=@ItemDropon_Ground
IF !(<SRC.ISPINVERIFIED>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Pin girişi yapmadan bunu yapamazsınız.
	SRC.f_pin_login
	RETURN 1
ENDIF



[EOF]
