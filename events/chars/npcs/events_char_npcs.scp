[EVENTS e_generic_npc_monster_spiders]
// ON=@NPCACTION
// serv.b NPCACTION

// ON=@NPCACTWANDER
// serv.b NPCACTWANDER

ON=@NPCSPECIALACTION
// serv.b NPCSPECIALACTION
TAG0.OVERRIDE.SPIDERWEB=0

// SPİDERWEB MANUEL YAPILDI, SPHERE ÇOK FAZLA ÇIKARTIYOR.
IF (<DTAG0.OVERRIDE.SPIDERWEB> <= 0)
	IF (RAND(400) == 1) 
		SERV.NEWITEM {0ee3 1 0ee4 1 0ee5 1 0ee6 1}
		NEW.TYPE = T_WEB
		NEW.TIMER {40 60}
		NEW.ATTR=ATTR_MOVE_NEVER|ATTR_DECAY
		NEW.P <P>
		// NEW.CANMASK |= CAN_O_NOSLEEP
		// serv.b spiderweb
	ENDIF
ENDIF


