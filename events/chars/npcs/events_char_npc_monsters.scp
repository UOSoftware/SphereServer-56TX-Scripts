

// sphere.ini EventsNpcMonster: sadece canavar NPC'lere (brain_monster, brain_berserk, brain_undead, brain_dragon) verilir.
[events e_generic_npc_monsters]
ON=@REGIONENTER
IF !(<NPC> == brain_guard)
	IF (<ARGO.FLAGS>&REGION_FLAG_SHIP|REGION_FLAG_SAFE|REGION_FLAG_GUARDED)
		SERV.log Monsterlar gemi, safe ve gz alanlara giremez. (<name>, <uid>)
		LEAVE <R3,5>
		REF1=<SPAWNITEM>
		IF (<REF1.ISVALIDE>)
			GOUID <REF1> // VARSA  SPAWNA GÖNDER.
		ENDIF
		RETURN 1
	ENDIF
ENDIF


[EVENTS e_monster_resist_field]
ON=@SPELLEFFECT
IF (<ARGN> == 28) || (<ARGN> == 39) || (<ARGN> == 47)
	FUNC_EMOTE_HELPFUL büyüden etkilenmez
	RETURN 1
ENDIF




[EVENTS e_monster_resist_poison_reflect]
ON=@SPELLEFFECT
IF (<ARGN> == 20)
	IF (RAND(5) == 1)
		FACE <SRC>
		ANIM 17
		FUNC_EMOTE_DEFAULT büyüyü geri çevirir
		IF (<FINDID.I_RUNE_POISON>)
			FINDID.I_RUNE_POISON.REMOVE
		ENDIF
		IF (<FINDID.I_RUNE_POISON_FIELD>)
			FINDID.I_RUNE_POISON_FIELD.REMOVE
		ENDIF
		EFFECT 3,0376A,1,30,1
		SOUND SND_SPELL_CURE
		SRC.POISON <FVAL <ARGN2>>
	ENDIF
RETURN 1
ENDIF





[EVENTS e_monster_resist_poison_hit]

ON=@GETHIT 
IF (<ARGN2>&dam_poison) && (<MANA> > 10)
	LOCAL.DAM = <ARGN1>
	FACE <SRC>
	ANIM 17
	FUNC_EMOTE_HELPFUL zehiri iyileştirir
	SOUND SND_SPELL_CURE
	MANA -=10
	ARGN1 = <EVAL <DLOCAL.DAM>/2>	
	EFFECT 3,0376A,1,30,1
	IF (<FINDID.I_RUNE_POISON>)
		FINDID.I_RUNE_POISON.REMOVE
	ENDIF
	IF (<FINDID.I_RUNE_POISON_FIELD>)
		FINDID.I_RUNE_POISON_FIELD.REMOVE
	ENDIF
ENDIF





[EVENTS e_monster_resist_spelleffect]

ON=@SPELLEFFECT
IF (<SERV.SPELL.<ARGN>.LAYER>&layer_spell_stats) || (<ARGN> == 5)
	FACE <SRC>
	ANIM 17
	FUNC_EMOTE_HELPFUL büyüden etkilenmez
	RETURN 1
ENDIF





[EVENTS e_monster_resist_poison_spelleffect]

ON=@SPELLEFFECT
IF (<ARGN> == 20) || (<ARGN> == 39)
	FACE <SRC>
	ANIM 17
	FUNC_EMOTE_HELPFUL büyüden etkilenmez
	IF (<FINDID.I_RUNE_POISON>)
		FINDID.I_RUNE_POISON.REMOVE
	ENDIF
	IF (<FINDID.I_RUNE_POISON_FIELD>)
		FINDID.I_RUNE_POISON_FIELD.REMOVE
	ENDIF
	EFFECT 3,0376A,1,30,1
	SOUND SND_SPELL_CURE 
	RETURN 1
ENDIF






[EVENTS e_monster_heal]

ON=@GETHIT
IF (<HITS> < <EVAL <STR>/3>)
	IF (RAND(15) == 1)
		LOCAL.DAM = <ARGN1>
		ANIM 17
		FUNC_EMOTE_HELPFUL kendini iyileştirir
		EFFECT=3,I_FX_HEAL_EFFECT,6,35,1 
		SOUND SND_SPELL_GREATER_HEAL 
		HITS +=<EVAL (<DLOCAL.DAM>/2)>
	ENDIF
ENDIF





[EVENTS e_monster_resist_summons]

ON=@GETHIT
// <SRC>	// TARGET
// <UID>	// CHAR
IF (<SRC.FINDID.I_RUNE_SUMMON_CREATURE>)
	FUNC_EMOTE_HELPFUL büyü etkisini kaldırır 
	EFFECT=3,i_fx_heal_effect,6,35,1 
	SOUND=SND_SPELL_GREATER_HEAL
	SRC.FINDID.I_RUNE_SUMMON_CREATURE.TIMER=
ENDIF


ON=@ATTACK
// <SRC>	// TARGET
// <UID>	// CHAR
IF (<SRC.FINDID.I_RUNE_SUMMON_CREATURE>)
	FUNC_EMOTE_HELPFUL büyü etkisini kaldırır 
	EFFECT=3,I_FX_HEAL_EFFECT,6,35,1 
	SOUND=SND_SPELL_GREATER_HEAL
	SRC.FINDID.I_RUNE_SUMMON_CREATURE.TIMER=
ENDIF




[EVENTS e_monster_intelligent]
ON=@Spelleffect
// poison resist
IF (<ARGN> == 20)
	SAYU * <NAME> resists poison *
	FINDID.i_rune_poison.REMOVE
	RETURN 1
ENDIF

IF (<ARGN> == 38)
	SAYU * <NAME> resists paralyze *
	FINDID.i_rune_paralyze.REMOVE
	RETURN 1
ENDIF



ON=@GetHit
// poison resist
IF (<FINDID.i_rune_poison>)
	SAYU * <NAME> resists poison *
	FINDID.i_rune_poison.REMOVE
ENDIF

// conjured flagi varsa dispel cak
IF (<SRC.FINDID.I_RUNE_SUMMON_CREATURE>) 
	IF (<MANA> > 21)
		SOUND=snd_SPELL_DISPEL
		FACE
		SRC.SPELLEFFECT 41 1000 // dispel
		// src.remove // daemonlar yok olmuyo?
		MANA -=20
		SAYU * <NAME> casts dispel *
	ENDIF 
ENDIF 

// hit point str/5 e dusmusse heal cek kendine
IF (<HITS> < (<STR>/5)) 
	IF (<MANA> > 101)
		SOUND=snd_SPELL_GREATER_HEAL 
		SPELLEFFECT 29 4000 // greater heal
		MANA -=100
		SAYU * <NAME> casts heal *
	ENDIF 
ENDIF 

// karsidaki polymorph olmussa dispel cak
IF (<SRC.FINDID.I_RUNE_POLYMORPH>)
	IF (<MANA> > 21) 
		SOUND=snd_SPELL_DISPEL
		FACE
		SRC.SPELLEFFECT 41 1000 // dispel
		MANA -=20
		SAYU * <NAME> casts dispel *
		RETURN 1
	ENDIF 
ENDIF 

// X'in canavar event'leri (Scripts-X events/e_npcs.scp): CHARDEF'lerin TEVENTS'i ve
// @Create'teki f_addExtendedAIEvent ile verilir.

[DEFNAME extendedAI]
ExtendedAI=1

[FUNCTION f_addExtendedAIEvent]
if (<def.ExtendedAI>==1)
    events +<args>
endif

[EVENTS e_Undead]
ON=@EnvironChange
   Return 0
   // Enter "//" before Return 0, if you want to make script working
   // i like the dark
   if (<sector.isdark>) || (<flags>& (statf_nightsight|statf_indoors))
      if (!<tag0.lightstr>)
         return 0
      endif
      anim 011
      bark 4
      str=<tag.lightstr>   // restore me.
      hits=<str>
      tag.lightstr=
      karma=<tag0.lightkarma>
      tag.lightkarma=//just dispose of this.
      fame=<tag0.lightfame>
      tag.lightfame=
      flags ^= statf_conjured   // no loot if killed.
      return 0
   endif
   // i can't live in light areas. weaken me ? or destroy me ?
   anim 014
   bark 4
   if (<tag0.lightstr>)
      return 0
   endif
   if ( <flags>&statf_conjured   )
      remove
      return 1
   endif
   flags |= statf_conjured   // no loot if killed.
   tag.lightstr=<str>
   str=1
   hits=1   // very weak.
   tag.lightkarma=<karma>   // killing it means nothing now.
   karma=-2
   tag.lightfame=<fame>
   fame=10
   return 0

[EVENTS e_extendedAI_aura_frost]
ON=@GetHit
//Ice Aura Attack
IF !(<R3>)
  REF11=<UID>
  FORCHARS 3
     IF (<ISPLAYER>) || (<FLAGS>&statf_pet)
        LOCAL.DAM=<R10,20>
        DAMAGE <LOCAL.DAM> <DEF.dam_cold> <REF11>
        SYSMESSAGE Intense cold radiating from the demon damages you
     ENDIF
  ENDFOR
ENDIF

[EVENTS e_extendedAI_aura_fire]
ON=@GetHit
//Fire Aura Attack
IF ( (<MANA> >= 20) && !(<R5>) )
  MANA -= 20
  REF11=<UID>
  FORCHARS 3
     IF (<ISPLAYER>) || (<FLAGS>&statf_pet)
        LOCAL.DAM=<R10,20>
        DAMAGE <LOCAL.DAM> <DEF.dam_fire> <REF11>
        SYSMESSAGE Intense heat radiating from the serpent damages you
     ENDIF
  ENDFOR
ENDIF

[EVENTS e_extendedAI_aura_summonDreadSpider]
ON=@GetHit
IF !(<R9>)
    SERV.NEWNPC c_spider_dread
    NEW.P=<P>
    NEW.HOME=<NEW.P>
    NEW.HOMEDIST=7
    NEW.f_NPCRemovalTimer 120 // X'te olmayan REMOVETIMER yerine
endif

[EVENTS e_extendedAI_hit_etherealWarrior]
ON=@Hit
HITS += <EVAL <ARGN1>/6>
IF (<HITS> > <MAXHITS>)
    HITS=<MAXHITS>
endif
STAM += <EVAL <ARGN1>/12>
IF (<STAM> > <MAXSTAM>)
    STAM=<MAXSTAM>
endif
SRC.STAM -= <EVAL <ARGN1>/12>
IF (<SRC.STAM> < 0)
    SRC.STAM=0
endif
MANA += <EVAL <ARGN1>/9>
IF (<MANA> > <MAXMANA>)
    MANA=<MAXMANA>
endif
SRC.MANA -= <EVAL <ARGN1>/9>
IF (<SRC.MANA> < 0)
    SRC.MANA=0
endif

[EVENTS e_extendedAI_plageBeast_eatCorpse]
ON=@ItemStep
IF (<ACT.TYPE>==t_corpse)
    IF !(<ACT.TAG0.PLAGUEEATEN>)
        MAXHITS += 200
        HITS += 200
        ACT.TAG.PLAGUEEATEN=1
        SAY @03c1,3,1 * <NAME> eats a corpse *
    endif
endif

[EVENTS e_extendedAI_aura_summon_fireAntWorker]
ON=@GetHit
IF !(<R10>)
    SERV.NEWNPC c_solen_worker // X'te tanımı olmayan C_FIRE_ANT_WORKER yerine (Red Solen Worker)
    NEW.P=<P>
    NEW.HOME=<NEW.P>
    NEW.HOMEDIST=7
    NEW.f_NPCRemovalTimer 120 // X'te olmayan REMOVETIMER yerine
endif


[eof]
