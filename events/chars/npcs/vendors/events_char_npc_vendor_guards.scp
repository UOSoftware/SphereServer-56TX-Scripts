
// sphere.ini EventsNpcGuard: sadece brain_guard NPC'lere verilir.
[events e_generic_npc_guards]
ON=@CLICK
// MESSAGE @0,3 [Guards Agency]
Messageloc 0,3301054

ON=@NPCRefuseItem
SAYLOC 0,3301044
return 1

// guardin hp gitmesin.
// ON=@GetHit
// RETURN 1


// guarda büyü islemesin
// ON=@SPELLEFFECT
// RETURN 1

ON=@ATTACK
GO <SRC.P>
// SRC.KILL

ON=@DEATH
REF1=<QVAL (<SRC.ATTACKER.LAST>)?<SRC.ATTACKER.LAST>:<SRC.ATTACKER.MAX>> // ÖLDÜREN
IF (<REF1.ISVALID> && <REF1.ISPLAYER>)
    REF1.KILLS=<eval <serv.MurderMinCount>>
    REF1.SYSMESSAGELOC 38,3300156
ENDIF


ON=@CRIMINAL
RETURN 1


[eof]
