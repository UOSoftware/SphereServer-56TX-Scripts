
// sphere.ini EventsNpcTeacher: sadece brain_teacher NPC'lere verilir.
[events e_generic_npc_teachers]
// ON=@CLICK
// MESSAGE @035 [<JOB>]
// MESSAGE @058 <NAME>
// RETURN 1

ON=@DCLICK
IF !(<SRC.ISGM>)
	IF (<SRC.FLAGS>&STATF_DEAD) 
		SRC.SYSMESSAGELOC <def.tcolor_red>,600027 // Ölü durumdayken bu islemi yapamazsiniz.
		RETURN 1
	ELSEIF (<SRC.ISDIFF 2,<UID>>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,600018,<JOB> <NAME>
		RETURN 1
	ENDIF
ENDIF
FACE <SRC>
DIALOGCLOSE D_TEACH_INFO
DIALOG D_TEACH_INFO
RETURN 1

[eof]
