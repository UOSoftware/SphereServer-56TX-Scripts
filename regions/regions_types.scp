// GRAVEYARDS
[REGIONTYPE r_graveyards]
ON=@RegPeriodic
SRC.SOUND={0a 1 0b 1}


// DUNGEONS
[REGIONTYPE r_dungeons]


// SHRINES
[REGIONTYPE r_shrines]

[REGIONTYPE r_shrine_humility]

[REGIONTYPE r_shrine_chaos]

[REGIONTYPE r_shrine_honesty]

[REGIONTYPE r_shrine_sacrifice]

[REGIONTYPE r_shrine_valor]

[REGIONTYPE r_shrine_spirituality]

[REGIONTYPE r_shrine_justice]

[REGIONTYPE r_shrine_honor]


// FORESTS
[REGIONTYPE r_forests]
ON=@RegPeriodic
IF (<SRC.SECTOR.ISNIGHTTIME>)
SRC.SOUND={00 2 01 2 02 2 07d 1}	//Play these sounds at night.
ELSE
SRC.SOUND={08 10 09 10 0219 1 07d 1}	//Play these sounds during the day.
ENDIF

// JUNGLES
[REGIONTYPE r_jungle]
ON=@RegPeriodic
IF (<SRC.SECTOR.ISNIGHTTIME>)
SRC.SOUND={0c 2 0d 2 0b3 1}
ELSE
SRC.SOUND={03 2 04 2 05 2 0b3 1}
ENDIF

// STAR CHAMBER
[REGIONTYPE r_star]

// JAILS
[REGIONTYPE r_jails]


// GUARD TOWER.
[REGIONTYPE r_guard_tower]
ON=@ENTER
IF (<SRC.ISPLAYER>)
	// SRC.MUSIC=midi_ForestA
	SRC.MIDILIST=midi_ForestA
ENDIF


// LORD BRIT CASTLE.
[REGIONTYPE r_brit_castle]
ON=@ENTER
IF (<SRC.ISPLAYER>)
	// SRC.MUSIC=midi_LBCastle
