	IF (<SRC.TARGP.STATICS.0.TYPE> == T_WATER) || (<SRC.TARGP.STATICS.0.TYPE> == T_LAVA) || (strmatch(*t_multi*,'<SRC.TARGP.REGION.TYPE>')) || (strmatch(*t_ship*,'<SRC.TARGP.REGION.TYPE>'))
		SRC.SKILL FAIL
		SRC.ACTION -1
