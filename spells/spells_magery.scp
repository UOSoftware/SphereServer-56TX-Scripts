[Spell 32]
DEFNAME=s_recall
NAME=Recall
SOUND=snd_SPELL_RECALL
RUNES=.Kal Ort Por
CAST_TIME=4.0
RESOURCES=i_reag_black_pearl,i_reag_blood_moss,i_reag_mandrake_root
RUNE_ITEM=i_rune_RECALL
SCROLL_ITEM=i_scroll_RECALL
FLAGS=SPELLFLAG_TARG_ITEM|SPELLFLAG_PLAYERONLY
EFFECT_ID=i_fx_smoke
EFFECT=0
DURATION=0.0
MANAUSE=0
SKILLREQ=MAGERY 40.0
INTERRUPT=100.0,100.0

ON=@Start
// Char Check

IF !(<SRC.IsCastUseSpell 32>)
	SRC.SKILL FAIL
	RETURN 1
ENDIF

IF (<ACT>)

	IF (<ACT.TYPE> == T_RUNE)
		ACT.MORE1=65000 // rune power hep full olsun.
	ENDIF
	
	// Item Check
	IF (<ACT.TYPE> == T_KEY)
		REF99=<ACT.LINK> // GEMİ
		IF ((<REF99>) && (<REF99.TYPE> == T_SHIP))	
			REF98=<REF99.LINK>
			IF ((<REF98>) && (<REF98.TYPE> == T_SHIP_TILLER))	
				// LOCAL.SHIP_POS = <REF98.P.X>,<REF98.P.Y>,<eval <REF98.P.Z>+5>,<REF98.P.M>
				LOCAL.SHIP_POS = <REF99.P.X>,<eval <REF99.P.Y>-1>,<eval <REF99.P.Z>+5>,<REF99.P.M>
				ACT.MOREP = <LOCAL.SHIP_POS>
			ELSE
				SRC.SYSMESSAGELOC <def.tcolor_red>,3300559
				SRC.SKILL FAIL
				RETURN 1	
			ENDIF
		ELSE
			SRC.SYSMESSAGELOC <def.tcolor_red>,3300560
			SRC.SKILL FAIL
			RETURN 1		
		ENDIF
		
	ELSEIF (<ACT.TYPE> == T_RUNE)
		IF (<ACT.MOREX> <= 0)
			SRC.SYSMESSAGELOC <def.tcolor_red>,3300561
			SRC.SKILL FAIL
			RETURN 1
		ENDIF
		REF100=<ACT.LINK>
	ELSE
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300562,<act.type>
		SRC.SKILL FAIL
		RETURN 1
	ENDIF
ENDIF

// Hedefin kontrolleri (kendi karesi, yasak deed, yürünebilirlik, lav, deniz, bölge bayrakları, ev, gemi) motorda:
//  sphere.ini'nin RecallSpellFlags'i (IsCastUseSpell'in notu).


on=@Success
IF (<SRC.ACT>)
	REF1=<SRC.ACT> // item
	IF (<REF1.TYPE> == T_RUNE)
		REF1.MORE1=65000 // rune power hep full olsun.
	ENDIF
ENDIF


