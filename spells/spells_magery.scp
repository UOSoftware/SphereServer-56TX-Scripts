FLAGS=SPELLFLAG_TARG_CHAR|SPELLFLAG_FX_TARG|SPELLFLAG_GOOD|SPELLFLAG_TARG_DEAD|SPELLFLAG_PLAYERONLY|SPELLFLAG_TARG_NO_NPC|SPELLFLAG_TARG_NOSELF
EFFECT_ID=i_fx_sparkle
EFFECT=0
DURATION=0.0
MANAUSE=50
SKILLREQ=MAGERY 90.0
INTERRUPT=100.0,100.0

ON=@EFFECT
IF (<MEMORYFINDTYPE.MEMORY_TOWN>) && !(<SRC.MEMORYFINDTYPE.MEMORY_TOWN>)
	SRC.SYSMESSAGELOC 0,3300557
	SRC.SKILL FAIL
	SRC.ACTION -1
	RETURN 1
ENDIF

// Hedefin guild memoryi var mı ve align > 0 mu?
IF (<MEMORYFINDTYPE.MEMORY_GUILD> && <MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN> > 0)
	// Src guildsiz mi?
	IF !(<SRC.MEMORYFINDTYPE.MEMORY_GUILD>)
		SRC.SYSMESSAGELOC 0,3300558
		ACT.SYSMESSAGELOC 0,3300587,<SRC.NAME>
		SRC.SKILL FAIL
		SRC.ACTION -1
		RETURN 1
	ELSE // Src guildi var, align > 0 ve farklı mı?
		IF (<SRC.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN> > 0 && <SRC.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN> != <MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN>)
			SRC.SYSMESSAGELOC 0,3300558
			ACT.SYSMESSAGELOC 0,3300588,<SRC.NAME>
			SRC.SKILL FAIL
			SRC.ACTION -1
			RETURN 1
		ENDIF
	ENDIF
ENDIF
IF (<ISNEARTYPE T_DOOR 1>) || (<ISNEARTYPE T_DOOR_LOCKED 1>) || (<ISNEARTYPE T_DOOR_OPEN 1>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300589
	SYSMESSAGELOC <def.tcolor_red>,3300590,<SRC.NAME>
	SRC.ACTION -1
	SRC.ACTARG1=
	SRC.SKILL FAIL
	RETURN 1
ENDIF


ON=@START
IF (<ACT.ISNEARTYPE T_DOOR 1>) || (<ACT.ISNEARTYPE T_DOOR_LOCKED 1>) || (<ACT.ISNEARTYPE T_DOOR_OPEN 1>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300589
	ACT.SYSMESSAGELOC <def.tcolor_red>,3300590,<SRC.NAME>
	SRC.ACTION -1
	SRC.ACTARG1=
	// SRC.ACTPRV= // BU NIYE VAR AQ?
	SRC.SKILL FAIL
	RETURN 1
ELSEIF (<ACT.FINDID.I_MEMORY_HELPPAGE_STUCK>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300591
	SRC.ACTION -1
	SRC.ACTARG1=
	// SRC.ACTPRV= // BU NIYE VAR AQ?
	SRC.SKILL FAIL
	RETURN 1
ENDIF


