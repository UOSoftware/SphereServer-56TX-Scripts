[Spell 22]
DEFNAME=s_teleport
NAME=Teleport
SOUND=snd_SPELL_TELEPORT
RUNES=.Rel Por
CAST_TIME=1.5
RESOURCES=i_reag_blood_moss,i_reag_mandrake_root
RUNE_ITEM=i_rune_TELEPORT
SCROLL_ITEM=i_scroll_TELEPORT
FLAGS=SPELLFLAG_TARG_XYZ
EFFECT_ID=0
EFFECT=0
DURATION=0.0
MANAUSE=9
SKILLREQ=MAGERY 30.0
INTERRUPT=100.0,100.0

ON=@SELECT
IF (<SRC.REGION.FLAGS>&REGION_FLAG_SHIP)
	SRC.SKILL FAIL
	SRC.ACTION -1
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300548
	RETURN 1
ENDIF

ON=@SUCCESS
IF (<SRC.DISTANCE <SRC.TARGP>> > 13)
	SRC.SKILL FAIL
	SRC.ACTION -1
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300549,<SRC.DISTANCE <SRC.TARGP>>
	RETURN 1
ENDIF
	
ON=@Start
IF (<SRC.REGION.FLAGS>&REGION_FLAG_SHIP)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300548
	RETURN 1
ENDIF
IF (<SRC.TARGP>) 
	IF (<SRC.DISTANCE <SRC.TARGP>> > 13)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300549,<SRC.DISTANCE <SRC.TARGP>>
		RETURN 1
	ELSEIF (<SRC.TARGP.Z> >= <EVAL <SRC.P.Z>+18>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300550
		RETURN 1
	ENDIF
ENDIF

