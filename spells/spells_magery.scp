DEFNAME=s_archcure
NAME=Arch Cure
SOUND=snd_SPELL_ARCHCURE
RUNES=.Vas An Nox
CAST_TIME=2.0
RESOURCES=i_reag_garlic,i_reag_ginseng,i_reag_mandrake_root
RUNE_ITEM=i_rune_ARCHCURE
SCROLL_ITEM=i_scroll_ARCHCURE
FLAGS=SPELLFLAG_FX_TARG|SPELLFLAG_GOOD|SPELLFLAG_AREA
EFFECT_ID=i_fx_HEAL_EFFECT
EFFECT=0
DURATION=0.0
MANAUSE=11
SKILLREQ=MAGERY 40.0
INTERRUPT=100.0,100.0

ON=@EFFECT
IF (<ISITEM>)
	RETURN 1
ENDIF

IF (<ISPLAYER>)

	IF (<MEMORYFINDTYPE.MEMORY_TOWN>) && !(<SRC.MEMORYFINDTYPE.MEMORY_TOWN>)
		SRC.SYSMESSAGELOC 0,3300553
		RETURN 1
	ENDIF
	
	// Hedefin guild memoryi var mı ve align > 0 mu?
	IF (<MEMORYFINDTYPE.MEMORY_GUILD> && <MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN> > 0)
		// Src guildsiz mi?
		IF !(<SRC.MEMORYFINDTYPE.MEMORY_GUILD>)
			SRC.SYSMESSAGELOC 0,3300554
			RETURN 1
		ELSE // Src guildi var, align > 0 ve farklı mı?
			IF (<SRC.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN> > 0 && <SRC.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN> != <MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN>)
				SRC.SYSMESSAGELOC 0,3300554
				RETURN 1
			ENDIF
		ENDIF
	ENDIF

	// effect kontrol
	// zaten cure itemi altinda sorgu var. burada ikinci sorguya gerek yok
	// IF (<FINDID.I_RUNE_POISON>)
	//     LOCAL.MaxMorey <EVAL ((<SRC.MAGERY> + 400) / 2)>
	// 	IF (<FINDID.I_RUNE_POISON.MOREY> > <dLOCAL.MaxMorey>)
	// 		IF !(RAND(8) == 1)
	// 			EFFECT 3,0374A,1,15,1
	// 			SOUND SND_SPELL_POISON
	// 			RETURN 1
	// 		ENDIF
	// 	ENDIF
	// ENDIF

ENDIF

