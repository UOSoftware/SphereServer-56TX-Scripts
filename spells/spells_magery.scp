IF (<ACT.ISVALID> && <ACT.ISCHAR>)
	IF (<SRC.INT> > <ACT.INT>)
		LOCAL.MB <EVAL (<SRC.INT> - <ACT.INT>)>
		LOCAL.MB <EVAL (<DLOCAL.MB> / 2)>
		IF (<DLOCAL.MB> > 40)
			LOCAL.MB 40
		ENDIF
		LOCAL.Dmg = <EVAL (<DLOCAL.MB> + {-5 5)>
	ELSE
		LOCAL.Dmg <R5,10>
	ENDIF
	ACT.DAMAGE <dlocal.dmg>, <SRC> , <DEF.DAMAGE_MAGIC>
ENDIF

	
