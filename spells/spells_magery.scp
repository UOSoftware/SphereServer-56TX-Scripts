// Hedefin kontrolleri motorda: sphere.ini'nin GateSpellFlags'i (IsCastUseSpell'in notu). Büyü SPELLFLAG_SCRIPTED
//  olsa da motor cast başlarken ve biterken (@Success'ten önce) denetler; gate'e giriş d_runebook_gate'te.

SERV.NEWITEM I_MOONGATE_BLUE_FX
NEW.P=<ACT.MOREP>
NEW.ATTR=ATTR_DECAY|ATTR_MOVE_NEVER
NEW.TYPE=T_SCRIPT
NEW.TIMER=5
NEW.MOREZ 1
NEW.COLOR=022
NEW.NAME=summoning gate
NEW.MOREP=1,1,1,1
NEW.SOUND 526


ON=@Success
// GATE 1
SERV.NEWITEM I_RUNEBOOK_GATE
NEW.P=<SRC.P>
NEW.MOREP=<ACT.MOREP>
NEW.TIMER=20
NEW.MORE1=5
NEW.SOUND 535
NEW.COLOR=022
LOCAL.GATE1=<NEW.UID>

// GATE 2
SERV.NEWITEM I_RUNEBOOK_GATE
NEW.P=<ACT.MOREP>
NEW.MOREP=<SRC.P>
NEW.TIMER=20
NEW.MORE1=5
NEW.SOUND 535
LOCAL.GATE2=<NEW.UID>

REF1=<LOCAL.GATE1>
REF2=<LOCAL.GATE2>
IF (<REF1.ISVALID> && <REF2.ISVALID>)
	REF1.LINK <REF2>
	REF2.LINK <REF1>
ENDIF
NEW.COLOR=022



