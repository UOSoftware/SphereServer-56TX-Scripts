[Spell 20]
// NOTE: Does poison need a duration or are they stuck with it until cured ??
DEFNAME=s_poison
NAME=Poison
SOUND=snd_SPELL_POISON
RUNES=.In Nox
CAST_TIME=2.0
RESOURCES=i_reag_nightshade
RUNE_ITEM=i_rune_POISON
SCROLL_ITEM=i_scroll_POISON
LAYER=LAYER_FLAG_Poison
// FLAGS=SPELLFLAG_NOUNPARALYZE|SPELLFLAG_TARG_CHAR|SPELLFLAG_DIR_ANIM|SPELLFLAG_HARM|SPELLFLAG_FX_TARG|SPELLFLAG_RESIST|SPELLFLAG_TARG_NOSELF
FLAGS=SPELLFLAG_TARG_CHAR|SPELLFLAG_DIR_ANIM|SPELLFLAG_HARM|SPELLFLAG_FX_TARG|SPELLFLAG_RESIST|SPELLFLAG_TARG_NOSELF
EFFECT_ID=i_fx_curse
EFFECT=15,20
DURATION=2,3
MANAUSE=9
SKILLREQ=MAGERY 30.0
INTERRUPT=100.0,100.0

// argn1 = spell
// argn2 = level
// argn3 = 0
// argo = item
// local.Charges 
// local.Delay 
// local.DamageType 
// local.Effect 

ON=@EffectTick
IF (<ARGN2> >= 4) // LETHALLY LEVEL
	ARGN2=3 // DEADLY LEVEL
ENDIF
IF (<LOCAL.EFFECT> >= 8) // LETHALLY EFFECT
	LOCAL.EFFECT=8 // DEADLY EFFECT
ENDIF
// LOCAL.DAMAGETYPE=(<DEF.dam_poison>|<def.dam_fixed>|<DEF.dam_magic>|<def.dam_god>)
LOCAL.DAMAGETYPE=(<DEF.dam_poison>|<def.dam_fixed>|<DEF.dam_magic>|<def.dam_god>)

ON=@EffectAdd
IF (<ARGO> && <ARGO.ISVALID>)
	ARGO.TAG.OVERRIDE.CUREPOISONCHANCE = 100
ENDIF

ON=@EFFECT
IF !(<FINDID.I_RUNE_POISON>) && (<FLAGS>&STATF_POISONED)
	FLAGS <FLAGS>&~STATF_POISONED
ENDIF
IF !(<SRC> == <UID>)
	SKILL FAIL
ENDIF
IF (<FINDID.I_RUNE_POISON>)
	LOCAL.PoisonMorey = <FINDID.I_RUNE_POISON.MOREY>
ELSE
	LOCAL.PoisonMorey = 0
ENDIF

IF (<EVAL (<SRC.POISONING> + 100)> > <DLOCAL.PoisonMorey>)
	IF (<FINDID.I_RUNE_PARALYZE>)
		FINDID.I_RUNE_PARALYZE.REMOVE
	ENDIF
	IF (<FINDID.I_RUNE_PARALYZE_FIELD>)
		FINDID.I_RUNE_PARALYZE_FIELD.REMOVE
	ENDIF
	IF (<FINDID.I_RUNE_POISON>)
		FINDID.I_RUNE_POISON.REMOVE
	ENDIF
	IF (<DISTANCE <SRC>> > 3) && (<EVAL (<SRC.POISONING> + 100)> > 700)
		LOCAL.PoisonPower <EVAL (600 + {-100 100})>
	ELSE
		LOCAL.PoisonPower <EVAL (<SRC.POISONING> + {-100 100} )>
	ENDIF
	LOCAL.EFFECT <DLOCAL.PoisonPower>
	SRC.SYSMESSAGELOC 0,3300546,<fval <dlocal.effect>>,<DISTANCE <SRC>>
ENDIF


[Spell 21]
DEFNAME=s_telekinesis
