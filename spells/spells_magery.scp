		IF (<SRC.TARGP.REGION.flags>&REGION_FLAG_NO_PVP|REGION_FLAG_SHIP|REGION_FLAG_HOUSE|REGION_FLAG_SAFE)
			SRC.SYSMESSAGELOC <def.tcolor_red>,3300551
			SRC.SKILL FAIL
			SRC.ACTION -1
			SRC.ACTARG1=
			RETURN 1
		ENDIF
	ENDIF
	IF ((<SRC.TARGP.ISNEARTYPE T_DEED_UYARI_UNCLOSE <DLOCAL.KARE>>) || (<SRC.TARGP.ISNEARTYPE T_DEED_UYARI_UNCLOSE_BLOCK <DLOCAL.KARE>>) || (<SRC.TARGP.ISNEARTYPE T_DEED_UYARI_UNCLOSE_FIELD <DLOCAL.KARE>>))
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300552,<DLOCAL.KARE>
		SRC.SKILL FAIL
		SRC.ACTION -1
		SRC.ACTARG1=
		RETURN 1
	ENDIF
ENDIF


[Spell 40]
DEFNAME=s_summon_creature
NAME=Summon
SOUND=snd_SPELL_SUMMON_CREATURE
RUNES=.Kal Xen
CAST_TIME=2.5
RESOURCES=i_reag_blood_moss,i_reag_mandrake_root,i_reag_spider_silk
RUNE_ITEM=i_rune_SUMMON_CREATURE
SCROLL_ITEM=i_scroll_SUMMON_CREATURE
FLAGS=SPELLFLAG_TARG_XYZ|SPELLFLAG_SUMMON
LAYER=layer_spell_summon
EFFECT_ID=0
EFFECT=0
DURATION=1*60.0,2*60.0
MANAUSE=14
SKILLREQ=MAGERY 60.0
INTERRUPT=100.0,100.0

ON=@START
FORITEMS <EVAL <SERV.MapViewSize>*10>
	IF ((<TYPE> == T_DEED_UYARI_UNCLOSE) || (<TYPE> == T_DEED_UYARI_UNCLOSE_BLOCK) || (<TYPE> == T_DEED_UYARI_UNCLOSE_FIELD)) && (<TAG0.KARE>)
	LOCAL.KARE <DTAG0.KARE>
		IF (<SRC.DISTANCE <UID>> <= <DTAG0.KARE>)
			SRC.SKILL FAIL
			SRC.ACTION -1
			SRC.SYSMESSAGELOC <def.tcolor_red>,3300579,<DTAG0.KARE>
			RETURN 1
		ENDIF
	ENDIF
ENDFOR
IF (<SRC.TARGP>)
REF1=<SRC.TARGP.REGION.UID>
	IF (<REF1>) && (<REF1.TYPE> == T_MULTI) || (<REF1.TYPE> == T_SHIP)
		SRC.SKILL FAIL
		SRC.ACTION -1
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300577
		RETURN 1
	ENDIF
	IF (<SRC.TARGP.STATICS.0.TYPE> == T_WATER) || (<SRC.TARGP.STATICS.0.TYPE> == T_LAVA) || (strmatch(*t_multi*,'<SRC.TARGP.REGION.TYPE>')) || (strmatch(*t_ship*,'<SRC.TARGP.REGION.TYPE>'))
		SRC.SKILL FAIL
		SRC.ACTION -1
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300578
		RETURN 1
	ENDIF
ENDIF


[Spell 41]
DEFNAME=s_dispel
NAME=Dispel
SOUND=snd_SPELL_DISPEL
RUNES=.An Ort
CAST_TIME=2.8
RESOURCES=i_reag_garlic,i_reag_mandrake_root,i_reag_sulfur_ash
RUNE_ITEM=i_rune_DISPEL
SCROLL_ITEM=i_scroll_DISPEL
FLAGS=SPELLFLAG_TARG_CHAR |SPELLFLAG_DIR_ANIM
EFFECT_ID=0
EFFECT=0
DURATION=0.0
MANAUSE=20
SKILLREQ=MAGERY 70.0
INTERRUPT=100.0,100.0

ON=@EFFECT
IF (<MEMORYFINDTYPE.MEMORY_TOWN>) && !(<SRC.MEMORYFINDTYPE.MEMORY_TOWN>)
	SRC.SKILL FAIL
	SRC.ACTION -1
	SRC.SYSMESSAGELOC 0,3300557
	RETURN 1
ENDIF

// Hedefin guild memoryi var mı ve align > 0 mu?
IF (<MEMORYFINDTYPE.MEMORY_GUILD> && <MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN> > 0)
	// Src guildsiz mi?
	IF !(<SRC.MEMORYFINDTYPE.MEMORY_GUILD>)
		SRC.SKILL FAIL
		SRC.ACTION -1
		SRC.SYSMESSAGELOC 0,3300558
		RETURN 1
	ELSE // Src guildi var, align > 0 ve farklı mı?
		IF (<SRC.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN> > 0 && <SRC.MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN> != <MEMORYFINDTYPE.MEMORY_GUILD.LINK.ALIGN>)
			SRC.SKILL FAIL
			SRC.ACTION -1
			SRC.SYSMESSAGELOC 0,3300558
			RETURN 1
		ENDIF
	ENDIF
ENDIF


