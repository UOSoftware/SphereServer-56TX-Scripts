

[TYPEDEF T_STONE_TOWN]

ON=@Click
// MESSAGE @1153,0 * <NAME> * <QVAL (<EVAL STRLEN(<ABBREV>)>) ? [<ABBREV>]:>
MESSAGE @1153,0 <NAME>
// MESSAGE Lonca Stone
IF (<SERV.AREA(<TAG0.CITYDEF>)>)
MESSAGE @<color>,,1,1 Şehir: <serv.area(<tag0.citydef>).name>
ENDIF
MESSAGE @,,1,1 Üye sayısı: <member.count>
RETURN 1


ON=@DCLICK
REF1=<UID>
FORINSTANCES i_town_stone
	IF (<REF1> != <UID>) && !(<UID.<REF1>.GUILDFROMUID.<UID>.ISENEMY>)
		DECLAREWAR <REF1>
		REF1.DECLAREWAR <UID>
	ENDIF
ENDFOR

// IF (<SRC.ISOUTOFREACH 2,<UID>>)
	// SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, <NAME>: <DEF.REACH_FAIL>
	// RETURN 1
// ENDIF
IF !(<SRC.MEMORYFINDTYPE.MEMORY_TOWN>)

	IF (<SRC.MEMORYFINDTYPE.MEMORY_GUILD>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Guild üyesiyken factiona giremezsiniz.
		RETURN 1
	ENDIF
		
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Herhangi bir factiona üyesi değilsiniz.
	DIALOGCLOSE D_TOWN_REGISGN
	DIALOG D_TOWN_REGISGN
ELSE
	IF (<MEMBERFROMUID.<SRC>.PRIV> > 0)
		SRC.SYSMESSAGELOC <def.tcolor_green>,<def.empty_cliloc2>, Bu factiona üyesiniz.
		DIALOGCLOSE D_TOWN_MAIN
		DIALOG D_TOWN_MAIN,0
	ELSE
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu factiona üye değilsiniz.
	ENDIF
ENDIF

