


[REGIONTYPE r_townFaction]

ON=@EXIT
IF (<SRC.ISPLAYER>)
SRC.SYSMESSAGELOC <def.tcolor_red>,3300969
ENDIF

ON=@ENTER
IF !(<SRC.MEMORYFINDTYPE.MEMORY_TOWN>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300970
	RETURN 1

ELSE
	REF1=<SRC.MEMORYFINDTYPE.MEMORY_TOWN.LINK>
	IF (<REF1.ISITEM>) && (<REF1.TYPE> == T_STONE_TOWN)
	
		IF (<REGION.DEFNAME> != <REF1.TAG0.CITYDEF>)
			IF (<SRC.ISPLAYER>)
				SRC.SYSMESSAGELOC <def.tcolor_red>,3300971
				SRC.POISON 100.0
				SRC.DAMAGE {3 8}
			ENDIF
		ELSE
			SRC.SYSMESSAGELOC <def.tcolor_green>,3300972,<src.name>
		ENDIF
		
	ENDIF
ENDIF


[eof]
