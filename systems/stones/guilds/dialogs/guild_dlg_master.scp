VERSION=0.56T


[DIALOG D_GUILD_MASTER]
<DEF.dsp>
IF (<TYPE>!=T_STONE_GUILD)
	RETURN 1
ELIF (<MASTERUID>!=<SRC.UID>)&&(!<SRC.ISGM>)
	RETURN 1
ENDIF


PAGE 0
RESIZE 0,0,340,440,Guildmaster

DORIGIN 20 50

IF (<TAG0.CHANGENAME_TIME> <= <SERV.TIME>)
	DHTMLGUMP +30 +0 270 25 1 0 Guild adını değiştir
	BUTTON +0 +0 4006 4007 1 0 1 
ELSE
	DHTMLGUMP +30 +0 270 25 1 0 <DEF.BFONT_DRED>Guild adını değiştir (<f_stonesys_determine_timeleft <tag0.changename_time>>)
	GUMPPIC +0 +0 4020
ENDIF


IF (<TAG0.CHANGEABBREV_TIME> <= <SERV.TIME>)
	DHTMLGUMP +30 +30 270 25 1 0 <def.bfont_black>Guild kısaltmasını değiştir
	BUTTON +0 +30 4006 4007 1 0 2 
ELSE
	DHTMLGUMP +30 +30 270 25 1 0 <DEF.BFONT_DRED>Guild kısaltmasını değiştir (<f_stonesys_determine_timeleft <tag0.changeabbrev_time>>)
	GUMPPIC +0 +30 4020
ENDIF


IF (<F_GUILDSYS_ISWARRING>)
	DHTMLGUMP +30 +60 270 25 1 0 Destek yönü (Savaş esnasında kullanamazsınız)
	GUMPPIC +0 +60 4020
ELIF (<TAG0.CHANGEALIGN_TIME> <= <SERV.TIME>)
	DHTMLGUMP +30 +60 270 25 1 0 Destek yönü: (<def0.guildconfig_align_<align>>) // Guild Type
	BUTTON +0 +60 4006 4007 1 0 3
ELSE
	DHTMLGUMP +30 +60 270 25 1 0 <DEF.BFONT_DRED>Destek yönü (<f_stonesys_determine_timeleft <tag0.changealign_time>>) // Guild Type
	GUMPPIC +0 +60 4020
ENDIF

DHTMLGUMP +30 +90 270 25 1 0 Guild tüzüğü belirle
BUTTON +0 +90 4006 4007 1 0 4


IF (<MEMBER.COUNT> > 1)
	DHTMLGUMP +30 +120 270 25 1 0 Üyelikten çıkart
	BUTTON +0 +120 4006 4007 1 0 5
ELSE
	DHTMLGUMP +30 +120 270 25 1 0 <DEF.BFONT_DRED>Üyelikten çıkart (Üye yok)
	GUMPPIC +0 +120 4021
ENDIF

DHTMLGUMP +30 +150 270 25 1 0 Savaş menüsü
BUTTON +0 +150 4006 4007 1 0 6
  
IF (<MEMBER.COUNT <DEF0.STONEPRIV_CANDIDATE>> > 0)
	DHTMLGUMP +30 +180 270 25 1 0 Aday üye listesi
	BUTTON +0 +180 4006 4007 1 0 7
ELSE
	DHTMLGUMP +30 +180 270 25 1 0 <DEF.BFONT_DRED>Şu anda üyelik için aday yok.
	GUMPPIC +0 +180 4021
ENDIF

DHTMLGUMP +30 260 270 25 1 0 Guildmaster ünvanını değiştir
BUTTON +0 260 4006 4007 1 0 8
  
IF (<MEMBER.COUNT> > 1)
	DHTMLGUMP +30 290 270 25 1 0 Üyeye unvan verin.
	BUTTON +0 290 4006 4007 1 0 9
ELSE
	DHTMLGUMP +30 290 270 25 1 0 <DEF.BFONT_DRED>Üyeye unvan verin. (Üye yok)
	GUMPPIC +0 290 4021
ENDIF

DHTMLGUMP +30 320 115 25 1 0 Guild rengi
BUTTON +0 320 4006 4007 1 0 13

DHTMLGUMP +185 320 115 25 1 0 Guildstone stili
BUTTON +155 320 4006 4007 1 0 14

IF (<DEF0.GUILDCONFIG_ALLOWTRANSFER>)
	DHTMLGUMP +30 370 270 25 1 0 Guildi transfer et
	BUTTON +0 370 4006 4007 1 0 12
ENDIF

BUTTON +0 400 4015 4016 1 0 11
DHTMLGUMP +30 400 155 25 0 0 <def.bfont_black>Ana menüye dön 
  
[DIALOG D_GUILD_MASTER BUTTON]
ON=0
SDIALOG d_Guild_Main,0

// Guild Name 
ON=1 
IF (<TAG0.CHANGENAME_TIME> <= <SERV.TIME>)
	SRC.CTAG.GUILD_PROMPTHANDLER_GUILDUID=<UID>
	TRY SRC.PROMPTCONSOLE F_PROMPTHANDLER_GUILDNAME
	SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Yeni guild adını giriniz. (En az: <dDEF0.GUILDCONFIG_NAME_MINLENGTH> En fazla: <dDEF0.GUILDCONFIG_NAME_MAXLENGTH>):
ELSE
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Guild adını değiştirmek için bir süre beklemelisiniz.
ENDIF

	
// Guild Abbrev	
ON=2
IF (<TAG0.CHANGEABBREV_TIME> <= <SERV.TIME>)
	SRC.CTAG.GUILD_PROMPTHANDLER_GUILDUID=<UID>
	TRY SRC.PROMPTCONSOLE F_PROMPTHANDLER_GUILDABBREV,Yeni guild kısaltmasını giriniz. (En az: <dDEF0.GUILDCONFIG_ABBREV_MINLENGTH> En fazla: <dDEF0.GUILDCONFIG_ABBREV_MAXLENGTH>):    
ELSE
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Guild kısaltmasını değiştirmek için bir süre beklemelisiniz.
ENDIF

// Guild  Type
ON=3
IF ((!<F_GUILDSYS_ISWARRING>) || (<TAG0.CHANGEALIGN_TIME> <= <SERV.TIME>))
	SDIALOG D_GUILD_CHANGEALIGN,0
ENDIF

// Charter	
ON=4
SDIALOG d_Guild_SetCharter,0,

// Dismiss member
ON=5
SDIALOG D_GUILD_CHARLIST,0,<DEF0.GUILDDLG_LISTTYPE_DISMISSMEMBER>

// War Menu	
ON=6
SDIALOG D_GUILD_MASTER_WARFARE,0
	
// Candidate Menu
ON=7
SDIALOG D_GUILD_CHARLIST,0,<DEF0.GUILDDLG_LISTTYPE_ADMINCANDIDATES>

// Set Guildmaster title
ON=8
SRC.CTAG.GUILD_PROMPTHANDLER_GUILDUID=<UID>
SRC.CTAG.GUILD_PROMPTHANDLER_THISUID=<SRC.UID>
TRY SRC.PROMPTCONSOLE F_PROMPTHANDLER_GUILDTITLE
SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Yeni ünvan giriniz. (En fazla:<dDEF0.GUILDCONFIG_TITLE_MAXLENGTH>):

// Grant title
ON=9
SDIALOG D_GUILD_CHARLIST,0,<DEF0.GUILDDLG_LISTTYPE_GRANTTITLE>

ON=11
SDIALOG D_GUILD_MAIN,0
	
ON=12
IF (<DEF0.GUILDCONFIG_ALLOWTRANSFER>)
	TRANSFERSTONE <UID>
ENDIF
	
ON=13
DIALOGCLOSE d_Guild_StoneColor
DIALOG d_Guild_StoneColor,0
	
ON=14
DIALOGCLOSE D_GUILD_STONESTYLE
DIALOG D_GUILD_STONESTYLE,0

  
[EOF]
  
