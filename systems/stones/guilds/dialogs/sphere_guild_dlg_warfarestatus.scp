VERSION=0.56T


[dialog d_Guild_WarfareStatus]
<DEF.dsp>
IF (<TYPE>!=T_STONE_GUILD)
	RETURN 1
ELIF (<MEMBERFROMUID.<SRC.UID>.UID>!=<SRC.UID>)&&(!<SRC.ISGM>)
	RETURN 1
ENDIF
  LOCAL.CHARPRIV=<QVAL <SRC.ISGM> ? <DEF0.STONEPRIV_MASTER>:<MEMBERFROMUID.<SRC.UID>.PRIV>>
IF (<LOCAL.CHARPRIV>!=<DEF0.STONEPRIV_MEMBER>)&&(<LOCAL.CHARPRIV>!=<DEF0.STONEPRIV_MASTER>)
	RETURN 1
ENDIF

LOCAL.GUILDCOUNT=<GUILD.COUNT>

// The gump
PAGE 0
RESIZE 0,0,560,445,Savas Durumu

BUTTON 20 400 0FAF 0FB0 1 0 0 // Quit
DHTMLGUMP 55 400 120 25 0 0 Ana menüye dön

PAGE 1
BUTTON 525 400 015A4 015A5 0 2 0 // Next Page
DHTMLGUMP 440 400 100 25 0 0 Sonraki sayfa

DHTMLGUMP 30 50 400 20 0 0 Şunlarla savaş halindeyiz:

// AT WAR LIST
IF (<GUILD.COUNT <DEF0.STONEPRIV_ENEMY>>==0)  
	DHTMLGUMP 60 80 400 20 0 0 <DEF.BFONT_DRED>- Mevcut savaş yok.
ELSE
	LOCAL.GICURRENT=0
	LOCAL.GPCURRENT=0
	WHILE (<LOCAL.GICURRENT> < <LOCAL.GUILDCOUNT>)
		LOCAL.GCUIDCURRENT = <GUILD.<LOCAL.GICURRENT>.UID>
			IF (<GUILDFROMUID.<LOCAL.GCUIDCURRENT>.ISENEMY>)
				DHTMLGUMP 30 <EVAL (75 + (<LOCAL.GPCURRENT> * 20))> 300 20 0 0 - <uid.<local.gcuidcurrent>.name> <qval (strlen(<uid.<local.gcuidcurrent>.abbrev>))&&(<DEF0.GUILDCONFIG_GUILDLIST_SHOWABBREV>) ? [<uid.<local.gcuidcurrent>.abbrev>]:>
				LOCAL.GPCURRENT += 1
			ENDIF
		LOCAL.GICURRENT += 1
	ENDWHILE
ENDIF
  
  
PAGE 2
BUTTON 250 400 015a1 015a2 0 1 0 // Previous Page
DHTMLGUMP 270 400 150 25 0 0 Önceki sayfa

BUTTON 525 400 015A4 015A5 0 3 0 // Next Page
DHTMLGUMP 440 400 100 25 0 0 Sonraki sayfa

DHTMLGUMP 30 50 400 20 0 0 Savaş ilan ettiğimiz guildler:

// We Declare List
IF (<GUILD.COUNT <DEF0.STONEPRIV_WEDECLARED>>==0)  
	DHTMLGUMP 60 80 400 20 0 0 <DEF.BFONT_DRED>- Savaş ilan ettiğiniz guild yok.
ELSE
  LOCAL.GICURRENT=0
  LOCAL.GPCURRENT=0
  WHILE (<LOCAL.GICURRENT> < <LOCAL.GUILDCOUNT>)
    LOCAL.GCUIDCURRENT = <GUILD.<LOCAL.GICURRENT>.UID>
    IF (<GUILDFROMUID.<LOCAL.GCUIDCURRENT>.WEWAR> && !<GUILDFROMUID.<LOCAL.GCUIDCURRENT>.THEYWAR>)
      DHTMLGUMP 30 <EVAL (75 + (<local.gpcurrent> * 20))> 300 20 0 0 - <uid.<local.gcuidcurrent>.name> <qval (strlen(<uid.<local.gcuidcurrent>.abbrev>))&&(<DEF0.GUILDCONFIG_GUILDLIST_SHOWABBREV>) ? [<uid.<local.gcuidcurrent>.abbrev>]:>
      LOCAL.GPCURRENT += 1
    ENDIF
    LOCAL.GICURRENT += 1
  ENDWHILE
ENDIF
  
  

PAGE 3
BUTTON 250 400 015a1 015a2 0 2 0 // Previous Page
DHTMLGUMP 270 400 150 25 0 0 Önceki sayfa

DHTMLGUMP 30 50 400 20 0 0 Bize savaş ilan eden guildler:


// THEY DECLARED LIST
IF (<GUILD.COUNT <DEF0.STONEPRIV_THEYDECLARED>>==0)  
    DHTMLGUMP 60 80 400 20 0 0 <DEF.BFONT_DRED>- Savaş için davet alınmadı
ELSE
	LOCAL.GICURRENT=0
	LOCAL.GPCURRENT=0
	WHILE (<LOCAL.GICURRENT> < <LOCAL.GUILDCOUNT>)
		LOCAL.GCUIDCURRENT = <GUILD.<LOCAL.GICURRENT>.UID>
		IF (<GUILDFROMUID.<LOCAL.GCUIDCURRENT>.THEYWAR> && !<GUILDFROMUID.<LOCAL.GCUIDCURRENT>.WEWAR>)
			DHTMLGUMP 30 <EVAL (75 + (<local.gpcurrent> * 20))> 300 20 0 0 - <uid.<local.gcuidcurrent>.name> <qval (strlen(<uid.<local.gcuidcurrent>.abbrev>))&&(<DEF0.GUILDCONFIG_GUILDLIST_SHOWABBREV>) ? [<uid.<local.gcuidcurrent>.abbrev>]:>
			LOCAL.GPCURRENT += 1
		ENDIF
	LOCAL.GICURRENT += 1
	ENDWHILE
ENDIF



[DIALOG D_GUILD_WARFARESTATUS BUTTON]
ON=0
SDIALOG D_GUILD_MAIN,0
RETURN 1
  
[EOF]
