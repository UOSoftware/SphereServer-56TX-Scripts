VERSION=0.56T

[dialog d_Guild_ViewCharter]
<DEF.dsp>
IF (<TYPE>!=T_STONE_GUILD)
	RETURN 1
ELIF (<MEMBERFROMUID.<SRC.UID>.UID>!=<SRC.UID>)&&(!<SRC.ISGM>)
	RETURN 1
ENDIF
	LOCAL.CHARPRIV=<QVAL <SRC.ISGM> ? <DEF0.STONEPRIV_MASTER>:<MEMBERFROMUID.<SRC.UID>.PRIV>>
IF (<LOCAL.CHARPRIV>!=<DEF0.STONEPRIV_MEMBER>)&&(<LOCAL.CHARPRIV>!=<DEF0.STONEPRIV_MASTER>)
	RETURN 1
ENDIF
  
page 0
RESIZE 0,0,550,390,Tuzuk

BUTTON 30 350 4015 4014 1 0 0 // Return
DHTMLGUMP 60 350 120 25 0 0 <def.bfont_black>Ana menüye dön

IF (<ISEMPTY <CHARTER0>>)
  LOCAL.NOEMPTY=0
  LOCAL.CHARTERTEXT=<DEF0.BR>
ELSE
  LOCAL.NOEMPTY=1
  LOCAL.CHARTERTEXT=<CHARTER0><DEF0.BR>
ENDIF

FOR _LINE 1 5
	IF (<ISEMPTY <CHARTER<DLOCAL._LINE>>>)
		LOCAL.CHARTERTEXT .= <DEF0.BR>
	ELSE
		LOCAL.CHARTERTEXT .= <CHARTER<DLOCAL._LINE>><DEF0.BR>
		LOCAL.NOEMPTY += 1
	ENDIF
ENDFOR

IF (!<LOCAL.NOEMPTY>)
	DHTMLGUMP 20 50 510 30 1 0 <DEF.BFONT_DRED>Hiçbir tüzük tanımlanmadı.
ELSE
	DHTMLGUMP 20 50 510 150 0 1 <def.bfont_black><LOCAL.CHARTERTEXT>
ENDIF

DHTMLGUMP 60 200 300 20 0 0 <def.bfont_black>Web sitemizi ziyaret edin : 
BUTTON 30 200 0fbe 0fbf 1 0 1 // Website
  
LOCAL.WEBSITE=<WEBPAGE>
IF (<EVAL STRLEN(<LOCAL.WEBSITE>)> <= 3) // A WEBSITE CANT BE THAT SMALL
	LOCAL.WEBSITE=<SERV.URL>
ENDIF
  
DHTMLGUMP 60 220 300 20 0 0 <def.bfont_black><local.website>


[dialog d_Guild_ViewCharter Button]
ON=0
SDIALOG D_GUILD_MAIN,0

ON=1
LOCAL.WEBSITE=<WEBPAGE>

IF (<EVAL STRLEN(<LOCAL.WEBSITE>)> <= 3)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Webste bağlantı adresi bu kadar kısa olamaz.
	LOCAL.WEBSITE=<SERV.URL>
ENDIF
SRC.OpenWebUrl <LOCAL.WEBSITE>
RETURN 1





//------------------------------------------------------------------------
[dialog d_Guild_SetCharter]
110, 70
IF (<TYPE>!=T_STONE_GUILD)
  RETURN 1
ELIF (<MASTERUID>!=<SRC.UID>)&&(!<SRC.ISGM>)
  RETURN 1
ENDIF

page 0
RESIZEPIC 0 0 2520 350 400
TILEPIC 30 50 3805
TILEPIC 275 50 3805

DHTMLGUMP 20 115 300 25 0 0 <DEF.CENTER>Tüzük
GUMPPIC 76 126 95
GUMPPIC 85 135 96
GUMPPIC 264 126 97

DHTMLGUMP 80 70 200 60 0 0 <DEF.CENTER>Maddeler halinde bir tüzük veya internet sayfası belirleyin.


DHTMLGUMP 20 290 300 25 0 0 <DEF.CENTER>Web
GUMPPIC 76 301 95
GUMPPIC 85 310 96
GUMPPIC 264 301 97

BUTTON 195 370 2130 2129 1 0 1
BUTTON 255 370 2121 2120 1 0 0

FOR 0 5
	RESIZEPIC 40 <EVAL (<DLOCAL._FOR>*25)+145> 2630 270 25
	DTEXTENTRYLIMITED 45 <EVAL (<DLOCAL._FOR>*25)+150> 250 25 1153 <EVAL <DLOCAL._FOR>+1000> 16 <CHARTER<DLOCAL._FOR>>
ENDFOR


LOCAL.WEBSITE=<WEBPAGE>
IF (<EVAL STRLEN(<LOCAL.WEBSITE>)> <= 3) // A WEBSITE CANT BE THAT SMALL
	LOCAL.WEBSITE=<SERV.URL>
ENDIF

GUMPPIC 40 328 1143
DTEXTENTRY 50 331 250 32 0 1 <LOCAL.WEBSITE>


[dialog d_Guild_SetCharter Button]
ON=0
IF (<MASTERUID>!=<SRC.UID>)&&(!<SRC.ISGM>)
	SDIALOG D_GUILD_MAIN,0
ENDIF
SDIALOG D_GUILD_MASTER,0

ON=1
IF (<MASTERUID>!=<SRC.UID>)&&(!<SRC.ISGM>)
	SDIALOG D_GUILD_MAIN,0
ENDIF
  
FOR 0 5
	CHARTER<DLOCAL._FOR>=<StrReplaceSQL <ARGTXT[<EVAL <DLOCAL._FOR>+1000>]>>
ENDFOR

WEBPAGE=<StrReplaceSQL <ARGTXT[1]>>
SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Guild tüzüğü güncellendi.
SDIALOG d_Guild_SetCharter,0
RETURN 1

[EOF]
