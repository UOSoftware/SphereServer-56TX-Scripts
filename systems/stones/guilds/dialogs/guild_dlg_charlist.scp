VERSION=0.56T


[DIALOG D_GUILD_CHARLIST]
<DEF.dsp>
LOCAL.LISTTYPE=<ARGS>

IF (<LOCAL.LISTTYPE> <= 0)||(<LOCAL.LISTTYPE> > 6)
	RETURN 1
	
ELIF (<TYPE>!=T_STONE_GUILD)
	RETURN 1
	
ELIF (<MEMBERFROMUID.<SRC.UID>.UID>!=<SRC.UID>)&&(!<SRC.ISGM>)
	RETURN 1
ENDIF
  
PAGE 0
RESIZE 0,0,550,435,Uye Listesi

LOCAL.PRIVTOLIST=-1
LOCAL.SHOWCHECKBOX=1

DORIGIN 20 20

IF (<LOCAL.LISTTYPE>==<DEF0.GUILDDLG_LISTTYPE_LOYALITY>)
	LOCAL.PRIVTOLIST=<DEF.STONEPRIV_MEMBER>
	
	DHTMLGUMP +0 +30 510 25 1 0 <DEF.CENTER>Tam Üye Listesi<DEF.CENTERE>
	  
	BUTTON +340 +370 4005 4007 1 0 1
	DHTMLGUMP +370 +370 140 25 0 0 Yeni Master Seçimi

ELSEIF (<LOCAL.LISTTYPE>==<DEF0.GUILDDLG_LISTTYPE_ROSTER>)
	LOCAL.PRIVTOLIST=<DEF.STONEPRIV_MEMBER>
	LOCAL.SHOWCHECKBOX=0

ELSEIF (<LOCAL.LISTTYPE>==<DEF0.GUILDDLG_LISTTYPE_CANDIDATES>)
	LOCAL.PRIVTOLIST=<DEF.STONEPRIV_CANDIDATE>
	LOCAL.SHOWCHECKBOX=0
	DHTMLGUMP +0 +30 510 25 1 0 <DEF.CENTER>Aday Üye Listesi<DEF.CENTERE>
	
ELSEIF (<LOCAL.LISTTYPE>==<DEF0.GUILDDLG_LISTTYPE_DISMISSMEMBER>)
	LOCAL.PRIVTOLIST=<DEF.STONEPRIV_MEMBER>
	DHTMLGUMP +0 +30 510 25 1 0 <DEF.CENTER>Hangi üyeyi kovmak istiyorsunuzu?<DEF.CENTERE>
		
	BUTTON +295 +373 0FA3 0FA4 1 0 1
	DHTMLGUMP +325 +370 150 30 1 0 <DEF.BFONT_DRED>Kov

ELSEIF (<LOCAL.LISTTYPE>==<DEF0.GUILDDLG_LISTTYPE_GRANTTITLE>)
	LOCAL.PRIVTOLIST=<DEF.STONEPRIV_MEMBER>
	DHTMLGUMP +0 +30 510 25 1 0 <DEF.CENTER>Ünvan vermek istediğiniz üyeyi seçiniz.<DEF.CENTERE>
	
	BUTTON +295 +373 4006 4007 1 0 1
	DHTMLGUMP +325 +370 150 30 1 0 <def.bfont_black>Ünvan ver

ELSEIF (<LOCAL.LISTTYPE>==<DEF0.GUILDDLG_LISTTYPE_ADMINCANDIDATES>)  
	LOCAL.PRIVTOLIST=<DEF.STONEPRIV_CANDIDATE>
	DHTMLGUMP +0 +30 510 25 1 0 <DEF.CENTER>Üyelik için adayları kabul et veya reddet<DEF.CENTERE>
	
	BUTTON 30 400 4005 4007 1 0 1
	DHTMLGUMP 60 400 245 30 0 0 <DEF.BFONT_GREEN>Kabul et
	
	BUTTON 300 400 4005 4007 1 0 2
	DHTMLGUMP 360 400 100 30 0 0 <DEF.BFONT_RED>Reddet
ENDIF

BUTTON +230 +370 4005 4007 1 0 999
DHTMLGUMP +260 +370 60 25 0 0 Takip

BUTTON +0 +370 0faf 0fb0 1 0 0
DHTMLGUMP +30 +370 120 25 0 0 <def.bfont_black>Ana menüye dön
  
IF (<LOCAL.PRIVTOLIST>==-1)
	RETURN 1
ENDIF
 
LOCAL.CURRENT=0
LOCAL.CURRENTGUMP=0
LOCAL.TOTALCOUNT=<MEMBER.COUNT>
LOCAL.TOTALPRIVCOUNT=<MEMBER.COUNT <LOCAL.PRIVTOLIST>>

IF (<LOCAL.LISTTYPE>==<DEF0.GUILDDLG_LISTTYPE_LOYALITY>)||(<LOCAL.LISTTYPE>==<DEF0.GUILDDLG_LISTTYPE_ROSTER>)
	LOCAL.TOTALPRIVCOUNT += 1
	LOCAL.EXTRAWHILECONDITION=1
ENDIF

SRC.CTAG.DIALOG_GUILDCHARLIST_TYPE=<LOCAL.LISTTYPE>
TRY SRC.CTAG.DIALOG_GUILDCHARLIST_<DLOCAL.LISTTYPE>_COUNT=<LOCAL.TOTALPRIVCOUNT>
TRY SRC.CTAG.DIALOG_GUILDCHARLIST_<DLOCAL.LISTTYPE>_RADIO=<LOCAL.SHOWCHECKBOX>

WHILE (<LOCAL.CURRENTGUMP> < <LOCAL.TOTALPRIVCOUNT>)

	// ---- Condition for executing -----
	LOCAL.IFISOK=<MEMBER.<LOCAL.CURRENT>.UID>
	IF (<LOCAL.EXTRAWHILECONDITION>)
		LOCAL.IFISOK=<LOCAL.IFISOK> && ((<MEMBER.<LOCAL.CURRENT>.PRIV>==<LOCAL.PRIVTOLIST>) || (<MEMBER.<LOCAL.CURRENT>.ISMASTER>))
	ELSE
		LOCAL.IFISOK=<LOCAL.IFISOK> && (<MEMBER.<LOCAL.CURRENT>.PRIV>==<LOCAL.PRIVTOLIST>)
	ENDIF
	// ----------------------------------

	IF (<LOCAL.IFISOK>)
	
		// ----- Begin: Page ------
		IF ((<LOCAL.CURRENTGUMP> % 12)==0)
			IF (<LOCAL.CURRENTGUMP> != 0)
				BUTTON 300 370 4005 4007 0 <EVAL ((<LOCAL.CURRENTGUMP>/12)+1)> 0
			ENDIF
			PAGE <EVAL ((<LOCAL.CURRENTGUMP>/12)+1)>
			IF (<LOCAL.CURRENTGUMP> != 0)
				BUTTON 250 370 4014 4016 0 <EVAL (<LOCAL.CURRENTGUMP>/12)> 0
			ENDIF
		ENDIF
		// --------End: Page --------

		IF (<LOCAL.SHOWCHECKBOX>)
			RADIO 30 <EVAL (80 + <EVAL ((<LOCAL.CURRENTGUMP> % 12) * 25)>)> 208 209 0 <EVAL (<LOCAL.CURRENT> + 10)>
		ENDIF

		LOCAL.CURRENTMEMBERUID=<MEMBER.<LOCAL.CURRENT>.UID>
		REF1=<LOCAL.CURRENTMEMBERUID>
		IF (<EVAL STRLEN(<UID.<LOCAL.CURRENTMEMBERUID>.NAME>)>)
			DTEXT <QVAL <LOCAL.SHOWCHECKBOX> ? 50 : 50> <EVAL (80 + <EVAL ((<LOCAL.CURRENTGUMP> % 12) * 25)>)> <DEF.NOTO.<REF1.NOTOGETFLAG>> <REF1.NAME><QVAL (!<ISEMPTY <MEMBERFROMUID.<LOCAL.CURRENTMEMBERUID>.GUILDTITLE>>)&&(<DEF0.GUILDCONFIG_CHARLIST_SHOWTITLE>) ? , <MEMBERFROMUID.<LOCAL.CURRENTMEMBERUID>.GUILDTITLE>:>
		ELSE
			DTEXT <QVAL <LOCAL.SHOWCHECKBOX> ? 50 : 50> <EVAL (80 + <EVAL ((<LOCAL.CURRENTGUMP> % 12) * 25)>)> 0 BOŞ
		ENDIF
  
		LOCAL.CURRENTGUMP += 1
	ENDIF
  
  
	// ----- Begin: Total Member -----
	LOCAL.CURRENT += 1
	IF (<LOCAL.CURRENT> >= <LOCAL.TOTALCOUNT>)
		LOCAL.CURRENTGUMP=<LOCAL.TOTALPRIVCOUNT>
	ENDIF
	// --------Eng: Total member -----
  
ENDWHILE



[DIALOG D_GUILD_CHARLIST BUTTON]
ON=999
LOCAL.SELECTEDMEMBER=<ARGCHKID> - 10
IF ((<LOCAL.SELECTEDMEMBER> < 0) || (<LOCAL.SELECTEDMEMBER> > <MEMBER.COUNT>))
	SDIALOG D_GUILD_MAIN,0
	RETURN 1
ENDIF

LOCAL.MEMBERUID=<MEMBER.<LOCAL.SELECTEDMEMBER>.UID>
IF (!<LOCAL.MEMBERUID>)
	SDIALOG D_GUILD_MAIN,0
	RETURN 1
ENDIF
REF1=<LOCAL.MEMBERUID>
SRC.ARROWQUEST <REF1.P.X>,<REF1.P.Y>,<EVAL <REF1>>


SDIALOG D_GUILD_MAIN,0


ON=0 2
IF (!<SRC.CTAG0.DIALOG_GUILDCHARLIST_TYPE>)
	SERV.LOG SDIALOG d_Guild_CharList veya src.ctag.dialog_guildcharlist_type olmadan cagirildi.
	RETURN 1
ENDIF
  
// ---- Var set ----
LOCAL.LISTTYPE=<SRC.CTAG0.DIALOG_GUILDCHARLIST_TYPE>
LOCAL.LISTTYPECOUNT=<SRC.CTAG0.DIALOG_GUILDCHARLIST_<DLOCAL.LISTTYPE>_COUNT>
LOCAL.LISTTYPERADIO=<SRC.CTAG0.DIALOG_GUILDCHARLIST_<DLOCAL.LISTTYPE>_RADIO>
SRC.CTAG.DIALOG_GUILDCHARLIST_TYPE=
TRY SRC.CTAG.DIALOG_GUILDCHARLIST_<DLOCAL.LISTTYPE>_COUNT=
TRY SRC.CTAG.DIALOG_GUILDCHARLIST_<DLOCAL.LISTTYPE>_RADIO=
  
LOCAL.MEMBERUID=0
IF (<LOCAL.LISTTYPERADIO> && <LOCAL.LISTTYPECOUNT>)

	LOCAL.SELECTEDMEMBER=<ARGCHKID> - 10
	IF ((<LOCAL.SELECTEDMEMBER> < 0) || (<LOCAL.SELECTEDMEMBER> > <MEMBER.COUNT>))
		SDIALOG D_GUILD_MAIN,0
		RETURN 1
	ENDIF

	LOCAL.MEMBERUID=<MEMBER.<LOCAL.SELECTEDMEMBER>.UID>
	IF (!<LOCAL.MEMBERUID>)
		SDIALOG D_GUILD_MAIN,0
		RETURN 1
	ENDIF
	
ENDIF

IF (<LOCAL.LISTTYPE>==<DEF0.GUILDDLG_LISTTYPE_ROSTER>)||(<LOCAL.LISTTYPE>==<DEF0.GUILDDLG_LISTTYPE_CANDIDATES>)
	SDIALOG D_GUILD_MAIN,0
	RETURN 1
ENDIF

// ---------------------------------------------
IF (<LOCAL.LISTTYPE>==<DEF0.GUILDDLG_LISTTYPE_LOYALITY>)

	IF (<ARGN1>==1)
		LOCAL.OLDMASTER=<MASTERUID>
		TRY MEMBERFROMUID.<SRC.UID>.LOYALTO=<LOCAL.MEMBERUID>
		ELECTMASTER
		IF (<LOCAL.OLDMASTER>!=<MASTERUID>)&&(<MASTERUID>)
			F_GUILDSYS_SENDSMSG <UID>,GUILDMASTER <MASTER> olarak değiştirildi.
		ENDIF
	ENDIF
	SDIALOG D_GUILD_MAIN,0


// ---------------------------------------------

ELIF (<LOCAL.LISTTYPE>==<DEF0.GUILDDLG_LISTTYPE_DISMISSMEMBER>)

IF (<ARGN1>==1)
	REF999=<LOCAL.MEMBERUID>
	IF !(<REF999.ISONLINE>)
		IF (<REF999.FINDID.I_GUILD_RESIGN_MEMORY>)
			REF999.FINDID.I_GUILD_RESIGN_MEMORY.REMOVE
		ENDIF
	ENDIF
	F_GUILDSYS_REMOVECHARFROMGUILD <UID>,<LOCAL.MEMBERUID>
	SDIALOG D_GUILD_CHARLIST,0,<DEF0.GUILDDLG_LISTTYPE_DISMISSMEMBER>
ELSE
	IF (<SRC.ISGM>)||(<MASTERUID>==<SRC.UID>)
		SDIALOG D_GUILD_MASTER,0
	ELSE
		SDIALOG D_GUILD_MAIN,0
	ENDIF
ENDIF


// ---------------------------------------------
ELIF (<LOCAL.LISTTYPE>==<DEF0.GUILDDLG_LISTTYPE_GRANTTITLE>)

	IF (<ARGN1>==1)
		SRC.CTAG.GUILD_PROMPTHANDLER_GUILDUID=<UID>
		SRC.CTAG.GUILD_PROMPTHANDLER_THISUID=<LOCAL.MEMBERUID>
		SRC.PROMPTCONSOLE F_PROMPTHANDLER_GUILDTITLE
		SRC.SYSMESSAGELOC <def.tcolor_text>,3300901,<DDEF0.GUILDCONFIG_TITLE_MAXLENGTH>
		
	ELSEIF (<SRC.ISGM>)||(<MASTERUID>==<SRC.UID>)
		SDIALOG D_GUILD_MASTER,0
	ELSE
		SDIALOG D_GUILD_MAIN,0
	ENDIF

// ---- Adayları Kabul Edin ----
ELIF (<LOCAL.LISTTYPE>==<DEF0.GUILDDLG_LISTTYPE_ADMINCANDIDATES>)

	IF (<MEMBERFROMUID.<LOCAL.MEMBERUID>.ISCANDIDATE>)
	
		IF (<ARGN1>==1) //ACCEPTED
		
			IF (<DEF0.GUILDCONFIG_MAXMEMBERS>)
				IF (<MEMBER.COUNT <DEF.STONEPRIV_MEMBER>> < <DEF0.GUILDCONFIG_MAXMEMBERS>)
					F_GUILDSYS_ADDCHARTOGUILD <UID>,<LOCAL.MEMBERUID>,1
				ELSE
					SRC.SYSMESSAGELOC <def.tcolor_red>,3300902,<dDEF0.GUILDCONFIG_MAXMEMBERS>
				ENDIF
			ELSE
				F_GUILDSYS_ADDCHARTOGUILD <UID>,<LOCAL.MEMBERUID>,1
			ENDIF
			
		ELSEIF (<ARGN1>==2) // REJECTED
			F_GUILDSYS_REMOVECHARFROMGUILD <UID>,<LOCAL.MEMBERUID>
		ENDIF

		TRY UID.<LOCAL.MEMBERUID>.UPDATE
		UPDATE
	ENDIF
	IF (<SRC.ISGM>)||(<MASTERUID>==<SRC.UID>)
		IF (<LOCAL.LISTTYPECOUNT>) 
			SDIALOG D_GUILD_CHARLIST,0,<DEF0.GUILDDLG_LISTTYPE_ADMINCANDIDATES>
		ELSE
			SDIALOG D_GUILD_MASTER,0
		ENDIF
	ELSE
		SDIALOG D_GUILD_MAIN,0
	ENDIF
ENDIF
RETURN 1



[DIALOG D_ACCOUNT_GUILD_UYE]
<DEF.DSP>
RESIZE 0,0,200,160,Hesap Uye Islemleri

FOR 0 <EVAL (<SRC.ACCOUNT.CHARS> -1)>
	REF1=<SRC.ACCOUNT.CHAR.<DLOCAL._FOR>.UID>
	IF (<REF1.ISVALID>)
		IF !(<REF1.GUILD>)
			DBUTTON 30,<EVAL (<DLOCAL._FOR>*20)+50>,4006,4007,1,0,<EVAL (<LOCAL._FOR> + 1)>,<DEF.SMSG_CUSTOM_COLOR>,<REF1.NAME>
		ELSE
			DTEXT 30 <EVAL (<DLOCAL._FOR>*20)+50> <def.tcolor_red> <REF1.NAME>
		ENDIF
	ENDIF
ENDFOR

[DIALOG D_ACCOUNT_GUILD_UYE BUTTON]
ON=1 5
IF (<SRC.ACCOUNT.CHARS> <= 1)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300903
	RETURN 1
ENDIF
REF1=<SRC.ACCOUNT.CHAR.<EVAL (<ARGN> -1)>.UID>
IF (<REF1.ISPLAYER>)
REF2=<SRC.GUILD>
	IF (<REF2>)
		REF2.Joinasmember <REF1>
		REF1.GC Guildinizin yeni üyesi olarak kabul edildim. Teşekkürler...
		REF2.SAYLOC 0,3301165,<REF1.NAME>
		SRC.SYSMESSAGELOC <def.tcolor_text>,3300904,<REF1.NAME>
		REF1.NOTICE <SRC.NAME> seni bu hesapta sahibi olduğn <REF2.NAME> guildinin üyeliğine dahil etti.
		IF (!<REF1.ISEVENT.<DEF.GUILDCONFIG_CHAREVENT_NAME>>)
		  REF1.EVENTS +<DEF.GUILDCONFIG_CHAREVENT_NAME>
		ENDIF  
		IF (!<REF1.ISDSPEECH.<DEF.GUILDCFGSPEECH_NAME>>)
		  REF1.DSPEECH +<DEF.GUILDCFGSPEECH_NAME>
		ENDIF
	ENDIF
ENDIF

ON=0
SRC.CLEARCTAGS GUILDROSTER=
SRC.CTAG0.GUILDROSTER.SEARCHTOTAL=

[EOF]
