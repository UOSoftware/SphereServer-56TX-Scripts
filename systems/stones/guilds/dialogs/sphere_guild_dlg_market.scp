VERSION=0.56T


[dialog d_Guild_Market]
<DEF.dsp>
IF (<TYPE> != T_STONE_GUILD)
	RETURN 1
ENDIF

RESIZE 0,0,320,<EVAL (<ARRAYCOUNT <DEF.GUILDCONFIG_MARKET_ITEMS>>*70)+140>,Guild Marketi

DCROPPEDTEXT 30 45 200 25 0 Guild puanınız: <NumberFormat <SRC.dTAG0.POINTS.GUILD>>

BUTTON 20 310 0FAF 0FB0 1 0 0 // Quit
DHTMLGUMP 55 310 120 25 0 0 Ana menüye dön

FOR 1 <ARRAYCOUNT <DEF.GUILDCONFIG_MARKET_ITEMS>>
	LOCAL.ITEM=<ARRAY <DEF.GUILDCONFIG_MARKET_ITEMS>,<DLOCAL._FOR>>
	IF (<SERV.ITEMDEF.<LOCAL.ITEM>>)
		LOCAL.POINT=<SERV.ITEMDEF.<LOCAL.ITEM>.TAG0.GuildPoint>
		LOCAL.ALIGN=<SERV.ITEMDEF.<LOCAL.ITEM>.TAG0.GuildAlign>
		
		IF (<DLOCAL.ALIGN> > 0)
			IF (<ALIGN> == <DLOCAL.ALIGN>)
				BUTTONTILEART 30 <EVAL (<DLOCAL._FOR>*60)+20> 151 151 1 0 <DLOCAL._FOR> <SERV.ITEMDEF.<LOCAL.ITEM>.ID> <SERV.ITEMDEF.<LOCAL.ITEM>.RESDISPDNHUE> 0 0
				DCROPPEDTEXT 90 <EVAL (<DLOCAL._FOR>*60)+20> 255 25 0 <SERV.ITEMDEF.<LOCAL.ITEM>.NAME> 
			ELSE
				BUTTONTILEART 30 <EVAL (<DLOCAL._FOR>*60)+20> 151 151 0 0 <DLOCAL._FOR> <SERV.ITEMDEF.<LOCAL.ITEM>.ID> <def.tcolor_red> 0 0 
				DCROPPEDTEXT 90 <EVAL (<DLOCAL._FOR>*60)+20> 255 25 <def.tcolor_red> <SERV.ITEMDEF.<LOCAL.ITEM>.NAME> 
			ENDIF
		ELSE
			BUTTONTILEART 30 <EVAL (<DLOCAL._FOR>*60)+20> 151 151 1 0 <DLOCAL._FOR> <SERV.ITEMDEF.<LOCAL.ITEM>.ID> <SERV.ITEMDEF.<LOCAL.ITEM>.RESDISPDNHUE> 0 0 
			DCROPPEDTEXT 90 <EVAL (<DLOCAL._FOR>*60)+20> 255 25 0 <SERV.ITEMDEF.<LOCAL.ITEM>.NAME> 
		ENDIF
		
		IF (<DLOCAL.POINT>)
			DCROPPEDTEXT 90 <EVAL (<DLOCAL._FOR>*60)+40> 255 25 0 Gerekli Puan: <NumberFormat <DLOCAL.POINT>>
		ENDIF
		
	ENDIF	
ENDFOR


[DIALOG D_GUILD_MARKET BUTTON]
ON=0
SDIALOG D_GUILD_MAIN

ON=1 500

LOCAL.ITEM=<ARRAY <DEF.GUILDCONFIG_MARKET_ITEMS>,<ARGN>>
LOCAL.POINT=<SERV.ITEMDEF.<LOCAL.ITEM>.TAG0.GuildPoint>
LOCAL.ALIGN=<SERV.ITEMDEF.<LOCAL.ITEM>.TAG0.GuildAlign>

IF (<DLOCAL.POINT>)
	IF (<SRC.dTAG0.POINTS.GUILD> < <DLOCAL.POINT>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu eşyayı almak için <NumberFormat <DLOCAL.POINT>> Guild puanına ihtiyacınız var.
		DIALOGCLOSE d_Guild_Market
		DIALOG d_Guild_Market
		RETURN 1
	ENDIF
ENDIF

SERV.NEWITEM <LOCAL.ITEM>
NEW.BOUNCE

IF (<NEW.BASEID> == I_CLOAK_GUILD)
	NEW.COLOR=<COLOR>
ENDIF

NEW.Ownedby=<UID>

IF (<DLOCAL.POINT>)
	SRC.TAG0.POINTS.GUILD -=<DLOCAL.POINT>
	SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, <NumberFormat <DLOCAL.POINT>> guild puanı harcadınız. Kalan guild puanını: <NumberFormat <SRC.dTAG0.POINTS.GUILD>>
	IF (<SRC.TAG0.POINTS.GUILD> <= 0)
		SRC.TAG0.POINTS.GUILD=0
	ENDIF
ENDIF




[EOF]


  
