
// guild rename
// ------------------------------------------------------
[FUNCTION F_PROMPTHANDLER_GUILDNAME]
IF (!<CTAG0.GUILD_PROMPTHANDLER_GUILDUID> || <ISEMPTY <ARGS>>)
	SYSMESSAGELOC <def.tcolor_red>,3300879
	RETURN 1
ENDIF

LOCAL.GUILDNAME=<ARGS>
LOCAL.GUILDLENGTH=<EVAL STRLEN(<LOCAL.GUILDNAME>)>
LOCAL.GUILD=<CTAG0.GUILD_PROMPTHANDLER_GUILDUID>
CTAG.GUILD_PROMPTHANDLER_GUILDUID=

IF (<LOCAL.GUILD>==0)
	RETURN 1
ENDIF

IF (<UID.<LOCAL.GUILD>.TYPE> != T_STONE_GUILD)
	RETURN 1
ENDIF

LOCAL.OLDOBJ=<OBJ.UID>
OBJ=<LOCAL.GUILD>
IF (<OBJ.MASTERUID>!=<UID>) && !(<ISGM>)
	OBJ=<LOCAL.OLDOBJ>
	RETURN 1
ENDIF

IF ((<LOCAL.GUILDLENGTH> < <DEF0.GUILDCONFIG_NAME_MINLENGTH>) || (<LOCAL.GUILDLENGTH> > <DEF0.GUILDCONFIG_NAME_MAXLENGTH>))
	SYSMESSAGELOC <def.tcolor_red>,3300880,<DEF0.GUILDCONFIG_NAME_MINLENGTH>,<DEF0.GUILDCONFIG_NAME_MAXLENGTH>
	RETURN 1
ELSEIF (<OBJ.TAG0.CHANGENAME_TIME> >= <SERV.TIME>)
	SYSMESSAGELOC <def.tcolor_red>,3300881
	RETURN 1

ELSEIF (<ISBLANK <LOCAL.GUILDNAME>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300090,<def.systxt_only_empty>
	RETURN 1
ELSEIF !(STRREGEX(^[a-zA-Z' ]+$,<LOCAL.GUILDNAME>))
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300882
	RETURN 1
ELSEIF (<ISFORBIDSTRING <LOCAL.GUILDNAME>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300090,<def.systxt_using_forbid>
	RETURN 1
ELSEIF (<F_GUILDSYS_ISNAMEUSED <LOCAL.GUILD>,<LOCAL.GUILDNAME>>)
	SYSMESSAGELOC <def.tcolor_red>,3300883
	RETURN 1
ENDIF
// CHANGE THE NAME
F_GUILDSYS_SENDSMSG <OBJ>,Guild adı değişti. (Eski:<OBJ.NAME>, Yeni:<LOCAL.GUILDNAME>)
OBJ.NAME=<LOCAL.GUILDNAME>
OBJ.TAG.CHANGENAME_TIME=<SERV.TIME> + <DEF0.GUILDCONFIG_MINTIME_NAME>
OBJ.UPDATE
UPDATE
TRYSRC <UID> OBJ.SDIALOG D_GUILD_MASTER,0,
OBJ=<LOCAL.OLDOBJ>
RETURN 1




// guild re-abbrev name
// ------------------------------------------------------
[FUNCTION F_PROMPTHANDLER_GUILDABBREV]
IF ( !<CTAG0.GUILD_PROMPTHANDLER_GUILDUID> || <ISEMPTY <ARGS>> )
	SYSMESSAGELOC <def.tcolor_red>,3300884
	RETURN 1
ENDIF
LOCAL.GUILDABBREV=<ARGS>
LOCAL.GUILDLENGTH=<EVAL STRLEN(<LOCAL.GUILDABBREV>)>
LOCAL.GUILD=<CTAG0.GUILD_PROMPTHANDLER_GUILDUID>
CTAG.GUILD_PROMPTHANDLER_GUILDUID =
IF (<LOCAL.GUILD> == 0)
	RETURN 1
ENDIF
IF ( <UID.<LOCAL.GUILD>.TYPE> != T_STONE_GUILD )
	RETURN 1
ENDIF
LOCAL.OLDOBJ=<OBJ.UID>
OBJ=<LOCAL.GUILD>
IF (<OBJ.MASTERUID>!=<UID>) && !(<ISGM>)
	OBJ=<LOCAL.OLDOBJ>
	RETURN 1
ENDIF
IF ((<LOCAL.GUILDLENGTH> < <DEF0.GUILDCONFIG_ABBREV_MINLENGTH>) || (<LOCAL.GUILDLENGTH> > <DEF0.GUILDCONFIG_ABBREV_MAXLENGTH>))
	SYSMESSAGELOC <def.tcolor_red>,3300885,<DEF0.GUILDCONFIG_ABBREV_MINLENGTH>,<DEF0.GUILDCONFIG_ABBREV_MAXLENGTH>
	RETURN 1
ELSEIF (<OBJ.TAG0.CHANGEABBREV_TIME> >= <SERV.TIME>)
	SYSMESSAGELOC <def.tcolor_red>,3300881
	RETURN 1
ELSEIF (<ISBADCHAR <LOCAL.GUILDABBREV>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300090,<def.systxt_using_bad>
	RETURN 1
ELSEIF (<ISBLANK <LOCAL.GUILDABBREV>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300090,<def.systxt_only_empty>
	RETURN 1
ELSEIF !(STRREGEX(^[a-zA-Z]+$,<LOCAL.GUILDABBREV>))
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300282
	RETURN 1
ELSEIF (<ISFORBIDSTRING <LOCAL.GUILDABBREV>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300090,<def.systxt_using_forbid>
	RETURN 1
ELSEIF (<F_GUILDSYS_ISABBREVUSED <LOCAL.GUILD>,<LOCAL.GUILDABBREV>>)
	SYSMESSAGELOC <def.tcolor_red>,3300886
	RETURN 1
ENDIF
// CHANGE THE ABBREV
F_GUILDSYS_SENDSMSG <OBJ>,Guild kısaltması değişti. (Eski:<OBJ.ABBREV>, Yeni:<LOCAL.GUILDABBREV>)
OBJ.ABBREV=<LOCAL.GUILDABBREV>
OBJ.TAG.CHANGEABBREV_TIME=<SERV.TIME> + <DEF0.GUILDCONFIG_MINTIME_ABBREV>
OBJ.UPDATE
UPDATE
TRYSRC <UID> OBJ.SDIALOG D_GUILD_MASTER,0
OBJ=<LOCAL.OLDOBJ>
RETURN 1






// guild unvani
// ------------------------------------------------------
[FUNCTION F_PROMPTHANDLER_GUILDTITLE]
LOCAL.TITLE=<ARGS>
LOCAL.TITLELENGTH=<EVAL STRLEN(<LOCAL.TITLE>)>
LOCAL.GUILD=<CTAG0.GUILD_PROMPTHANDLER_GUILDUID>
LOCAL.THISUID=<CTAG0.GUILD_PROMPTHANDLER_THISUID>
CTAG.GUILD_PROMPTHANDLER_GUILDUID=
CTAG.GUILD_PROMPTHANDLER_THISUID=
IF (<LOCAL.GUILD>==0)
	RETURN 1
ELIF (<UID.<LOCAL.GUILD>.TYPE> != T_STONE_GUILD)
	RETURN 1
ENDIF
LOCAL.OLDOBJ=<OBJ.UID>
OBJ=<LOCAL.GUILD>
IF (<OBJ.MASTERUID>!=<UID>) && !(<ISGM>)
	OBJ=<LOCAL.OLDOBJ>
	RETURN 1
ENDIF
IF (<ISEMPTY <ARGS>>)
	SYSMESSAGELOC <def.tcolor_red>,3300887
	OBJ.MEMBERFROMUID.<LOCAL.THISUID>.GUILDTITLE=
ELSE
	IF (<LOCAL.TITLELENGTH> > <DEF0.GUILDCONFIG_TITLE_MAXLENGTH>)
		SYSMESSAGELOC <def.tcolor_red>,3300888,<DEF0.GUILDCONFIG_TITLE_MAXLENGTH>
		RETURN 1
	ELSEIF (<LOCAL.TITLELENGTH> < 3)
		SYSMESSAGELOC <def.tcolor_red>,3300889
		RETURN 1
	ELSEIF (<ISBADCHAR <LOCAL.TITLE>>)
		SYSMESSAGELOC <def.tcolor_red>,3300090,<def.systxt_using_bad>
		RETURN 1
	ELSEIF (<ISBLANK <LOCAL.TITLE>>)
		SYSMESSAGELOC <def.tcolor_red>,3300090,<def.systxt_only_empty>
		RETURN 1
	ELSEIF !(STRREGEX(^[a-zA-Z]+$,<LOCAL.TITLE>))
		SYSMESSAGELOC <def.tcolor_red>,3300282
		RETURN 1
	ELSEIF (<ISFORBIDSTRING <LOCAL.TITLE>>)
		SYSMESSAGELOC <def.tcolor_red>,3300090,<def.systxt_using_forbid>
		RETURN 1
	ELSEIF (<OBJ.MEMBERFROMUID.<LOCAL.THISUID>.UID> != <LOCAL.THISUID>)
		SYSMESSAGELOC <def.tcolor_red>,3300890
		RETURN 1
	ENDIF
	// CHANGE THE GUIILD TITLE
	SYSMESSAGELOC <def.tcolor_green>,3300891,<UID.<LOCAL.THISUID>.NAME>,<LOCAL.TITLE>
	OBJ.MEMBERFROMUID.<LOCAL.THISUID>.GUILDTITLE=<LOCAL.TITLE>
ENDIF

	TRYSRC <UID> OBJ.SDIALOG D_GUILD_MASTER,0
	OBJ=<LOCAL.OLDOBJ>
RETURN 1





// ------------------------------------------------------
[FUNCTION F_PROMPTHANDLER_GUILDDCLAREWAR]
IF ( !<CTAG0.GUILD_PROMPTHANDLER_GUILDUID> || <ISEMPTY <ARGS>> )
	SYSMESSAGELOC <def.tcolor_text>,3300892
	RETURN 1
ENDIF
LOCAL.GUILDTEXT=<ARGS>
LOCAL.GUILDLENGTH=<EVAL STRLEN(<LOCAL.GUILDTEXT>)>
LOCAL.GUILD=<CTAG0.GUILD_PROMPTHANDLER_GUILDUID>
CTAG.GUILD_PROMPTHANDLER_GUILDUID=
IF (<LOCAL.GUILD> == 0)
	RETURN 1
ELIF (<UID.<LOCAL.GUILD>.TYPE>!=T_STONE_GUILD )
	RETURN 1
ENDIF
LOCAL.OLDOBJ=<OBJ.UID>
OBJ=<LOCAL.GUILD>
IF (<OBJ.MASTERUID>!=<UID>) && !(<ISGM>)
	OBJ=<LOCAL.OLDOBJ>
	RETURN 1
ENDIF

IF ((<LOCAL.GUILDLENGTH> < <DEF0.GUILDCONFIG_NSEARCH_MINLENGTH>) || (<LOCAL.GUILDLENGTH> > <DEF0.GUILDCONFIG_NAME_MAXLENGTH>))

ELIF ( STRREGEX([^A-ZA-Z0-9\S]+,<LOCAL.GUILDTEXT>) == 1 )

ELSE
	// GO FOR DIALOG
	TRYSRC <UID> OBJ.SDIALOG D_GUILD_MASTER_WARFARE_DECLAREWAR,0,<LOCAL.GUILDTEXT>
	OBJ=<LOCAL.OLDOBJ>
	RETURN 1
ENDIF

TRYSRC <UID> OBJ.SDIALOG D_GUILD_MASTER_WARFARE,0
OBJ=<LOCAL.OLDOBJ>
RETURN 1



[EOF]
