VERSION=0.56T

[DEFNAME DEF_GUILDSYS_GTYPE]
GUILDCONFIG_ALIGN_0		    		"Standard"
GUILDCONFIG_ALIGN_1		    		"Order"
GUILDCONFIG_ALIGN_2		    		"Chaos"

GUILDCONFIG_ALIGNSHIELD_1			01BC5
GUILDCONFIG_ALIGNSHIELD_2			01BC3

[DEFNAME DEF_GUILDSYS_CHARLISTTYPES]
GUILDDLG_LISTTYPE_ROSTER		    		1
GUILDDLG_LISTTYPE_CANDIDATES				2
GUILDDLG_LISTTYPE_LOYALITY		    	3
GUILDDLG_LISTTYPE_DISMISSMEMBER			4
GUILDDLG_LISTTYPE_GRANTTITLE				5
GUILDDLG_LISTTYPE_ADMINCANDIDATES		6

[DEFNAME DEF_GUILDSYS_GUILDLISTTYPES]
GUILDDLG_LISTTYPE_G_DECLAREPEACE		1
GUILDDLG_LISTTYPE_G_ACCEPTWAR				2
GUILDDLG_LISTTYPE_G_REJECTWAR				3
GUILDDLG_LISTTYPE_G_RESCIND		    	4

[DEFNAME DEF_GUILDSYS_CONFIG]
GUILDCONFIG_CHARLIST_SHOWTITLE 				1
GUILDCONFIG_GUILDLIST_SHOWABBREV 			1
GUILDCONFIG_ALLOWTRANSFER 		    		1

GUILDCONFIG_MAXMEMBERS			    		0						// 0 = unlimited
GUILDCONFIG_MAXCANDIDATES		    		0						// 0 = unlimited

GUILDCONFIG_MINTIME_NAME		    		86400 			// 7 Days (in tenths of a sec)
GUILDCONFIG_MINTIME_ABBREV		    		86400 			// 7 Days (in tenths of a sec)	
GUILDCONFIG_MINTIME_ALIGN		    		86400 			// 7 Days (in tenths of a sec)


GUILDCONFIG_NAME_MINLENGTH		    	3
GUILDCONFIG_NAME_MAXLENGTH		    	16

GUILDCONFIG_TITLE_MINLENGTH		    		3
GUILDCONFIG_TITLE_MAXLENGTH		    		16


GUILDCONFIG_ABBREV_MINLENGTH				3
GUILDCONFIG_ABBREV_MAXLENGTH				3


GUILDCONFIG_ALLOW_ALLGUILD_SEARCH		1							// Search GUILDCONFIG_ALLOW_ALLGUILD_TEXT for full guild list
GUILDCONFIG_ALLOW_ALLGUILD_TEXT			"allguilds"

GUILDCONFIG_NSEARCH_MINLENGTH				4       			// Don't set to 0, to allow allguild search simply set the above to 1

GUILDCONFIG_MAX_NSEARCH_RES		    	75						// 0 = unlimited

GUILDCONFIG_CHAREVENT_NAME          e_GuildGenericEvent

// 0 ise guildbutton hic kullanilmaz
// 1 ise sadece guild uyeleri guild butonunu kullanabilir.
// 2 ise hem guild uyeleri hem de guildde olmayanlar kullanabilir (guildde olmayanlar guild kurulum menusunu gorur.)
GUILDCONFIG_USEGUILDBUTTON          2

GUILDCONFIG_CREATED_GOLD			3000000

GUILDCONFIG_MIN_MEMBERCOUNT			5
GUILDCONFIG_MAX_MEMBERCOUNT			60

SERVER_MAX_GUILDS					40

[DEFNAME DEF_GUILDSYS_CONFIG_SPEECH]
GUILDCFGSPEECH_GLOBAL_ENABLE         0
GUILDCFGSPEECH_NAME                  spk_guildspeech
GUILDCFGSPEECH_ENABLE_MEMBERS        1
GUILDCFGSPEECH_ENABLE_CANDIDATES     0
GUILDCFGSPEECH_SPAM_INTERVAL         20     // 2 sec (in tenths of a sec) (0 disabled)

[DEFNAME DEF_GUILDSYS_CONFIG_LEVELS]
//Rank Names
GUILDCONFIG_RANK_0				"Yeni Uye"
GUILDCONFIG_RANK_1				"Uye"
GUILDCONFIG_RANK_2				"Kurucu"

[DEFNAME DEF_GUILDSYS_CONFIG_MARKET]
GUILDCONFIG_MARKET_ITEMS I_CLOAK_GUILD,I_SHIELD_CHAOS,I_SHIELD_ORDER


[EOF]
