on=@Login
REF1=<SRC.REGION.UID>
REF2=<REF1.LINK>

IF !((<REF1.ISOWNER <SRC>>) || (<REF1.GETCOOWNERPOS <SRC>> >= 0) || (<REF1.GETFRIENDPOS <SRC>> >= 0) || (<SRC.ISGM>))
	
	IF (<REF2.ISVALIDE>)
		SRC.GO <REF2.P>
		SRC.MOVE 0 <r1,2>
		SRC.Func_House_BanishArea_Clear
		SRC.FIX
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300662
	ENDIF
ELSE
	SRC.SYSMESSAGELOC <def.tcolor_text>,3300663
ENDIF







[EVENTS e_house_count_block]
