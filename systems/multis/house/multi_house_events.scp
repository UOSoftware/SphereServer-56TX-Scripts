
//////////////////////////////////////////////////////////////////////////////////////events///////////////////////////////////////////////////




// Event applied when you are listed (with any privilege) on one or more houses.
// Sadece ev sahiplerine verilen event
[EVENTS e_house_priv]




// Eve giris cikis yapan herkese verilen event.
[EVENTS e_house_events_player]

ON=@REGIONLEAVE
SRC.EVENTS -e_house_events_player

On=@EnvironChange
IF !(<SRC.IsInHouse>)
	SRC.EVENTS -e_house_events_player
ENDIF

ON=@SPELLSELECT
IF (<SERV.SPELL.<ARGN>.FLAGS>&spellflag_field)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300548
	RETURN 1
ENDIF

on=@spellcast
IF (<SERV.SPELL.<ARGN>.FLAGS>&spellflag_field)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300548
	RETURN 1
ENDIF

