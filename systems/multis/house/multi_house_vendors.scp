[DIALOG d_player_vendor_owner button]


////////////////////////////////////////////////////////////
// Page 3 : KONTRAT
////////////////////////////////////////////////////////////
// Kontrat kabul
ON=30
REF1=<REGION.UID>
IF (<SRC.ISOUTOFREACH 3,<UID>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300782
	RETURN 1
ELSEIF !(<OWNER>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300781
	RETURN 1
ELSEIF (<OWNER> != <SRC>)
	REF1.SYSMESSAGELOC <def.tcolor_red>,3300820
	RETURN 1
ENDIF
