

// @Custom region event for houses.
[REGIONTYPE r_house_system]

ON=@ENTER
REF1=<UID>
IF (<SRC.ISPLAYER>)
	SRC.DIALOGCLOSEALL
	
	IF (<SRC.ACTION> == Magery) && ((<SRC.ACTARG1> == 32) || (<SRC.ACTARG1> == 52))
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300722
		SRC.SKILL FAIL
	ENDIF
	
	IF !(<SRC.ISEVENT.<DEF.hs_default_player_event>>)
		SRC.EVENTS +<DEF.hs_default_player_event>
	ENDIF
	IF !(<SRC.ISDSPEECH.<DEF.hs_default_player_speech>>)
		SRC.DSPEECH +<DEF.hs_default_player_speech>
	ENDIF
	
	IF (<REF1.ISVALIDE>)
		IF ((<REF1.ISOWNER <SRC>>) || (<REF1.GETCOOWNERPOS <SRC>> >= 0) || (<REF1.GETFRIENDPOS <SRC>> >= 0) || (<SRC.ISGM>))
			// Ev uyeleri girerse	
			SRC.SYSMESSAGELOC <def.tcolor_green>,3300723
		ELSE
			// SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Evden ayril yazarak yabanci kisilerin evlerinden 10 sn. içinde ayrilabilirsiniz.
			REF1.TAG0.VISITS ++
		ENDIF
	ENDIF
ENDIF


ON=@Exit
IF (<SRC.ISPLAYER>)
	SRC.DIALOGCLOSE d_house_menu
	IF (<SRC.ISEVENT.<DEF.hs_default_player_event>>)
		SRC.EVENTS -<DEF.hs_default_player_event>
	ENDIF
	IF (<SRC.ISDSPEECH.<DEF.hs_default_player_speech>>)
		SRC.DSPEECH -<DEF.hs_default_player_speech>
	ENDIF
ENDIF


ON=@STEP
IF (<SRC.ISPLAYER>)
	// SRC.DIALOGCLOSE d_house_menu
	IF !(<SRC.ISEVENT.<DEF.hs_default_player_event>>)
		SRC.EVENTS +<DEF.hs_default_player_event>
	ENDIF
	IF !(<SRC.ISDSPEECH.<DEF.hs_default_player_speech>>)
		SRC.DSPEECH +<DEF.hs_default_player_speech>
	ENDIF
ENDIF


[eof]
