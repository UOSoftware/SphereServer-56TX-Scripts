[DIALOG D_HOUSE_MENU BUTTON]

//////////////////////////////////////////////////////
//  PAGE 0: MAIN
//////////////////////////////////////////////////////
// Button yok




//////////////////////////////////////////////////////
//  PAGE 1: Bilgi
//////////////////////////////////////////////////////
// Button yok




//////////////////////////////////////////////////////
//  PAGE 2: Güvenlik
//////////////////////////////////////////////////////
// Ev anahtarlarımı yenile
ON=20
REMOVEKEYS <SRC>
ADDKEY <SRC>,0
SDIALOG d_house_menu,2


// Kapı, kutu/kasa izinlerini ayarla.
ON=21


// Halka aç
ON=22
HOUSETYPE=<DEF.HOUSE_PUBLIC>
SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Bu ev "Halka Açık" olarak ayarlandı.
SDIALOG d_house_menu,2

// Özel
ON=23
HOUSETYPE=<DEF.HOUSE_PRIVATE>
SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Bu ev "Özel" olarak ayarlandı.
SDIALOG d_house_menu,2


// Tüm anahtarları yenile
ON=24
REF1=<UID>
FORINSTANCES I_KEY_COPPER
	IF (<LINK.ISVALIDE>)
		IF (<LINK> == <REF1>)
			REMOVE
		ENDIF
	ENDIF
ENDFOR
SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Bu eve ait tüm anahtarlar silindi.
REMOVEKEYS <SRC>
ADDKEY <SRC>,1

// ORTAKLARA ANAHTAR
IF (<Coowners>)
	FOR 0 <EVAL <Coowners>-1>
		IF (<CoOwner.<DLOCAL._FOR>>)
			REF1=<CoOwner.<DLOCAL._FOR>>
			IF (<REF1.ISPLAYER>)
				REMOVEKEYS <REF1>
				ADDKEY <REF1>,1
				REF1.NOTICE <NAME> isimli ev anahtarlarını yenilendi.
			ENDIF
		ENDIF
	ENDFOR
	SRC.SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Evin anahtarı tüm ortaklara dağıtıldı.
ENDIF

// DOSTLARA ANAHTAR
IF (<Friends>)
	FOR 0 <EVAL <Friends>-1>
		IF (<Friend.<DLOCAL._FOR>>)
			REF2=<Friend.<DLOCAL._FOR>>
			IF (<REF2.ISVALIDE>)
				REMOVEKEYS <REF2>
				ADDKEY <REF2>,1
				REF2.NOTICE <NAME> isimli ev anahtarlarını yenilendi.
			ENDIF
		ENDIF
	ENDFOR
	SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Evin anahtarı tüm dostlara dağıtıldı.
ENDIF

REF99=<OWNER>
// GUILD UYELERINE ANAHTAR
IF (<REF99.GUILD>)
	REF98=<REF99.GUILD>	
	FOR 0 <EVAL <REF98.MEMBER.COUNT>>
	REF97=<REF98.MEMBER.<DLOCAL._FOR>.UID>
		IF (<REF97.ISVALIDE>)
			REMOVEKEYS <REF97>
			ADDKEY <REF97>,1
			REF97.NOTICE <NAME> isimli ev anahtarlarını yenilendi.
		ENDIF
	ENDFOR
	SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Evin anahtarı tüm guild üyelerine dağıtıldı.
ENDIF

SDIALOG d_house_menu,2






// Ortaklık/dostluktan ayrıl
on=25
IF !(<SRC.IsInHouse>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ev içinde değilsiniz.
	RETURN 1
ELSEIF (<SRC.REGION.UID> != <UID>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ev içinde değilsiniz.
	RETURN 1
ENDIF
IF (<GETCOOWNERPOS <SRC>> >= 0)
	DELCOOWNER <SRC>
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Evin ortaklığından ayrıldınız.
ELSEIF (<GETFRIENDPOS <SRC>> >= 0)
	DELFRIEND <src>
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Evin dostluğundan ayrıldınız.
ENDIF
REMOVEKEYS <SRC>




//////////////////////////////////////////////////////
//  PAGE 20: Ortak işlemleri
//////////////////////////////////////////////////////
// Ortak Ekle
ON=200
IF !(<SRC.IsInHouse>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ev içinde değilsiniz.
	RETURN 1
ELSEIF (<SRC.REGION.UID> != <UID>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ev içinde değilsiniz.
	RETURN 1
ENDIF
TARGETF F_HOUSE_ADD_LIST 1
SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Eve ortak olarak eklemek istediğiniz oyuncuyu seçiniz.

// Tüm Ortakları Sil 
ON=201
SRC.CTAG0.LIST=coowner
SDIALOG D_HOUSE_LIST_CLEAR 

// Ortak Sil
ON=2000 2099
REF1=<CoOwner.<EVAL <DARGN>-2000>.UID>
IF !(<REF1.ISVALIDE>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Oyuncu bulunamadı!
	RETURN 1
ELSEIF !(<REF1.ISPLAYER>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Oyuncu bulunamadı!
	RETURN 1
ENDIF
REF1.NOTICE <OWNER.NAME> isimli oyuncunun sahibi olduğu <NAME> evindeki ortaklığınız kaldırıldı!
SRC.SYSMESSAGELOC <def.tcolor_green>,<def.empty_cliloc2>, <REF1.NAME> isimli oyuncunun ortaklığı kaldırıldı.
DELCOOWNER <REF1>
REMOVEKEYS <REF1>


// Dost sil
ON=2100 2200
REF1=<Friend.<EVAL <DARGN>-2100>.UID>
IF !(<REF1.ISVALIDE>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Oyuncu bulunamadı!
	RETURN 1
ELSEIF !(<REF1.ISPLAYER>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Oyuncu bulunamadı!
	RETURN 1
ENDIF
REF1.NOTICE <OWNER.NAME> isimli oyuncunun sahibi olduğu <NAME> evindeki dostluğunuz kaldırıldı!
SRC.SYSMESSAGELOC <def.tcolor_green>,<def.empty_cliloc2>, <REF1.NAME> isimli oyuncunun dostluğu kaldırıldı.
DELFRIEND <REF1>
REMOVEKEYS <REF1>




//////////////////////////////////////////////////////
//  PAGE 21: Dost işlemleri
//////////////////////////////////////////////////////
// Dost Ekle
ON=202
IF !(<SRC.IsInHouse>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ev içinde değilsiniz.
	RETURN 1
ELSEIF (<SRC.REGION.UID> != <UID>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ev içinde değilsiniz.
	RETURN 1
