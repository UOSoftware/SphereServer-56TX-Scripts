// Evi kaldır
ON=51
IF (<SRC.IsInHouse>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ev içindeyken evi yıkamazsınız.
	RETURN 1
ENDIF

SDIALOG D_HOUSE_REDEED


//////////////////////////////////////////////////////
//  PAGE 50: Satışa çıkart
//////////////////////////////////////////////////////
// Satışa çıkart
ON=500
IF (<TAG0.DEMOLITION>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu evin yıkılması planlanıyor ve satışı yapılamaz.
	RETURN 1
ENDIF
IF !(<ISNUM <ARGTXT[0]>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Sadece rakam girebilirsiniz.
	RETURN 1
ENDIF
TAG0.PRICE=<ARGTXT[0]>
SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Evi satılığa çıkarttınız.
SDIALOG D_HOUSE_MENU 50



// Fiyatı güncelle
ON=501
IF (<TAG0.DEMOLITION>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu evin yıkılması planlanıyor ve satışı yapılamaz.
	RETURN 1
ENDIF
IF !(<ISNUM <ARGTXT[0]>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Sadece rakam girebilirsiniz.
	RETURN 1
ENDIF

TAG0.PRICE=<ARGTXT[0]>
SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Evin fiyatı güncellendi.
SDIALOG D_HOUSE_MENU 50



// Satıştan kaldır
ON=502
TAG0.PRICE=
SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Evi satmaktan vazgeçtiniz.
SDIALOG D_HOUSE_MENU 50



//////////////////////////////////////////////////////
//  PAGE 7: Banka
//////////////////////////////////////////////////////
ON=7
IF (<DEF.hs_can_bank>)
	IF !(<SRC.IsInHouse>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ev içinde değilsiniz.
		RETURN 1
	ENDIF
	SRC.OPENBANK
ENDIF
	


//////////////////////////////////////////////////////
//  PAGE 8: Staff
//////////////////////////////////////////////////////
// Demolish Plan
ON=80
IF !(<TAG0.DEMOLITION>)
	IF (<TAG0.PRICE>)
		TAG.PRICE=
		SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Bu evin satisi durduruldu.
	ENDIF
			
	IF (<ISNUM <ARGTXT[1]>>)
		IF (<EVAL <ARGTXT[1]>> < 31)
			IF (<EVAL <ARGTXT[1]>> > 6)
				TAG0.DEMOLITION=<EVAL <ARGTXT[1]>>
				LINK.TIMER=60*60*24*<EVAL <ARGTXT[1]>>
				SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Bu ev <EVAL <TAG0.DEMOLITION>> sonra yıkılması planladı.
			ELSE
				SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Yıkımdan önce en az 7 günlük ihbar süresi gerekmektedir.
			ENDIF
		ELSE
			SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Yıkım 30 gün içinde gerçekleşmelidir
		ENDIF
		
	ELSE
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Geçersiz giriş, günler sayısal olmalı & < 30
	ENDIF
ELSE
	TAG.DEMOLITION=
	SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Evin yikilma sureci iptal edildi.
ENDIF

	
    
// ELIF (<ARGN>==86)
