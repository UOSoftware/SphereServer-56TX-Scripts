REF1.GOLD +=<DTAG0.PRICE>

IF (<REF1.ISONLINE>)
	REF1.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Sahip olduğunuz <NAME> isimli ev <SRC.NAME> isimli oyuncu tarafından <Bolukayir <DTAG.PRICE>> gp karşılığından satın alınmıştır. Dost - Ortak - Yasaklı - Erişim listesi temizlendi. Evin sahibi artık <SRC.NAME>.
ENDIF

// Yeni sahibi
SRC.GOLD -=<DTAG0.PRICE>
IF (<SRC.ISONLINE>)
	SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, <Bolukayir <DTAG.PRICE>> gp karşılığında <NAME> isimli ev satın alındı. Dost - Ortak - Yasaklı - Erişim listesi temizlendi. Evin sahibi artık sensin.
ENDIF
SRC.ADDHOUSE <UID>

// Tabela
LINK.SAYU Yeni sahibi: <SRC.NAME>

// Ev
