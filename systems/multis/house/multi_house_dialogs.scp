SRC.CLEARCTAGS HOUSE_ACCESS_INVITE




ON=1
ARGS=<SRC.CTAG0.HOUSE_ACCESS_INVITE>
REF1=<ARGV0>		// ev
REF2=<ARGV1>		// teklifi gönderen
REF3=<REF1.LINK>	// tabela

IF !(<REF1.ISVALIDE>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ev bulunamadı!
	RETURN 1
ELSEIF !(<REF1.ISMULTI>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Burası ev olarak görünmüyor.
	RETURN 1
ENDIF

IF (<ARGV2> == 1) // ORTAK eklemek
	IF (<REF1.COOWNERS> >= <DDEF.HS_MAX_CO_OWNERS>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu evin ortak ekleme limiti dolmuş. (<REF1.COOWNERS>/<DDEF.HS_MAX_CO_OWNERS>)
		REF1.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu evin ortak ekleme limiti dolmuş. (<REF1.COOWNERS>/<DDEF.HS_MAX_CO_OWNERS>)
		RETURN 1
	ELSEIF (<REF1.ISOWNER <SRC>>) || (<REF1.GETCOOWNERPOS <SRC>> >= 0) || (<REF1.GETFRIENDPOS <SRC>> >= 0) || (<SRC.ISGM>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu ev ile zaten bir ilişiğiniz var.
		REF1.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, <SRC.NAME> isimli oyuncunun bu ev ile zaten bir ilişiği var.
		RETURN 1
	ENDIF
	REF1.ADDKEY <SRC>
	REF1.ADDCOOWNER=<SRC>
	REF3.SAYU Yeni ortak: <SRC.NAME>
	SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, <ref1.name> isimli eve ortak oldunuz.
	REF2.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, <SRC.NAME> <ref1.name> isimli evin ortaklar listesine başarıyla eklendi.

ELSEIF (<ARGV2> == 2) // Dost ekleme

	IF (<REF1.FRIENDS> >= <DDEF.hs_max_friends>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu evin dost ekleme limiti dolmuş. (<REF1.FRIENDS>/<DDEF.hs_max_friends>)
		REF1.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu evin dost ekleme limiti dolmuş. (<REF1.FRIENDS>/<DDEF.hs_max_friends>)
		RETURN 1
	ELSEIF (<REF1.ISOWNER <SRC>>) || (<REF1.GETCOOWNERPOS <SRC>> >= 0) || (<REF1.GETFRIENDPOS <SRC>> >= 0) || (<SRC.ISGM>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu ev ile zaten bir ilişiğiniz var.
		REF1.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>,  <SRC.NAME> isimli oyuncunun bu ev ile zaten bir ilişiği var.
		RETURN 1
	ENDIF
	REF1.ADDKEY <SRC>
	REF1.ADDFRIEND=<SRC>
	REF3.SAYU Yeni dost: <SRC.NAME>
	SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, <ref1.name> isimli eve dost oldunuz.
	REF2.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, <SRC.NAME> <ref1.name> isimli evin dost listesine başarıyla eklendi.

ELSEIF (<ARGV2> == 3) // Transfer

	SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, <REF2.NAME> isimli oyuncudan <REF1.name> isimli evi başarıyla transfer aldınız.
	SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Evin tüm ortak - dost - yasaklı ve izin listesi temizlendi.
	
	REF2.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, <SRC.NAME> isimli oyuncuya evi başarıyla transfer ettiniz.
	REF2.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Evin tüm ortak - dost - yasaklı ve izin listesi temizlendi.
	
	REF1.REMOVEKEYS
	
	REF1.ADDKEY <SRC>,1
	
	REF1.TAG.LASTTRANSFER=<SERV.RTIME>
	REF1.OWNER=<SRC>
	REF1.MORE1=<SRC>
	REF1.DELBAN -1
	REF1.DELCOOWNER -1
	REF1.DELACCESS -1
	REF1.DELFRIEND -1
	
	REF3.SAYU Yeni sahibi: <SRC.NAME>
	
	REF2.DELHOUSE <REF1>


ELSE
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Tanımsız işlem.
ENDIF

SRC.CLEARCTAGS HOUSE_ACCESS_INVITE




