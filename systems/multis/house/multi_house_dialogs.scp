	BUTTONTILEART <DLOCAL.X5> <DLOCAL.Y5> 07588 07588 1 0 <EVAL <DLOCAL._FOR>+5000> <LINK.DISPIDDEC> <DEF.SIGN_COLOR_<DLOCAL._FOR>> -10 -5
	LOCAL.Y5 += 30
ENDFOR


