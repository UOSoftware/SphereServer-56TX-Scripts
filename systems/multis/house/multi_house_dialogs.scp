VERSION=X1


[DIALOG D_HOUSE_MENU]
<DEF.DSP>

PAGE 0

RESIZEPIC 0 0 5054 399 375
GUMPPICTILED 150 8 240 102 2624                //TOP BOX
GUMPPICTILED 7 116 383 253 2624                //MIDDLE BOX     

GUMPPIC 7 8 100                                //BRASS SIGN GUMP
DHTMLGUMP 25 38 106 60 0 0 <DEF.CENTER><DEF.H3><DEF.BFONT_SIZE7><LINK.NAME>

DORIGIN 150 10

BUTTON +0 +0 4005 4007 0 1 0 // page
DHTMLGUMP +30 +0 100 20 0 0 <def.bfont_white>BİLGİ

BUTTON +0 +20 4005 4007 0 2 0 // page
DHTMLGUMP +30 +20 100 20 0 0 <def.bfont_white>GÜVENLİK

BUTTON +0 +40 4005 4007 0 3 0 // page
DHTMLGUMP +30 +40 100 20 0 0 <def.bfont_white>DEPOLAMA

BUTTON +0 +60 4005 4007 0 4 0 // page
DHTMLGUMP +30 +60 100 20 0 0 <def.bfont_white>ÖZELLEŞTİRME

BUTTON +0 +80 4005 4007 0 5 0 // page
DHTMLGUMP +30 +80 100 20 0 0 <def.bfont_white>MÜLKİYET

BUTTON +140 +0 4005 4007 0 6 0 // page
DHTMLGUMP +170 +0 100 20 0 0 <def.bfont_white>KOMUTLAR

IF (<DEF.hs_can_bank>)
	BUTTON +140 +20 4005 4007 1 0 7 // button
	DHTMLGUMP +170 +20 100 20 0 0 <def.bfont_white>BANKA
ENDIF

IF (<SRC.ISGM>)
	BUTTON +140 +40 4005 4007 0 8 0 // page
	DHTMLGUMP +170 +40 100 20 0 0 <def.bfont_hs_text1>STAFF
ENDIF




// INFORMATION
PAGE 1
DORIGIN 150 10
BUTTON +0 +0 4006 4007 0 1 0
DHTMLGUMP +30 +0 100 20 0 0 <def.BFONT_HS_TITLE>BİLGİ

DORIGIN 20 130
DHTMLGUMP +0 +0 220 20 0 0 <DEF.bfont_white>Sahibi: <owner.name> 

IF (<HOUSETYPE> == <DEF.house_private>)
	DHTMLGUMP 20 +20 220 20 0 0 <def.bfont_white>Türü: <def.bfont_lgreen>Özel
ELSEIF (<HOUSETYPE> == <DEF.house_public>)
	DHTMLGUMP 20 +20 220 20 0 0 <def.bfont_white>Türü: <def.bfont_lred>Halka açık
ELSE
	DHTMLGUMP 20 +20 220 20 0 0 <def.bfont_white>Türü: <def.bfont_lred>Tanımsız
ENDIF

DHTMLGUMP +0 +40 220 20 0 0 <QVAL (<tag0.demolition>)?<def.bfont_lred>Bu ev düzgün yerleştirilmemiş.:<def.bfont_lgreen>Bu ev düzgün şekilde yerleştirilmiş.>

DHTMLGUMP +0 +60 320 20 0 0 <def.bfont_lred>Evin çürümesine <DURATIONFORHUMANS <LINK.TIMER>,,short> kaldı.

IF (<TAG0.PRICE>)
    DHTMLGUMP +0 +80 220 20 0 0 <def.bfont_lgreen>Bu ev satışta: <def.bfont_yellow><def.bfont_hs_text2><NumberFormat <dtag0.price>> gp
ENDIF

DHTMLGUMP +0 +100 360 40 0 0 <def.bfont_lgreen>Sahibi, ortağı veya dostu eve girdiğinde, kapıları açtığında, tabelaya tıkladığında ev otomatik olarak yenilenir.

IF !(<isblank <TAG0.LASTTRANSFER>>)
    DHTMLGUMP +0 +140 220 20 0 0 <def.bfont_white>Last Traded: <def.bfont_white><tag0.lasttransfer>
ENDIF

DHTMLGUMP +0 +160 220 20 0 0 <def.bfont_white>Kurulum tarihi: <tag0.created_at>
DHTMLGUMP +0 +180 220 20 0 0 <def.bfont_white>Fiyatı: <NumberFormat <value>> gp
DHTMLGUMP +0 +200 220 20 0 0 <def.bfont_white>Ziyaretçi sayısı: <eval <link.tag0.VISITS> + <tag0.VISITS>>


// GÜVENLİK
PAGE 2
DORIGIN 150 10
BUTTON +0 +20 4006 4007 0 2 0
DHTMLGUMP +30 +20 100 20 0 0 <def.bfont_hs_title>GÜVENLİK

DORIGIN 20 130

IF (<ISOWNER <SRC>>) || (<SRC.ISGM>)
    BUTTON +0 +0 4006 4007 0 20 20 // page
    DHTMLGUMP +30 +0 150 20 0 0 <def.bfont_hs_text1>Ortak işlemleri
ENDIF

IF (<ISOWNER <SRC>>) || (<GETCOOWNERPOS <SRC>> >= 0) || (<SRC.ISGM>)
    BUTTON +0 +20 4006 4007 0 21 21 // page
    DHTMLGUMP +30 +20 120 20 0 0 <def.bfont_hs_text1>Dost işlemleri
ENDIF

IF (<ISOWNER <SRC>>) || (<GETCOOWNERPOS <SRC>> >= 0) || (<GETFRIENDPOS <SRC>> >= 0) || (<SRC.ISGM>)
	BUTTON +0 +40 4006 4007 1 0 20 // button
	DHTMLGUMP +30 +40 280 20 0 0 <def.bfont_hs_text1>Ev anahtarlarımı yenile
ENDIF

IF (<ISOWNER <SRC>>) || (<SRC.ISGM>)
    BUTTON +0 +60 4006 4007 1 0 21 // button
    DHTMLGUMP +30 +60 180 20 0 0 <def.bfont_hs_text1>Kapı, kutu/kasa izinlerini ayarla.
	
	IF !(<HOUSETYPE> == <DEF.HOUSE_PUBLIC>)
		BUTTON +0 +100 4006 4007 1 0 22  // button
	ENDIF
	DHTMLGUMP +30 +100 250 20 0 0 <QVAL (<HOUSETYPE> != <DEF.HOUSE_PUBLIC>)?<DEF.BFONT_lRED>:<DEF.BFONT_lGREEN>> Halka açık duruma getir.
				
	IF !(<HOUSETYPE> == <DEF.HOUSE_PRIVATE>)
		BUTTON +0 +120 4006 4007 1 0 23  // button
	ENDIF
	DHTMLGUMP +30 +120 250 20 0 0 <QVAL (<HOUSETYPE> != <DEF.HOUSE_PRIVATE>)?<DEF.BFONT_lRED>:<DEF.BFONT_lGREEN>> Özel duruma getir.
	
    DHTMLGUMP +40 +140 280 20 0 0 <def.bfont_hs_text1>* Eviniz şuan <QVAL (<housetype> != <def.house_private>)? Halka açık:Özel> durumda.
	
	BUTTON +0 +170 4006 4007 1 0 24  // button
	DHTMLGUMP +30 +170 280 20 0 0 <def.bfont_hs_text1>Tüm anahtarları yenile
	
ENDIF

IF (<GETCOOWNERPOS <SRC>> >= 0)
    BUTTON +0 +200 4006 4007 1 0 25 // button
    DHTMLGUMP +30 +200 120 20 0 0 <def.bfont_hs_text1>Ortaklıktan ayrıl
	
ELSEIF (<GETFRIENDPOS <SRC>> >= 0)
    BUTTON +0 +240 4006 4007 1 0 25 // button
    DHTMLGUMP +30 +240 120 20 0 0 <def.bfont_hs_text1>Dostluktan ayrıl
ENDIF


// Ortak Listesi
PAGE 20
DORIGIN 20 130
LOCAL.Xc=20
LOCAL.Yc=160
BUTTON +0 +0 4006 4007 1 0 200 // button
DHTMLGUMP +30 +0 150 20 0 0 <def.bfont_hs_text1>Ortak Ekle (<coowners>/<ddef.hs_max_co_owners>)
IF (<Coowners>)
    BUTTON +150 +0 4003 4004 1 0 201 // button
    DHTMLGUMP +180 +0 150 20 0 0 <def.bfont_lred>Tüm Ortakları Sil (<COOWNERS>)
	FOR c 0 <EVAL <Coowners>-1>
		IF ( <CoOwners.<DLOCAL.c>>)
			BUTTON <DLOCAL.Xc> <eval <DLOCAL.Yc>+2> 03 04 1 0 <EVAL <DLOCAL._FOR>+2000>
			DTEXT <EVAL <DLOCAL.Xc>+0> <eval <DLOCAL.Yc>+15> <def.tcolor_red> Sil
			DCROPPEDTEXT <EVAL <DLOCAL.Xc>+17> <DLOCAL.Yc> 120 25 <def.tcolor_grey> <CoOwner.<DLOCAL.c>.name>
			LOCAL.Yc += 32
			IF (<LOCAL.Yc> > 340)
				LOCAL.Yc 160
				LOCAL.Xc +=90
			ENDIF
		ENDIF
	ENDFOR
ELSE
    DHTMLGUMP +0 +20 120 20 0 0 <def.bfont_hs_text1>Ortak yok.
ENDIF


// Dost Listesi
PAGE 21
DORIGIN 20 130
LOCAL.Xf=20
LOCAL.Yf=160
BUTTON +0 +0 4005 4007 1 0 202 // button
DHTMLGUMP +30 +0 150 20 0 0 <def.bfont_hs_text1>Dost Ekle (<friends>/<ddef.hs_max_friends>)
IF (<Friends>)
    BUTTON +150 +0 4005 4007 1 0 203 // button
    DHTMLGUMP +180 +0 150 20 0 0 <def.bfont_lred>Tüm Dostları Sil (<Friends>)
	FOR f 0 <EVAL <Friends>-1>
		IF ( <Friends.<DLOCAL.f>>)			
			BUTTON <DLOCAL.Xf> <eval <DLOCAL.Yf>+2> 03 04 1 0 <EVAL <DLOCAL.f>+2100>
			DTEXT <EVAL <DLOCAL.Xf>+0> <eval <DLOCAL.Yf>+15> <def.tcolor_red> Sil
			DCROPPEDTEXT <EVAL <DLOCAL.Xf>+17> <DLOCAL.Yf> 120 25 <def.tcolor_grey> <Friend.<DLOCAL.f>.name>
			LOCAL.Yf += 32
			IF (<LOCAL.Yf> > 340)
				LOCAL.Yf 160
				LOCAL.Xf +=90
			ENDIF
		ENDIF
	ENDFOR
ELSE
    DHTMLGUMP +0 +20 120 20 0 0 <def.bfont_hs_text1>Dost yok.
ENDIF





