ON=2965 3140
LINK.DISPID=<HVAL <ARGN>>
LINK.UPDATE

// SIGN COLORING
ON=5000 9000    
LINK.COLOR=<DEF.SIGN_COLOR_<EVAL <ARGN>-5000>>
