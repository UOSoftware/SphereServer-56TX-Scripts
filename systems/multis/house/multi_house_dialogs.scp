	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu ev satilik degil.
	RETURN 1
ELSEIF (<DTAG0.PRICE> <= 0)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu ev satilik degil.
	RETURN 1
ELSEIF (<SRC.GOLD> < <DTAG0.PRICE>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, <bolukayir <DTAG0.PRICE>> gpniz yok.
	RETURN 1
ENDIF

