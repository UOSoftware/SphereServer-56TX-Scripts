VERSION=X1



[ITEMDEF i_sign_brass_house]
DEFNAME=i_sign_brass_house
ID=i_sign_brass_2
NAME=house sign
CAN=CAN_O_NOSLEEP|can_i_dcignoredist|can_i_dcignorelos

ON=@CREATE
TIMERF 1, TRIGGER @CreateInit

ON=@CreateInit
IF (<LINK.ISVALIDE>)
	ATTR=ATTR_DECAY|ATTR_MOVE_NEVER
	LINK.F_HOUSE_REFRESH_TIMER 0
	LINK.REGION.EVENTS=+r_house_system
ENDIF


ON=@CLICK
IF (<LINK.HOUSETYPE> == <DEF.HOUSE_PRIVATE>)
	MESSAGELOC 38,3301132
ELSEIF (<LINK.HOUSETYPE> == <DEF.HOUSE_PUBLIC>)
	MESSAGELOC 044,3301133
ENDIF
MESSAGE @<DEF.NOTO.<LINK.OWNER.NOTOGETFLAG>> [<LINK.OWNER.NAME>] // sahibinin adı
IF (<LINK.ISVALIDE>)
	MESSAGE @,,1,1 [<LINK.NAME>] // evin adı
ENDIF
IF (<LINK.DTAG0.PRICE>)
	MESSAGELOC 044,3301134
	MESSAGELOC 0,3301135,<LINK.DTAG0.PRICE>
ENDIF
// MESSAGE <NAME>
RETURN 1

ON=@DClick
IF (<LINK.ISOWNER <SRC>>) || (<LINK.GETCOOWNERPOS <SRC>> >= 0) || (<LINK.GETFRIENDPOS <SRC>> >= 0) || (<SRC.ISGM>)	
	LINK.F_HOUSE_REFRESH_TIMER 1
	DIALOGCLOSE d_house_menu
	LINK.DIALOG d_house_menu
ELSE
	LINK.DIALOG D_HOUSE_VISITOR
ENDIF
RETURN 1


ON=@TIMER
ATTR=ATTR_DECAY|ATTR_MOVE_NEVER
IF (<LINK.ISVALIDE>)
	REF1=<LINK.OWNER>
	IF (<REF1.ISVALIDE>)
		REF1.Notice <LINK.NAME> isimli evinizi uzun süredir yenilemediğiniz için eviniz silindi.
	ENDIF
	LINK.REMOVE
ENDIF
RETURN 1






[ITEMDEF I_STRONGBOX]
DEFNAME=I_STRONGBOX
TYPE=T_CONTAINER
ID=I_BOX_BRASS
NAME=Strongbox
TDATA2=04B

ON=@CREATE
TIMER -1
ATTR=ATTR_MOVE_NEVER
COLOR=0

On=@Click
REF1=<MORE2>
IF (<REF1.ISVALIDE>)
	MESSAGE @38,,1,1 (<REF1.NAME>)
ENDIF

On=@DClick
REF1=<MORE1> // EV
REF2=<MORE2> // SAHİBİ
REF3=<REGION.UID> // İÇİNDE BULUNDUĞU eval

IF (<SRC.ACCOUNT.PLEVEL> == 7)
	RETURN 0
ENDIF
IF (<REF2.ISPLAYER>)
	IF (<REF2> == <SRC>) || (<REF1.ISOWNER <SRC>>)
		RETURN 0
	ELSE
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300743
		RETURN 1
	ENDIF
ENDIF

On=@PickUp_Ground
IF !(<SRC.ISGM>)
	RETURN 1
ENDIF




[ITEMDEF I_TRASHCAN]
DEFNAME=I_TRASHCAN
ID=I_BARREL_OPEN
NAME=trashcan
// RESDISPDNHUE=0
// RESDISPDNHUE=052f
RESDISPDNHUE=0
// CAN=can_o_nosleep

ON=@Create
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
ATTR=ATTR_MOVE_NEVER

ON=@DCLICK
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
IF (<TIMER> <= 0)
	TIMER=
ENDIF



ON=@CLICK
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
IF (<RESCOUNT>)
	MESSAGELOC 0,3301136,<RESCOUNT>
ENDIF
IF !(<TIMER> <= 0)
	MESSAGELOC 044,3301137,<timer>
ENDIF
MESSAGELOC 0,3301138
RETURN 1



ON=@PICKUP_GROUND
IF !(<SRC.ISGM>)
	RETURN 1
ENDIF


ON=@Timer
COLOR=<SERV.ITEMDEF.<BASEID>.RESDISPDNHUE>
IF (<RESCOUNT>)
	EMPTY
	UPDATEX
	SAYLOC 0,3301139
ENDIF
TIMER 10
RETURN 1


ON=@DropOn_Self
IF (<RESCOUNT> >= 50)
	SAYLOC 0,3301140
	EMPTY
	UPDATEX
ELSE
	SRC.sysmessageloc 0,3300744,<ARGO.NAME>,<TIMER>
	// TIMER=10
ENDIF








[ITEMDEF i_house_interior_decorator]
DEFNAME=i_house_interior_decorator
ID=0fc1
NAME=Interior Decorator
VALUE=10000
WEIGHT=1.0
RESOURCES=
SKILLMAKE=

ON=@Click
IF (<TAG0.MODE>==1)
	MESSAGELOC 0,3301141
ELIF (<TAG0.MODE>==2)
	MESSAGELOC 0,3301142
ELIF (<TAG0.MODE>==3)
	MESSAGELOC 0,3301143
ENDIF


ON=@DCLICK
REF1=<SRC.REGION.UID>
IF !(<REF1.ISVALID>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300648
	RETURN 1
ENDIF

IF (<CONT.TOPOBJ> != <SRC>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300479
	RETURN 1
ELIF !((<REF1.ISOWNER <SRC>>) || (<REF1.GETCOOWNERPOS <SRC>> >= 0) || (<SRC.ISGM>))
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300745
	RETURN 1
ELIF !(<TAG0.MODE>)
	SDIALOG D_HOUSE_INTERIOR_DECORATOR
ELSE
	TAG.HOUSE=<REGION.UID>
	TARGET
ENDIF
RETURN 1

ON=@TARGON_CHAR
TAG.HOUSE=
SRC.SYSMESSAGELOC <def.tcolor_red>,3300221
RETURN 1

ON=@TARGON_GROUND
TAG.HOUSE=
SRC.SYSMESSAGELOC <def.tcolor_red>,3300221
RETURN 1


ON=@TARGON_CANCEL
TAG.HOUSE=

ON=@TARGON_ITEM
IF (<ARGO> == <UID>)
	TAG.HOUSE=
	TAG.MODE=
	SDIALOG D_HOUSE_INTERIOR_DECORATOR
	RETURN 1
ELSE

	REF1 = <ARGO.REGION.UID>
	
	IF (<REF1> != <TAG0.HOUSE>) || !(<SRC.IsInHouse>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300746
		RETURN 1
	ELIF (<ARGO.CONT>) || (<ARGO.REGION.UID> != <TAG0.HOUSE>) || !(<ARGO.IsInHouse>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300747
		RETURN 1
	ELIF !(<ARGO.ISEVENT.EI_HOUSE_LOCKDOWN>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300748
		RETURN 1
	ELIF !(<REF1.OWNER> == <SRC>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3300749
		RETURN 1		
	ELSE
		TAG.HOUSE=
		
		IF (<TAG0.MODE>==1) // flip
			IF !(<ARGO.FLIP>)
				SRC.SYSMESSAGELOC <def.tcolor_red>,3300750
			ELSE
				ARGO.FLIP
				DCLICK
			ENDIF
			RETURN 1
			
		ELIF (<TAG0.MODE>==2) // up
			IF (<ARGO.HouseFloor <ARGO.Z>> != <ARGO.HouseFloor <eval <ARGO.Z>+<ARGO.HEIGHT>+3>>)
				SRC.SYSMESSAGELOC <def.tcolor_red>,3300751
			ELSE
				ARGO.NUDGEUP
				DCLICK
			ENDIF
			RETURN 1
			
		ELIF (<TAG0.MODE>==3) // down
			IF (<ARGO.P.Z> <= <SRC.P.Z>)
				SRC.SYSMESSAGELOC <def.tcolor_red>,3300752
				RETURN 1
			ENDIF
			IF (<ARGO.HouseFloor <ARGO.Z>> != <ARGO.HouseFloor <eval <ARGO.Z>-1>>)
				SRC.SYSMESSAGELOC <def.tcolor_red>,3300753
			ELSE
				ARGO.NUDGEDOWN
				DCLICK
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	RETURN 1
ENDIF



[EOF]
