ON=bank*
IF (<DEF.HS_CAN_BANK>)
	REF1=<REGION.UID>
	IF (<SRC.ISDEATH>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ölüyken bu komutu kullanamazsiniz.
		RETURN 1
	ELSEIF !(<REF1.ISOWNER <SRC>> || <REF1.GETCOOWNERPOS <SRC>> >= 0 || <REF1.GETFRIENDPOS <SRC>> >= 0 || <SRC.ISGM>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ev ile iliskiniz yok. (Sahip - Ortak - Dost)
		RETURN 1
	ENDIF
SRC.OPENBANK
ENDIF





ON=remove thyself
ON=i ban thee
REF1=<REGION.UID>
IF (<SRC.ISDEATH>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ölüyken bu komutu kullanamazsiniz.
	RETURN 1
ELSEIF !(<REF1.ISOWNER <SRC>> || <REF1.GETCOOWNERPOS <SRC>> >= 0 || <REF1.GETFRIENDPOS <SRC>> >= 0 || <SRC.ISGM>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ev ile iliskiniz yok. (Sahip - Ortak - Dost)
	RETURN 1
ENDIF
TARGETF, F_HOUSE_EJECT
SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Kovmak istediginizi varligi seçiniz.





ON=*trashcan*
REF1=<REGION.UID>
IF (<SRC.ISDEATH>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ölüyken bu komutu kullanamazsiniz.
	RETURN 1
ELSEIF !(<REF1.ISOWNER <SRC>> || <REF1.GETCOOWNERPOS <SRC>> >= 0 || <REF1.GETFRIENDPOS <SRC>> >= 0 || <SRC.ISGM>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ev ile iliskiniz yok. (Sahip - Ortak - Dost)
	RETURN 1
ELSEIF (<REF1.TAG0.PRICE>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Satiliga çikartilmis evlerde bu komutu kullanamazsiniz.
	RETURN 1
ELSEIF (<SRC.F_HOUSE_NEAR_DOOR 2>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Kapilarin yakininda bu komutu kullanamazsiniz.
	RETURN 1
ENDIF
ARGS=<REF1.MULTIREGION>
LOCAL.M=<EVAL (<ARGV[2]>+<ARGV[3]>)>
FORITEMS <dLOCAL.M>
	IF (<REGION.UID> == <REF1>) && (<BASEID> == I_TRASHCAN)
		REF2=<UID>
	ENDIF
ENDFOR
IF (<REF2.ISVALIDE>) && (<REF2.BASEID> == I_TRASHCAN)
	REF2.P <SRC.P>
	REF2.UPDATE
	SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Evde zaten bir trashcan oldugu için mevcut trashcan bulundugunuz yere getirildi.
ELSE
	SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Trashcan bulundugunuz yerde olusturuldu.
	SERV.NEWITEM I_TRASHCAN
	NEW.P=<SRC.P>
	NEW.HouseItemSetLockedProps 1
ENDIF




ON=*reward barrel*
REF1=<REGION.UID>
IF (<SRC.ISDEATH>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ölüyken bu komutu kullanamazsiniz.
	RETURN 1
ELSEIF !(<REF1.ISOWNER <SRC>> || <REF1.GETCOOWNERPOS <SRC>> >= 0 || <REF1.GETFRIENDPOS <SRC>> >= 0 || <SRC.ISGM>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ev ile iliskiniz yok. (Sahip - Ortak - Dost)
	RETURN 1
ELSEIF (<REF1.TAG0.PRICE>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Satiliga cikartilmis evlerde bu komutu kullanamazsiniz.
	RETURN 1
ELSEIF (<SRC.F_HOUSE_NEAR_DOOR 2>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Kapilarin yakininda bu komutu kullanamazsiniz.
	RETURN 1
ENDIF
ARGS=<REF1.MULTIREGION>
LOCAL.M=<EVAL (<ARGV[2]>+<ARGV[3]>)>
FORITEMS <dLOCAL.M>
	IF (<REGION.UID> == <REF1>) && (<BASEID> == i_reward_barrel)
		REF2=<UID>
	ENDIF
ENDFOR
IF (<REF2.ISVALIDE>) && (<REF2.BASEID> == I_REWARD_BARREL)
	REF2.P <SRC.P>
	REF2.UPDATE
	SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Evde zaten bir reward barrel oldugu için mevcut reward barrel bulundugunuz yere getirildi.
ELSE
	SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Reward barrel bulundugunuz yerde olusturuldu.
	SERV.NEWITEM I_REWARD_BARREL
	NEW.P=<SRC.P>
	NEW.HouseItemSetLockedProps 1
ENDIF




ON=*resurrect*
REF1=<REGION.UID>
IF (<DEF.hs_can_resurrect>)
	IF !(<SRC.ISDEATH>)
		SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Zaten hayattasin.
		RETURN 1
	ELSEIF !(<REF1.ISOWNER <SRC>> || <REF1.GETCOOWNERPOS <SRC>> >= 0 || <REF1.GETFRIENDPOS <SRC>> >= 0 || <SRC.ISGM>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ev ile iliskiniz yok. (Sahip - Ortak - Dost)
		RETURN 1
	ELSEIF (<REF1.TAG0.PRICE>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Satiliga çikartilmis evlerde bu komutu kullanamazsiniz.
		RETURN 1
	ELSEIF (<SRC.F_HOUSE_NEAR_DOOR 2>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Kapilarin yakininda bu komutu kullanamazsiniz.
		RETURN 1
	ELSEIF (<SRC.FINDID.I_RESTIMER>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Zaten hayata dönmeyi bekliyorsunuz.
		RETURN 1
	ENDIF
	SRC.STONE 1
	SRC.FUNC_ResTIMER <ddef.hs_can_resurrect_timer>
ENDIF




ON=help*
ON=commands*
IF !(<REF1.ISOWNER <SRC>> || <REF1.GETCOOWNERPOS <SRC>> >= 0 || <REF1.GETFRIENDPOS <SRC>> >= 0 || <SRC.ISGM>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Ev ile iliskiniz yok. (Sahip - Ortak - Dost)
	RETURN 1
ENDIF
DIALOGCLOSE D_HOUSE_MENU
SDIALOG D_HOUSE_MENU 6



