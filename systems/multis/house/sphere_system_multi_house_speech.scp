	RETURN 1
ENDIF
SRC.TARGETF F_HOUSE_ITEM_LOCK
SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Sabitlemek istediginiz esyayi seçiniz.





ON=release this*
