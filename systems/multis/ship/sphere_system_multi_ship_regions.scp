


[REGIONTYPE r_ship_system]

ON=@Enter
REF1=<UID>

IF (<SRC.ISPLAYER>)
	SRC.DIALOGCLOSEALL
	
	IF (<SRC.ACTION> == Magery) && ((<SRC.ACTARG1> == 32) || (<SRC.ACTARG1> == 52))
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Gemi içinde recall veya gate travel yapamazsiniz.
		SRC.SKILL FAIL
	ENDIF
	
	IF !(<SRC.ISEVENT.<DEF.ss_default_player_event>>)
		SRC.EVENTS +<DEF.ss_default_player_event>
	ENDIF
	IF !(<SRC.ISDSPEECH.<DEF.ss_default_player_speech>>)
		SRC.DSPEECH +<DEF.ss_default_player_speech>
	ENDIF
	
	IF (<REF1.ISVALIDE>)
		IF ((<REF1.ISOWNER <SRC>>) || (<REF1.GETCOOWNERPOS <SRC>> >= 0) || (<REF1.GETFRIENDPOS <SRC>> >= 0) || (<SRC.ISGM>))
			// gemiye uyeleri girerse	
			SRC.SYSMESSAGELOC <def.tcolor_green>,<def.empty_cliloc2>, Geminize hosgeldiniz.
		ELSE
			REF1.TAG0.VISITS ++
		ENDIF
	ENDIF
ENDIF

ON=@STEP
IF (<SRC.ISPLAYER>)
	SRC.DIALOGCLOSE d_ship_menu
	IF !(<SRC.ISEVENT.<DEF.ss_default_player_event>>)
		SRC.EVENTS +<DEF.ss_default_player_event>
	ENDIF
	IF !(<SRC.ISDSPEECH.<DEF.ss_default_player_speech>>)
		SRC.DSPEECH +<DEF.ss_default_player_speech>
	ENDIF
ENDIF


ON=@Exit
REF1=<UID>
IF (<SRC.ISPLAYER>)
	SRC.DIALOGCLOSE d_house_menu
	IF (<SRC.ISEVENT.<DEF.ss_default_player_event>>)
		SRC.EVENTS -<DEF.ss_default_player_event>
	ENDIF
	IF (<SRC.ISDSPEECH.<DEF.ss_default_player_speech>>)
		SRC.DSPEECH -<DEF.ss_default_player_speech>
	ENDIF
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>,Gemiden ayrildiniz.  (<REF1.name>)
	SRC.DIALOGCLOSEALL
ENDIF




[eof]
