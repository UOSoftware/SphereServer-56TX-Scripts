




[FUNCTION ShipRemoveKeys]
REF1=<FINDLAYER.21>
IF (<REF1.ISVALIDE> && <REF1.RESCOUNT>)
	FOR 0 <EVAL <REF1.RESCOUNT>-1>
		REF2=<REF1.FINDCONT.<dLOCAL._FOR>.UID>
		IF (<REF2.ISVALIDE> && <REF2.DISPID> == I_KEY_COPPER)
			IF STRMATCH("T_SHIP*","<REF2.LINK.TYPE>")
				REF2.REMOVE
			ENDIF
		ENDIF
	ENDFOR
ENDIF

REF3=<FINDLAYER.29>
IF (<REF3.ISVALIDE> && <REF3.RESCOUNT>)
	FOR 0 <EVAL <REF3.RESCOUNT>-1>
		REF4=<REF1.FINDCONT.<dLOCAL._FOR>.UID>
		IF (<REF4.ISVALIDE> && <REF4.DISPID> == I_KEY_COPPER)
			IF STRMATCH("T_SHIP*","<REF4.LINK.TYPE>")
				REF4.REMOVE
			ENDIF
		ENDIF
	ENDFOR
ENDIF




[FUNCTION CharGemileriKontrol]
REF1 = <UID>
FORCHARMEMORYTYPE memory_guard
    IF (<LINK.TYPE> == t_ship)
		LOCAL.SHIPCOUNT ++
	ENDIF
ENDFOR
RETURN <DLOCAL.SHIPCOUNT>





