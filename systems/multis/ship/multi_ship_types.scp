

[TYPEDEF t_ship_tiller]
ON=@DCLICK
IF (<LINK.TYPE> == T_SHIP)
	// SRC.USEITEM <LINK> // eğer gemiyi görmüyorsa çalışmıyor.
	SRC.dclick <LINK>
ENDIF
RETURN 1

ON=@TIMER
LINK.REMOVE
RETURN 1

ON=@Click
IF (<LINK.ISITEM>)
	IF !(STRMATCH('<SERV.MULTIDEF.<LINK.BASEID>.NAME>','<LINK.NAME>'))
		MESSAGE [<SERV.MULTIDEF.<LINK.BASEID>.NAME>]
	ENDIF
	MESSAGE @,,1,1 <link.name>
	IF (<UID.<LINK.MORE1>.ISCHAR>)
		MESSAGE @,,1,1 [Sahibi: <UID.<LINK.MORE1>.NAME>]
	ENDIF
	IF (<TIMER> > 0)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Geminin çürümesine <DURATIONFORHUMANS <TIMER>,,short> kaldı.
	ENDIF
ENDIF
RETURN 1





[TYPEDEF t_ship_side]
// ON=@DCLICK
// LOCAL.HITS = <EVAL (30*<SRC.STR>)/100> 
// IF !(<SRC.IsInShip>)
	// IF (<SRC.HITS> < <DLOCAL.HITS>)
		// SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Hitsiniz %30nin altinda olduğu için gemiye binemiyorsun.
		// RETURN 1
	// ENDIF
// ENDIF

ON=@CLICK
message @,1,1 (Kilitsiz)




[TYPEDEF t_ship_plank]
ON=@DCLICK
LOCAL.HITS = <EVAL (30*<SRC.STR>)/100> 
IF (<SRC.FLAGS>&STATF_DEAD)
	SRC.SYSMESSAGELOC <def.tcolor_Red>,600027 // "Ölü durumdayken bu işlemi yapamazsınız."
	RETURN 1

ELSEIF (<SRC.FLAGS>&STATF_WAR)
	SRC.SYSMESSAGELOC <def.tcolor_Red>,600030 // "Savaş durumdayken bu işlemi yapamazsınız."
	RETURN 1

ELSEIF (<SRC.FLAGS>&STATF_FREEZE)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600029 // "Freeze durumdayken bu işlemi yapamazsınız."
	RETURN 1

ELSEIF (<SRC.FLAGS>&STATF_STONE)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600028 // "Stone durumdayken bu işlemi yapamazsınız."
	RETURN 1

ELSEIF (<SRC.ISHELPSTUCK>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>,Stuck halinde bunu kullanamazsınız.
	RETURN 1
	
ELSEIF (<SRC.ISUSESKILL Magery>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600122 // "Büyü yaparken bu işlemi yapamazsınız."
	RETURN 1
ENDIF
IF !(<SRC.IsInShip>)
	IF (<SRC.HITS> < <LOCAL.HITS>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Hitsiniz %<def.Ship_Enter_Hits_Percent> altinda olduğu için gemiye binemiyorsun.
		RETURN 1
	ENDIF
ENDIF

ON=@CLICK
message @,1,1 (Açık)

ON=@STEP
IF !(<SRC.FINDID.I_SHIP_STEP_MEM>)
	SERV.NEWITEM I_SHIP_STEP_MEM,1,<SRC>,1
ENDIF






[TYPEDEF t_ship_hold_lock]
ON=@DCLICK
IF (<LINK.ISVALIDE>) && ((<LINK.OWNER> == <SRC>) || (<SRC.ISGM>))
	OPEN
	//SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Geminin sahibi oldugunuz icin kilitli kasayi acabildiniz.
	RETURN 1
ENDIF





[TYPEDEF t_ship_side_locked]
// ON=@DCLICK
// LOCAL.HITS = <EVAL (30*<SRC.STR>)/100> 
// IF !(<SRC.IsInShip>)
	// IF (<SRC.HITS> < <DLOCAL.HITS>)
		// SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Hitsiniz %30nin altinda olduğu için gemiye binemiyorsun.
		// RETURN 1
	// ENDIF
// ENDIF

ON=@CLICK
message @38,1,1 (Kilitli)




[TYPEDEF t_ship]
ON=@DClick
IF (<MORE1> == <SRC>) || (<SRC.ISGM>)
	LINK.TIMER=43201
	SRC.SYSMESSAGELOC <def.tcolor_green>,<def.empty_cliloc2>,Geminiz yenilendi.
    IF (<SRC.REGION.UID> != <UID>)
		DIALOGCLOSE D_SHIP_DEMOLISH
		DIALOG D_SHIP_DEMOLISH
	ELSE
		DIALOGCLOSE D_SHIP_MENU
		DIALOG D_SHIP_MENU
    ENDIF
ELSE
	DIALOGCLOSE D_SHIP_VISITOR
	DIALOG D_SHIP_VISITOR
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>,Gemi ile bir ilişkiniz bulunmuyor.
ENDIF
RETURN 1



ON=@CREATE
TIMERFMS 1, TRIGGER @CreateInit



ON=@CreateInit
// LINK.F_HOUSE_REFRESH_TIMER 0
IF (<LINK.ISVALIDE>)
	LINK.REGION.EVENTS=+r_ship_system
ENDIF


// X bugu: Burayı şu yüzden koyduk,  gemiyi kurduktan sonra nerede olursan olur gemi içindeymiş gibi görünüyorsun. 
// Örneğin Britain Territory (Small Ship)de görünüyor char.
REF1=<OWNER>
IF (<REF1.ISVALIDE>)
	IF !(<REF1.ISINSHIP>)
		REF1.TAG0.Ship_Placement_Coords=<REF1.P>
	ENDIF
	REF1.MOVENEAR <UID> 1 // geçici fix, gemiyi kurunca sahibine içine gönder.
ENDIF


ON=@DESTROY
REF1=<MORE1>
IF (<REF1.ISVALIDE>)
	IF (<REF1.ISINSHIP>)
		// Gemi bi şekilde silinirse sahibini gemiyi kurduğu koordinata gönder.
		IF !(<ISBLANK <REF1.TAG0.Ship_Placement_Coords>>)
			REF1.GO <REF1.TAG0.Ship_Placement_Coords>
		ENDIF
	ENDIF
ENDIF




// ON=@SHIP_STOP
// serv.b Stop

// ON=@SHIP_TURN
// serv.b Turn

// ON=@SHIP_MOVE
// serv.b Move










[TYPEDEF ei_ship_deed]
ON=@CLICK
COLOR=0
ATTR |= ATTR_NEWBIE
IF (<ATTR>&ATTR_NEWBIE)
	MESSAGE <defmsg.tooltip_tag_newbie>
ENDIF
MESSAGE [<SERV.ITEMDEF.<MORE1>.NAME>]
MESSAGE @,,1 Gemi Kontratı
RETURN 1

ON=@DCLICK
COLOR=0
ATTR |=ATTR_NEWBIE
LOCAL.HITS = <EVAL (30*<SRC.STR>)/100> 

IF !(<SRC.ISINPACK <UID>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600036,<NAME>	// Bunu (~1_val~) kullanabilmek için çantanızda veya üzerinizde olmalıdır.
	RETURN 1
ELSEIF (<SRC.HITS> < <DLOCAL.HITS>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Hitsiniz %30 altinda olduğu için bunu kullanamazsınız.
	RETURN 1
ELSEIF (<SRC.ISPOISONED>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600031 // "Zehirli durumdayken bu işlemi yapamazsınız."
	RETURN 1
ELSEIF (<SRC.FLAGS>&STATF_WAR)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Savaş halindeyken bunu kullanamazsınız.
	RETURN 1
ELSEIF (<SRC.FLAGS>&STATF_INVISIBLE) || (<SRC.FLAGS>&STATF_INSUBSTANTIAL) || (<SRC.FLAGS>&STATF_HIDDEN)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Görünmezken bunu kullanamazsınız.
	RETURN 1
ELSEIF (<SRC.REGION.FLAGS>&REGION_FLAG_UNDERGROUND|REGION_FLAG_NOBUILDING|REGION_FLAG_SAFE|REGION_ANTIMAGIC_ALL|REGION_ANTIMAGIC_RECALL_IN|REGION_ANTIMAGIC_RECALL_OUT|REGION_ANTIMAGIC_GATE|REGION_ANTIMAGIC_TELEPORT|REGION_ANTIMAGIC_DAMAGE|REGION_FLAG_SHIP|REGION_FLAG_NO_PVP) 
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu bölgeye yapı kuramazsınız. (<SRC.REGION.NAME>)
	RETURN 1
ELSEIF (strmatch('Star','<SRC.REGION.NAME>')) || (strmatch(*Green Acres*,'<SRC.REGION.NAME>'))
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu bölgeye yapı kuramazsınız. (<SRC.REGION.NAME>)
	RETURN 1
ELSEIF (<SRC.SHIPS> >= 1) 
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Sizin zaten geminiz var. (<SRC.ships>/1)
	RETURN 1
ELSEIF (<SRC.ISNEARPLAYERS>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Etrafınızda oyuncu varken yapı kuramazsınız.
	RETURN 1
ENDIF
IF !(<MORE2>)
	DIALOGCLOSE D_SHIP_PLACEMENT
	DIALOG D_SHIP_PLACEMENT
	RETURN 1
ENDIF


ON=@TARGON_GROUND
FORITEMS 100
	IF (<BASEID> == I_DEED_UYARI_MULTI) && (<TAG0.KARE>)
		IF (<SRC.DISTANCE <UID>> <= <DTAG0.KARE>)
			LOCAL.KARE <DTAG0.KARE>
		ENDIF
	ENDIF
ENDFOR

LOCAL.HITS = <EVAL (30*<SRC.STR>)/100> 

// Player kontrol
IF !(<SRC.ISINPACK <UID>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600036,<NAME>	// Bunu (~1_val~) kullanabilmek için çantanızda veya üzerinizde olmalıdır.
	RETURN 1
ELSEIF (<SRC.HITS> < <DLOCAL.HITS>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Hitsiniz %30 altinda olduğu için bunu kullanamazsınız.
	RETURN 1
ELSEIF (<SRC.ISPOISONED>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600031 // "Zehirli durumdayken bu işlemi yapamazsınız."
	RETURN 1
ELSEIF (<SRC.FLAGS>&STATF_WAR)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Savaş halindeyken bunu kullanamazsınız.
	RETURN 1
ELSEIF (<SRC.REGION.FLAGS>&region_flag_underground|region_flag_nobuilding|region_flag_safe|region_antimagic_all|region_antimagic_recall_in|region_antimagic_recall_out|region_antimagic_gate|region_antimagic_teleport|region_antimagic_damage|region_flag_ship|region_flag_no_pvp) 
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, 1. Bu bölgeye yapı kuramazsınız. (<SRC.REGION.NAME>)
	RETURN 1
ELSEIF (strmatch('Star','<SRC.REGION.NAME>')) || (strmatch(*Green Acres*,'<SRC.REGION.NAME>'))
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu bölgeye yapı kuramazsınız. Yasaklı bolge. (<SRC.REGION.NAME>)
	RETURN 1
ELSEIF (<SRC.SHIPS> >= 1) 
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Sizin zaten geminiz var. (<SRC.SHIPS>/1)
	RETURN 1
ENDIF

// Targp Kontrol
IF (<SRC.TARGP>)
	IF (<SRC.TARGP.REGION>)
		IF (<SRC.TARGP.REGION.FLAGS>&region_flag_underground|region_flag_nobuilding|region_flag_safe|region_antimagic_all|region_antimagic_recall_in|region_antimagic_recall_out|region_antimagic_gate|region_antimagic_teleport|region_antimagic_damage|region_flag_ship|region_flag_no_pvp) 
			SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, 2. Bu bölgeye kuramazsınız. (<SRC.TARGP.REGION.NAME>)
			RETURN 1 
		ELSEIF (strmatch('Star','<SRC.TARGP.REGION.NAME>')) || (strmatch(*Green Acres*,'<SRC.TARGP.REGION.NAME>'))
			SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu bölgeye kuramazsınız. Yasaklı bolge. (<SRC.TARGP.REGION.NAME>)
			RETURN 1
		ENDIF
	ENDIF
	IF (<SRC.TARGP.ISNEARTYPE t_DEED_UYARI_MULTI <DLOCAL.KARE>>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu alanda yapı kurulamaz uyarısı mevcut. (<DLOCAL.KARE> mt.)
		RETURN 1
	ENDIF
ENDIF
IF (<SRC.ISNEARPLAYERS>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Etrafınızda oyuncu varken yapı kuramazsınız.
	RETURN 1
ENDIF


ON=@TARGON_ITEM
SRC.SYSMESSAGELOC <def.tcolor_red>,600020 //"Hatalı seçim/hedef."
RETURN 1

ON=@TARGON_CHAR
SRC.SYSMESSAGELOC <def.tcolor_red>,600020 //"Hatalı seçim/hedef."
RETURN 1

ON=@DROPON_GROUND
DIALOGCLOSE D_SHIP_PLACEMENT
MORE2=0

ON=@PICKUP_SELF
DIALOGCLOSE D_SHIP_PLACEMENT
MORE2=0


ON=@TARGON_CANCEL
DIALOGCLOSE D_SHIP_PLACEMENT
DIALOG D_SHIP_PLACEMENT
MORE2=0



[eof]
