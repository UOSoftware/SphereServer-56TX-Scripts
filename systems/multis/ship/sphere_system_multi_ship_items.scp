


[ITEMDEF I_SHIP_STEP_MEM]
DEFNAME=I_SHIP_STEP_MEM
ID=I_MEMORY
TYPE=T_EQ_SCRIPT
VALUE=0
WEIGHT=0
NAME=Ship Plank Memory

ON=@CREATE
ATTR=ATTR_INVIS|ATTR_NEWBIE|ATTR_DECAY

ON=@EQUIP
