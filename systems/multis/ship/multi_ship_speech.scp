

// gemiye giren oyuncu speechi
[SPEECH spk_ship_cmds_player]



// geminin kendi speechi
[SPEECH spk_ship_cmds]
ON=Stop
IF !((<MORE1> == <SRC>) || (<SRC.ISGM>))
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300832
	RETURN 1
ENDIF
SHIPSTOP



ON=Turn Left
IF (<SRC.FLAGS>&STATF_DEAD)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600027 // "Ölü durumdayken bu işlemi yapamazsınız."
	RETURN 1
ELSEIF !((<MORE1> == <SRC>) || (<SRC.ISGM>))
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300832
	RETURN 1
ENDIF
LOCAL.HITS = <EVAL (30*<SRC.STR>)/100> 
IF (<SRC.HITS> < <DLOCAL.HITS>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300833
	RETURN 1
ENDIF
SHIPTURNLEFT



ON=Turn Right
IF (<SRC.FLAGS>&STATF_DEAD)
