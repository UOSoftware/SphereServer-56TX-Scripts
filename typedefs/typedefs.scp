ON=@Click
IF (<LINK.ISITEM>)
	IF (STRMATCH(*t_multi*,'<LINK.TYPE>')) || (STRMATCH(*t_ship*,'<LINK.TYPE>'))
		MESSAGE <LINK.NAME>
		MESSAGE [<LINK.P>]
	ENDIF
ENDIF
MESSAGE <name>
RETURN 1

ON=@DCLICK
IF !(<SRC.ISINPACK <UID>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600036,<NAME>	// Bunu (~1_val~) kullanabilmek için çantanızda veya üzerinizde olmalıdır.
	RETURN 1
ENDIF










[TYPEDEF t_corpse]

on=@Create
TAG0.BLOOD=0 // CARVED CREATE BLOOD
// MORE1=0 // İS CARVED 
// MOREZ=6 // DİRECTION FACE
// UPDATE


On=@CarveCorpse //Ceset kesildi mi?
//MORE1=1 //  emülatör zaten bunu yapıyor.
IF (<LINK.ISVALIDE> && <LINK.ISPLAYER>)
	FORCONT <UID> 1 //Cesetteki sadece en üstteki eşyaları al
		IF !(<ATTR> & ATTR_NEWBIE|ATTR_MOVE_NEVER)
			DROP //Itemleri drop ettir.
		ENDIF
		IF !(<CAN>&can_i_pile) 
			TAG0.CarveCorpseItems=1 // iteme tag ver cesetten kesilerek mi gelmiş
		ENDIF
	ENDFOR
	REMOVE //Ceset sil
ENDIF




ON=@CLICK
IF (<SRC.ISGM>)
MESSAGELOC 0,3301182,<DURATIONFORHUMANS <TIMER>,,short>
ENDIF

IF !(<LINK.ISVALIDE>)
	IF (<FINDTYPE.T_HAIR>)
		FINDTYPE.T_HAIR.REMOVE
	ENDIF
	IF (<FINDTYPE.T_BEARD>)
		FINDTYPE.T_BEARD.REMOVE
	ENDIF
ELSE
	IF (<LINK.MEMORYFINDTYPE.MEMORY_GUILD>) && (<LINK.MEMORYFINDTYPE.MEMORY_TOWN>)
		MESSAGE [<LINK.MEMORYFINDTYPE.MEMORY_GUILD.LINK.NAME>] [<LINK.MEMORYFINDTYPE.MEMORY_TOWN.LINK.NAME>]
	ELSEIF (<LINK.MEMORYFINDTYPE.MEMORY_GUILD>)
		MESSAGE [<LINK.MEMORYFINDTYPE.MEMORY_GUILD.LINK.NAME>]
	ELSEIF (<LINK.MEMORYFINDTYPE.MEMORY_TOWN>)
		MESSAGE [<LINK.MEMORYFINDTYPE.MEMORY_TOWN.LINK.NAME>]
	ENDIF
ENDIF



ON=@DROPON_ITEM
IF (<EVAL <ARGO.WEIGHT>+<WEIGHT>> > <SRC.MAXWEIGHT>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301014
	RETURN 1
ENDIF
IF (<RESCOUNT> >= 100)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301015
	RETURN 1
ENDIF


ON=@DROPON_Self
IF (<EVAL <ARGO.WEIGHT>+<WEIGHT>> > <SRC.MAXWEIGHT>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301014
	RETURN 1
ENDIF
IF (<RESCOUNT> >= 100)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301015
	RETURN 1
ENDIF


on=@dclick
IF !(<LINK.ISVALIDE>)
	IF (<FINDTYPE.T_HAIR>)
		FINDTYPE.T_HAIR.REMOVE
	ENDIF
	IF (<FINDTYPE.T_BEARD>)
		FINDTYPE.T_BEARD.REMOVE
	ENDIF
	IF !(STRMATCH('<NAME>','corpse'))
		NAME a corpse
	ENDIF
ELSE
	IF (<SRC> == <LINK>)
		SRC.SYSMESSAGELOC <def.tcolor_green>,3301016
	ENDIF
ENDIF




