[TYPEDEF t_cooking]
ON=@DCLICK
IF !(<SRC.ISNEARTYPE T_CAMPFIRE 1>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300993
	RETURN 1
ELSEIF !(<SRC.COOKING> >= 85.0)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300994
	RETURN 1
ENDIF
TARGET 
SRC.SYSMESSAGELOC <def.tcolor_text>,3300995
RETURN 1


ON=@TARGON_ITEM
IF (<SRC.TARG.BASEID> != i_fish_cut_raw)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300996
	RETURN 1
ELSEIF !(<SRC.ISINPACK <SRC.TARG.UID>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600036,<SRC.TARG.NAME>	// Bunu (~1_val~) kullanabilmek için çantanızda veya üzerinizde olmalıdır.
	RETURN 1
ELSEIF !(<SRC.RESTEST 10 I_FISH_CUT_RAW>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300997
	RETURN 1
ENDIF
SRC.TARG.CONSUME 10
IF (RAND(100) <= <EVAL (<SRC.COOKING> / 10)>)
	USESCUR ++
	SERV.NEWITEM I_FISH_CUT_COOKED,10,<SRC.FINDLAYER.21>,1
	SRC.SYSMESSAGELOC <def.tcolor_green>,3300998
ELSE
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300999
ENDIF
RETURN 1


