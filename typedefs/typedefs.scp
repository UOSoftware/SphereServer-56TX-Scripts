	SRC.SYSMESSAGELOC <def.tcolor_red>,3301029
ELSE
	TARGET 
	SRC.SYSMESSAGELOC <def.tcolor_grey>,3301033
ENDIF
RETURN 1

ON=@TARGON_ITEM
IF (<SRC.FLAGS>&STATF_STONE|STATF_FREEZE|STATF_DEAD)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301026
	RETURN 1
ELSEIF (<SRC.ISOUTOFREACH 2,<UID>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301027
	RETURN 1
ELSEIF (<BASEID> == I_EMBER_LIT)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301029
	RETURN 1
ELSEIF !(<SRC.TARG.TYPE> == T_MEAT_RAW)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301034
	RETURN 1
ELSEIF !(<SRC.TARG.TDATA1>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301030
	RETURN 1
ELSEIF (<RESOURCETYPE <SRC.TARG.TDATA1>> != RES_ITEMDEF)	
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301030
	RETURN 1
ELSEIF !(<SRC.CANMAKESKILL <SRC.TARG.TDATA1>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301031,<SERV.ITEMDEF.<SRC.TARG.TDATA1>.SKILLMAKE>
	RETURN 1
ELSEIF !(<SRC.CANMAKE <SRC.TARG.TDATA1>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301032,<SERV.ITEMDEF.<SRC.TARG.TDATA1>.RESMAKE>
	RETURN 1
ENDIF
SRC.MAKEITEM <SRC.TARG.TDATA1>,<R1,10>
RETURN 1


