[DIALOG D_SCISSORS_PLAYER_MYSELF]
<DEF.DSP>
RESIZE 0,0,210,200,<StrTitle <NAME>>


DORIGIN 20 50
RESIZEPIC +0 +0 2620 75 75
IF (<SRC.FINDLAYER.LAYER_HAIR>)
	REF1=<SRC.FINDLAYER.LAYER_HAIR>
	IF (<REF1.ISVALIDE>) && (<REF1.TYPE> == T_HAIR)
		LOCAL.HairAnim = <SERV.TILEDATA.ITEM(<REF1.DISPIDDEC>).ANIM>
		LOCAL.HairGump = <EVAL <LOCAL.HairAnim> + 50000>		
		DHTMLGUMP +5 +45 70 25 0 0 <DEF.CENTER><DEF.BFONT_White><StrLimit 8,<REF1.NAME>>
		DHTMLGUMP +0 +80 75 25 1 0 <DEF.CENTER><DEF.BFONT_Black>Saçı kes
		GUMPPIC -50 5 <LOCAL.HairGump> <EVAL (<REF1.COLOR> - 1) &~ 08000|04000>
	ENDIF
	
	DORIGIN 20 50
	BUTTON +30 +65 0845 0846 1 0 1
ELSE
	DHTMLGUMP +5 +25 70 50 0 0 <DEF.CENTER><DEF.BFONT_LRED>Saç yok
ENDIF


DORIGIN 110 50
RESIZEPIC +0 +0 2620 75 75
IF (<SRC.FINDLAYER.LAYER_BEARD>)
	REF2=<SRC.FINDLAYER.LAYER_BEARD>
	IF (<REF2.ISVALIDE>) && (<REF2.TYPE> == T_BEARD)

		LOCAL.BeardAnim = <SERV.TILEDATA.ITEM(<REF2.DISPIDDEC>).ANIM>
		LOCAL.BeardGump = <EVAL <LOCAL.BeardAnim> + 50000>

		DHTMLGUMP +5 +45 70 25 0 0 <DEF.CENTER><DEF.BFONT_White><StrLimit 8, <REF2.NAME>>
		DHTMLGUMP +0 +80 75 25 1 0 <DEF.CENTER><DEF.BFONT_Black>Sakalı kes
		GUMPPIC -50 5 <LOCAL.BeardGump> <EVAL (<REF2.COLOR> - 1) &~ 08000|04000>
		
	ENDIF
	BUTTON +30 +65 0845 0846 1 0 2
ELSE
	DHTMLGUMP +5 +25 70 50 0 0 <DEF.CENTER><DEF.BFONT_LRED>Sakal yok
ENDIF

DORIGIN 20 160
IF (<SRC.FINDLAYER.LAYER_BEARD> && <SRC.FINDLAYER.LAYER_HAIR>)
	DHTMLGUMP +20 +0 145 25 1 0 <DEF.BFONT_Black>Saç & Sakal Kes
	BUTTON +0 +5 0845 0846 1 0 3
ENDIF

