[TYPEDEF t_rune]

ON=@CLICK
IF (<MOREX> > 0)
   MESSAGE (<MOREX>,<MOREY>,<MOREZ>,<MOREM>)
ENDIF
IF (<COLOR>)
	IF !(STRMATCH('<SERV.MAP(<MOREX>,<MOREY>,<MOREZ>,<MOREM>).REGION.NAME>','<NAME>'))
		MESSAGE @<COLOR>,,1 [<SERV.MAP(<MOREX>,<MOREY>,<MOREZ>,<MOREM>).REGION.NAME>]
	ENDIF
	MESSAGE @<COLOR>,,1 <NAME>
	RETURN 1
ELSE
   RETURN 0
ENDIF

ON=@DCLICK
IF !(<MOREX> > 0)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301017
	RETURN 1
ENDIF
TARGET
SRC.SYSMESSAGELOC <def.tcolor_grey>,3301018
RETURN 1


ON=@TARGON_ITEM
IF (<SRC.TARG.UID> == <UID>)
	IF !(<MOREX> > 0)
		SRC.SYSMESSAGELOC <def.tcolor_red>,3301019
		RETURN 1
	ENDIF
	DIALOGCLOSE D_RUNE_RENAME
	DIALOG D_RUNE_RENAME

ELSEIF (<SRC.TARG.BASEID> == I_RUNEBOOK)
	SRC.TARG.Func_Runebook_Add_Rune <UID>
ELSE
SRC.SYSMESSAGELOC <def.tcolor_red>,3301020
ENDIF
RETURN 1


[DIALOG D_RUNE_RENAME]
<DEF.DSP>
RESIZE 0,0,280,185,Rune İşlemleri

DORIGIN 20 50
RESIZEPIC +0 +0 3000 240 25
DTEXTENTRYLIMITED +5 +5 215 25 <COLOR> 0 16 <NAME>

BUTTON +0 +30 4006 4007 1 0 1 
DTEXT +30 +30 <def.tcolor_green> Tamam

BUTTON +125 +30 4006 4007 1 0 2
DTEXT +155 +30 <def.tcolor_text> Varsayılan

CALL Func_Map_Colors <MOREX>,<MOREY>,<MOREZ>,<MOREM>

DHTMLGUMP +0 +60 240 25 1 0 <LOCAL.REGIONCOLOR_HTML><SERV.MAP(<MOREX>,<MOREY>,<MOREZ>,<MOREM>).REGION.NAME>
DHTMLGUMP +0 +90 240 25 1 0 <MOREX>,<MOREY>,<MOREZ>,<MOREM>

[DIALOG D_RUNE_RENAME BUTTON]
ON=1
IF (<ISBADCHAR <ARGTXT[0]>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301021
	RETURN 1
ELSEIF (<ISBLANK <ARGTXT[0]>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300323
	RETURN 1
ELSEIF !(STRREGEX(^[a-zA-Z0-9 ]+$,<ARGTXT[0]>))
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301022
	RETURN 1
ELSEIF (<EVAL STRLEN(<ARGTXT[0]>)> < 3) || (<EVAL STRLEN(<ARGTXT[0]>)> > 25)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3300443
	RETURN 1
ENDIF
NAME=rn: <ARGTXT[0]>
SRC.SYSMESSAGELOC <def.tcolor_grey>,3301023,<ARGTXT[0]>

ON=2
NAME=<SERV.MAP(<MOREX>,<MOREY>,<MOREZ>,<MOREM>).REGION.NAME>
SRC.SYSMESSAGELOC <def.tcolor_grey>,3301024,<NAME>
















