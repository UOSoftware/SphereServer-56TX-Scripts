// hardcodenin yanisira ayni algoritma ile scriptlede stat verelim dedik ama bence gerek yok.
// ON=@DCLICK
// local.skill <SRC.Fight_GetWeaponSkillID>
// SRC.f_StatGain <dlocal.skill>



// ============================================================
// [ADVANCE] bloğundaki değerleri buraya yansıt
// Örnek: STR=10000,3500,250
// ============================================================
[DEFNAME statadv_values]
STATADV_STR_0   10000
STATADV_STR_1   3500
STATADV_STR_2   250

STATADV_DEX_0   10000
STATADV_DEX_1   3500
STATADV_DEX_2   250

STATADV_INT_0   10000
STATADV_INT_1   3500
STATADV_INT_2   250


// ============================================================
// Stat Gain — C++ CChar::Skill_Experience karşılığı
// Kullanım: f_StatGain(<skillnum>)
// ============================================================
[FUNCTION f_StatGain]
LOCAL.skill   = <ARGV0>
LOCAL.statcap = <SKILLCLASS.STATSUM>
LOCAL.statsum = <eval <STR> + <DEX> + <INT>>

FOR i 0 2

    // Can't gain STR(0) or DEX(1) if morphed
    IF (<FLAGS>&STATF_POLYMORPH && (<dLOCAL.i> != 2))
        CONTINUE
    ENDIF

    // Stata özel değerleri ata
    IF (<dLOCAL.i> == 0)
        LOCAL.statval   = <STR>
		local.statname	= STR
        LOCAL.statmax   = 100
        LOCAL.lock      = <STATLOCK[0]>     // STR = index 0
        LOCAL.stattarg  = <SERV.SKILL.<dLOCAL.skill>.STAT_STR>
        LOCAL.statbonus = <SERV.SKILL.<dLOCAL.skill>.BONUS_STR>
        LOCAL.adv0      = <def.STATADV_STR_0>
        LOCAL.adv1      = <def.STATADV_STR_1>
        LOCAL.adv2      = <def.STATADV_STR_2>
	
    ELSEIF (<dLOCAL.i> == 1)
        LOCAL.statval   = <DEX>
		local.statname	= DEX
        LOCAL.statmax   = 100
        LOCAL.lock      = <STATLOCK[1]>     // DEX = index 1
        LOCAL.stattarg  = <SERV.SKILL.<dLOCAL.skill>.STAT_DEX>
        LOCAL.statbonus = <SERV.SKILL.<dLOCAL.skill>.BONUS_DEX>
        LOCAL.adv0      = <def.STATADV_DEX_0>
        LOCAL.adv1      = <def.STATADV_DEX_1>
        LOCAL.adv2      = <def.STATADV_DEX_2>

    ELSE
        LOCAL.statval   = <INT>
		local.statname	= INT
        LOCAL.statmax   = 100
        LOCAL.lock      = <STATLOCK[2]>     // INT = index 2
        LOCAL.stattarg  = <SERV.SKILL.<dLOCAL.skill>.STAT_INT>
        LOCAL.statbonus = <SERV.SKILL.<dLOCAL.skill>.BONUS_INT>
        LOCAL.adv0      = <def.STATADV_INT_0>
        LOCAL.adv1      = <def.STATADV_INT_1>
        LOCAL.adv2      = <def.STATADV_INT_2>
    ENDIF
	// serv.log <local.statname>;
	
    // SKILLLOCK_UP = 0 → artabilir; diğerleri atla
    IF (<dLOCAL.lock> != 0)
		// serv.log Skill lock.
        CONTINUE
    ENDIF

    // Beklenmedik durum
    IF (<dLOCAL.statval> <= 0)
		// serv.log Beklenmedik durum.
        CONTINUE
    ENDIF

    // stat cap aşılmış → döngüyü kır
    IF (<dLOCAL.statsum> > <dLOCAL.statcap>)
		// serv.log statcap asmis.
        BREAK
    ENDIF

    // Stat kendi limitine ulaşmış
    IF (<dLOCAL.statval> >= <dLOCAL.statmax>)
		// serv.log Stat kendi limitine ulasmis.
        CONTINUE
    ENDIF

    // Skill bu stat için hedef tanımlamamış
    IF (<dLOCAL.stattarg> <= 0)
		// serv.log Skill bu stat icin skillde hedef tanimlamamis. 
        CONTINUE
    ENDIF

    // Mevcut stat hedefi zaten geçmiş
    IF (<dLOCAL.statval> >= <dLOCAL.stattarg>)
		// serv.log Mevcut stat hedefi zaten gecmis.
        CONTINUE
    ENDIF

    // iDifficulty = IMulDiv( uiStatVal, 1000, bStatTarg )
    LOCAL.iDifficulty = <MULDIV <dLOCAL.statval>, 1000, <dLOCAL.stattarg>>

    // iChance = g_Cfg.m_StatAdv[i].GetChancePercent(iDifficulty)
    LOCAL.iChance = <CValueCurveDefGetChancePercent <dLOCAL.iDifficulty>,<dLOCAL.adv0>,<dLOCAL.adv1>,<dLOCAL.adv2>>
	// serv.log <dLOCAL.iDifficulty>,<dLOCAL.adv0>,<dLOCAL.adv1>,<dLOCAL.adv2>

    // if (m_StatPercent) iChance = (iChance * m_StatBonus[i] * m_StatPercent) / 10000
    LOCAL.iStatPercent = <SERV.SKILL.<dLOCAL.skill>.BONUS_STATS>
	
    IF (<dLOCAL.iStatPercent>)
        LOCAL.iChance = <eval (<dLOCAL.iChance> * <dLOCAL.statbonus> * <dLOCAL.iStatPercent>) / 10000>
    ENDIF
	
	// local.iChance *=5 // kolay gain
	
	// serv.log Chance = <dLOCAL.iChance>

    IF (<dLOCAL.iChance> <= 0)
        CONTINUE
    ENDIF

    // Stat_Decrease — cap doluysa başka bir statı düşür
    LOCAL.fDecrease = 1

    IF (<dLOCAL.statsum> >= <dLOCAL.statcap>)
        LOCAL.fDecrease = 0

        IF (<dLOCAL.i> != 0 && <STATLOCK[0]> == 0 && <STR> > 0)
            STR -= 1
            LOCAL.statsum --
            LOCAL.fDecrease = 1
			
        ELSEIF (<dLOCAL.i> != 1 && <STATLOCK[1]> == 0 && <DEX> > 0)
            DEX -= 1
            LOCAL.statsum --
            LOCAL.fDecrease = 1
			
        ELSEIF (<dLOCAL.i> != 2 && <STATLOCK[2]> == 0 && <INT> > 0)
            INT -= 1
            LOCAL.statsum --
            LOCAL.fDecrease = 1
        ENDIF
		
    ENDIF
	

    // if ( iChance > g_Rand.GetVal(1000) && fDecrease )
    IF (<R1000> < <dLOCAL.iChance> && <dLOCAL.fDecrease>)
        IF (<dLOCAL.i> == 0)
            STR += 1
        ELSEIF (<dLOCAL.i> == 1)
            DEX += 1
        ELSE
            INT += 1
        ENDIF
		
        LOCAL.statsum = <eval <STR> + <DEX> + <INT>>
		
        BREAK
    ENDIF

ENDFOR


// ============================================================
// CValueCurveDef::GetLinear
// ARGV0           = iSkillPercent (0-1000)
// ARGV1..ARGV<N>  = m_aiValues (curve değerleri)
// RETURN          = raw chance value
// ============================================================
[FUNCTION CValueCurveDefGetLinear]
LOCAL.iSkillPercent = <ARGV0>
LOCAL.iQty          = <eval <ARGV> - 1>    // ARGV0 iSkillPercent, geri kalanı değerler
LOCAL.iLoIdx        = 0
LOCAL.iSegSize      = 0

IF (<dLOCAL.iQty> == 0)
    RETURN 0
ENDIF

IF (<dLOCAL.iQty> == 1)
    RETURN <ARGV1>
ENDIF

IF (<dLOCAL.iQty> == 2)
    LOCAL.iLoIdx   = 0
    LOCAL.iSegSize = 1000

ELSEIF (<dLOCAL.iQty> == 3)
    // En hızlı yol — iki segment: [0,500) ve [500,1000]
    IF (<dLOCAL.iSkillPercent> >= 500)
        LOCAL.iLoIdx        = 1
        LOCAL.iSkillPercent = <eval <dLOCAL.iSkillPercent> - 500>
    ELSE
        LOCAL.iLoIdx = 0
    ENDIF
    LOCAL.iSegSize = 500

ELSE
    // default: iQty > 3
    LOCAL.iLoIdx = <MULDIV <dLOCAL.iSkillPercent>, <dLOCAL.iQty>, 1000>
    LOCAL.iQty --
    IF (<dLOCAL.iLoIdx> < 0)
        LOCAL.iLoIdx = 0
    ENDIF
    IF (<dLOCAL.iLoIdx> >= <dLOCAL.iQty>)
        LOCAL.iLoIdx = <eval <LOCAL.iQty> - 1>
    ENDIF
    LOCAL.iSegSize      = <eval 1000 / <dLOCAL.iQty>>
    LOCAL.iSkillPercent = <eval <dLOCAL.iSkillPercent> - (<dLOCAL.iLoIdx> * <dLOCAL.iSegSize>)>
ENDIF

// Değerler ARGV1'den başlar → ARGV[iLoIdx+1] ve ARGV[iLoIdx+2]
LOCAL.iLoVal  = <ARGV<eval <dLOCAL.iLoIdx> + 1>>
LOCAL.iHiVal  = <ARGV<eval <dLOCAL.iLoIdx> + 2>>
LOCAL.iDiff   = <eval <dLOCAL.iHiVal> - <dLOCAL.iLoVal>>
LOCAL.iChance = <eval <dLOCAL.iLoVal> + <MULDIV <dLOCAL.iDiff>, <dLOCAL.iSkillPercent>, <dLOCAL.iSegSize>>>

IF (<dLOCAL.iChance> <= 0)
    RETURN 0
ENDIF

RETURN <dLOCAL.iChance>



// ============================================================
// CValueCurveDef::GetChancePercent
// ARGV0           = iSkillPercent (0-1000)
// ARGV1..ARGV3    = curve değerleri (m_aiValues)
// RETURN          = percent chance * 10 (0-1000)
// ============================================================
[FUNCTION CValueCurveDefGetChancePercent]
LOCAL.iChance = <CValueCurveDefGetLinear <ARGV0>,<ARGV1>,<ARGV2>,<ARGV3>>
IF (<dLOCAL.iChance> <= 0)
    RETURN 0
ENDIF
// return( 100000 / iChance )
RETURN <eval 100000 / <LOCAL.iChance>>





