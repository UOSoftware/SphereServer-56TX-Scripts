[TYPEDEF t_book]
ON=@CLICK
// MESSAGE @,,1 (Başlık: <TITLE>)
MESSAGE @,,1 (<TITLE>)
// IF !(<ISBLANK <TAG0.AUTHOR>>)
	// MESSAGE @,,1 (Yazar: <TAG0.AUTHOR>)
// ENDIF
MESSAGE <SERV.ITEMDEF.<ID>.NAME>
RETURN 1

ON=@DCLICK
// IF (<ISBLANK <TAG0.AUTHOR>>)
	// TAG0.AUTHOR=<SRC.NAME>
// ENDIF
DIALOGCLOSE D_BOOK
DIALOG D_BOOK
RETURN 1


[DIALOG D_BOOK]
<DEF.DSP>


GUMPPIC 0 0 01fe

DORIGIN 40 50
dhtmlgump +0 +0 200 25 0 0 Başlık:
IF !(<ISBLANK <TITLE>>)
	DTEXTENTRYLIMITED +50 +0 120 25 0 0 25 <TITLE>
ELSE
	DTEXTENTRYLIMITED +50 +0 120 25 0 0 25 
ENDIF


DORIGIN 40 80
IF (<ISBLANK <TAG0.AUTHOR>>)
	dhtmlgump +0 +0 200 25 0 0 Yazar: <SRC.NAME>
ELSE
	dhtmlgump +0 +0 200 25 0 0 Yazar: <TAG0.AUTHOR>
ENDIF

DORIGIN 40 110
IF !(<ISBLANK <TAG0.WRITED_AT>>)
	dhtmlgump +0 +0 150 60 0 0 Yazılma Tarihi: <DEF.BR><TAG0.WRITED_AT>
ENDIF

DORIGIN 40 160
IF !(<ISBLANK <TAG0.UPDATED_AT>>)
	dhtmlgump +0 +0 150 60 0 0 Güncellenme Tarihi: <DEF.BR><TAG0.UPDATED_AT>
ENDIF

DORIGIN 220 10
dhtmlgump +0 +0 175 240 0 1 
IF !(<ISBLANK <TAG0.BODY>>)
	dtextentrylimited +10 +0 175 240 0 1 125 <TAG0.BODY>
ELSE
	dtextentrylimited +10 +0 175 240 0 1 125 
ENDIF

[DIALOG D_BOOK BUTTON]
ON=0
IF (<ISBLANK <TAG0.AUTHOR>>)
	TAG0.AUTHOR=<SRC.NAME>
ENDIF
TITLE=<ARGTXT[0]>
TAG0.BODY=<ARGTXT[1]>
IF (<ISBLANK <TAG0.WRITED_AT>>)
	TAG0.WRITED_AT=<SERV.RTIME>
ENDIF
TAG0.UPDATED_AT=<SERV.RTIME>








