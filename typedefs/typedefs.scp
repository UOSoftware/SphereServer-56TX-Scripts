[TYPEDEF ei_deed_parts]

ON=@DCLICK
LOCAL.PARTS = <SERV.ITEMDEF.<BASEID>.TAG0.PARTS>
IF !(<ISEMPTY <LOCAL.PARTS>>)
	FOR 1 <ARRAYCOUNT <LOCAL.PARTS>>
		LOCAL.PART = <ARRAY <LOCAL.PARTS>,<DLOCAL._FOR>>
		SERV.NEWITEM <LOCAL.PART>,1,<SRC>,1
	ENDFOR
	REMOVE
ENDIF
RETURN 1






[TYPEDEF ei_food]

ON=@DClick
IF (<ATTR>&ATTR_MOVE_NEVER)
	RETURN 1
ELSEIF (<ATTR>&ATTR_STATIC)
	RETURN 1
ENDIF
IF (<SRC.FOOD> >= <SRC.MAXFOOD>)
	SRC.FOOD=<SRC.MAXFOOD>
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301008,<SRC.Food>,<SRC.MAXFOOD>
ELSE
	//SRC.FOOD +=1
	Local.FoodGain <qval (<morem>)?<morem>:1>
	SRC.FOOD +=<dlocal.foodgain>
	SRC.ANIM 6
	SRC.SOUND {03a 1 03b 1 03c 1}
	IF !(<SRC.IsUseSkill Magery>)
		SRC.EMOTELOC 0,3301181,<NAME>
	ENDIF
	SRC.TRIGGER @EAT
	CONSUME 1
ENDIF
RETURN 1




