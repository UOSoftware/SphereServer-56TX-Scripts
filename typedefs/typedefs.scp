// ÇİĞ ETLERİ PİŞİRMEK İÇİN GEREKLİ EKLENTİ.
[TYPEDEF t_meat_raw] 
ON=@DCLICK
IF !(<SRC.ISINPACK <UID>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600036,<SRC.TARG.NAME>	// Bunu (~1_val~) kullanabilmek için çantanızda veya üzerinizde olmalıdır.
ELSE
	TARGET
	SRC.SYSMESSAGELOC <def.tcolor_grey>,3301025
ENDIF
RETURN 1

ON=@TARGON_ITEM
IF (<SRC.FLAGS>&STATF_STONE|STATF_FREEZE|STATF_DEAD)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301026
	RETURN 1
ELSEIF (<SRC.ISOUTOFREACH 2,<SRC.TARG.UID>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301027
	RETURN 1
ELSEIF (<SRC.TARG.TYPE>!=T_CAMPFIRE)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301028
	RETURN 1
ELSEIF (<SRC.TARG.BASEID> == I_EMBER_LIT)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301029
	RETURN 1
ELSEIF !(<TDATA1>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301030
	RETURN 1
ELSEIF (<RESOURCETYPE <TDATA1>> != RES_ITEMDEF)	
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301030
	RETURN 1
ELSEIF !(<SRC.CANMAKESKILL <TDATA1>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301031,<SERV.ITEMDEF.<TDATA1>.SKILLMAKE>
	RETURN 1
ELSEIF !(<SRC.CANMAKE <TDATA1>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301032,<SERV.ITEMDEF.<TDATA1>.RESMAKE>
	RETURN 1
ENDIF
SRC.MAKEITEM <TDATA1>,<R1,10>
// SRC.FACE <SRC.TARG>
// SRC.BOW
RETURN 1







