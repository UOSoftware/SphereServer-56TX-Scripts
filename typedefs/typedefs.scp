[TYPEDEF t_container]
ON=@CLICK
IF !((<TYPE> == T_CORPSE) || (<BASEID> == I_MULTI_FINDER) || (<BASEID> == I_TRASHCAN) || (<BASEID> == I_RUNEBOOK))
	IF (<RESCOUNT>)
		MESSAGELOC 0,3301179,<RESCOUNT>,<FVAL <WEIGHT>>
	ENDIF
ENDIF


ON=@DCLICK
IF !((<BASEID> == I_BACKPACK) || (<BASEID> == I_MULTI_FINDER) || (<BASEID> == I_RUNEBOOK))
	LOCAL.MaxItems = <EVAL <SERV.CONTAINERMAXITEMS>-5>
	IF (<RESCOUNT>) && (<RESCOUNT> >= <LOCAL.MaxItems>)
		SRC.Notice Dikkat! Maksimum eşya limitini aştığı için (<RESCOUNT><dLOCAL.MaxItems> Items) içindeki bazı eşyaları göremiyor olabilirsiniz. İçindeki eşyaların tamamını görebilmek için kasanın içindeki eşya adetini <dLOCAL.MaxItems> altında tutunuz.
	ENDIF
ENDIF


ON=@DROPON_SELF
IF !((<BASEID> == I_BACKPACK) || (<BASEID> == I_MULTI_FINDER) || (<BASEID> == I_RUNEBOOK))
	LOCAL.MaxItems = <EVAL <SERV.CONTAINERMAXITEMS>-5>
	IF (<RESCOUNT>) && (<RESCOUNT> >= <LOCAL.MaxItems>)
		SRC.Notice Dikkat! Bu kasa maksimum eşya limitini aştığı için (<RESCOUNT>/<dLOCAL.MaxItems> Items) içindeki bazı eşyaları göremiyor olabilirsiniz. İçindeki eşyaların tamamını görebilmek için kasanın içindeki eşya adetini <dLOCAL.MaxItems> altında tutunuz.
	ENDIF
	IF (<ATTR>&ATTR_NEWBIE) 
		SRC.SYSMESSAGELOC <def.tcolor_red>,3301006
		// ATTR=<ATTR>&~ATTR_NEWBIE
		RETURN 1
	ENDIF
	IF (<ARGO.ATTR>&ATTR_NEWBIE) 
		SRC.SYSMESSAGELOC <def.tcolor_red>,3301007,<ARGO.NAME>
		RETURN 1
	ENDIF
ENDIF








