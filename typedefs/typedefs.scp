[TYPEDEF t_spawn_item]
ON=@SPAWN
REF1=<UID>

FORITEMS <EVAL <MAXDIST>+5>
	REF2=<UID>
	IF (<REF1> != <REF2>)
		IF (STRMATCH(*I_DUNGEON_CHEST_LEVEL_*,'<BASEID>'))
			REMOVE
		ENDIF
		IF (STRMATCH(*I_Lagan_CHEST_LEVEL_*,'<BASEID>'))
			REMOVE
		ENDIF
	ENDIF
ENDFOR

// GM'in tek tıklamasındaki ayrıntıyı (tür, ad, DEFNAME, sayı, süre aralığı, kalan süre) emulatör yazar.

ON=@DCLICK
IF (<SRC.ACCOUNT.PLEVEL> < 5)
	AUDIT spawn.dclick_denied,t_spawn_item
	RETURN 1
ELSE
	SRC.CTAG0.SPAWN_ITEM.MORE1=<MORE1>
	DIALOGCLOSE D_ITEMPROP1
	DIALOG D_ITEMPROP1 9
ENDIF
RESET
RETURN 1








