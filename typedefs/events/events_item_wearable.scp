VERSION=0.56T

// sphere.ini EventsItemWearable: sadece giyilen eşyalara (zırh, kıyafet, takı, silah, büyü kitabı) verilir.
[TYPEDEF ei_generic_item_wearables]
ON=@CLICK
LOCAL.DURABILITY = <EVAL 100 - <EVAL <HITPOINTS>*100>/<MAXHITS>>
IF (<DLOCAL.DURABILITY>)
	MESSAGELOC 0,3301198,<DLOCAL.Durability>
ENDIF
IF ((<ATTR>&ATTR_MAGIC) && (<MOREY> > 0)
	IF (<ATTR>&ATTR_IDENTIFIED)
		MESSAGE [<ColoredItemTitle>]
	ENDIF
	MESSAGELOC 0,3301189,<SERV.ITEMDEF.<ID>.NAME>
	RETURN 1
ENDIF

// ON=@EQUIP
// IF (<SRC.STR> < <REQSTR>)
	// SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bunu giyebilecek güçte değilsiniz. (Gerekli Str: <REQSTR>, Str:<SRC.STR>)
	// UNEQUIP
	// RETURN 1
// ENDIF

ON=@DCLICK
IF (<REQSTR>) && (<SRC.STR> < <REQSTR>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301039,<defmsg.equip_not_strong_enough>,<name>,<REQSTR>,<SRC.STR>
	UNEQUIP
	RETURN 1
ENDIF




[eof]
