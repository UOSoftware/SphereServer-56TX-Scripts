[TYPEDEF t_armor_leather]



[TYPEDEF t_clothing]











[TYPEDEF t_robe_gm]

ON=@DCLICK
IF (<SRC.ISINVIS>)
	SRC.INVIS=0
ELSE
	SRC.INVIS=1
ENDIF




[TYPEDEF t_spellbook]

ON=@CLICK
IF (<SPELLCOUNT> <= 0)
	MESSAGELOC 0,3301190
ELSE
	MESSAGELOC 0,3301191,<spellcount>
ENDIF
RETURN 1




[TYPEDEF t_spellbook_necro]

ON=@CLICK
IF (<SPELLCOUNT> <= 0)
	MESSAGELOC 0,3301192
ELSE
	MESSAGELOC 0,3301193,<spellcount>
ENDIF
RETURN 1





[TYPEDEF t_hair]

ON=@TIMER
RETURN 1
	


[TYPEDEF t_beard]

ON=@TIMER
RETURN 1




[TYPEDEF t_weapon_bow]

ON=@CLICK
IF (<TOPOBJ> == <SRC>)
	MESSAGELOC 0,3301194,<EVAL <TOPOBJ.RESCOUNT <TDATA3>>>
ENDIF



[TYPEDEF t_weapon_xbow]

ON=@CLICK
IF (<TOPOBJ> == <SRC>)
	MESSAGELOC 0,3301195,<EVAL <TOPOBJ.RESCOUNT <TDATA3>>>
ENDIF



[TYPEDEF t_weapon_mace_crook]

ON=@CLICK
REF1=<TAG0.NPC>
IF (<REF1.isvalid>) && (<REF1.ISCHAR>)
	MESSAGE (<REF1.NAME>)
ENDIF

IF (<TAG0.TARGP>)
MESSAGE (<TAG0.TARGP>)
ENDIF

ON=@TARGON_ITEM
RETURN 1

ON=@TARGON_CHAR
IF !(<SRC.TARG.NPC> == brain_animal)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301037
	RETURN 1
ELSEIF (<SRC.ISDISS 5,<SRC.TARG.UID>>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600018,<SRC.TARG.NAME>
	RETURN 1
ELSEIF (<SRC.TARG.OWNER>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,3301038
	RETURN 1
ENDIF
TAG0.NPC=<SRC.TARG.UID>


