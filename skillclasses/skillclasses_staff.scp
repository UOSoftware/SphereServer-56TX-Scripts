ON=@ItemClick
IF (<ACT.ATTR>&ATTR_STATIC)
	ACT.MESSAGE @0,3 (static)
ENDIF

ON=@DEATH
IF (<ISGM>)
	HITS=<STR>
	RESURRECT 1
	RETURN 1
ENDIF

ON=@ITEMCREATE
REF1=<ACT>
IF (<SRC.ACCOUNT.PLEVEL> > 2)
	IF (<REF1.ISVALID>) && !((<REF1.CAN>&can_i_pile) || (<REF1.TYPE> == T_NORMAL) || (<REF1.ISEVENT.T_ROBE_GM>) || (<REF1.TYPE> == T_WALL) || (<REF1.TYPE> == T_SCRIPT) || (STRMATCH(*T_EQ*,'<REF1.TYPE>')) || (STRMATCH(*Missing*,'<REF1.NAME>')))
		REF1.TAG0.CREAT <SRC>
		SRC.LOGGER Esya olusturdu : <REF1.NAME> (<REF1>)
	ENDIF
ENDIF

ON=@USEREXTCMD
IF (<DARGN1> == 207)
	IF (<ARGV0> == 1)
		SRC.PG
	ELSEIF (<ARGV0> == 2)
		SRC.STAFFSETUP
	ENDIF
ENDIF
// Gm Char Worldmap üzerinde ALT + mouse click yaparsa tıkladığı yere gider.

IF (<DARGN1> == 211)
	IF (<ACCOUNT.PLEVEL> > 1)
		// SERV.B <argv0>,<argv1>,<argv2>,<argv3>
		SERV.NEWNPC C_MAN_INVISIBLE
		NEW.FLAGS |= STATF_INVISIBLE
		REF1=<NEW>
		NEW.P <argv0>,<argv1>,<argv2>,<argv3>

		NEW.FIX
		
		SRC.GO <REF1.P.X>,<REF1.P.Y>,<REF1.P.Z>,<REF1.P.M>
		SRC.MOVENEAR <REF1> 1
		SRC.SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc>, <ref1.p.x>-<ref1.p.y>-<ref1.p.z>-<ref1.p.m>
		SRC.FIX
		
		NEW.REMOVE
	ENDIF
ENDIF

ON=@SPELLEFFECT
IF (<ARGN> == 20)
	SAYU * büyüyü geri çevirir *
	IF (<FINDID.I_RUNE_POISON>)
		FINDID.I_RUNE_POISON.REMOVE
	ENDIF
	IF (<FINDID.I_RUNE_POISON_FIELD>)
		FINDID.I_RUNE_POISON_FIELD.REMOVE
	ENDIF
	EFFECT 3,0376A,1,30,1
	SOUND SND_SPELL_CURE
	SRC.POISON <FVAL <ARGN2>>
RETURN 1
ENDIF


[EOF]
