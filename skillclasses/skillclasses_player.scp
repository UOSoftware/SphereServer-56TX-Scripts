ON=@LOGIN
IF (<SRC.ISGM>)
	SRC.GM=0
ENDIF
IF (<SRC.DEBUG>)
	SRC.DEBUG=0
ENDIF
IF (<SRC.HEARALL>)
	SRC.HEARALL=0
ENDIF
IF !(<SRC.FINDLAYER(32)> || <SRC.FINDLAYER(44)> || <SRC.FINDLAYER(47)>)
	IF (<SRC.STATTOTAL> > <SRC.SKILLCLASS.STATSUM>)
		SRC.STR 75
		SRC.HITS <SRC.STR>
		SRC.DEX 75
		SRC.STAM <SRC.DEX>
		SRC.INT 75
		SRC.MANA <SRC.INT>
		SRC.NOTICE <DEF.BFONT_NOTICE_DRED>Statlarınız <SRC.SKILLCLASS.STATSUM> aşmış. Statlarınız varsayılan haline alınmıştır. Tekrar ayarlayınız.
	ENDIF
ENDIF




ON=@USERWARMODE
// ARGN1	I	If 0, the player is entering peace mode. If 1, the player is entering war mode.
// ARGN2	I	If 1 will trigger skill fail for the current skill.
// ARGN3	I	Setting it to 1 will force a attacker's cleanup.
// ARGN3=1
IF (<FLAGS>&STATF_STONE)
	RETURN 1
ENDIF



//*****************************************
// Spell Triggers
//*****************************************


ON=@DEATH
REF1=<QVAL (<SRC.ATTACKER.LAST>)?<SRC.ATTACKER.LAST>:<SRC.ATTACKER.MAX>> // ÖLDÜREN
SRC.SPEEDSET=0
SRC.TARGETCLOSE
IF (<SRC.FINDID.I_RUNE_INCOGNITO>)	
	SRC.FINDID.I_RUNE_INCOGNITO.REMOVE	
ENDIF
IF (<SRC.FINDID.I_RUNE_POLYMORPH>)
	SRC.FINDID.I_RUNE_POLYMORPH.REMOVE
ENDIF
IF (<REF1.ISVALID>) // öldüren varsa
	IF (<REF1.ISPLAYER>)
		LOCAL.DEATHBY <REF1.NAME>
		
	ELSEIF (<REF1.NPC>) && !(<REF1.OWNER>)
		LOCAL.DEATHBY <REF1.NAME> [Sahipsiz]
		
	ELSEIF (<REF1.NPC>) && (<REF1.OWNER>)
		LOCAL.DEATHBY <REF1.NAME> [Sahibi: <UID.<REF1.OWNER>.NAME>]
		
	ELSE
		LOCAL.DEATHBY <REF1.NAME>
	ENDIF

	IF !(STRMATCH('0','<TAG0.DEATHFORM>'))
		SERV.B @83,,1,1 <NAME>, <LOCAL.DEATHBY> tarafından <REF1.IsRegionNameDetail> bölgesinde <TAG0.DEATHFORM> öldürüldü.
	ELSE
		SERV.B @83,,1,1 <NAME>, <LOCAL.DEATHBY> tarafından <REF1.IsRegionNameDetail> bölgesinde öldürüldü.
	ENDIF
ENDIF

ON=@ITEMDCLICK
IF (<ACT.TOPOBJ.BASEID> == C_H_VENDOR) && (<ACT.TYPE>==T_CONTAINER)
	ACT.OPEN
	RETURN 1
ENDIF

ON=@TravelCheck
// Yolculuk büyüsünün motordaki kontrolü (sphere.ini'nin RecallSpellFlags'i...): ARGN1 büyü, ARGN2 bakılacak bitler,
//  ARGN3 aşama, ARGO hedef eşya. Gemi anahtarıyla recall: s_recall'ın @Start'ı anahtarın MOREP'ini geminin bugünkü
//  yerine çeker, cast başlarken hedef henüz eski yer: sadece atanın bitleri (07f). Anahtar kendi gemisine götürür:
//  hedefin gemi kontrolü yok.
IF (<ARGN1> == 32)
	IF (<ARGO>)
		IF (<ARGO.TYPE> == t_key)
			IF (<ARGN3> == travel_stage_caststart)
				ARGN2=<EVAL <ARGN2>&07f>
			ELSE
				ARGN2=<EVAL <ARGN2>&~travelf_dst_ship>
			ENDIF
		ENDIF
	ENDIF
ENDIF

[EOF]
