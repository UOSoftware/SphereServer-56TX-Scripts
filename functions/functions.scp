// Kullanim <DamTypesOfString <damtype>>
[function DamTypesOfString]
LOCAL.DAMTYPE_NAME = 0,

IF (<ARGV0>&dam_god)
	LOCAL.DAMTYPE_NAME= .=God-
ENDIF

IF (<ARGV0>&dam_physical)
	LOCAL.DAMTYPE_NAME .=Physical-
ENDIF

IF (<ARGV0>&dam_magic)
	LOCAL.DAMTYPE_NAME .=Magic-
ENDIF

IF (<ARGV0>&dam_poison)
	LOCAL.DAMTYPE_NAME .=Poison-
ENDIF

IF (<ARGV0>&dam_fire)
	LOCAL.DAMTYPE_NAME .=Fire-
ENDIF

IF (<ARGV0>&dam_energy)
	LOCAL.DAMTYPE_NAME .=Energy-
ENDIF

IF (<ARGV0>&dam_general)
	LOCAL.DAMTYPE_NAME .=Genel-
ENDIF

IF (<ARGV0>&dam_acidic)
	LOCAL.DAMTYPE_NAME .=Acidic-
ENDIF

IF (<ARGV0>&dam_cold)
	LOCAL.DAMTYPE_NAME .=Cold-
ENDIF

IF (<ARGV0>&dam_slash)
	LOCAL.DAMTYPE_NAME .=Slash-
ENDIF

IF (<ARGV0>&dam_pierce)
	LOCAL.DAMTYPE_NAME .=Pierce-
ENDIF

// IF (<ARGV0>&dam_nodisturb)
	// LOCAL.DAMTYPE_NAME .=NoDisturb,
// ENDIF

IF (<ARGV0>&dam_noreveal)
	LOCAL.DAMTYPE_NAME .=NoReveal-
ENDIF

IF (<ARGV0>&dam_nounparalyze)
	LOCAL.DAMTYPE_NAME .=NoUnParalyze-
ENDIF

IF (<ARGV0>&dam_fixed)
	LOCAL.DAMTYPE_NAME .=Fixed-
ENDIF

IF (<ARGV0>&dam_breath)
	LOCAL.DAMTYPE_NAME .=Breath-
ENDIF

IF (<ARGV0>&dam_thrown)
	LOCAL.DAMTYPE_NAME .=Throw-
ENDIF

IF (<ARGV0>&dam_reactive)
	LOCAL.DAMTYPE_NAME .=Reactive-
ENDIF
ARGS <LOCAL.DAMTYPE_NAME>
FOR 1 <EVAL <ARGV>-1>
	IF (STRMATCH('0','<LOCAL.RESULT>'))
		LOCAL.RESULT =<ARGV<DLOCAL._FOR>>
	ELSE
		LOCAL.RESULT .=<ARGV<DLOCAL._FOR>>
	ENDIF
ENDFOR
RETURN <LOCAL.RESULT>



[FUNCTION poop_smart_scan]
LOCAL.StartUID = 040000000
LOCAL.EndUID = <SERV.LASTNEWITEM>
LOCAL.FoundItems = 0
LOCAL.UID = <LOCAL.StartUID>
SERV.B @07a1 Scan start, <dLOCAL.EndUID> It will be checked all the way to the UID...
WHILE (<LOCAL.UID> < <LOCAL.EndUID>)
    IF (<UID.<LOCAL.UID>.ISVALID>) && (<UID.<LOCAL.UID>.ISITEM>)
        LOCAL.FoundItems ++
    ENDIF
    LOCAL.UID ++
ENDWHILE
SERV.LOG Scanned UID Range: <dLOCAL.StartUID> - <dLOCAL.EndUID>
SERV.LOG Valid Items Found: <dLOCAL.FoundItems> / <SERV.ITEMS>

[eof]
