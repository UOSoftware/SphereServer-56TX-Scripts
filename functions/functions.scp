[FUNCTION Func_Char_Default_Speech_Set]
// Speechs
IF !(<ISDSPEECH.spk_generic_chars>)
	DSPEECH +spk_generic_chars
ENDIF

IF (<ACCOUNT.PLEVEL> > 1) // Staff

	IF !(<ISDSPEECH.spk_generic_chars_staffs>)
		DSPEECH +spk_generic_chars_staffs
	ENDIF
	IF (<ISDSPEECH.spk_generic_chars_players>)
		DSPEECH -spk_generic_chars_players
	ENDIF

ELSE // Player

	IF (<ISDSPEECH.spk_generic_chars_staffs>)
		DSPEECH -spk_generic_chars_staffs
	ENDIF
	IF !(<ISDSPEECH.spk_generic_chars_players>)
		DSPEECH +spk_generic_chars_players
	ENDIF

ENDIF


