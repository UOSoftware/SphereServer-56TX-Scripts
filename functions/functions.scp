MANA = <INT>

[DIALOG D_SPELLBOOK]
<DEF.DSP>

RESIZEPIC 0 0 3000 660 730
LOCAL.X=5
LOCAL.Y=5

FOR 2240 2303
	local.spell <eval <dlocal._for>-2240+1>
	

	BUTTON <DLOCAL.X> <DLOCAL.Y> <dlocal._for> <dlocal._for> 1 0 <dlocal.spell>
	LOCAL.HUETEXT=0
	
	IF (<SERV.SPELL.<DLOCAL.SPELL>.FLAGS>&SPELLFLAG_DISABLED)
		LOCAL.HUETEXT=38
	ENDIF
	
	// DTEXT <EVAL <DLOCAL.X>+50> <DLOCAL.Y> <LOCAL.HUETEXT> <dlocal.spell>. <SERV.SPELL.<DLOCAL.spell>.NAME> 
	// DTEXT <EVAL <DLOCAL.X>+50> <eval <DLOCAL.Y>+20> <def.tcolor_text> <SERV.SPELL.<DLOCAL.spell>.RUNES> 
	dhtmlgump <EVAL <DLOCAL.X>+50> <eval <DLOCAL.Y>> 110 20 0 0 <dlocal.spell>. <SERV.SPELL.<DLOCAL.spell>.NAME> 
	
	dhtmlgump <EVAL <DLOCAL.X>+50> <eval <DLOCAL.Y>+20> 110 20 0 0 <strsub 1 99 <SERV.SPELL.<DLOCAL.spell>.RUNES> >
	
	// DTEXT <EVAL <DLOCAL.X>+0> <eval <DLOCAL.Y>+20> <def.tcolor_text> (<DLOCAL._FOR>)
	
	LOCAL.Y +=45
	IF (<LOCAL.Y> > 720)
		LOCAL.X +=160
		LOCAL.Y=5
	ENDIF
ENDFOR

