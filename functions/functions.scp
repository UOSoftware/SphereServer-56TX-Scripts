[PLEVEL 1]
SPELLBOOK


[FUNCTION SPELLBOOK]
DIALOGCLOSE D_SPELLBOOK
DIALOG D_SPELLBOOK
MANA = <INT>

[DIALOG D_SPELLBOOK]
<DEF.DSP>

RESIZEPIC 0 0 3000 660 730
LOCAL.X=5
LOCAL.Y=5

FOR 2240 2303
	local.spell <eval <dlocal._for>-2240+1>
	

	BUTTON <DLOCAL.X> <DLOCAL.Y> <dlocal._for> <dlocal._for> 1 0 <dlocal.spell>
	LOCAL.HUETEXT=0
	
	IF (<SERV.SPELL.<DLOCAL.SPELL>.FLAGS>&SPELLFLAG_DISABLED)
		LOCAL.HUETEXT=38
	ENDIF
	
	// DTEXT <EVAL <DLOCAL.X>+50> <DLOCAL.Y> <LOCAL.HUETEXT> <dlocal.spell>. <SERV.SPELL.<DLOCAL.spell>.NAME> 
	// DTEXT <EVAL <DLOCAL.X>+50> <eval <DLOCAL.Y>+20> <def.tcolor_text> <SERV.SPELL.<DLOCAL.spell>.RUNES> 
	dhtmlgump <EVAL <DLOCAL.X>+50> <eval <DLOCAL.Y>> 110 20 0 0 <dlocal.spell>. <SERV.SPELL.<DLOCAL.spell>.NAME> 
	
	dhtmlgump <EVAL <DLOCAL.X>+50> <eval <DLOCAL.Y>+20> 110 20 0 0 <strsub 1 99 <SERV.SPELL.<DLOCAL.spell>.RUNES> >
	
	// DTEXT <EVAL <DLOCAL.X>+0> <eval <DLOCAL.Y>+20> <def.tcolor_text> (<DLOCAL._FOR>)
	
	LOCAL.Y +=45
	IF (<LOCAL.Y> > 720)
		LOCAL.X +=160
		LOCAL.Y=5
	ENDIF
ENDFOR

[DIALOG D_SPELLBOOK BUTTON]
on=1 64
IF !(<RESTEST 1 I_FULL_SPELLBOOK>)
	SERV.NEWITEM I_FULL_SPELLBOOK
	NEW.BOUNCE
ENDIF
//src.mana = <src.int>
CAST <DARGN>
sysmessageloc <def.tcolor_text>, <def.empty_cliloc2>, ID=<ARGN>, NAME=<SERV.SPELL.<DARGN>.NAME>, WORD=<SERV.SPELL.<DARGN>.RUNES>
DIALOGCLOSE D_SPELLBOOK
DIALOG D_SPELLBOOK





[FUNCTION GetCharActionName]
IF ((<ACTION> >= skill_anatomy) && (<ACTION> <= skill_throwing))	//1 ~ 57
 return <DEF.skillact_using> <SERV.SKILL.<eval <ACTION> & 0ff>.KEY>
ELIF (<ACTION> == 100)
 return <DEF.skillact_following>
ELIF (<ACTION> == 101)
 return <DEF.skillact_staying>
ELIF (<ACTION> == 102)
 return <DEF.skillact_goingto>
ELIF (<ACTION> == 103)
 return <DEF.skillact_wandering>
ELIF (<ACTION> == 104)
 return <DEF.skillact_looking>
ELIF (<ACTION> == 105)
 return <DEF.skillact_fleeing>
ELIF (<ACTION> == 106)
 return <DEF.skillact_talking>
ELIF (<ACTION> == 107)
 return <DEF.skillact_talkfollow>
ELIF (<ACTION> == 108)
 return <DEF.skillact_guarding>
ELIF (<ACTION> == 109)
 return <DEF.skillact_goinghome>
ELIF (<ACTION> == 110)
 return <DEF.skillact_breathing>
ELIF (<ACTION> == 111)
 return <DEF.skillact_ridden>
ELIF (<ACTION> == 112)
 return <DEF.skillact_throwing>
ELIF (<ACTION> == 113)
 return <DEF.skillact_training>
ELIF (<ACTION> == 114)
 return <DEF.skillact_searchingfood>
ELIF (<ACTION> == 115)
 return <DEF.skillact_runningto>
ELSE
 return <DEF.skillact_idling>
ENDIF









[FUNCTION Logger]
// TREF_SERV          000001
// TREF_FILE          000002
// TREF_NEWFILE       000004
// TREF_DB            000008
// TREF_RESDEF        000010
// TREF_RESBASE       000020
// TREF_FUNCTIONARGS  000040
// TREF_FILEOBJ       000080
// TREF_FILEOBJCONT   000100
// TREF_ACCOUNT       000200
// TREF_STONEMEMBER   000800
// TREF_SERVERDEF     001000
// TREF_SECTOR        002000
// TREF_WORLD         004000
// TREF_GMPAGE        008000
// TREF_CLIENT        010000
// TREF_OBJECT        020000
// TREF_CHAR          040000
// TREF_ITEM          080000
//EXAMPLE: @
// CTCOL_RED, 
// LOGL_EVENT, 
// LOGM_NOCONTEXT|LOGM_KILLS 
// MESSAGE

IF (<GETREFTYPE> == <def.tref_account> || <GETREFTYPE> == <def.tref_client> || <GETREFTYPE> == <def.tref_world> || <GETREFTYPE> == <def.tref_char> || <GETREFTYPE> == <def.tref_item> || <GETREFTYPE> == <def.tref_object>)
	
	IF (<GETREFTYPE> == <def.tref_world>)
	
		// Item
		IF (<ISITEM>)
			LOCAL.OBJINFO = ItemLog - [BaseID=<BASEID>, Type=<TYPE>, Name=<NAME>, UID=<UID>, P=<P>, Region=<QVAL (<REGION>)?<REGION.NAME>:->, Topobj=<TOPOBJ>(<TOPOBJ.NAME>)]
			LOCAL.COLOR=<def.CTCOL_DEFAULT>
			CALL ContanerAllInsideLog 
			
		// Char
		ELSEIF (<ISCHAR>)
			IF (<ISPLAYER>)
				LOCAL.COLOR=<QVAL (<ACCOUNT.PLEVEL> == 1)?<def.CTCOL_YELLOW>:<DEF.CTCOL_CYAN>>
				LOCAL.OBJINFO <QVAL (<ACCOUNT.PLEVEL> == 1)?Player:Staff>Log - [Priv=<ACCOUNT.PLEVEL>, Account=<ACCOUNT>, Name=<NAME>, UID=<UID>, Region=<QVAL (<REGION>)?<REGION.NAME>/<P>:>, IP=<ACCOUNT.LASTIP>, ClientVersion=<REPORTEDCLIVER>]
			ELSE
				LOCAL.COLOR=<def.CTCOL_WHITE>
				LOCAL.OBJINFO NPCLog - [Name=<NAME>, UID=<UID>, Food=<FOOD>/<MAXFOOD>, Owner=<qval (<owner>)?<owner.NAME>:Yok>, Region=<QVAL (<REGION>)?<REGION.NAME>/<P>:>]
			ENDIF
		ENDIF
	ENDIF
	
	SERV.LOG @<LOCAL.COLOR>,<def.LOGL_EVENT>,(<def.LOGM_NOCONTEXT>) [<GETREFTYPE>] <LOCAL.OBJINFO> == <ARGS>
ELSE
	SERV.LOG @<def.CTCOL_DEFAULT>,<def.LOGL_EVENT>,(<def.LOGM_NOCONTEXT>) [<GETREFTYPE>] <ARGS>
ENDIF







[FUNCTION ContanerAllInsideLog]
REF1=<UID>
IF (<REF1.ISCONT>)
	IF (<REF1.RESCOUNT> > 0)
		LOCAL.OBJINFO .= [Container Items / Rescont=<RESCOUNT>];
		FORCONT <UID> 99999999
			LOCAL.x ++
			LOCAL.OBJINFO .= * <DLOCAL.x>. BaseID=<BASEID>, Type=<TYPE>, Name=<NAME>, UID=<UID> , 
		ENDFOR
		LOCAL.OBJINFO .= ]
	ENDIF
ENDIF





[FUNCTION Func_Map_Colors]
// argv0 = x , argv1 = y, argv2 = z , argv3 = m
IF ((<ISNUM <ARGV[0]>>) || (<ISNUM <ARGV[1]>>) || (<ISNUM <ARGV[2]>>) || (<ISNUM <ARGV[3]>>))
LOCAL.P <ARGV[0]>,<ARGV[1]>,<ARGV[2]>,<ARGV[3]>

	IF !(<ISEMPTY <LOCAL.P>>)
		IF (<SERV.MAP(<LOCAL.P>).REGION.FLAGS>&REGION_FLAG_GUARDED)
			LOCAL.REGIONCOLOR_MARK 084A
			LOCAL.REGIONCOLOR_HTML <DEF.BFONT_BLUE>
			LOCAL.REGIONCOLOR_TEXT 084a
		ELIF (<SERV.MAP(<LOCAL.P>).REGION.FLAGS>&REGION_FLAG_UNDERGROUND)
			LOCAL.REGIONCOLOR_MARK 03B0
			LOCAL.REGIONCOLOR_HTML <DEF.BFONT_GRAY_RUNEBOOK>
			LOCAL.REGIONCOLOR_TEXT 0450
		ELIF (<SERV.MAP(<LOCAL.P>).REGION.FLAGS>&REGION_FLAG_SAFE)
			LOCAL.REGIONCOLOR_MARK 08A1
			LOCAL.REGIONCOLOR_HTML <DEF.BFONT_GREEN>
			LOCAL.REGIONCOLOR_TEXT 044
		ELSE
			LOCAL.REGIONCOLOR_MARK 0845
			LOCAL.REGIONCOLOR_HTML <DEF.BFONT_RED>
			LOCAL.REGIONCOLOR_TEXT 38
		ENDIF
	ENDIF
ENDIF




// LOCAL.REGIONCOLOR_MARK 0845
// LOCAL.REGIONCOLOR_HTML <DEF.BFONT_RED>
// LOCAL.REGIONCOLOR_TEXT 38
[FUNCTION Func_CharName_Colors]
REF100=<ARGS>
IF (<REF100>)
	IF (0<REF100.ACCOUNT.PLEVEL> > 1)
		LOCAL.CharNameColor_HTML <DEF.BFONT_PURPLE>
		LOCAL.CharNameColor_Text 030
	ELSEIF (<REF100.ISDEATH>)
		LOCAL.CharNameColor_HTML <DEF.BFONT_DGRAY>
		LOCAL.CharNameColor_Text 0455
	ELSEIF (<REF100.ISPK>)
		LOCAL.CharNameColor_HTML <DEF.BFONT_RED>
		LOCAL.CharNameColor_Text 38
	ELSEIF !(<REF100.ISPK>)
		LOCAL.CharNameColor_HTML <DEF.BFONT_BLUE>
		LOCAL.CharNameColor_Text 063
	ELSE
		LOCAL.CharNameColor_HTML <DEF.BFONT_BLACK>
		LOCAL.CharNameColor_Text 1000
	ENDIF
ENDIF




[FUNCTION Func_CharRegion_Colors]
REF1=<ARGS>
IF (<REF1>)
	IF (<REF1.ISONLINE>)
		IF (<REF1.REGION.GUARDED>)
			LOCAL.CharRegionColor_HTML <DEF.BFONT_BLUE>
			LOCAL.CharRegionColor_TEXT 063
		ELSEIF (<ref1.REGION.FLAGS>&REGION_FLAG_SAFE)
			LOCAL.CharRegionColor_HTML <DEF.BFONT_GREEN>
			LOCAL.CharRegionColor_TEXT 044
		ELSEIF (<REF1.REGION.FLAGS>&region_flag_underground)
			LOCAL.CharRegionColor_HTML <DEF.BFONT_GRAY>
			LOCAL.CharRegionColor_TEXT 03b0
		ELSE
			LOCAL.CharRegionColor_HTML <DEF.BFONT_RED>
			LOCAL.CharRegionColor_TEXT 38
		ENDIF
	ELSE
		LOCAL.CharRegionColor_HTML <DEF.BFONT_RED>
		LOCAL.CharRegionColor_TEXT 38
	ENDIF
ENDIF





[FUNCTION ISVALIDE]
RETURN <ISVALID>

