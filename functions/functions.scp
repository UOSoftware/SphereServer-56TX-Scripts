[PLEVEL 9]
WRITEFILE
DELETEFILE

[FUNCTION WRITEFILE]
IF (STRMATCH(*.scp*,'<ARGS>')) 
	RETURN 1
// ELSEIF (STRMATCH(*.php*,'<ARGS>'))
	// RETURN 1
ENDIF

IF !(<FILE.INUSE>)
	FILE.MODE.CREATE=1
	FILE.MODE.APPEND=1
	FILE.MODE.WRITEFLAG=1
	IF (<FILE.OPEN <STRARG <ARGS>>>)
		FILE.WRITELINE <STREAT <ARGS>>
		FILE.CLOSE
	ENDIF
ENDIF



[FUNCTION DELETEFILE]
IF (STRMATCH(*.scp*,'<ARGS>')) 
	RETURN 1
ELSEIF (STRMATCH(*.php*,'<ARGS>'))
	RETURN 1
ENDIF
IF !(<FILE.INUSE>)
	FILE.MODE.APPEND=1
	FILE.DELETEFILE <ARGS>
	FILE.CLOSE
ENDIF






