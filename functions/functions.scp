[function FUNC_SETREFRESH]
LOCAL.VALUE <ARGS>

IF !(<ISEMPTY <ARGS>>)
	IF (<FINDID.I_<LOCAL.VALUE>_PLATEMAIL>)
		FINDID.I_<LOCAL.VALUE>_PLATEMAIL.REMOVE
	ENDIF
	IF (<FINDID.I_<LOCAL.VALUE>_PLATEMAIL_ARMS>)
		FINDID.I_<LOCAL.VALUE>_PLATEMAIL_ARMS.REMOVE
	ENDIF
	IF (<FINDID.I_<LOCAL.VALUE>_PLATEMAIL_LEGGINGS>)
		FINDID.I_<LOCAL.VALUE>_PLATEMAIL_LEGGINGS.REMOVE
	ENDIF
	IF (<FINDID.I_<LOCAL.VALUE>_PLATEMAIL_GORGET>)
		FINDID.I_<LOCAL.VALUE>_PLATEMAIL_GORGET.REMOVE
	ENDIF
	IF (<FINDID.I_<LOCAL.VALUE>_PLATEMAIL_GAUNTLETS>)
		FINDID.I_<LOCAL.VALUE>_PLATEMAIL_GAUNTLETS.REMOVE
	ENDIF
	IF (<FINDID.I_<LOCAL.VALUE>_PLATE_HELM>)
		FINDID.I_<LOCAL.VALUE>_PLATE_HELM.REMOVE
	ENDIF
	IF (<FINDID.I_<LOCAL.VALUE>_HEATER_SHIELD>)
		FINDID.I_<LOCAL.VALUE>_HEATER_SHIELD.REMOVE
	ENDIF

	FOR 1 24
		IF (<FINDLAYER(<DLOCAL._FOR>)>)
			IF (<DLOCAL._FOR> != 11) && (<DLOCAL._FOR> != 15) && (<DLOCAL._FOR> != 16) && (<DLOCAL._FOR> != 21)
			FINDLAYER.<LOCAL._FOR>.REMOVE
			ENDIF
		ENDIF
	ENDFOR

	SERV.NEWITEM I_<LOCAL.VALUE>_PLATEMAIL,1,<SRC>,1
	SERV.NEWITEM I_<LOCAL.VALUE>_PLATEMAIL_ARMS,1,<SRC>,1
	SERV.NEWITEM I_<LOCAL.VALUE>_PLATEMAIL_LEGGINGS,1,<SRC>,1
	SERV.NEWITEM I_<LOCAL.VALUE>_PLATEMAIL_GORGET,1,<SRC>,1
	SERV.NEWITEM I_<LOCAL.VALUE>_PLATEMAIL_GAUNTLETS,1,<SRC>,1
	SERV.NEWITEM I_<LOCAL.VALUE>_PLATE_HELM,1,<SRC>,1
	SERV.NEWITEM I_<LOCAL.VALUE>_HEATER_SHIELD,1,<SRC>,1

ELSE

	IF (<FINDID.I_PLATEMAIL_CHEST>)
		FINDID.I_PLATEMAIL_CHEST.REMOVE
	ENDIF

	IF (<FINDID.I_PLATEMAIL_ARMS>)
		FINDID.I_PLATEMAIL_ARMS.REMOVE
	ENDIF

	IF (<FINDID.I_PLATEMAIL_LEGGINGS>)
		FINDID.I_PLATEMAIL_LEGGINGS.REMOVE
	ENDIF

	IF (<FINDID.I_PLATEMAIL_GORGET>)
		FINDID.I_PLATEMAIL_GORGET.REMOVE
	ENDIF

	IF (<FINDID.I_PLATEMAIL_GLOVES>)
		FINDID.I_PLATEMAIL_GLOVES.REMOVE
	ENDIF

	IF (<FINDID.I_PLATEMAIL_HELM>)
		FINDID.I_PLATEMAIL_HELM.REMOVE
	ENDIF

	IF (<FINDID.I_SHIELD_HEATER>)
		FINDID.I_SHIELD_HEATER.REMOVE
	ENDIF

	FOR 1 24
		IF (<FINDLAYER(<DLOCAL._FOR>)>)
			IF (<DLOCAL._FOR> != 11) && (<DLOCAL._FOR> != 15) && (<DLOCAL._FOR> != 16) && (<DLOCAL._FOR> != 21)
				FINDLAYER.<LOCAL._FOR>.REMOVE
			ENDIF
		ENDIF
	ENDFOR
	SERV.NEWITEM I_PLATEMAIL_CHEST,1,<SRC>,1
	SERV.NEWITEM I_PLATEMAIL_ARMS,1,<SRC>,1
	SERV.NEWITEM I_PLATEMAIL_LEGGINGS,1,<SRC>,1
	SERV.NEWITEM I_PLATEMAIL_GORGET,1,<SRC>,1
	SERV.NEWITEM I_PLATEMAIL_GLOVES,1,<SRC>,1
	SERV.NEWITEM I_PLATEMAIL_HELM,1,<SRC>,1
	SERV.NEWITEM I_SHIELD_HEATER,1,<SRC>,1
ENDIF

