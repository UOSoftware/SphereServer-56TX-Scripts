[FUNCTION SPEEDSET]
IF (<ISBLANK <ARGS>>)
	SYSMESSAGELOC <def.tcolor_grey>,600098, Normal // Karakter hızı: ~1_val~
ELSEIF (<ARGS> == 1)
	SYSMESSAGELOC <def.tcolor_grey>,600098,Hızlı  // Karakter hızı: ~1_val~
ELSEIF (<ARGS> == 2)
	SYSMESSAGELOC <def.tcolor_grey>,600098,Sadece yürüme  // Karakter hızı: ~1_val~
ELSEIF (<ARGS> == 3)
	SYSMESSAGELOC <def.tcolor_grey>,600098,Hızlı yürüme  // Karakter hızı: ~1_val~
ELSEIF (<ARGS> == 3)
	SYSMESSAGELOC <def.tcolor_grey>,600098,Yürüme/koşma kapalı  // Karakter hızı: ~1_val~
ENDIF
SPEEDMODE=<ARGS>




