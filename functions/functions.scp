[FUNCTION ServerStart_WorldContainerControl]
FORITEMS 7168
	IF (<TYPE> == T_CONTAINER)
		IF (<RESCOUNT> > 0)
			// SERV.B <NAME>
			REF1=<UID>
			LOCAL.I ++
