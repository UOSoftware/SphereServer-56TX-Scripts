[FUNCTION FUNC_ISIM_KONTROL]
IF (<FINDID.I_RUNE_INCOGNITO>)
	FINDID.I_RUNE_INCOGNITO.REMOVE
ENDIF

IF (STRLEN(<ARGS>) > 16) || (STRLEN(<ARGS>) < 2)
	LOCAL.NAME_BAD_LEN ++
ENDIF

IF (<ISFORBIDSTRING <ARGS>>)
	LOCAL.NAME_BAD_FORBIDDEN ++
ENDIF

LOCAL.CHAR=<ASC <ARGS>>

IF ( (STRMATCH('41*,'<LOCAL.CHAR>')) || (STRMATCH(*03d*,'<LOCAL.CHAR>')) || (STRMATCH(*02c*,'<LOCAL.CHAR>')) || (STRMATCH(*02e*,'<LOCAL.CHAR>')) || (STRMATCH(*021*,'<LOCAL.CHAR>')) || (STRMATCH(*05e*,'<LOCAL.CHAR>')) || (STRMATCH(*02b*,'<LOCAL.CHAR>')) || (STRMATCH(*025*,'<LOCAL.CHAR>')) || (STRMATCH(*026*,'<LOCAL.CHAR>')) || (STRMATCH(*028*,'<LOCAL.CHAR>')) || (STRMATCH(*029*,'<LOCAL.CHAR>')) || (STRMATCH(*03f*,'<LOCAL.CHAR>')) || (STRMATCH(*03e*,'<LOCAL.CHAR>')) || (STRMATCH(*03c*,'<LOCAL.CHAR>')) || (STRMATCH(*023*,'<LOCAL.CHAR>')) || (STRMATCH(*07b*,'<LOCAL.CHAR>')) || (STRMATCH(*05b*,'<LOCAL.CHAR>')) || (STRMATCH(*05d*,'<LOCAL.CHAR>')) || (STRMATCH(*07d*,'<LOCAL.CHAR>')) || (STRMATCH(*05c*,'<LOCAL.CHAR>')) || (STRMATCH(*07c*,'<LOCAL.CHAR>')) )
	LOCAL.NAME_BAD_CHAR ++
ENDIF

IF !(<ISSTRING <ARGS>>)
	LOCAL.NAME_BAD_CHAR ++
ENDIF

FOR a 0 <EVAL <SERV.ACCOUNTS>-1>
IF (<SERV.ACCOUNT.<DLOCAL.a>>)
	LOCAL.ACCOUNT <SERV.ACCOUNT.<DLOCAL.a>.NAME>
		IF (<SERV.ACCOUNT.<LOCAL.ACCOUNT>.CHARS>)
			FOR c 0 <EVAL <SERV.ACCOUNT.<LOCAL.ACCOUNT>.CHARS>-1>
				REF1=<SERV.ACCOUNT.<LOCAL.ACCOUNT>.CHAR.<DLOCAL.c>.UID>
				IF !(<REF1> == <UID>) && (STRMATCH('<REF1.NAME>','<ARGS>'))
					LOCAL.NAME_DUPE ++
				ENDIF
			ENDFOR
		ENDIF
	ENDIF
ENDFOR

IF (<DLOCAL.NAME_BAD_LEN>)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, İsminiz EN AZ 2 EN FAZLA 16 karakter olmalıdır.
ENDIF
IF (<DLOCAL.NAME_BAD_FORBIDDEN>)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, İsminiz içeriğinde argo veya yasaklı kelimeler bulunuyor.
ENDIF	
IF (<DLOCAL.NAME_BAD_CHAR>)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, İsminizde yalnızca alfabetik karakter kullanabilirsiniz.
ENDIF		
IF (<DLOCAL.NAME_DUPE>)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu isimden sunucuda bulunuyor.
ENDIF
LOCAL.Result <EVAL <DLOCAL.NAME_BAD_LEN> + <DLOCAL.NAME_BAD_FORBIDDEN> + <DLOCAL.NAME_BAD_CHAR> + <DLOCAL.NAME_DUPE>>
// serv.b <dLOCAL.Result>
IF (<DLOCAL.Result>)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, İsminiz hatalıdır, Otomatik olarak değiştirilmiştir. (<NAME>)
	NAME #NAMES_HUMAN<IsGenderName>
	DIALOGCLOSE D_RENAME_CHAR
	DIALOG D_RENAME_CHAR
ENDIF



// öldüren, tagname, fame
// <SRC.RESKILLCONDITION <REF99>,GUILD,1000>
// IF (<SRC.ResKillCondition <REF1>,Death,1000>)
	// SERV.B ResKillCondition
// ENDIF
[FUNCTION ResKillCondition]
// UID = ölen
// ARGV0 = öldüren
// ARGV1 = method
// ARGV2 = fame
REF1=<ARGV0>
IF (<REF1.ISVALID>)
	IF ((<FAME> > <ARGV2>) && (<dTAG0.LastDeathTime> > <SERV.TIME>) ) && !( (STRMATCH('<ACCOUNT.LASTIP>','<REF1.ACCOUNT.LASTIP>')) || (<UID> == <REF1>) )
		RETURN 1
	ENDIF
ENDIF
RETURN 0



[FUNCTION fCalcBellCurve]
LOCAL.iValDiff = <ARGV0>
LOCAL.iVariance = <ARGV1>
LOCAL.iChance = 500
IF (<LOCAL.iVariance> <= 0)
    RETURN 500
ENDIF
IF (<LOCAL.iValDiff> < 0)
    LOCAL.iValDiff = <EVAL -<LOCAL.iValDiff>>
ENDIF
WHILE (<LOCAL.iValDiff> > <LOCAL.iVariance>) && (<LOCAL.iChance> > 0)
    LOCAL.iValDiff = <EVAL <LOCAL.iValDiff> - <LOCAL.iVariance>>
    LOCAL.iChance = <EVAL <LOCAL.iChance> / 2>
ENDWHILE
LOCAL.iHalfChance = <EVAL <LOCAL.iChance> / 2>
LOCAL.iAdjust = <EVAL <LOCAL.iHalfChance> * <LOCAL.iValDiff>>
IF (<LOCAL.iVariance> > 0)
    LOCAL.iAdjust = <EVAL <LOCAL.iAdjust> / <LOCAL.iVariance>>
ELSE
    LOCAL.iAdjust = 0
ENDIF
RETURN <EVAL <LOCAL.iChance> - <LOCAL.iAdjust>>



[FUNCTION fCalcSCurve]
LOCAL.iValDiff = <ARGV0>
LOCAL.iVariance = <ARGV1>
LOCAL.iChance = <fCalcBellCurve <LOCAL.iValDiff>,<LOCAL.iVariance>>
IF (<LOCAL.iValDiff> > 0)
    RETURN <EVAL 1000 - <LOCAL.iChance>>
ENDIF
RETURN <LOCAL.iChance>





[FUNCTION Calc_CombatChanceToHit]
// basit usul miss hesap zimbirtisi
IF (<ACTDIFF> <= 0) // sadece faile dusecekse
    IF (RAND(45) <= <EVAL (<TACTICS> / 50)>)
        //ACTDIFF +=<R250,500>
        ACTDIFF = <R700,900>
        //serv.b @044,,1,1 Set <ACTDIFF>
    ENDIF
ENDIF
//serv.b @,,1,1 Name= <name> (Trigger:<ARGV0>, Actdiff:<actdiff>)





[FUNCTION Calc_CombatChanceToHitV3]
// IF (<ACTDIFF> <= 0) // EKSI YANI MISS ISE
	// ACTDIFF = 1000
	// SERV.B @044,,1,1 Actdiff Update (Eksi geldi.)
	// ACTDIFF 1000
	
	// local.Chance <Calc_CombatChanceToHitV2>
	// serv.b Chance = <dlocal.Chance>
	
	// ACTDIFF = <Dlocal.Chance>	
// ENDIF
// skillcheck <action>, <actdiff>, 0 




[FUNCTION Calc_CombatChanceToHitV2]
// serv.b action= <ACTION>
// IF (<ACTION> == -1)
    // RETURN
// ENDIF
// IF (<ACTION> > 59)
    // RETURN
// ENDIF

IF !(<SERV.SKILL.<ACTION>.FLAGS>&SKF_FIGHT)
   RETURN
ENDIF

IF (<IsUseSkill Parrying>)
    RETURN
ENDIF

REF1 = <ATTACKER.LAST>
IF !(<REF1.ISVALID>)
	REF1= <ACT>
ENDIF
IF !(<REF1.ISVALID>)
	LOCAL.iDiff <R31>
ELSE

	LOCAL.iSkillVal = <I.<ACTION>> // BENIM KULLANDIGIM SKILL DEGERI
	LOCAL.iSkillAttack = <EVAL (<dLOCAL.iSkillVal> + <I.Tactics>) / 2>
	// serv.b <LOCAL.iSkillVal>
	// serv.b <dLOCAL.iSkillAttack>
	
	LOCAL._Carpan 10

	IF (<REF1.ISVALID> && <REF1.ISCHAR>)
		LOCAL.iSkillDefend = <REF1.Tactics> // HEDEFIN TACTICS
		LOCAL.iStam = <REF1.DEX> // HEDEFIN STAM
		
		IF ((<ref1.action> != -1 && <ref1.action> == ARCHERY) && (<i.action> != -1 && <i.action> != ARCHERY))
			LOCAL._Carpan 9	
		ENDIF
		
	ENDIF

	LOCAL.iSkillDefend = <EVAL ( <dLOCAL.iSkillDefend> + <dLOCAL.iStam> * <dlocal._Carpan>) / 2>
	
	LOCAL.iDiff = <EVAL (<dLOCAL.iSkillAttack> - <dLOCAL.iSkillDefend>) / 5>
	LOCAL.iDiff = <EVAL (<dLOCAL.iSkillVal> - <dLOCAL.iDiff>) / 10>
	
	
	// LOCAL.iDiff +=<R250,500> // BİRAZ AZ MİSS GEÇSİN.
	// serv.b iDiff = <dlocal.iDiff>
	// serv.b <ref1.name>

	// IF (<LOCAL.iDiff> < 0)
		// LOCAL.iDiff = 0 // just means it's very easy. Bu sadece çok kolay olduğu anlamına geliyor.
	// ENDIF

	// IF (<LOCAL.iDiff> > 100)
		// LOCAL.iDiff = 100 // just means it's very hard. Bu sadece çok zor olduğu anlamına geliyor.
	// ENDIF

	Local.Result <R<dLOCAL.iDiff>> // always need to have some chance. Her zaman bir şansa ihtiyaç vardır.
	// serv.b result = <dlocal.result>
ENDIF

RETURN <dlocal.result>






[FUNCTION Calc_CombatChanceToHitV1]
IF (<ACTION> == -1)
    RETURN
ENDIF

IF (<ACTION> > 59)
    RETURN
ENDIF

//IF !(<SERV.SKILL.<ACTION>.FLAGS>&SKF_FIGHT)
  //  RETURN
//ENDIF

IF (<IsUseSkill Parrying>)
    RETURN
ENDIF

REF1 = <ATTACKER.LAST>
IF !(<REF1.ISVALID>)
	REF1= <ACT>
ENDIF

IF !(<REF1.ISVALID>)
	LOCAL.DIFF <R31>
ENDIF

LOCAL.iSkillVal = <I.<ACTION>> // BENIM KULLANDIGIM SKILL DEGERI
LOCAL.iSkillAttack = <EVAL (<dLOCAL.iSkillVal> + <I.Tactics>) / 2>
LOCAL._Carpan 10

IF (<REF1.ISVALID> && <REF1.ISCHAR>)
	LOCAL.iSkillDefend = <REF1.Tactics>
	LOCAL.iStam = <REF1.DEX>
	IF ((<ref1.action> != -1 && <ref1.action> == ARCHERY) && (<i.action> != -1 && <i.action> != ARCHERY))
		LOCAL._Carpan 9	
	ENDIF
ENDIF

LOCAL.iSkillDefend = <EVAL ( <dLOCAL.iSkillDefend> + <dLOCAL.iStam> * <dlocal._Carpan>) / 2>

LOCAL.iDiff = <EVAL (<dLOCAL.iSkillAttack> - <dLOCAL.iSkillDefend>) / 5>
LOCAL.iDiff = <EVAL (<dLOCAL.iSkillVal> - <dLOCAL.iDiff>) / 10>


IF (<LOCAL.iDiff> < 0)
    LOCAL.iDiff = 0 // just means it's very easy.
ENDIF
IF (<LOCAL.iDiff> > 100)
    LOCAL.iDiff = 100 // just means it's very hard.
ENDIF

ACTDIFF = <R<dLOCAL.iDiff>>

IF (<ISPLAYER>)
    //SERV.LOG [Combat] iSkillVal=<LOCAL.iSkillVal>, Tactics=<I.Tactics>, Attack=<DLOCAL.iSkillAttack>, Defend=<DLOCAL.iSkillDefend>, Diff=<DLOCAL.iDiff>, ACTDIFF=<ACTDIFF>
ENDIF

RETURN <ACTDIFF>





[FUNCTION Calc_CombatChanceToHitV0]
IF (<ACTION> == -1)
    RETURN
ENDIF

IF !(<SERV.SKILL.<ACTION>.FLAGS>&SKF_FIGHT)
    RETURN
ENDIF

IF (<IsUseSkill Parrying>)
    RETURN
ENDIF

LOCAL.iMyWeaponSkill = <I.<ACTION>>
LOCAL.iMyTactics     = <I.Tactics>
LOCAL.iSkillAttack   = <EVAL (<LOCAL.iMyWeaponSkill> + <LOCAL.iMyTactics>) / 2>

REF1 = <ATTACKER.LAST>
IF !(<REF1.ISVALID>)
	REF1= <ACT>
ENDIF

LOCAL.iTargetTactics = 0
LOCAL.iTargetDex     = 0

IF (<REF1.ISVALID>)
    LOCAL.iTargetTactics = <REF1.Tactics>
    LOCAL.iTargetDex     = <REF1.DEX>
ENDIF

LOCAL.iSkillDefend = <EVAL (<LOCAL.iTargetTactics> + (<LOCAL.iTargetDex> * 10)) / 2>

LOCAL.iDiff = <EVAL (<LOCAL.iSkillAttack> - <LOCAL.iSkillDefend>) / 5>
LOCAL.iDiff = <EVAL (<LOCAL.iMyWeaponSkill> - <LOCAL.iDiff>) / 10>

IF (<LOCAL.iDiff> < 0)
    LOCAL.iDiff = 0
ENDIF
IF (<LOCAL.iDiff> > 100)
    LOCAL.iDiff = 100
ENDIF

LOCAL.iDifficulty = 0
IF (<LOCAL.iDiff> > 0)
    LOCAL.iDifficulty = <r<dLOCAL.iDiff>>
ENDIF


LOCAL.iValDiff = <EVAL <LOCAL.iMyWeaponSkill> - (<LOCAL.iDifficulty> * 10)>
LOCAL.iChance  = <fCalcSCurve <LOCAL.iValDiff>,100>
LOCAL.iRoll    = <R1000>

IF (<LOCAL.iRoll> <= <LOCAL.iChance>)
    // Başarı: difficulty değerinin kendisi skill advance için kullanılır
    ACTDIFF = <LOCAL.iDifficulty>
ELSE
    ACTDIFF = -1
ENDIF


// IF (<ISPLAYER>)
    // SERV.B @,,1,1 [Combat] WeaponSkill=<LOCAL.iMyWeaponSkill> Tactics=<LOCAL.iMyTactics> Attack=<DLOCAL.iSkillAttack> Defend=<DLOCAL.iSkillDefend> Diff=<DLOCAL.iDiff> RandDiff=<DLOCAL.iDifficulty> Chance=<DLOCAL.iChance> Roll=<DLOCAL.iRoll> ACTDIFF=<ACTDIFF>
    // SERV.LOG [Combat] WeaponSkill=<LOCAL.iMyWeaponSkill> Tactics=<LOCAL.iMyTactics> Attack=<DLOCAL.iSkillAttack> Defend=<DLOCAL.iSkillDefend> Diff=<DLOCAL.iDiff> RandDiff=<DLOCAL.iDifficulty> Chance=<DLOCAL.iChance> Roll=<DLOCAL.iRoll> ACTDIFF=<ACTDIFF>
// ENDIF








[FUNCTION ImpassableEnvironClear]
IF (<ISBLANK <ARGV0>>)
	Local.Radius=3
ELSE
	Local.Radius=<ARGV0>
ENDIF
IF (<DLocal.Radius> >= <SERV.MapViewSize>)
	Local.Radius=<EVAL <SERV.MapViewSize>>
ENDIF

FORITEMS <DLocal.Radius>
	IF (<IsItemTDataFlag <DEF.tilef_impassable>)
		TIMER
	ENDIF
ENDFOR



[FUNCTION fUnequip]
IF (<SRC.WEIGHT> >= <SRC.MAXWEIGHT>)
	DROP
	SRC.LOGGER <SRC.NAME> agirligi cok fazla oldugu icin <NAME> (<UID>) yere dustu.
ELSE
	UNEQUIP
ENDIF


// "ARGN" or "ARGN1" = a modifying numeric arg to the current trigger.
// "ARGN2" = a modifying numeric arg to the current trigger.
// "ARGN3" = a modifying numeric arg to the current trigger.
// m_pO1;      // "ARGO" or "ARGO1" = object 1
// m_s1;           // ""ARGS" or "ARGS1" = string 1
// m_s1_buf_vec;   // RAW, used to build argv in runtime
// "LOCAL.x" = local variable x
// "FLOAT.x" = float local variable x
// "REFx" = local object x
[FUNCTION AllArgLog]
SERV.B @,,1,1 SRC: UID=<SRC>, NAME=<SRC.NAME>
SERV.B @,,1,1 UID: UID=<UID>, NAME=<NAME>

REF1=<ARGN1>
IF (<REF1.ISVALID>)
    SERV.B @,,1,1 ARGN1: UID=<REF1>, NAME=<REF1.NAME>
ELSE
    SERV.B @,,1,1 ARGN1: <ARGN1>
ENDIF

REF2=<ARGN2>
IF (<REF2.ISVALID>)
    SERV.B @,,1,1 ARGN2: UID=<REF2>, NAME=<REF2.NAME>
ELSE
    SERV.B @,,1,1 ARGN2: <ARGN2>
ENDIF

REF3=<ARGN3>
IF (<REF3.ISVALID>)
    SERV.B @,,1,1 ARGN3: UID=<REF3>, NAME=<REF3.NAME>
ELSE
    SERV.B @,,1,1 ARGN3: <ARGN3>
ENDIF

REF4=<ARGO>
IF (<REF4.ISVALID>)
    SERV.B @,,1,1 ARGO: UID=<REF4>, NAME=<REF4.NAME>
ELSE
    SERV.B @,,1,1 ARGO: <ARGO>
ENDIF

REF5=<ARGS>
IF (<REF5.ISVALID>)
    SERV.B @,,1,1 ARGS: UID=<REF5>, NAME=<REF5.NAME>
ELSE
    SERV.B @,,1,1 ARGS: <ARGS>
ENDIF





[FUNCTION fControlledbyBounce]
REF1=<ARGV0> // PLAYER
IF (<REF1.ISVALID>)
    ref1.sysmessage Weight: <REF1.WEIGHT> / <REF1.MAXWEIGHT>
    IF (<REF1.WEIGHT> < <REF1.MAXWEIGHT>)
        CONT=<SRC.FINDLAYER.21>
        REF1.SYSMESSAGE <name> cantaniza gonderildi.
    ELSE
        CONT=<SRC.FINDLAYER.29>
        REF1.SYSMESSAGE <name> bankaniza gonderildi.
    ENDIF
ENDIF




