		// UPDATE
	ENDFOR
ENDIF




// AccountAllCharsEventToggle <eventname>
[FUNCTION AccountAllCharsEventToggle]
IF (<ACCOUNT.CHARS> > 0)
	FOR c 0 <EVAL <ACCOUNT.CHARS>-1>
		REF1=<ACCOUNT.CHAR.<DLOCAL.c>.UID>
		IF (<REF1.ISVALID>)
			IF (<ISEVENT.<ARGV0>>)
				REF1.EVENTS -<ARGV0>
			ELSE
				REF1.EVENTS +<ARGV0>
			ENDIF
		ENDIF
	ENDFOR
ENDIF


// AccountAllCharsGo <p>
[FUNCTION AccountAllCharsGo]
IF (<ACCOUNT.CHARS> > 0)
	FOR c 0 <EVAL <ACCOUNT.CHARS>-1>
		REF1=<ACCOUNT.CHAR.<DLOCAL.c>.UID>
		IF (<REF1.ISVALID>)
			REF1.GO <ARGS>
		ENDIF
	ENDFOR
ENDIF






[FUNCTION fFireWorksEffect]
IF (<ISBLANK <ARGV0>>)
	LOCAL.AMOUNT <R10,20>
ELSE
	LOCAL.AMOUNT <ARGV0>
ENDIF
IF (<ISBLANK <ARGV1>>)
	LOCAL.TIME <ARGV1>
ENDIF
FOR <dLOCAL.AMOUNT>
	SERV.NEWITEM { I_FX_SPARKLE 1 I_FX_HEAL_EFFECT 1  I_FX_BLESS_EFFECT 1 I_FX_CURSE 1  I_FX_SPARKLE_2 1}
	NEW.P=<SRC.P>
	NEW.NAME=a Fireworks display
	NEW.COLOR=COLORS_ALL
	NEW.ATTR ATTR_MOVE_NEVER|ATTR_DECAY
	IF (<LOCAL.TIME>)
		NEW.TIMER=<DLOCAL.TIME>
	ELSE
		NEW.TIMER={19 24}
	ENDIF
	NEW.MOVENEAR <SRC> <R3,9>
	NEW.NUDGEUP=<R15,35>
ENDFOR
// SRC.SOUND={ 011e 1 011f 1 }
SECTOR.ALLCLIENTS SOUND { 011b 1 011c 1 011c 1 011e 1 }




[FUNCTION Func_Open_Diff_Dlg]
IF (<ISONLINE>)	
	TRYSRC <UID> DIALOG <args>
ENDIF





// ARGS 0 = çantaya
// ARGS 1 = bankaya
[FUNCTION Player_Mounted_Binek_toShrink]
REF1=<FINDLAYER.layer_horse> // binek memory uid

IF (<ISBLANK <ARGS>>)
	LOCAL.PACK = <FINDLAYER.LAYER_PACK>
ELSE
	LOCAL.PACK = <ARGS>
ENDIF

IF (<REF1.ISVALID>)
	REF2=<REF1.MORE2> // binek uid
	IF (<REF2.ISVALID>)
		DISMOUNT <REF2>
		REF2.SHRINK
		REF3=<HVAL <REF2.ACTARG1>&~030000000> // Shrink item
		IF (<REF3.ISVALID>)
			REF3.CONT <FINDLAYER.LAYER_PACK>
		ENDIF
	ENDIF
ENDIF


[FUNCTION ESYA_KAYIT]
IF (<ISEMPTY <ARGS>>)
	Player_Mounted_Binek_toShrink <FINDLAYER.LAYER_PACK>
ENDIF

// Once tum layerleri cantaya indir
FOR layers 1 24
	IF (<dLOCAL.layers> != 11) && (<dLOCAL.layers> != 15) && (<dLOCAL.layers> != 16) && (<dLOCAL.layers> != 21)
		IF (<FINDLAYER.<LOCAL.layers>>)
			FINDLAYER.<LOCAL.layers>.BOUNCE
		ENDIF
	ENDIF
ENDFOR

// Cantadakileri hafiza belgesinin icine gonder.
REF1=<FINDLAYER.layer_pack>
IF (<REF1.ISVALID>)
	IF (<REF1.RESCOUNT>)
		SERV.NEWITEM I_HAFIZA_BELGESI
		NEW.MORE1 <UID>
		REF2=<NEW.UID>
		FORCONT <REF1> 0
			TAG0.CONTP=<CONTP>
			CONT <REF2>
			REMOVEFROMVIEW
			UPDATE
		ENDFOR
		REF2.CONT <FINDLAYER.layer_bankbox>
		REF1.UPDATE
		REF1.OPEN
		UPDATE
		UPDATEX
	ENDIF
ENDIF



[ITEMDEF I_HAFIZA_BELGESI]
DEFNAME=I_HAFIZA_BELGESI
ID=09ab
TYPE=T_CONTAINER
TDATA2=03c
FLIP=1
NAME=Esya Hafiza Belgesi
WEIGHT=0

ON=@create
DISPID=I_DEED
ATTR=ATTR_NEWBIE
COLOR=1936

ON=@DCLICK
IF !(<TOPOBJ.UID> == <SRC>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,600036,<NAME>
	RETURN 1
ENDIF
REF1=<MORE1>
IF (<REF1>) && (<SRC> != <REF1>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu belge size ait değil. (<REF1.NAME>)
	IF (<REF1>)
		CONT=<REF1.FINDLAYER.layer_bankbox>
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Belge sahibinin bankasına gönderildi.
		REF1.NOTICE <DEF.BFONT_NOTICE_RED>Size ait bir Eşya Hafıza belgesi <SRC.NAME> isimli oyuncu tarafından kullanılmaya çalışıldı. Belge bankanıza aktarıldı.
	ELSE
		RETURN 1
	ENDIF
	RETURN 1
ENDIF

IF (<RESCOUNT>)
	FORCONT <UID> 0
		CONT=<REF1.FINDLAYER.layer_pack>
		IF !(<ISBLANK <TAG0.CONTP>>)
			CONTP <TAG0.CONTP>
			TAG0.CONTP=
		ENDIF
	ENDFOR
ELSE
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Hafıza belgesi içinde eşya bulunmadığı için geri iade yapılmadı.
ENDIF

REMOVE
IF (<SRC.ISGM>)
	RETURN 0
ELSE
	RETURN 1
ENDIF






[FUNCTION sahipsizbinekler]
FORCHARS 7168
	IF (<NPC> == brain_animal) && !(<OWNER>)
		IF !( (<SPAWNITEM>) || (<ISEVENT.e_spawn_binek>) )
			ref1=<uid>
		ENDIF
	ENDIF
ENDFOR
src.gouid <ref1>


[FUNCTION Func_Auto_World_Char_Cleaner]
FORCHARS 7168
	IF (<NPC> == brain_animal)
		IF !(<REGION.FLAGS>&REGION_FLAG_HOUSE)
			IF !(<OWNER>)
				IF !( (<SPAWNITEM>) || (<ISEVENT.e_spawn_binek>) )
					LOCAL.BASIBOS ++
				ENDIF
			ELSE
				IF ((<REGION.SAFE>) && (<ISONLINE>))
					LOCAL.SAHIPLI ++
				ENDIF
			ENDIF
			
		ENDIF
	ENDIF
ENDFOR
IF (<dLOCAL.BASIBOS>)
	serv.b @39,,1,1 Sunucudan <dLOCAL.BASIBOS> adet başıboş binek silinmiştir. <QVAL (<dLOCAL.SAHIPLI>)?Safe alanda bulunan <dLOCAL.SAHIPLI> adet sahipli binek sahiplerinin bankasına gönderilmiştir.:>
ENDIF
IF (<dLOCAL.SAHIPLI>)
	serv.b @39,,1,1 Safe alanda bulunan <dLOCAL.SAHIPLI> adet sahipli binek sahiplerinin bankasına gönderilmiştir.
ENDIF






[FUNCTION NOTICE]
TAG0.NOTICE=<DEF.BFONT_BLACK><DEF.CENTER><SERV.rtime><DEF.BIG><DEF.CENTERE>*<DEF.BFONTE> <ARGS>
EVENTS +e_notice
IF (<ISCHAR>) && (<ISONLINE>)	
	TRYSRC <UID> DIALOG D_NOTICE
ENDIF

[DIALOG D_NOTICE]
0,30
RESIZEPIC 0 0 9380 315 170 
DHTMLGUMP 0 5 290 25 0 0 <DEF.CENTER>BİLDİRİM!
DHTMLGUMP 25 35 265 90 0 1 <SRC.TAG0.NOTICE>

[DIALOG D_NOTICE BUTTON]
ON=0
SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu bildiriyi okudunuz sayıldı!
SRC.TAG0.NOTICE.READ_AT=<serv.rtime>
SRC.EVENTS -e_notice


[EVENTS e_notice]

ON=@Login
TAG0.NOTICE.READ_AT=
DIALOGCLOSE D_NOTICE
DIALOG D_NOTICE
EVENTS -e_notice






[FUNCTION LOGOUT]
IF (<ISPLAYER>) && (<ISONLINE>)

	// SENDPACKET 026 00 00 00 00 00 // Disconnect (Tüm istemciler için)

	// Eger quit butonuna basmissa calisiyor.
	SENDPACKET 0D1 B01 // Logout Client
	
	// Eger bir scene varsa calisiyor.
	SENDPACKET 082 B04 // ReceiveLoginRejection
	SENDPACKET 085 B01 // ReceiveLoginRejection
	SENDPACKET 053 B04 // ReceiveLoginRejection
	
	SERV.LOGGER Logout Force: <name>
	
	DISCONNECT
	
ENDIF 



