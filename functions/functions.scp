LOCAL.X ++
REMOVE
ENDFOR
SRC.SYSMESSAGE SUNUCUDAN <DLOCAL.X> adet <args> silindi.

[FUNCTION SPELL_SAY]
SAYUA 0835,6,0,ENU <args>




[FUNCTION GetLinear]
LOCAL.iSkillPercent = <streat <args>>
LOCAL.Spell = <strarg <args>>
LOCAL.SpellEffect = <serv.spell.<dlocal.Spell>.effect>
args = <LOCAL.SpellEffect>
LOCAL.iSegSize = 0
LOCAL.iLoIdx = 0
LOCAL.iQty = <ARGV>

IF (<DLOCAL.iQty> == 0)
    RETURN 0
ELSEIF (<DLOCAL.iQty> == 1)
    RETURN <argv0>
ELSEIF (<DLOCAL.iQty> == 2)
    LOCAL.iLoIdx = 0
    LOCAL.iSegSize = 1000
ELSEIF (<DLOCAL.iQty> == 3)
    IF (<DLOCAL.iSkillPercent> >= 500)
        LOCAL.iLoIdx = 1
        LOCAL.iSkillPercent -= 500
    ELSE
        LOCAL.iLoIdx = 0
    ENDIF
    LOCAL.iSegSize = 500
ELSE
    LOCAL.iLoIdx = <MULDIV <DLOCAL.iSkillPercent>, <DLOCAL.iQty>, 1000>
    LOCAL.iQty --
    IF (<DLOCAL.iLoIdx> < 0)
        LOCAL.iLoIdx = 0
    ENDIF
    IF (<DLOCAL.iLoIdx> >= <DLOCAL.iQty>)
        LOCAL.iLoIdx = <EVAL <DLOCAL.iQty> - 1>
    ENDIF
    LOCAL.iSegSize = <EVAL 1000 / <DLOCAL.iQty>>
    LOCAL.iSkillPercent -= <EVAL <DLOCAL.iLoIdx> * <DLOCAL.iSegSize>>
ENDIF

LOCAL.iLoVal = <argv<dlocal.iLoIdx>>
LOCAL.iHiVal = <argv<eval <dlocal.iLoIdx>+1>>
LOCAL.iDiff = <EVAL <DLOCAL.iHiVal> - <DLOCAL.iLoVal>>
LOCAL.iChance = <EVAL <DLOCAL.iLoVal> + <MULDIV <DLOCAL.iDiff>, <DLOCAL.iSkillPercent>, <DLOCAL.iSegSize>>>

IF (<DLOCAL.iChance> <= 0)
    RETURN 0
ENDIF
RETURN <DLOCAL.iChance>




[FUNCTION Calc_GetRandVal]
LOCAL.IQTY <ARGV0>
IF (<DLOCAL.IQTY> <= 0)
	RETURN 0
ENDIF
IF (<DLOCAL.IQTY> > 32767)
	RETURN <MULDIV <R>, <DLOCAL.IQTY>, 327678 >
ENDIF
RETURN <EVAL (<R> % <DLOCAL.IQTY>)>




[FUNCTION GetSpellEffect]
// argv0 = spell
// argv1 = iSkillVal
// NOTE: Any randomizing of the effect must be done by varying the skill level .
// iSkillVal = 0-1000
IF !(<ARGV0>)
	RETURN 0
ENDIF
IF !(<ARGV1>)
	RETURN 0
ENDIF
RETURN <GetLinear <argv0> <argv1>>








