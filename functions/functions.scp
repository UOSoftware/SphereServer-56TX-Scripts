[FUNCTION FUNC_ORDERSET]
LOCAL.TAG=<ARGV[0]>
IF (<ISCHAR>)
	IF (STRMATCH(*ASC*,<CTAG0.<LOCAL.TAG>>)) || (STRMATCH(*ASC*,<TAG0.<LOCAL.TAG>>))
		SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Listeleme : Artan
		RETURN DESC
	ELSE
		SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Listeleme : Azalan
		RETURN ASC
	ENDIF
ELSE
	IF STRMATCH(*ASC*,<TAG0.<LOCAL.TAG>>)
		SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Listeleme : Artan
		RETURN DESC
	ELSE
		SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Listeleme : Azalan
		RETURN ASC
	ENDIF
ENDIF




[FUNCTION ActLogla]
SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, ----------------
SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, ACT: <ACT> <qval (<act.isvalid>) ? [<ACT.NAME>] : >
SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, ACTARG1: <dACTARG1>
SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, ACTARG2: <dACTARG2>
SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, ACTARG3: <dACTARG3>
REF1=<ACTPRV>

SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, ACTPRV: <REF1> <QVAL (<REF1.ISVALID>) ? [<REF1.NAME>] : >
SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, ACTP: <ACTP>
SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, ACTION: <ACTION>
SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, ACTIONEFFECT: <ACTIONEFFECT>
SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, ACTDIFF: <ACTDIFF>
IF (<ISONLINE> && <ISPLAYER>)
	IF (<TARG>)
		SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, Targ: <TARG> <qval (<Targ>) ? [<Targ.NAME>] : >
		SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, TargP: <TargP>
	ENDIF
ENDIF
SYSMESSAGELOC <def.tcolor_text>,<def.empty_cliloc2>, ActPri: <ActPri>








// Custom Warmde Function
// Use; I.FUNC_WARMODE 0/Empty = Peace Mode, 1 = War Mode
// [PLEVEL 1]
// WARMODE

[FUNCTION WARMODE]
IF !(<ISEMPTY <ARGS>>) && (<ISNUM <ARGS>>)
	FUNC_WARMODE <ARGS>
ELSE
	FUNC_WARMODE 0
ENDIF


[FUNCTION FUNC_WARMODE]
IF !(0<ARGN1>)
	FLAGS &= ~STATF_WAR
	IF (<ISPLAYER>) && (<ISONLINE>)
		SENDPACKET 072 00 00 32 00
	ENDIF
ELSE
	FLAGS |= STATF_WAR
	IF (<ISPLAYER>) && (<ISONLINE>)
		SENDPACKET 072 01 00 32 00
	ENDIF
ENDIF




[FUNCTION CustomMemDel_Force]
FORCHARMEMORYTYPE <args>
	REMOVE
ENDFOR



// Custom Peace Mode Function
[FUNCTION FUNC_PEACEMODE]
IF (<ISCHAR>)
	IF (<ISPLAYER>)
		TARGETCLOSE

		CustomMemDel_Force memory_iaggressor
		CustomMemDel_Force memory_harmedby
		CustomMemDel_Force memory_irritatedby
		CustomMemDel_Force memory_aggreived
		CustomMemDel_Force memory_fight	
		
		ACTION -1
		FUNC_WARMODE 0
		ATTACKER.CLEAR
		SKILL FAIL	
	ENDIF
ENDIF



