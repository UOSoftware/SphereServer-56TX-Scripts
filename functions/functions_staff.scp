VERSION=TX


[FUNCTION GETUID]
IF (<ISEMPTY <ARGS>>)
	SRC.SYSMESSAGE Bir serial (uid) giriniz.
	RETURN 1
ENDIF
REF1=<ARGS>
IF (<REF1.ISVALID>)
	IF (<REF1.ISITEM>)
		REF1.P <SRC.P>
	ELSEIF (<REF1.ISCHAR>)
		// REF1.MOVETO <SRC.P>
		REF1.GO <SRC.P>
		REF1.UPDATE
	ELSE
		SRC.SYSMESSAGE @38,,1,1 Bu seri numarasında herhangi bir nesne/obje yok.
	ENDIF
ELSE
	SRC.SYSMESSAGE @38,,1,1 Bu seri numarasında herhangi bir nesne/obje yok.
ENDIF


// Bir guilde gider (isim ile)
[FUNCTION GOGUILD]
IF (<ISEMPTY <ARGS>>)
	SRC.SYSMESSAGE Bir guild adi giriniz.
	RETURN 1
ENDIF
FORINSTANCES i_guild_stone
	IF (STRMATCH(*<ARGS>*,'<NAME>'))
		REF1=<UID>
		SRC.GOUID <REF1>
	ELSE
		SRC.SYSMESSAGE @38,,1,1 Bu isimde guild bulunamadı!
		RETURN 1
	ENDIF
ENDFOR




// Player adından oyuncuya gitme
[FUNCTION GoPlayerForName]
FOR 0 <EVAL <SERV.ACCOUNTS>-1>
IF (<SERV.ACCOUNT.<DLOCAL._for>>)
	LOCAL.ACCOUNT <SERV.ACCOUNT.<DLOCAL._for>.NAME>
		IF (<SERV.ACCOUNT.<LOCAL.ACCOUNT>.CHARS>)
			FOR CHARS 0 <EVAL <SERV.ACCOUNT.<LOCAL.ACCOUNT>.CHARS>-1>
				REF1=<SERV.ACCOUNT.<LOCAL.ACCOUNT>.CHAR.<DLOCAL.CHARS>.UID>
				IF (STRMATCH('<ARGS>','<REF1.NAME>'))
					SRC.GO <REF1.P>
				ENDIF
			ENDFOR
		ENDIF
	ENDIF
ENDFOR


// Player adından oyunucuyu getirme
[FUNCTION GetPlayerForName]
FOR 0 <EVAL <SERV.ACCOUNTS>-1>
	IF (<SERV.ACCOUNT.<DLOCAL._FOR>>)
		LOCAL.ACCOUNT <SERV.ACCOUNT.<DLOCAL._FOR>.NAME>
		IF (<SERV.ACCOUNT.<LOCAL.ACCOUNT>.CHARS> > 1)
			FOR CHARS 0 <EVAL <SERV.ACCOUNT.<LOCAL.ACCOUNT>.CHARS>-1>
				REF1=<SERV.ACCOUNT.<LOCAL.ACCOUNT>.CHAR.<DLOCAL.CHARS>.UID>
				IF (STRMATCH('<ARGS>','<REF1.NAME>'))
					//REF1.MOVETO <SRC.P>
					REF1.GO <SRC.P>
					SRC.UPDATE
				ENDIF
			ENDFOR
		ENDIF
	ENDIF
ENDFOR








