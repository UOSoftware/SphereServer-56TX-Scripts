// BULUNDUĞUM BÖLGEDEKİ ITEM SPAWNLARI
ON=6
FORINSTANCES i_worldgem_bit
	IF (<MAP> == <SRC.MAP>)
		IF (<REGION.DEFNAME> == <SRC.REGION.DEFNAME>)
			IF (<TYPE> == T_SPAWN_ITEM) && !(<CONT>)
				RESET
				LOCAL.I ++
			ENDIF
		ENDIF
	ENDIF
ENDFOR
SRC.sysmessageloc <def.tcolor_text>, <def.empty_cliloc2>, <DLOCAL.I> adet spawn resetlendi.
DIALOGCLOSE D_SpawnReset 
DIALOG D_SpawnReset 



// Seçili obje spawnları
ON=7
SRC.TARGETF FUNC_SPAWNRESET_TARGET_OBJ
DIALOGCLOSE D_SpawnReset 
DIALOG D_SpawnReset 


[FUNCTION FUNC_SPAWNRESET_TARGET_OBJ]
IF !(<ARGO>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Birşey seçiniz.
	RETURN 1
ELSEIF !((<ARGO.ISITEM>) || (<ARGO.ISCHAR>))
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Seçtiğiniz şey item veya char olmalı.
	RETURN 1
ENDIF

FORINSTANCES i_worldgem_bit
	IF (<MORE1> == <ARGO.BASEID>)
		RESET
		LOCAL.I ++
	ENDIF
ENDFOR
SRC.sysmessageloc <def.tcolor_text>, <def.empty_cliloc2>, <DLOCAL.I> adet spawn resetlendi.





