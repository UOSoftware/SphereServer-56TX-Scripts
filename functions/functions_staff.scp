[function herkesidiz]
// Başlangıç koordinatları
// LOCAL.StartX = 6449
// LOCAL.StartY = 1851
LOCAL.StartX = <SRC.P.X>
LOCAL.StartY = <SRC.P.Y>
LOCAL.StartZ = 0

// Grid ayarları
LOCAL.ColumnsPerRow = 5      // Her satırda kaç kişi olacak
LOCAL.SpacingY = 2            // Karakterler arası Y (güney) mesafesi
LOCAL.SpacingX = 2            // Sütunlar arası X (doğu) mesafesi

LOCAL.CurrentColumn = 0
LOCAL.CurrentRow = 0

FOR a 0 <EVAL <SERV.ACCOUNTS>-1>
    IF (<SERV.ACCOUNT.<DLOCAL.a>>)
        LOCAL.ACCOUNT = <SERV.ACCOUNT.<DLOCAL.a>.NAME>
		
        IF (<SERV.ACCOUNT.<LOCAL.ACCOUNT>>) && (<SERV.ACCOUNT.<LOCAL.ACCOUNT>.CHARS> > 0)
        
            FOR c 0 <EVAL <SERV.ACCOUNT.<LOCAL.ACCOUNT>.CHARS>-1>
                REF1 = <SERV.ACCOUNT.<LOCAL.ACCOUNT>.CHAR.<DLOCAL.c>.UID>
                // serv.log <ref1.name>
                // Yeni pozisyon hesapla
                LOCAL.NewX = <EVAL <LOCAL.StartX> + (<LOCAL.CurrentColumn> * <LOCAL.SpacingX>)>
                LOCAL.NewY = <EVAL <LOCAL.StartY> + (<LOCAL.CurrentRow> * <LOCAL.SpacingY>)>
                
                // Karakteri taşı
                REF1.GO <dLOCAL.NewX>,<dLOCAL.NewY>,<dLOCAL.StartZ>,0
                REF1.MOVE S
				IF (<REF1.FLAGS>&STATF_DEAD)
					REF1.RESURRECT 2
				ENDIF
				REF1.DIR 4
				REF1.UPDATE
                
                // Sıradaki pozisyona geç
                LOCAL.CurrentRow += 1
                
                // Eğer satır dolmuşsa
                IF (<LOCAL.CurrentRow> >= <LOCAL.ColumnsPerRow>)
                    LOCAL.CurrentRow = 0
                    LOCAL.CurrentColumn += 1
                ENDIF
                
            ENDFOR
            
        ENDIF
    ENDIF
ENDFOR





[FUNCTION RESKILL]
SRC.TARGETF F_RESKILL

[FUNCTION F_RESKILL]
IF !(<ARGO>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Hatalı seçim.
	SRC.TARGETF F_RESKILL
	RETURN 1
ELSEIF !(<ARGO.ISCHAR>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Hatalı seçim.
	SRC.TARGETF F_RESKILL
	RETURN 1
ENDIF
IF (<ARGO.FLAGS>&STATF_DEAD)
	ARGO.RESURRECT 1
	ARGO.HITS=<ARGO.STR>
	SRC.RESKILL
ELSE
	ARGO.DAMAGE 9999
	// ARGO.HITS=0
	SRC.RESKILL
ENDIF















