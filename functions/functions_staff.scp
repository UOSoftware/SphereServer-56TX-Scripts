[PLEVEL 2]
GOTUR

[FUNCTION GOTUR]
SRC.TARGETF FUNC_GOTUR_SELECT_OBJ
SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Başka yere götürmek istediğiniz varlığı veya eşyayı seçiniz.
RETURN 1

[FUNCTION FUNC_GOTUR_SELECT_OBJ]
REF1=<ARGO>

IF !(<ARGO>)
SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bir eşya veya varlık seçiniz.
SRC.TARGETFG FUNC_GOTUR_SELECT_OBJ
RETURN 1
ENDIF

SRC.CTAG0.GOTUR_OBJ <REF1>
SRC.TARGETFG FUNC_GOTUR_SELECT_P
SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Götürmek istediğiniz <qval (<ref1.isitem>)?eşya:varlık> seçildi. Şimdi götürmek istediğiniz yeri seçiniz.
 

[FUNCTION FUNC_GOTUR_SELECT_P]
REF1=<SRC.CTAG0.GOTUR_OBJ>

IF !(<REF1>)
	SRC.SYSMESSAGELOC <def.tcolor_red>,SYSMESSAGELOC <def.tcolor_red>,600022 // Bir hata oluştu!
	SRC.SYSMESSAGELOC <def.tcolor_red>,SYSMESSAGELOC <def.tcolor_red>,600052 // Nesne sunucuda kayıtlı değil/bulunamadı!
	SRC.TARGETFG FUNC_GOTUR_SELECT_OBJ
RETURN 1
ENDIF

IF (<REF1>)

	IF (<REF1.ISITEM>)
		REF1.P <SRC.TARGP>
		IF (<ref1.TYPE> == T_SPAWN_CHAR)
			ref1.RESET
		ENDIF
	ELSE
		REF1.GO <SRC.TARGP>
	ENDIF

	SRC.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, <REF1.NAME>: <SRC.TARGP.X>-<SRC.TARGP.Y>-<SRC.TARGP.Z>-<SRC.TARGP.M> yerine götürüldü!
	SRC.CTAG0.GOTUR_OBJ=
	SRC.TARGETFG FUNC_GOTUR_SELECT_OBJ
ELSE
SRC.SYSMESSAGELOC <def.tcolor_red>,600021 // Hatalı seçim/hedef.
ENDIF



[PLEVEL 2]
GETIR

[FUNCTION GETIR]
SRC.TARGETF F_SUMMONTO
src.SYSMESSAGELOC <def.tcolor_grey>,<def.empty_cliloc2>, Yanınıza getirmek istediğiniz varlığı veya eşyayı seçiniz.

[FUNCTION F_SUMMONTO]
IF (<ARGO>)
	IF (<ARGO.UID> == <SRC.UID>)
		SRC.SYSMESSAGELOC <def.tcolor_red>,600088 // "Kendinizi seçemezsiniz."
		SRC.TARGETF F_SUMMONTO
	ENDIF

	IF (<ARGO.ISITEM>)
		ARGO.P <SRC.P>
		SRC.TARGETF F_SUMMONTO
		IF (<ARGO.TYPE> == T_SPAWN_CHAR)
			ARGO.RESET
		ENDIF
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, <argo.name> isimli esya yaniniza geldi.
	ENDIF

	IF (<ARGO.ISCHAR>)
		ARGO.GO <SRC.P>
		SRC.TARGETF F_SUMMONTO
		SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, <argo.name> isimli varlik yaniniza geldi.
	ENDIF
ENDIF






[FUNCTION SpawnReset]
DIALOGCLOSE D_SpawnReset
DIALOG D_SpawnReset


[DIALOG D_SpawnReset]
<DEF.DSP>

RESIZE 0,0,330,210,Spawn RESET

DORIGIN 20 50

BUTTON +0 +0 4006 4007 1 0 1
DTEXT +30 +0 0 Tüm spawnlar (Chars, Items)

BUTTON +0 +20 4006 4007 1 0 2
DTEXT +30 +20 0 Char spawnları

BUTTON +0 +40 4006 4007 1 0 3
DTEXT +30 +40 0 Item spawnları

BUTTON +0 +60 4006 4007 1 0 4
DTEXT +30 +60 0 Bulunduğum bölgedeki spawnlar

BUTTON +0 +80 4006 4007 1 0 5
DTEXT +30 +80 0 Bulunduğum bölgedeki char spawnları

BUTTON +0 +100 4006 4007 1 0 6
DTEXT +30 +100 0 Bulunduğum bölgedeki item spawnları

BUTTON +0 +120 4006 4007 1 0 7
DTEXT +30 +120 0 Seçili object spawnları


[DIALOG D_SpawnReset BUTTON]
// TÜM SPAWNLAR
ON=1
FORINSTANCES i_worldgem_bit
	IF (<MAP> == <SRC.MAP>)
		IF (<TYPE> == T_SPAWN_CHAR) && !(<CONT>)
			RESET
			LOCAL.I ++
		ENDIF
	ENDIF
ENDFOR
SRC.sysmessageloc <def.tcolor_text>, <def.empty_cliloc2>, <DLOCAL.I> adet spawn resetlendi.
DIALOGCLOSE D_SpawnReset 
DIALOG D_SpawnReset 


// CHAR SPAWNLARı
ON=2 
FORINSTANCES i_worldgem_bit
	IF (<MAP> == <SRC.MAP>)
		IF (<TYPE> == T_SPAWN_CHAR) && !(<CONT>)
			RESET
			LOCAL.I ++
		ENDIF
	ENDIF
ENDFOR
SRC.sysmessageloc <def.tcolor_text>, <def.empty_cliloc2>, <DLOCAL.I> adet spawn resetlendi.
DIALOGCLOSE D_SpawnReset 
DIALOG D_SpawnReset 


// ITEM SPAWNLARı
ON=3
FORINSTANCES i_worldgem_bit
	IF (<MAP> == <SRC.MAP>)
		IF (<TYPE> == T_SPAWN_ITEM) && !(<CONT>)
			RESET
			LOCAL.I ++
		ENDIF
	ENDIF
ENDFOR
SRC.sysmessageloc <def.tcolor_text>, <def.empty_cliloc2>, <DLOCAL.I> adet spawn resetlendi.
DIALOGCLOSE D_SpawnReset 
DIALOG D_SpawnReset 



// BULUNDUĞUM BÖLGELDEKİ SPAWNLAR
ON=4
FORINSTANCES i_worldgem_bit
	IF (<MAP> == <SRC.MAP>)
		IF (<REGION>) && (<REGION.DEFNAME> == <SRC.REGION.DEFNAME>)
			RESET
			LOCAL.I ++
		ENDIF
	ENDIF
ENDFOR
SRC.sysmessageloc <def.tcolor_text>, <def.empty_cliloc2>, <DLOCAL.I> adet spawn resetlendi.
DIALOGCLOSE D_SpawnReset 
DIALOG D_SpawnReset 



// BULUNDUĞUM BÖLGEDEKİ CHAR SPAWNLARI
ON=5
FORINSTANCES i_worldgem_bit
	IF (<MAP> == <SRC.MAP>)
		IF (<TYPE> == T_SPAWN_CHAR) && !(<CONT>)
			IF (<REGION>) && (<REGION.DEFNAME> == <SRC.REGION.DEFNAME>)
				RESET
				LOCAL.I ++
			ENDIF
		ENDIF
	ENDIF
ENDFOR
