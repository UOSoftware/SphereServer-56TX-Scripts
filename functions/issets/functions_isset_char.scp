[FUNCTION f_isCursed]
FORCHARLAYER 32
   IF (<BASEID>==i_rune_curse)
      RETURN 1
   ENDIF
ENDFOR
RETURN 0

[FUNCTION IsBodyMan]
IF ((<BODY> == C_MAN) || (<ID> == C_MAN) || (<OBODY> == C_MAN))
