[FUNCTION IsNearGate]
LOCAL.Radius = <args>
IF (<LOCAL.Radius> > 7168)
	LOCAL.Radius = 100
ENDIF
IF (<LOCAL.Radius> < 0)
	LOCAL.Radius = 1
ENDIF
FORITEMS <DLOCAL.Radius>
	IF (<IsTeleportItem>)
		LOCAL.X ++
	ENDIF
ENDFOR
RETURN <DLOCAL.X>





[FUNCTION NoGoldMsg]
RETURN Bu işlem için <NumberFormat <DARGS>> gpye ihtiyacınız var. (Gerekli gold: <NumberFormat <EVAL <DARGS>-<GOLD>>>)


[FUNCTION IsNomove]
IF (<FLAGS>&STATF_STONE|STATF_FREEZE)
RETURN 1
ENDIF
RETURN 0


[FUNCTION IsInvis]
IF (<FLAGS>&STATF_INVISIBLE|STATF_INSUBSTANTIAL) 
	RETURN 1
ENDIF
RETURN 0

[FUNCTION IsHide]
IF (<FLAGS>&STATF_HIDDEN|STATF_INSUBSTANTIAL)
	RETURN 1
ENDIF
RETURN 0

[FUNCTION IsDeath]
IF (<FLAGS>&STATF_DEAD) 
	RETURN 1
ELSEIF (<HITS> <= 0)
	RETURN 1
ENDIF
RETURN 0


// Stat

[FUNCTION oStatTotal]
RETURN <EVAL <OSTR>+<ODEX>+<OINT>>

[FUNCTION StatTotal]
RETURN <EVAL <STR>+<DEX>+<INT>>



// Class


/// Mage Kontrol
[FUNCTION IsMage]
IF ((<MAGERY> > 98.0) && (<MEDITATION> > 98.0) && (<EVALUATINGINTEL> > 98.0)) && ((<OSTR> >= 80) || (<ODEX> <= 25)) && !((<TACTICS>) || (<FENCING>) || (<MACEFIGHTING>) || (<SWORDSMANSHIP>) || (<ARCHERY>) || (<WRESTLING>))
	RETURN 1
ENDIF
RETURN 0

// Warrior Kontrol
[FUNCTION ISWARRIOR]
IF (<TACTICS> > 98.0) && ((<OSTR> >= 100) || (<ODEX> >= 100)) && ((<FENCING> > 98.0) || (<MACEFIGHTING> > 98.0) || (<SWORDSMANSHIP> > 98.0) || (<ARCHERY> > 98.0) || (<WRESTLING> > 98.0)) && !((<MAGERY>) || (<MEDITATION>) || (<EVALUATINGINTEL>))
	RETURN 1
ENDIF
RETURN 0

// Warlock Kontrol
[FUNCTION ISWARLOCK]
IF ((<MAGERY> > 98.0) && (<TACTICS> > 98.0)) && ((<FENCING> > 98.0) || (<MACEFIGHTING> > 98.0) || (<SWORDSMANSHIP> > 98.0) || (<ARCHERY> > 98.0) || (<WRESTLING> > 98.0))
	RETURN 1
ENDIF
RETURN 0



[FUNCTION ISCLASSNAME]
IF (<ISWARRIOR>)
	RETURN Warrior
	
ELSEIF (<ISMAGE>)
	RETURN Mage
	
ELSEIF (<ISWARLOCK>)
	RETURN Warlock
	
ENDIF
Return Belirsiz






[FUNCTION IsCharType]
IF (<NPC>)
	LOCAL.CHARTYPE = <NPC>
ELSEIF (<SRC.ISPLAYER>)
	LOCAL.CHARTYPE = -1
ENDIF
RETURN <DLOCAL.CHARTYPE>



[FUNCTION IsGenderName]
return <IsSexName>


[FUNCTION IsSexName]
IF (<OBODY>==c_man)
	RETURN Male
ELSEIF (<OBODY> == c_woman)
	RETURN Female
ELSEIF (<OBODY> == c_man_gm)
	RETURN GM
ELSE
	RETURN -
ENDIF





[FUNCTION IsPoisoned]
IF (<FLAGS>&STATF_POISONED) 
	RETURN 1
ELSEIF (<FINDID.I_RUNE_POISON>)
	RETURN 1
ENDIF
RETURN 0


[FUNCTION IsNoFullHp]
IF !(<ISDEATH>) && (<hits> < <str>)
RETURN 1
ENDIF
RETURN 0


// hits
// stam
// mana
[FUNCTION IsNoFullStatVal]
local.key = <argv0>
IF (strmatch(*hits*,'<local.key>))
local.stat str
ELSEIF (strmatch(*stam*,'<local.key>))
local.stat dex
ELSEIF (strmatch(*mana*,'<local.key>))
local.stat int
ENDIF
IF !(<ISDEATH>) && (<i.<local.key>> < <i.<local.stat>>)
	RETURN 1
ENDIF
RETURN 0


[FUNCTION IsNoFullMp]
IF !(<ISDEATH>) && (<mana> < <int>)
RETURN 1
ENDIF
RETURN 0


[FUNCTION IsNoFullSp]
IF !(<ISDEATH>) && (<stam> < <dex>)
RETURN 1
ENDIF
RETURN 0



[FUNCTION IsMonsters]
IF (<ISCHAR>)
	IF (<NPC> == brain_monster || <NPC> == brain_berserk  || <NPC> == brain_dragon) 
		RETURN 1
	ENDIF
ENDIF
RETURN 0

[FUNCTION IsVendors]
IF (<NPC> == brain_healer || <NPC> == brain_banker || <NPC> == brain_vendor || <NPC> == brain_animal_trainer) 
	RETURN 1
ENDIF
RETURN 0



[FUNCTION IsSummonNpc]
IF (<ISCHAR> && <NPC>)
	IF (<FINDID.I_RUNE_SUMMON_CREATURE>)
		RETURN 1
	ENDIF
ENDIF
RETURN 0


[FUNCTION IsAnimalNpc]
IF (<ISCHAR> && <NPC>) 
	IF (<NPC> == brain_animal) 
		RETURN 1
	ENDIF
ENDIF
RETURN 0

[FUNCTION IsMountableNpc]
IF (<ISCHAR> && <NPC>) 
	LOCAL.ID 0x<STRSUB 1 99 <SERV.CHARDEF.<BASEID>.ID>>
	LOCAL.MT <def.mount_<LOCAL.ID>>
	IF !(<ISEMPTY <LOCAL.MT>>) && (<RESOURCETYPE <LOCAL.MT>> == RES_ITEMDEF)
		RETURN 1
	ENDIF
ENDIF
RETURN 0


[FUNCTION IsGolemNpc]
IF (<BASEID> == C_GOLEM_TINKER) || (<BASEID> == C_GOLEM_TINKER_ENERGY) || (<BASEID> == C_GOLEM_TINKER_EARTH)
	RETURN 1
ENDIF
RETURN 0


[FUNCTION IsPetableNpc]
IF (<IsMountableNpc>)
	RETURN 1
ELSEIF (<IsGolemNpc>) 
	RETURN 1
ENDIF
RETURN 0


[FUNCTION IsHealableChar]
IF (<ISCHAR>)

	IF (<ISPLAYER>)
		RETURN 1
		
	ELSEIF (<NPC> == brain_animal || <NPC> == brain_none)
		RETURN 1	
		
	ENDIF
ENDIF
RETURN 0


[FUNCTION ISCRIMINAL]
IF (<ISCHAR>)
	IF (<ISPLAYER>)
		IF ((<FLAGS>&STATF_CRIMINAL) || (<FINDLAYER.layer_flag_criminal>)) || (<KARMA> <= -2000)
			RETURN 1
		ENDIF	
	ELSE
		IF ((<FLAGS>&STATF_CRIMINAL) || (<KARMA> <= 0)) && (<NPC> != BRAIN_HUMAN)
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 0




[FUNCTION ISPK]
IF (<ISCHAR>)
	IF !(<NPC>)
	LOCAL.MURDERKILL=<EVAL <SERV.MURDERMINCOUNT>+1>
		IF (<KILLS> >= <LOCAL.MURDERKILL>) || (<KARMA> <= -2001)
			RETURN 1
		ENDIF
	ELSE
		IF (<KARMA> <= -800)
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 0



[FUNCTION ISHELPSTUCK]
IF (<FINDID.I_MEMORY_HELPPAGE_STUCK>)
	IF (<FINDID.I_MEMORY_HELPPAGE_STUCK.MORE1>)
		RETURN 1
	ENDIF
ENDIF
RETURN 0


[FUNCTION IsUseSkill]
IF ((<ACTION> == ID(SKILL_<ARGV[0]>)) || (<ACTION> == SKILL_<ARGV[0]>))
	RETURN 1
ENDIF
RETURN 0


