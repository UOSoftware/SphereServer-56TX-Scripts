



[FUNCTION Food_GetLevelPercent]
LOCAL.MAX = <MAXFOOD>
IF (<DLOCAL.MAX> == 0)
	RETURN 100
ENDIF
return <MulDiv <food>, 100, <dLOCAL.MAX>>





[FUNCTION JobKey]
IF (STRMATCH('Animal Trainer','<JOB>'))
	LOCAL.Job Animal_Trainer
	
ELSEIF (STRMATCH('High Mage','<JOB>'))
	LOCAL.Job High_Mage
	
ELSEIF (STRMATCH('Fur Trader','<JOB>'))
	LOCAL.Job Fur_Trader	
	
ELSEIF (STRMATCH('Weaponsmith Blade','<JOB>'))
	LOCAL.Job Weaponsmith_Blade	
	
ELSEIF (STRMATCH('Weaponsmith Blunt','<JOB>'))
	LOCAL.Job Weaponsmith_Blunt
	
ELSE
	LOCAL.Job <JOB>
ENDIF
RETURN <LOCAL.JOB>





[FUNCTION IsCastUseSpell]
// 45 = Mark
// 32 = Recall
// 52 = Gate

//IF (<MANA> < <SERV.SPELL.<ARGS>.MANAUSE>)
	//SRC.SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, <DEFMSG.spell_try_nomana> (<SERV.SPELL.<ARGS>.NAME> için Gereken mana: <SERV.SPELL.<ARGS>.MANAUSE>)
	//RETURN 0

IF (<TAG0.TAMETEKRAR> > 0)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Binek evcilleştirirken recall / gate / mark işlemi yapamazsınız.
	RETURN 0
	
ELIF (<TAG0.NOMOVETILL>) 
	SYSMESSAGELOC <def.tcolor_red>,600029 // "Freeze durumdayken bu işlemi yapamazsınız."
	RETURN 0

ELIF (<FLAGS>&STATF_DEAD)
	SYSMESSAGELOC <def.tcolor_red>,600027 // "Ölü durumdayken bu işlemi yapamazsınız."
	RETURN 0

ELIF (<FLAGS>&STATF_STONE)
	SYSMESSAGELOC <def.tcolor_red>,600028 // "Stone durumdayken bu işlemi yapamazsınız."
	RETURN 0

ELIF (<FLAGS>&STATF_FREEZE)
	SYSMESSAGELOC <def.tcolor_red>,600029 // "Freeze durumdayken bu işlemi yapamazsınız."
	RETURN 0
	
ELIF (<REGION.FLAGS>&REGION_FLAG_SAFE)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu bölgede bunu kullanamazsınız.
	RETURN 0

ELIF (<REGION.FLAGS>&REGION_ANTIMAGIC_RECALL_OUT)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu bölgeden ulaşımlar kapatılmıştır. (Anti-magic recall out)
	RETURN 0

ELIF (<REGION.FLAGS>&REGION_ANTIMAGIC_GATE)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu bölgeden ulaşımlar kapatılmıştır. (Anti-magic gate)
	RETURN 0
	
ELIF (<REGION.FLAGS>&REGION_ANTIMAGIC_ALL)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu bölgeden ulaşımlar kapatılmıştır. (Anti-magic all)
	RETURN 0
	
ELIF (<IsInHouse>)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu bölgede recall / gate / mark işlemi yapamazsınız.
	RETURN 0

ELIF (<IsInShip>) || (<IsOnSea>)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu bölgede recall / gate / mark işlemi yapamazsınız.
	RETURN 0

ELIF (strmatch('Logout','<REGION.NAME>')) || (strmatch(*Immortal City*,'<REGION.NAME>')) || (strmatch('Star','<REGION.NAME>')) || (strmatch(*Green Acres*,'<REGION.NAME>')) || (strmatch(*Jail*,'<REGION.NAME>'))
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Bu bölgede recall / gate / mark işlemi yapamazsınız.
	RETURN 0
	
ELIF (<ACCOUNT.PRIV>&PRIV_JAILED)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Hapis cezanız bitmedi bu yüzden recall / gate / mark işlemi yapamazsınız.
	RETURN 0

ELIF (<ISHELPSTUCK>)
	SYSMESSAGELOC <def.tcolor_red>,<def.empty_cliloc2>, Stuck halinde recall / gate / mark işlemi yapamazsınız.
	RETURN 0
ENDIF

RETURN 1






[FUNCTION IsCanMoveFullDir]
IF (<CANMOVE S> || <CANMOVE SW> || <CANMOVE SW> || <CANMOVE W> || <CANMOVE NW> || <CANMOVE N> || <CANMOVE NE> || <CANMOVE E> || <CANMOVE SE> || <CANMOVE S>)
	RETURN 1
ENDIF
RETURN 0



