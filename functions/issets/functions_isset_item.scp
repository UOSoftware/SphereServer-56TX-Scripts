[FUNCTION IsSpellFieldItem]
IF (<TYPE> == T_SPELL) 
	RETURN 1
ELSEIF (<BASEID> == 080) 
	RETURN 1
ELSEIF (STRMATCH(*I_FX_ENERGY_FIELD*,'<BASEID>'))
	RETURN 1
ELSEIF (STRMATCH(*I_FX_FIELD_PARALYZE*,'<BASEID>'))
	RETURN 1
ELSEIF (STRMATCH(*I_FX_POISON_FIELD*,'<BASEID>'))
	RETURN 1
ELSEIF (STRMATCH(*I_FX_FIELD_FIRE*,'<BASEID>'))
	RETURN 1
ELSEIF (STRMATCH(*I_FX_FIELD_FIRE_NS*,'<BASEID>'))
	RETURN 1
ENDIF
RETURN 0

