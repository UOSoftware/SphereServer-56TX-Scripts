[FUNCTION IsWeaponPoisonLevelName]
IF (<MOREZ>)
	IF ((<MOREZ> >= 1) && (<MOREZ> < 53))
		LOCAL.CONDITION sickly
	ELSEIF ((<MOREZ> >= 53) && (<MOREZ> < 73))
		LOCAL.CONDITION very ill
	ELSEIF ((<MOREZ> >= 73) && (<MOREZ> < 96))
		LOCAL.CONDITION extremely
	ELSEIF ((<MOREZ> >= 96) && (<MOREZ> < 127))
		LOCAL.CONDITION deadly
	ENDIF
RETURN <LOCAL.CONDITION>
ENDIF	



[FUNCTION IsDamageName]
IF (<HITS> > <MAXHITS>)
	LOCAL.STATUSMSG <DEFMSG.ITEMSTATUS_PERFECT> // kusursuz
	
ELSEIF (<HITS> == <MAXHITS>)
	LOCAL.STATUSMSG <DEFMSG.ITEMSTATUS_FULL> // hasarsız
	
ELSEIF (<HITS> > <EVAL <MAXHITS> / 2>)
	LOCAL.STATUSMSG <DEFMSG.ITEMSTATUS_WELLWORN> // iyi
		
ELSEIF (<HITS> > <EVAL <MAXHITS> / 3>)
	LOCAL.STATUSMSG <DEFMSG.ITEMSTATUS_SCRATCHED>  // yıpranmış
		
ELSEIF (<HITS> > 3)
	LOCAL.STATUSMSG <DEFMSG.ITEMSTATUS_BADLY> // ağır hasarlı
ELSE
	LOCAL.STATUSMSG <DEFMSG.ITEMSTATUS_FALL_APART> // parçalanmak üzere
ENDIF

RETURN <LOCAL.STATUSMSG>


[FUNCTION IsSignID]
// START: 0x0BA3 = 2979
// END: 0x0C0E = 3086
IF (<DISPID> == 0B95)
	LOCAL.SIGN=1
ELSEIF (<DISPID> == 0B96)
	LOCAL.SIGN=1
ELSEIF (<DISPID> == 01F28)
	LOCAL.SIGN=1
ELSEIF (<DISPID> == 01F29)
	LOCAL.SIGN=1
ENDIF
IF ((<DISPID> >= 2979) && (<DISPID> <= 3086))
	LOCAL.SIGN=1
ENDIF
RETURN <DLOCAL.SIGN>


[FUNCTION IsMulti]
IF (<TYPE> == T_MULTI) 
	RETURN 1
ELSEIF (<TYPE> == T_MULTI_CUSTOM)
	RETURN 1
ENDIF
RETURN 0







// .show IsGuildAlignCount 0 (natural)
// .show IsGuildAlignCount 1 (order)
// .show IsGuildAlignCount 2 (chaos)
[FUNCTION IsGuildAlignCount]
IF (<ARGS> >= 0) || (<ARGS> <= 2)
	FORINSTANCES i_guild_stone
		IF (<ALIGN> == <ARGS>)
			LOCAL.ALIGN_<ARGS> ++
		ENDIF
	ENDFOR
	RETURN <DLOCAL.ALIGN_<ARGS>>
ENDIF





