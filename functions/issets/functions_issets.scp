
[COMMENT]

//*****************************************
// Region & Map & Area
//*****************************************

// Ev sistemi icinde var.
// [FUNCTION IsOnHouse]
// REF1 = <REGION.UID>
// IF (<IsInHouse>) && !(<Z> == <SERV.MAP(<P.X>,<P.Y>,<P.M>).TERRAIN.Z>)
	// RETURN 1
// ENDIF
// RETURN 0

[FUNCTION IsInHouse]
IF (<REGION>)
	IF (<REGION.FLAGS>&REGION_FLAG_HOUSE)
		RETURN 1
	ENDIF
ENDIF
RETURN 0


[FUNCTION IsInShip]
IF (<REGION>)
	IF (<REGION.FLAGS>&REGION_FLAG_SHIP)
		RETURN 1
	ENDIF
ENDIF
RETURN 0


[FUNCTION ISINSEA]
RETURN <IsOnSea>

[FUNCTION IsOnSea]
IF (<REGION>)
	IF !(<REGION.FLAGS>&REGION_FLAG_SHIP)
		IF (<P.Z> <= -3) && ( (<P.TYPE> == T_WATER) || (<P.TERRAIN> == 05f) || (<P.TERRAIN> == 055) || (<P.TERRAIN> == 059) || (<P.TERRAIN> == 064) || (<P.TERRAIN> == 0AA) || (<ISNEARTYPE T_WATER 0>) )
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 0

[FUNCTION ISINSAFE]
IF (<REGION>)
	IF (<REGION.SAFE>)
		RETURN 1
	ENDIF
ENDIF
RETURN 0

[FUNCTION IsNotAllowedRecallArea]
IF (<REGION>)
	IF (<REGION.DEFNAME> == a_yomotsu_mines)
		RETURN 1
	ELSEIF (<REGION.DEFNAME> == a_duello_inside_0)
		RETURN 1
	ELSEIF (<REGION.DEFNAME> == a_duello_inside_0_2v2)
		RETURN 1
	ELSEIF (<REGION.DEFNAME> == a_baslangic)
		RETURN 1
	ENDIF
ENDIF
RETURN 0

[FUNCTION IsRegionNameDetail]
IF (<REGION>)
	IF (<IsInHouse>)
		REF1=<UID.<REGION.UID>.MORE1> // ÖLDÜRÜLDÜĞÜ YERİN SAHİBİ EV-GEMİ
		LOCAL.REGION <STRARG <STRTOUPPER(<STRSUB 0 1 <REGION.NAME>>)><STRTOLOWER(<STRSUB 1 16 <REGION.NAME>>)>> (<REF1.NAME> evinde)
	ELSEIF (<IsInShip>)
		REF2=<UID.<REGION.UID>.MORE1> // ÖLDÜRÜLDÜĞÜ YERİN SAHİBİ EV-GEMİ
		LOCAL.REGION <STRARG <STRTOUPPER(<STRSUB 0 1 <REGION.NAME>>)><STRTOLOWER(<STRSUB 1 16 <REGION.NAME>>)>> (<REF2.NAME> gemisinde)
	ELSE
		LOCAL.REGION <REGION.NAME>	
	ENDIF
RETURN <LOCAL.REGION>
ENDIF






[eof]
