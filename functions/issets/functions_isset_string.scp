


//*****************************************
// Strings
//*****************************************

[FUNCTION ISBADCHAR]
// Harf (Türkçe dahil), rakam ve boşluk dışında bir karakter varsa 1 (emulatörün HASSPECIAL'ı).
RETURN <HASSPECIAL <ARGS>>



[FUNCTION ISFORBIDSTRING]
IF  (STRMATCH(*<SERV.NAME>*,'<ARGS>'))
	RETURN 1
ENDIF
FOR 1 <ARRAYCOUNT <DEF.forbidden_strings>>
	IF  (STRMATCH(*<ARRAY <DEF.forbidden_strings>,<DLOCAL._FOR>>*,'<ARGS>'))
		RETURN 1
	ENDIF
ENDFOR
RETURN 0


[FUNCTION ISNUMERIC]
// Sadece rakam (0-9) varsa 1 (emulatörün ISDIGITS'i).
RETURN <ISDIGITS <ARGS>>



[FUNCTION ISSTRING]
// Sadece A-Z ve a-z varsa 1 (emulatörün ISALPHA.ASCII'si).
RETURN <ISALPHA.ASCII <ARGS>>

[FUNCTION ISALPHANUMERIC]
// Sadece A-Z, a-z ve 0-9 varsa 1 (emulatörün ISALNUM.ASCII'si).
RETURN <ISALNUM.ASCII <ARGS>>


[eof]
