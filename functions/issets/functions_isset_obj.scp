

// IsNearSpellField id
[FUNCTION IsNearSpellField]
REF1=<UID>
FORITEMS 0
	IF (<TYPE> == T_SPELL && <ID> == <ARGS>)
		// IF (<LINK.ISVALID>) && (<LINK.ISPLAYER>)
			// IF (<LINK> != <REF1>)
				LOCAL.CROSSFIELD ++
			// ENDIF
		// ENDIF
	ENDIF
ENDFOR
RETURN <DLOCAL.CROSSFIELD>




// etrafındaki eşya sayısı
[FUNCTION IsNearItemCount]
REF1=<UID>
IF (<P.M>)
	FORITEMS 1
		REF2=<UID>
		IF (<REF1.DISPID> == <REF2.DISPID>) && (<REF1.DISTANCE <REF2>> <= 1)
			LOCAL.ITEMS ++
		ENDIF
	ENDFOR
ENDIF
RETURN <LOCAL.ITEMS>



[FUNCTION ISNEARPLAYERS]
FORCLIENTS <EVAL <SERV.MapViewSize>>
	IF (<ISPLAYER>) && !(<ISGM>)
		LOCAL.PLAYERS ++
	ENDIF
ENDFOR
RETURN <dLOCAL.PLAYERS>


[eof]
